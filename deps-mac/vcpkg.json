{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "kicad-mac-deps",
  "version": "0.1.0",
  "$comment": "macOS (arm64-osx) dependencies for the native wxOSX build of the same KiCad tree. Derived from ../deps/vcpkg.json without the Android-only libspnav and mimalloc.",
  "dependencies": [
    "boost-algorithm",
    "boost-bimap",
    "boost-filesystem",
    "boost-functional",
    "boost-graph",
    "boost-iterator",
    "boost-locale",
    "boost-math",
    "boost-optional",
    "boost-property-tree",
    "boost-ptr-container",
    "boost-random",
    "boost-range",
    "boost-stacktrace",
    "boost-uuid",
    "cairo",
    "curl",
    {
      "name": "gettext",
      "features": [
        "tools"
      ],
      "host": true
    },
    "harfbuzz",
    "freetype",
    "fontconfig",
    "libiconv",
    "libpng",
    "glm",
    {
      "name": "opencascade",
      "features": [
        "rapidjson"
      ]
    },
    "openssl",
    {
      "name": "sqlite3",
      "features": [
        "fts5",
        "fts4",
        "fts3",
        "rtree",
        "session"
      ]
    },
    "icu",
    "ngspice",
    {
      "name": "libgit2",
      "features": [
        "ssh"
      ]
    },
    "nng",
    "protobuf",
    "zstd",
    "vulkan-headers",
    {
      "name": "glslang",
      "features": [
        "tools"
      ],
      "host": true
    },
    {
      "name": "spirv-tools",
      "features": [
        "tools"
      ],
      "host": true
    },
    "libjpeg-turbo",
    "unixodbc",
    {
      "name": "spirv-cross",
      "host": true
    }
  ],
  "overrides": [
    {
      "name": "glm",
      "version": "0.9.9.8#2"
    },
    {
      "name": "ngspice",
      "version": "46#0"
    },
    {
      "name": "protobuf",
      "version": "6.33.4#2"
    }
  ]
}