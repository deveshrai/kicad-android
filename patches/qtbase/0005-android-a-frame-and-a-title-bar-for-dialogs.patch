 QT_BEGIN_NAMESPACE
 
@@ -59,6 +63,9 @@ void QAndroidPlatformWindow::initialize()
             isForeignWindow(), m_nativeParentQtWindow, listener);
     m_nativeViewId = m_nativeQtWindow.callMethod<jint>("getId");
 
+    // Before the first geometry: with a frame, a position can be the frame's
+    updateDecoration();
