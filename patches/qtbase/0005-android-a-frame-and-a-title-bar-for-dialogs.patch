     // the fact that it's a raster window for now
     m_isRaster = window->surfaceType() == QSurface::RasterSurface;
@@ -136,8 +143,106 @@ void QAndroidPlatformWindow::setSafeAreaMargins(const QMargins safeMargins)
     m_safeAreaMargins = safeMargins;
 }
 
-void QAndroidPlatformWindow::setGeometry(const QRect &rect)
+// Android has no window manager for the windows inside an activity, so without this a
+// dialog is a bare rectangle: no frame, no title, and no way to move it.  QtWindow draws
+// a title strip and a border around a dialog's client area, and moves the window when
+// the strip is dragged.  Here they are the window's frame margins, so QWidget's
+// frameGeometry(), pos() and move() count them in.
+bool QAndroidPlatformWindow::wantsDecoration() const
+{
+    static const bool disabled = qEnvironmentVariableIntValue("QT_ANDROID_NO_WINDOW_DECORATION");
+    if (disabled || !QtAndroid::isQtApplication() || isForeignWindow()
+        || !m_nativeQtWindow.isValid()) {
+        return false;
+    }
+
+    const QWindow *w = window();
+    if (!w->isTopLevel() || w->type() != Qt::Dialog)
+        return false;
+
+    const Qt::WindowFlags flags = w->flags();
+    if (flags & (Qt::FramelessWindowHint | Qt::BypassWindowManagerHint
+                 | Qt::ExpandedClientAreaHint)) {
+        return false;
+    }
+    if ((flags & Qt::CustomizeWindowHint) && !(flags & Qt::WindowTitleHint))
+        return false;
+
+    return !(w->windowStates() & (Qt::WindowMaximized | Qt::WindowFullScreen));
+}
+
+static jint blendedColor(const QColor &base, const QColor &other, qreal amount)
+{
+    const auto mix = [amount](int a, int b) { return qRound(a + (b - a) * amount); };
+    return jint(qRgb(mix(base.red(), other.red()), mix(base.green(), other.green()),
+                     mix(base.blue(), other.blue())));
+}
+
+void QAndroidPlatformWindow::updateDecoration()
+{
+    if (!m_nativeQtWindow.isValid())
+        return;
+
+    QMargins margins;
+    if (wantsDecoration()) {
+        // Whole device independent pixels, so that QWindow::frameMargins() is exact.
+        // The strip is 1.75 lines of text tall, and tall enough for a finger.
+        const qreal factor = QHighDpiScaling::factor(window());
+        const int border = qMax(1, qRound(factor));
+        const qreal textHeight = QFontMetricsF(QGuiApplication::font()).height() * factor;
+        const qreal fingerHeight = 30 * QtAndroid::pixelDensity();
+        const int strip = qRound(qCeil(qMax(textHeight * 1.75, fingerHeight) / factor) * factor);
+        margins = QMargins(border, strip + border, border, border);
+    }
+
+    if (margins.isNull() && m_frameMargins.isNull())
+        return;
+
+    const bool marginsChanged = margins != m_frameMargins;
+    m_frameMargins = margins;
+
+    const QPalette palette = QGuiApplication::palette();
+    const QColor background = palette.color(QPalette::Active, QPalette::Window);
+    const QColor text = palette.color(QPalette::Active, QPalette::WindowText);
+    const bool closeButton = window()->flags() & Qt::WindowCloseButtonHint;
+
+    m_nativeQtWindow.callMethod<void>("setTitle", window()->title());
+    m_nativeQtWindow.callMethod<void>("setDecoration", jint(margins.top()), jint(margins.left()),
+                                      blendedColor(background, text, 0.14),
+                                      blendedColor(text, background, 0.0),
+                                      blendedColor(background, text, 0.4),
+                                      jboolean(closeButton));
+
+    // QWidget takes the frame margins from move and resize events
+    if (marginsChanged && window()->isVisible() && !geometry().isEmpty())
+        QWindowSystemInterface::handleGeometryChange(window(), geometry());
+}
+
+QMargins QAndroidPlatformWindow::frameMargins() const
+{
+    return m_frameMargins;
+}
+
+void QAndroidPlatformWindow::setWindowTitle(const QString &title)
 {
+    if (m_nativeQtWindow.isValid() && !isEmbeddingContainer())
+        m_nativeQtWindow.callMethod<void>("setTitle", title);
+}
+
+void QAndroidPlatformWindow::setGeometry(const QRect &requestedRect)
+{
+    // QtWindow and QWindow::geometry() get the client area.  A position that includes
+    // the frame comes from QWindow::setFramePosition(), or from a QWidget that was moved
+    // before it had a window.
+    QRect rect = requestedRect;
+    if (!m_frameMargins.isNull() && !rect.isNull()) {
+        QWindowPrivate *windowPrivate = qt_window_private(window());
+        if (windowPrivate->positionPolicy == QWindowPrivate::WindowFrameInclusive) {
+            rect.translate(m_frameMargins.left(), m_frameMargins.top());
+            windowPrivate->positionPolicy = QWindowPrivate::WindowFrameExclusive;
+        }
+    }
+
     if (!isEmbeddingContainer()) {
         Q_ASSERT(m_nativeQtWindow.isValid());
 
@@ -173,6 +278,9 @@ void QAndroidPlatformWindow::setVisible(bool visible)
                 setGeometry(platformScreen()->geometry());
             else if (states & Qt::WindowMaximized)
                 setGeometry(platformScreen()->availableGeometry());
+            // The palette can have changed since the window was created
+            if (visible)
+                updateDecoration();
             requestActivateWindow();
         }
     }
@@ -195,6 +303,9 @@ void QAndroidPlatformWindow::setWindowState(Qt::WindowStates state)
 {
     QPlatformWindow::setWindowState(state);
 
+    if (!isEmbeddingContainer())
+        updateDecoration();
+
     if (window()->isVisible())
         updateSystemUiVisibility(state, window()->flags());
 }
@@ -203,6 +314,9 @@ void QAndroidPlatformWindow::setWindowFlags(Qt::WindowFlags flags)
 {
     QPlatformWindow::setWindowFlags(flags);
 
+    if (!isEmbeddingContainer())
+        updateDecoration();
+
     if (window()->isVisible())
         updateSystemUiVisibility(window()->windowStates(), flags);
 }
@@ -434,6 +548,45 @@ void QAndroidPlatformWindow::safeAreaMarginsChanged(JNIEnv *env, jobject object,
     }
 }
 
+// QtWindow moved the window, at the end of a drag on its title strip, or moved or shrank it
+// to keep it clear of the system bars.  It has the new client geometry already.
+void QAndroidPlatformWindow::decorationGeometry(JNIEnv *env, jobject object, jint windowId,
+                                                jint x, jint y, jint w, jint h)
+{
+    Q_UNUSED(env)
+    Q_UNUSED(object)
+
+    if (!qGuiApp)
+        return;
+
+    QMetaObject::invokeMethod(qGuiApp, [windowId, x, y, w, h]() {
+        QWindow *window = QtAndroid::windowFromId(windowId);
+        if (!window || !window->handle())
+            return;
+
+        const QRect rect(x, y, w, h);
+        if (rect.isEmpty() || rect == window->handle()->geometry())
+            return;
+
+        QWindowSystemInterface::handleGeometryChange(window, rect);
+    }, Qt::QueuedConnection);
+}
+
+// The cross in the title strip
+void QAndroidPlatformWindow::decorationClose(JNIEnv *env, jobject object, jint windowId)
+{
+    Q_UNUSED(env)
+    Q_UNUSED(object)
+
+    if (!qGuiApp)
+        return;
+
+    QMetaObject::invokeMethod(qGuiApp, [windowId]() {
+        if (QWindow *window = QtAndroid::windowFromId(windowId))
+            QWindowSystemInterface::handleCloseEvent(window);
+    }, Qt::QueuedConnection);
+}
+
 static void updateWindows(JNIEnv *env, jobject object)
 {
     Q_UNUSED(env)
@@ -505,7 +658,9 @@ bool QAndroidPlatformWindow::registerNatives(QJniEnvironment &env)
                 Q_JNI_NATIVE_METHOD(updateWindows),
                 Q_JNI_NATIVE_SCOPED_METHOD(setSurface, QAndroidPlatformWindow),
                 Q_JNI_NATIVE_SCOPED_METHOD(windowFocusChanged, QAndroidPlatformWindow),
-                Q_JNI_NATIVE_SCOPED_METHOD(safeAreaMarginsChanged, QAndroidPlatformWindow)
+                Q_JNI_NATIVE_SCOPED_METHOD(safeAreaMarginsChanged, QAndroidPlatformWindow),
+                Q_JNI_NATIVE_SCOPED_METHOD(decorationGeometry, QAndroidPlatformWindow),
+                Q_JNI_NATIVE_SCOPED_METHOD(decorationClose, QAndroidPlatformWindow)
             })) {
         qCCritical(lcQpaWindow) << "RegisterNatives failed for"
                                 << QtJniTypes::Traits<QtJniTypes::QtWindow>::className();
