+++ b/src/main/java/app/freerouting/logger/Logger.java
@@ -0,0 +1,56 @@
+package app.freerouting.logger;
+
+/**
+ * Stands in for the Log4j logger on Android. Android sends standard output to logcat. Debug and
+ * trace messages are dropped unless the system property {@code freerouting.debug} is true.
+ */
+public final class Logger {
+
+  static final Logger INSTANCE = new Logger();
+  private static final boolean DEBUG = Boolean.getBoolean("freerouting.debug");
+
+  private Logger() {}
+
+  private static void print(String level, String msg, Throwable t) {
+    System.out.println("freerouting " + level + ": " + msg);
+    if (t != null) {
+      t.printStackTrace(System.out);
+    }
+  }
+
+  public boolean isTraceEnabled() {
+    return DEBUG;
+  }
+
+  public void trace(String msg) {
+    if (DEBUG) {
+      print("TRACE", msg, null);
+    }
+  }
+
+  public void debug(String msg) {
+    if (DEBUG) {
+      print("DEBUG", msg, null);
+    }
+  }
+
+  public void info(String msg) {
+    print("INFO", msg, null);
+  }
+
+  public void warn(String msg) {
+    print("WARN", msg, null);
+  }
+
+  public void warn(String msg, Throwable t) {
+    print("WARN", msg, t);
+  }
+
+  public void error(String msg) {
+    print("ERROR", msg, null);
+  }
+
+  public void error(String msg, Throwable t) {
+    print("ERROR", msg, t);
+  }
+}
