@@ -0,0 +1,48 @@
+package app.freerouting.geometry.planar;
+
+/**
+ * The part of {@code java.awt.geom.Rectangle2D} that board statistics use. Android has no {@code
+ * java.awt}, so the Android build of the router uses this instead.
+ */
+public abstract class Rectangle2D {
+
+  private Rectangle2D() {}
+
+  /** A rectangle with float coordinates. */
+  public static class Float extends Rectangle2D {
+    public float x;
+    public float y;
+    public float width;
+    public float height;
+
+    public Float() {}
+
+    public Float(float x, float y, float width, float height) {
+      this.x = x;
+      this.y = y;
+      this.width = width;
+      this.height = height;
+    }
+
+    public double getX() {
+      return x;
+    }
+
+    public double getY() {
+      return y;
+    }
+
+    public double getWidth() {
+      return width;
+    }
+
+    public double getHeight() {
+      return height;
+    }
+
+    @Override
+    public String toString() {
+      return "Rectangle2D.Float[x=" + x + ",y=" + y + ",w=" + width + ",h=" + height + "]";
+    }
+  }
+}
