-void DIALOG_AUTOROUTE::start()
-{
-    AUTOROUTE_SETTINGS settings;
-    wxString           error;
-
-    // From the Settings tab, the button routes.
-    if( m_book->GetSelection() == 4 )
-        m_book->SetSelection( 0 );
-
-    if( !readSettings( settings, error ) )
-    {
-        m_startError = error;
-
-        if( !m_autoStart )
-            DisplayErrorMessage( this, error );
-
-        return;
-    }
-
-    if( !m_job->Start( settings, error ) )
-    {
-        m_startError = error;
-
-        if( !m_autoStart )
-            DisplayErrorMessage( this, error );
-
-        return;
-    }
-
-    s_lastSettings = settings;
-    s_haveLastSettings = true;
-    m_startError.clear();
-    m_shownLogLines = 0;
-    m_log->Clear();
-    setView( VIEW::RUN );
-    m_timer.Start( 300 );
-}
