-void DIALOG_AUTOROUTE::loadSettings( const AUTOROUTE_SETTINGS& s )
-{
-    m_router->SetSelection( s.router == AR_ROUTER::KRT ? 0 : 1 );
-
-    m_routeAll->SetValue( s.allNets );
-    m_routeChosen->SetValue( !s.allNets );
-    m_routeNets->SetChecked( s.nets );
-    m_routeNets->Enable( !s.allNets );
-    m_bus->SetValue( s.bus );
-
-    wxString parts;
-
-    for( const wxString& ref : s.betweenParts )
-        parts << ( parts.IsEmpty() ? wxS( "" ) : wxS( ", " ) ) << ref;
-
-    m_betweenParts->ChangeValue( parts );
-    m_betweenOn->SetValue( !s.betweenParts.empty() );
-
-    for( unsigned i = 0; i < m_layers->GetCount(); i++ )
-    {
-        m_layers->Check( i, s.layers.empty()
-                                    || std::find( s.layers.begin(), s.layers.end(),
