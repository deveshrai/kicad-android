+wxPanel* AUTOROUTE_PANEL::buildPlanesPage( wxNotebook* aBook )
+{
+    wxPanel*    page = new wxPanel( aBook );
+    wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+    BOARD*      board = m_frame->GetBoard();
+
+    top->Add( note( page, _( "A plane is a copper zone over the whole board on one layer, "
+                             "usually ground or a supply on an inner layer. The router connects "
+                             "pads to it with vias. Add inner layers in Board Setup > Physical "
+                             "Stackup." ) ),
+              0, wxALL | wxEXPAND, 6 );
+
+    wxBoxSizer* row = new wxBoxSizer( wxHORIZONTAL );
+    m_planeNet = new wxChoice( page, wxID_ANY );
+    m_planeLayer = new wxChoice( page, wxID_ANY );
+
+    std::vector<wxString> nets;
+
+    for( NETINFO_ITEM* net : board->GetNetInfo() )
+    {
+        if( net->GetNetCode() > 0 && !net->GetNetname().IsEmpty() )
+            nets.push_back( net->GetNetname() );
+    }
+
+    std::sort( nets.begin(), nets.end(),
+               []( const wxString& a, const wxString& b ) { return a.CmpNoCase( b ) < 0; } );
+
+    for( const wxString& net : nets )
+        m_planeNet->Append( net );
+
+    for( PCB_LAYER_ID layer : board->GetEnabledLayers().CuStack() )
+        m_planeLayer->Append( board->GetLayerName( layer ) );
+
+    // Sensible first choices: ground, and the first inner layer if there is one.
+    for( unsigned i = 0; i < m_planeNet->GetCount(); i++ )
+    {
+        if( m_planeNet->GetString( i ).Upper() == wxS( "GND" ) )
+            m_planeNet->SetSelection( i );
+    }
+
+    if( m_planeNet->GetSelection() == wxNOT_FOUND && m_planeNet->GetCount() )
+        m_planeNet->SetSelection( 0 );
+
+    m_planeLayer->SetSelection( m_planeLayer->GetCount() > 2 ? 1 : 0 );
+
+    wxButton* add = new wxButton( page, wxID_ANY, _( "Add" ) );
+    row->Add( m_planeNet, 1, wxRIGHT, 6 );
+    row->Add( new wxStaticText( page, wxID_ANY, _( "on" ) ), 0, wxALIGN_CENTER_VERTICAL | wxRIGHT,
+              6 );
+    row->Add( m_planeLayer, 0, wxRIGHT, 6 );
+    row->Add( add, 0 );
+    top->Add( row, 0, wxEXPAND | wxLEFT | wxRIGHT, 6 );
+
+    m_planeList = new wxListBox( page, wxID_ANY, wxDefaultPosition, FromDIP( wxSize( -1, 120 ) ) );
+    top->Add( m_planeList, 1, wxEXPAND | wxALL, 6 );
+
+    wxBoxSizer* row2 = new wxBoxSizer( wxHORIZONTAL );
+    wxButton*   remove = new wxButton( page, wxID_ANY, _( "Remove" ) );
+    wxButton*   setupBtn = new wxButton( page, wxID_ANY, _( "Board Setup..." ) );
+    row2->Add( remove, 0, wxRIGHT, 8 );
+    row2->Add( setupBtn, 0 );
+    top->Add( row2, 0, wxLEFT | wxRIGHT | wxBOTTOM, 6 );
+
+    page->SetSizer( top );
+
+    add->Bind( wxEVT_BUTTON,
+               [this]( wxCommandEvent& )
+               {
+                   if( m_planeNet->GetSelection() == wxNOT_FOUND
+                       || m_planeLayer->GetSelection() == wxNOT_FOUND )
+                   {
+                       return;
+                   }
+
+                   AR_PLANE plane{ m_planeNet->GetStringSelection(),
+                                   m_planeLayer->GetStringSelection() };
+
+                   for( const AR_PLANE& p : m_planes )
+                   {
+                       if( p.layer == plane.layer && p.net == plane.net )
+                           return;
+                   }
+
+                   m_planes.push_back( plane );
+                   fillPlanesList();
+               } );
+    remove->Bind( wxEVT_BUTTON,
+                  [this]( wxCommandEvent& )
+                  {
+                      int i = m_planeList->GetSelection();
+
+                      if( i != wxNOT_FOUND && i < (int) m_planes.size() )
+                      {
+                          m_planes.erase( m_planes.begin() + i );
+                          fillPlanesList();
+                      }
+                  } );
+    setupBtn->Bind( wxEVT_BUTTON,
+                    [this]( wxCommandEvent& )
+                    {
+                        DisplayInfoMessage( this, _( "Close the Autoroute tool, open File > "
+                                                     "Board Setup > Physical Stackup and choose "
+                                                     "4 or more copper layers. Then come back "
+                                                     "here to add the planes." ) );
+                    } );
+    return page;
+}
+
+
+void AUTOROUTE_PANEL::fillPlanesList()
+{
+    m_planeList->Clear();
+
+    for( const AR_PLANE& p : m_planes )
+        m_planeList->Append( wxString::Format( _( "%s on %s" ), p.net, p.layer ) );
+
+    updateRouterHints();
+}
