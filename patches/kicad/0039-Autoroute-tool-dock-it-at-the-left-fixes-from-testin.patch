+/**
+ * A filterable checklist of nets: a filter box, the list, and buttons to take the nets of the
+ * board selection or clear the choice.  Checked nets stay checked while filtered out.
+ */
+class NET_CHECKLIST : public wxPanel
+{
+public:
+    NET_CHECKLIST( wxWindow* aParent, PCB_EDIT_FRAME* aFrame ) :
+            wxPanel( aParent ),
+            m_frame( aFrame )
+    {
+        wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+        wxBoxSizer* row = new wxBoxSizer( wxHORIZONTAL );
+
+        m_filter = new wxTextCtrl( this, wxID_ANY, wxEmptyString );
+        m_filter->SetHint( _( "Filter nets" ) );
+        row->Add( m_filter, 1, wxALIGN_CENTER_VERTICAL );
+
+        wxButton* fromSel = new wxButton( this, wxID_ANY, _( "Use Selection" ) );
+        wxButton* none = new wxButton( this, wxID_ANY, _( "Clear" ) );
+        row->Add( fromSel, 0, wxLEFT, 6 );
+        row->Add( none, 0, wxLEFT, 6 );
+        top->Add( row, 0, wxEXPAND | wxBOTTOM, 4 );
+
+        m_list = new wxCheckListBox( this, wxID_ANY, wxDefaultPosition, FromDIP( wxSize( -1, 150 ) ) );
+        top->Add( m_list, 1, wxEXPAND );
+
+        m_count = new wxStaticText( this, wxID_ANY, wxEmptyString );
+        top->Add( m_count, 0, wxTOP, 2 );
+        SetSizer( top );
+
+        for( NETINFO_ITEM* net : aFrame->GetBoard()->GetNetInfo() )
+        {
+            if( net->GetNetCode() > 0 && !net->GetNetname().IsEmpty() )
+                m_all.push_back( net->GetNetname() );
+        }
+
+        std::sort( m_all.begin(), m_all.end(),
+                   []( const wxString& a, const wxString& b ) { return a.CmpNoCase( b ) < 0; } );
+
+        m_filter->Bind( wxEVT_TEXT, [this]( wxCommandEvent& ) { rebuild(); } );
+        m_list->Bind( wxEVT_CHECKLISTBOX,
+                      [this]( wxCommandEvent& aEvent )
+                      {
+                          int      i = aEvent.GetInt();
+                          wxString net = m_shown[i];
+
+                          if( m_list->IsChecked( i ) )
+                              m_checked.insert( net );
+                          else
+                              m_checked.erase( net );
+
+                          updateCount();
+                          wxCommandEvent changed( wxEVT_CHECKLISTBOX, GetId() );
+                          wxPostEvent( GetParent(), changed );
+                      } );
+        fromSel->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { useSelection(); } );
+        none->Bind( wxEVT_BUTTON,
+                    [this]( wxCommandEvent& )
+                    {
+                        m_checked.clear();
+                        rebuild();
+                    } );
+        rebuild();
+    }
+
+    void SetChecked( const std::vector<wxString>& aNets )
+    {
+        m_checked = std::set<wxString>( aNets.begin(), aNets.end() );
+        rebuild();
+    }
+
+    std::vector<wxString> GetChecked() const
+    {
+        std::vector<wxString> out;
+
+        for( const wxString& net : m_all )
+        {
+            if( m_checked.count( net ) )
+                out.push_back( net );
+        }
+
+        return out;
+    }
+
+private:
+    void rebuild()
+    {
+        wxString filter = m_filter->GetValue().Lower();
+
+        m_list->Freeze();
+        m_list->Clear();
+        m_shown.clear();
+
+        for( const wxString& net : m_all )
+        {
+            if( !filter.IsEmpty() && !net.Lower().Contains( filter ) )
+                continue;
+
+            m_shown.push_back( net );
+            int i = m_list->Append( net );
+            m_list->Check( i, m_checked.count( net ) > 0 );
+        }
+
+        m_list->Thaw();
+        updateCount();
+    }
+
+    void updateCount()
+    {
+        m_count->SetLabel( wxString::Format( _( "%zu of %zu nets chosen" ), m_checked.size(),
+                                             m_all.size() ) );
+    }
+
+    void useSelection()
+    {
+        for( EDA_ITEM* item : m_frame->GetCurrentSelection() )
+        {
+            if( FOOTPRINT* fp = dynamic_cast<FOOTPRINT*>( item ) )
+            {
+                for( PAD* pad : fp->Pads() )
+                {
+                    if( pad->GetNetCode() > 0 )
+                        m_checked.insert( pad->GetNetname() );
+                }
+            }
+            else if( BOARD_CONNECTED_ITEM* bci = dynamic_cast<BOARD_CONNECTED_ITEM*>( item ) )
+            {
+                if( bci->GetNetCode() > 0 )
+                    m_checked.insert( bci->GetNetname() );
+            }
+        }
+
+        rebuild();
+    }
+
+    PCB_EDIT_FRAME*       m_frame;
+    wxTextCtrl*           m_filter;
+    wxCheckListBox*       m_list;
+    wxStaticText*         m_count;
+    std::vector<wxString> m_all;
+    std::vector<wxString> m_shown;
+    std::set<wxString>    m_checked;
+};
