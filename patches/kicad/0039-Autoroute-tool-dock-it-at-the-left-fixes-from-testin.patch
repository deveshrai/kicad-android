+/**
+ * What holds an AUTOROUTE_PANEL: the modal Autoroute dialog, or the pane docked at the left of
+ * the board editor.
+ */
+class AUTOROUTE_HOST
+{
+public:
+    virtual ~AUTOROUTE_HOST() = default;
+
+    virtual bool IsDocked() const = 0;
+
+    /// The panel changed what it shows (setup, run, result); size and place it.
+    virtual void PanelLayoutChanged( bool aRunning ) = 0;
+
+    /// Close the tool.  @a aToggleDock: reopen it in the other host.
+    virtual void CloseTool( bool aToggleDock ) = 0;
+};
+
+
+/**
+ * The Autoroute tool: choose a router and what to do (route, fan out, pour planes, optimize),
+ * then watch the run.  The board cannot be edited while a run is active and until its result is
+ * kept or discarded: the dialog host is modal, and the docked host locks the editor (canvas
+ * clicks, keys, menus, toolbars, other panels and the IPC API).  Everything a run changes is one
+ * undo step.
+ */
+class AUTOROUTE_PANEL : public wxPanel
+{
+public:
+    AUTOROUTE_PANEL( wxWindow* aParent, PCB_EDIT_FRAME* aFrame, AUTOROUTE_HOST* aHost );
+    ~AUTOROUTE_PANEL() override;
+
+    /**
+     * Open the tool the way the user last chose (docked or as a dialog).  With @a aSettings,
+     * start from them; with @a aAutoStart, start the run at once (MCP).  The dialog form returns
+     * only when it closes; call it through CallAfter() when that matters.
+     */
+    static void OpenTool( PCB_EDIT_FRAME* aFrame, const AUTOROUTE_SETTINGS* aSettings = nullptr,
+                          bool aAutoStart = false );
+
+    /// The tool on screen (in either host), or nullptr.
+    static AUTOROUTE_PANEL* Active();
+
+    /// After OpenTool( ..., true ): whether the run has been started, and why not if it failed.
+    static bool AutoStartDone( wxString& aError );
+
+    /// The status (JSON text) of the last run, kept after its tool closes.
+    static const std::string& LastStatus() { return s_lastStatus; }
+
+    static bool PreferDocked();
+    static void SetPreferDocked( bool aDocked );
+
+    /// True while the editor must stay locked: a run is active, or its result is not decided.
+    static bool IsEditorLocked();
+
+    AUTOROUTE_JOB& Job() { return *m_job; }
+
+    void LoadSettings( const AUTOROUTE_SETTINGS& aSettings );
+    void ShowSetup();
+
+    /// Start a run from the controls; returns false with StartError() set.
+    bool Start();
+
+    /// The same as the buttons; also used by MCP.
+    bool     DoPause();
+    bool     DoResume();
+    void     DoStop();
+    void     DoKeep();
+    void     DoDiscard();
+    void     DoClose();
+    wxString StartError() const { return m_startError; }
+
+    /// For the host: whether closing now is allowed, and what closing means.
+    void HandleCloseRequest();
+
+    /// The host is going away (its frame is closing): forget the frame.
+    void Detach();
+
+private:
+    enum class VIEW
+    {
+        SETUP,
+        RUN,
+        RESULT
+    };
+
+    wxPanel* buildRoutePage( wxNotebook* aBook );
+    wxPanel* buildFanoutPage( wxNotebook* aBook );
+    wxPanel* buildPlanesPage( wxNotebook* aBook );
+    wxPanel* buildOptimizePage( wxNotebook* aBook );
+    wxPanel* buildSettingsPage( wxNotebook* aBook );
+    wxPanel* buildRunPanel();
+
+    bool readSettings( AUTOROUTE_SETTINGS& aSettings, wxString& aError );
+    void updateRouterHints();
+    void updateRunButton();
+    void fillPlanesList();
+    void selectFinePitchParts();
+
+    void setView( VIEW aView );
+    void refreshRunView();
+    void zoomToNet( const wxString& aNet );
+    void clearHighlight();
+    void lockEditor( bool aLock );
+
+    void onTimer( wxTimerEvent& aEvent );
+
+    PCB_EDIT_FRAME*                 m_frame;
+    AUTOROUTE_HOST*                 m_host;
+    std::unique_ptr<AUTOROUTE_HOST> m_ownedHost;   ///< The docked host; the dialog owns itself
+    std::unique_ptr<AUTOROUTE_JOB> m_job;
+    wxTimer                        m_timer;
+    VIEW                           m_view = VIEW::SETUP;
+    bool                           m_locked = false;
+    wxEvtHandler*                  m_canvasBlocker = nullptr;
+    wxEvtHandler*                  m_frameBlocker = nullptr;
+    wxString                       m_startError;
+    size_t                         m_shownLogLines = 0;
+    std::vector<wxString>          m_fanoutRefs;      ///< One per row of m_fanoutParts
+    std::vector<AR_PLANE>          m_planes;
+
+    // Setup
+    wxPanel*        m_setupPanel;
+    wxChoice*       m_router;
+    wxButton*       m_dockBtn;
+    wxStaticText*   m_routerInfo;
+    wxNotebook*     m_book;
+    wxStaticText*   m_hint;
+
+    wxRadioButton*  m_routeAll;
+    wxRadioButton*  m_routeChosen;
+    NET_CHECKLIST*  m_routeNets;
+    wxCheckBox*     m_bus;
+    wxCheckBox*     m_betweenOn;
+    wxTextCtrl*     m_betweenParts;
+    wxCheckListBox* m_layers;
+    wxCheckBox*     m_planesFirst;
+    wxCheckBox*     m_fanoutFirst;
+
+    wxCheckListBox* m_fanoutParts;
+    wxTextCtrl*     m_fanoutWidth;
+
+    wxChoice*       m_planeNet;
+    wxChoice*       m_planeLayer;
+    wxListBox*      m_planeList;
+
+    wxRadioButton*  m_optimizeAll;
+    wxRadioButton*  m_optimizeChosen;
+    NET_CHECKLIST*  m_optimizeNets;
+
+    wxRadioBox*     m_rules;
+    wxTextCtrl*     m_grid;
+    wxSpinCtrl*     m_viaCost;
+    wxSpinCtrl*     m_passes;
+    wxCheckBox*     m_optimizeAfter;
+    wxCheckBox*     m_frFanout;
+    wxCheckBox*     m_live;
+    wxCheckBox*     m_refill;
+    wxCheckBox*     m_ripOthers;
+
+    // Run and result
+    wxPanel*        m_runPanel;
+    wxStaticText*   m_runTitle;
+    wxStaticText*   m_stage;
+    wxGauge*        m_gauge;
+    wxStaticText*   m_counts;
+    wxListCtrl*     m_steps;
+    wxTextCtrl*     m_log;
+    wxStaticText*   m_openLabel;
+    wxListBox*      m_openNets;
+
+    wxButton*       m_closeBtn;
+    wxButton*       m_runBtn;
+    wxButton*       m_fitBtn;
+    wxButton*       m_pauseBtn;
+    wxButton*       m_stopBtn;
+    wxButton*       m_backBtn;
+    wxButton*       m_discardBtn;
+    wxButton*       m_keepBtn;
+
+    static AUTOROUTE_PANEL* s_active;
+    static std::string      s_lastStatus;
+
+    friend class DOCKED_AUTOROUTE_HOST;
+};
+
+#endif // AUTOROUTE_PANEL_H
