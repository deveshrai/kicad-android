+
+wxPanel* AUTOROUTE_PANEL::buildFanoutPage( wxNotebook* aBook )
+{
+    wxPanel*    page = new wxPanel( aBook );
+    wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+    BOARD*      board = m_frame->GetBoard();
+
+    top->Add( note( page, _( "Fanning out pulls a short track (and a via where needed) out of "
+                             "every pin of a dense part, so the router can reach the pins. "
+                             "KiCadRoutingTools only." ) ),
+              0, wxALL | wxEXPAND, 6 );
+
+    m_fanoutParts = new wxCheckListBox( page, wxID_ANY, wxDefaultPosition,
+                                        FromDIP( wxSize( -1, 180 ) ) );
+
+    std::vector<std::pair<wxString, FOOTPRINT*>> parts;
+
+    for( FOOTPRINT* fp : board->Footprints() )
+    {
+        if( fp->Pads().size() >= 8 )
+            parts.emplace_back( fp->GetReference(), fp );
+    }
+
+    std::sort( parts.begin(), parts.end(),
+               []( const auto& a, const auto& b ) { return a.first.CmpNoCase( b.first ) < 0; } );
+
+    for( const auto& [ref, fp] : parts )
+    {
+        int pitch = 0;
+
+        for( size_t i = 0; i < fp->Pads().size(); i++ )
+        {
+            for( size_t j = i + 1; j < fp->Pads().size(); j++ )
+            {
+                int d = ( fp->Pads()[i]->GetPosition() - fp->Pads()[j]->GetPosition() ).EuclideanNorm();
+
+                if( d > 0 && ( pitch == 0 || d < pitch ) )
+                    pitch = d;
+            }
+        }
+
+        m_fanoutRefs.push_back( ref );
+        m_fanoutParts->Append( wxString::Format( wxS( "%s    %s    (%zu pads, %s mm pitch)" ), ref,
+                                                 fp->GetFPID().GetLibItemName().wx_str(),
+                                                 fp->Pads().size(),
+                                                 mmText( pcbIUScale.IUTomm( pitch ) ) ) );
+        m_fanoutParts->SetClientData( m_fanoutParts->GetCount() - 1,
+                                      reinterpret_cast<void*>( (intptr_t) pitch ) );
+    }
+
+    top->Add( m_fanoutParts, 1, wxEXPAND | wxLEFT | wxRIGHT, 6 );
+
+    wxBoxSizer* row = new wxBoxSizer( wxHORIZONTAL );
+    wxButton*   fine = new wxButton( page, wxID_ANY, _( "Choose Fine-Pitch Parts" ) );
+    row->Add( fine, 0, wxRIGHT, 16 );
+    row->Add( new wxStaticText( page, wxID_ANY, _( "Track width:" ) ), 0,
+              wxALIGN_CENTER_VERTICAL | wxRIGHT, 6 );
+    m_fanoutWidth = new wxTextCtrl( page, wxID_ANY, wxEmptyString, wxDefaultPosition,
+                                    FromDIP( wxSize( 70, -1 ) ) );
+    m_fanoutWidth->SetHint( _( "board min" ) );
+    row->Add( m_fanoutWidth, 0, wxALIGN_CENTER_VERTICAL );
+    row->Add( new wxStaticText( page, wxID_ANY, _( "mm" ) ), 0, wxALIGN_CENTER_VERTICAL | wxLEFT,
+              4 );
+    top->Add( row, 0, wxALL, 6 );
+
+    top->Add( note( page, wxString::Format( _( "Leave the width empty to use the board's minimum "
+                                               "track width (%s mm, Board Setup > Constraints)." ),
+                                            mmText( pcbIUScale.IUTomm(
+                                                    board->GetDesignSettings().m_TrackMinWidth ) ) ) ),
+              0, wxLEFT | wxRIGHT | wxBOTTOM, 6 );
+
+    page->SetSizer( top );
+    fine->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { selectFinePitchParts(); } );
+    m_fanoutParts->Bind( wxEVT_CHECKLISTBOX, [this]( wxCommandEvent& ) { updateRouterHints(); } );
+    return page;
+}
+
+
+void AUTOROUTE_PANEL::selectFinePitchParts()
+{
+    int limit = pcbIUScale.mmToIU( 0.51 );
+
+    for( unsigned i = 0; i < m_fanoutParts->GetCount(); i++ )
+    {
+        int pitch = (int) reinterpret_cast<intptr_t>( m_fanoutParts->GetClientData( i ) );
+        m_fanoutParts->Check( i, pitch > 0 && pitch <= limit );
+    }
+
+    updateRouterHints();
+}
