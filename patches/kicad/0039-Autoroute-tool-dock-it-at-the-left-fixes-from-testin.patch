-bool DIALOG_AUTOROUTE::readSettings( AUTOROUTE_SETTINGS& s, wxString& aError )
-{
-    s.router = m_router->GetSelection() == 1 ? AR_ROUTER::FREEROUTING : AR_ROUTER::KRT;
-
-    switch( m_book->GetSelection() )
-    {
-    case 1:  s.task = AR_TASK::FANOUT; break;
-    case 2:  s.task = AR_TASK::PLANES; break;
-    case 3:  s.task = AR_TASK::OPTIMIZE; break;
-    default: s.task = AR_TASK::ROUTE; break;
-    }
-
-    s.allNets = m_routeAll->GetValue();
-    s.nets = m_routeNets->GetChecked();
-    s.bus = m_bus->GetValue();
-    s.betweenParts.clear();
-
-    if( m_betweenOn->GetValue() )
-    {
-        BOARD*            board = m_frame->GetBoard();
-        wxStringTokenizer tok( m_betweenParts->GetValue(), wxS( ", ;" ), wxTOKEN_STRTOK );
-
-        while( tok.HasMoreTokens() )
-        {
-            wxString ref = tok.GetNextToken();
-            bool     found = false;
-
-            for( FOOTPRINT* fp : board->Footprints() )
-                found |= fp->GetReference() == ref;
-
-            if( !found )
-            {
-                aError = wxString::Format( _( "The board has no part %s." ), ref );
-                return false;
-            }
-
-            s.betweenParts.push_back( ref );
-        }
-
-        if( s.betweenParts.size() < 2 )
-        {
-            aError = _( "Name at least two parts to route between." );
-            return false;
-        }
-    }
-
-    s.layers.clear();
-    bool allLayers = true;
-
-    for( unsigned i = 0; i < m_layers->GetCount(); i++ )
-    {
-        if( m_layers->IsChecked( i ) )
-            s.layers.push_back( m_layers->GetString( i ) );
-        else
-            allLayers = false;
-    }
-
-    if( s.layers.empty() )
-    {
-        aError = _( "Choose at least one layer to route on." );
-        return false;
-    }
-
-    if( allLayers )
-        s.layers.clear();
-
-    s.planesFirst = m_planesFirst->GetValue();
-    s.fanoutFirst = m_fanoutFirst->GetValue();
-
-    s.fanoutParts.clear();
-
-    for( unsigned i = 0; i < m_fanoutParts->GetCount(); i++ )
-    {
-        if( m_fanoutParts->IsChecked( i ) )
-            s.fanoutParts.push_back( m_fanoutRefs[i] );
-    }
-
-    s.fanoutWidthMm = 0;
-
-    if( !m_fanoutWidth->GetValue().Trim().IsEmpty()
-        && ( !m_fanoutWidth->GetValue().ToCDouble( &s.fanoutWidthMm ) || s.fanoutWidthMm <= 0 ) )
-    {
-        aError = _( "The fan-out track width must be a number of millimetres." );
-        return false;
-    }
-
-    s.planes = m_planes;
-    s.optimizeAll = m_optimizeAll->GetValue();
-    s.optimizeNets = m_optimizeNets->GetChecked();
-
-    if( s.task == AR_TASK::OPTIMIZE && !s.optimizeAll && s.optimizeNets.empty() )
-    {
-        aError = _( "Choose at least one net to optimize." );
-        return false;
-    }
-
-    s.rules = m_rules->GetSelection() == 0 ? AR_RULES::EXACT
-            : m_rules->GetSelection() == 1 ? AR_RULES::BOARD
-                                           : AR_RULES::FAB;
-
-    if( !m_grid->GetValue().ToCDouble( &s.gridMm ) || s.gridMm < 0.01 || s.gridMm > 1.0 )
-    {
-        aError = _( "The routing grid must be between 0.01 and 1 mm." );
-        return false;
-    }
-
-    s.viaCost = m_viaCost->GetValue();
-    s.optimizerPasses = m_passes->GetValue();
-    s.optimizeAfter = m_optimizeAfter->GetValue();
-    s.freeroutingFanout = m_frFanout->GetValue();
-    s.liveView = m_live->GetValue();
-    s.refillZones = m_refill->GetValue();
-    s.ripOtherNets = m_ripOthers->GetValue();
-    return true;
-}
