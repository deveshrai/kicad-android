+void AUTOROUTE_PANEL::SetPreferDocked( bool aDocked )
+{
+    wxString path = dockPrefPath();
+
+    if( aDocked )
+    {
+        wxFileName::Mkdir( wxFileName( path ).GetPath(), wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+        wxFFile( path, wxS( "w" ) ).Write( wxS( "1" ) );
+    }
+    else if( wxFileExists( path ) )
+    {
+        wxRemoveFile( path );
+    }
+}
