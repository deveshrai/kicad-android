+AUTOROUTE_PANEL::~AUTOROUTE_PANEL()
+{
+    m_timer.Stop();
+
+    if( m_frame && !m_frame->IsBeingDeleted() )
+    {
+        clearHighlight();
+        lockEditor( false );
+    }
+
+    if( m_job->GetState() != AUTOROUTE_JOB::STATE::IDLE )
+        s_lastStatus = m_job->StatusJson().dump();
+
+    if( s_active == this )
+        s_active = nullptr;
+}
