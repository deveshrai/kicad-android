+/**
+ * Swallows the clicks and keys that would edit the board, so the docked tool can lock the editor
+ * while the canvas still draws and two-finger gestures still zoom and pan.  Keys typed into
+ * @a aAllowed (the Autoroute panel) still go through.
+ */
+class AR_INPUT_BLOCKER : public wxEvtHandler
+{
+public:
+    AR_INPUT_BLOCKER( wxWindow* aAllowed, bool aMouse ) : m_allowed( aAllowed )
+    {
+        if( aMouse )
+        {
+            auto swallow = []( wxMouseEvent& ) {};
+            Bind( wxEVT_LEFT_DOWN, swallow );
+            Bind( wxEVT_LEFT_UP, swallow );
+            Bind( wxEVT_LEFT_DCLICK, swallow );
+            Bind( wxEVT_RIGHT_DOWN, swallow );
+            Bind( wxEVT_RIGHT_UP, swallow );
+            Bind( wxEVT_RIGHT_DCLICK, swallow );
+        }
+
+        Bind( wxEVT_KEY_DOWN, &AR_INPUT_BLOCKER::onKey, this );
+        Bind( wxEVT_KEY_UP, &AR_INPUT_BLOCKER::onKey, this );
+        Bind( wxEVT_CHAR, &AR_INPUT_BLOCKER::onKey, this );
+        Bind( wxEVT_CHAR_HOOK, &AR_INPUT_BLOCKER::onKey, this );
+    }
+
+private:
+    void onKey( wxKeyEvent& aEvent )
+    {
+        wxWindow* focus = wxWindow::FindFocus();
+
+        for( wxWindow* w = focus; w && m_allowed; w = w->GetParent() )
+        {
+            if( w == m_allowed )
+            {
+                aEvent.Skip();
+                return;
+            }
+        }
+    }
+
+    wxWindow* m_allowed;
+};
+
+
+void AUTOROUTE_PANEL::lockEditor( bool aLock )
+{
+    if( m_locked == aLock || !m_frame )
+        return;
+
+    m_locked = aLock;
+
+    // The dialog is modal, which locks the editor by itself; the flag still stops MCP edits.
+    if( !m_host->IsDocked() )
+        return;
+
+    if( aLock )
+    {
+        m_frame->GetToolManager()->RunAction( ACTIONS::cancelInteractive );
+        m_frame->GetToolManager()->RunAction( ACTIONS::selectionClear );
+    }
+
+    for( wxAuiPaneInfo& pane : m_frame->m_auimgr.GetAllPanes() )
+    {
+        if( pane.window && pane.window != this && pane.window != m_frame->GetCanvas() )
+            pane.window->Enable( !aLock );
+    }
+
+    if( wxMenuBar* menus = m_frame->GetMenuBar() )
+    {
+        for( size_t i = 0; i < menus->GetMenuCount(); i++ )
+            menus->EnableTop( i, !aLock );
+    }
+
+    if( aLock )
+    {
+        m_canvasBlocker = new AR_INPUT_BLOCKER( nullptr, true );
+        m_frameBlocker = new AR_INPUT_BLOCKER( this, false );
+        m_frame->GetCanvas()->PushEventHandler( m_canvasBlocker );
+        m_frame->PushEventHandler( m_frameBlocker );
+    }
+    else
+    {
+        if( m_canvasBlocker )
+            m_frame->GetCanvas()->RemoveEventHandler( m_canvasBlocker );
+
+        if( m_frameBlocker )
+            m_frame->RemoveEventHandler( m_frameBlocker );
+
+        delete m_canvasBlocker;
+        delete m_frameBlocker;
+        m_canvasBlocker = m_frameBlocker = nullptr;
+    }
+}
