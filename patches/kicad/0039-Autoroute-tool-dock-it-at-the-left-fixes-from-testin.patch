+/// Breaks @a aText into lines no wider than @a aWidth in @a aWin's font (wxStaticText::Wrap()
+/// does not take on wxQt when the label changes after creation).
+static wxString wrapText( wxWindow* aWin, const wxString& aText, int aWidth )
+{
+    wxString out;
+
+    for( const wxString& para : wxSplit( aText, '\n', 0 ) )
+    {
+        wxString line;
+
+        for( const wxString& word : wxSplit( para, ' ', 0 ) )
+        {
+            wxString trial = line.IsEmpty() ? word : line + wxS( " " ) + word;
+
+            if( !line.IsEmpty() && aWin->GetTextExtent( trial ).x > aWidth )
+            {
+                out << line << wxS( "\n" );
+                line = word;
+            }
+            else
+            {
+                line = trial;
+            }
+        }
+
+        out << line << wxS( "\n" );
+    }
+
+    return out.Trim();
+}
+
+
+static void setWrapped( wxStaticText* aText, const wxString& aLabel, int aWidthDip = 300 )
+{
+    aText->SetLabel( wrapText( aText, aLabel, aText->FromDIP( aWidthDip ) ) );
+}
+
+
+static wxStaticText* note( wxWindow* aParent, const wxString& aText )
+{
+    wxStaticText* t = new wxStaticText( aParent, wxID_ANY, wxEmptyString );
+    t->SetFont( t->GetFont().Smaller() );
+    setWrapped( t, aText );
+    return t;
+}
+
+
+/// A note for the third column of a settings row.
+static wxStaticText* narrowNote( wxWindow* aParent, const wxString& aText )
+{
+    wxStaticText* t = new wxStaticText( aParent, wxID_ANY, wxEmptyString );
+    t->SetFont( t->GetFont().Smaller() );
+    setWrapped( t, aText, 150 );
+    return t;
+}
+
+
+static wxString mmText( double aMm )
+{
+    return wxString::FromCDouble( aMm, 3 );
+}
