-        m_fanoutParts->Check( i, std::find( s.fanoutParts.begin(), s.fanoutParts.end(),
-                                            m_fanoutRefs[i] )
-                                         != s.fanoutParts.end() );
-    }
-
-    m_fanoutWidth->SetValue( s.fanoutWidthMm > 0 ? mmText( s.fanoutWidthMm ) : wxString() );
-    m_planes = s.planes;
-    fillPlanesList();
-
-    m_optimizeAll->SetValue( s.optimizeAll );
-    m_optimizeChosen->SetValue( !s.optimizeAll );
-    m_optimizeNets->SetChecked( s.optimizeNets );
-    m_optimizeNets->Enable( !s.optimizeAll );
-
-    m_rules->SetSelection( s.rules == AR_RULES::EXACT ? 0 : s.rules == AR_RULES::BOARD ? 1 : 2 );
-    m_grid->SetValue( mmText( s.gridMm ) );
