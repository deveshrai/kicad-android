+wxPanel* AUTOROUTE_PANEL::buildRoutePage( wxNotebook* aBook )
+{
+    wxPanel*    page = new wxPanel( aBook );
+    wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+    BOARD*      board = m_frame->GetBoard();
+
+    m_routeAll = new wxRadioButton( page, wxID_ANY, _( "Every unrouted net" ), wxDefaultPosition,
+                                    wxDefaultSize, wxRB_GROUP );
+    m_routeChosen = new wxRadioButton( page, wxID_ANY, _( "Only these nets:" ) );
+    top->Add( m_routeAll, 0, wxALL, 6 );
+    top->Add( m_routeChosen, 0, wxLEFT | wxRIGHT, 6 );
+
+    m_routeNets = new NET_CHECKLIST( page, m_frame );
+    top->Add( m_routeNets, 1, wxEXPAND | wxLEFT | wxRIGHT | wxTOP, 6 );
+
+    m_bus = new wxCheckBox( page, wxID_ANY,
+                            _( "Route them side by side, like a bus" ) );
+    top->Add( m_bus, 0, wxALL, 6 );
+
+    wxBoxSizer* between = new wxBoxSizer( wxHORIZONTAL );
+    m_betweenOn = new wxCheckBox( page, wxID_ANY, _( "Only between these parts:" ) );
+    m_betweenParts = new wxTextCtrl( page, wxID_ANY, wxEmptyString );
+    m_betweenParts->SetHint( _( "e.g. U1, J3" ) );
+    wxButton* partsFromSel = new wxButton( page, wxID_ANY, _( "Use Selection" ) );
+    between->Add( m_betweenOn, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 6 );
+    between->Add( m_betweenParts, 1, wxALIGN_CENTER_VERTICAL | wxRIGHT, 6 );
+    between->Add( partsFromSel, 0, wxALIGN_CENTER_VERTICAL );
+    top->Add( between, 0, wxEXPAND | wxLEFT | wxRIGHT, 6 );
+    top->Add( note( page, _( "Routes the nets' connections among two or more parts only; their "
+                             "pads on other parts are left unrouted." ) ),
+              0, wxLEFT | wxRIGHT | wxTOP, 6 );
+
+    partsFromSel->Bind( wxEVT_BUTTON,
+                        [this]( wxCommandEvent& )
+                        {
+                            wxString refs;
+
+                            for( EDA_ITEM* item : m_frame->GetCurrentSelection() )
+                            {
+                                FOOTPRINT* fp = dynamic_cast<FOOTPRINT*>( item );
+
+                                if( !fp && item->GetParent() )
+                                    fp = dynamic_cast<FOOTPRINT*>( item->GetParent() );
+
+                                if( fp && !refs.Contains( fp->GetReference() ) )
+                                    refs << ( refs.IsEmpty() ? wxS( "" ) : wxS( ", " ) )
+                                         << fp->GetReference();
+                            }
+
+                            m_betweenParts->SetValue( refs );
+                            m_betweenOn->SetValue( !refs.IsEmpty() );
+                        } );
+    m_betweenParts->Bind( wxEVT_TEXT,
+                          [this]( wxCommandEvent& )
+                          {
+                              m_betweenOn->SetValue( !m_betweenParts->GetValue().Trim().IsEmpty() );
+                          } );
+
+    wxBoxSizer* lower = new wxBoxSizer( wxHORIZONTAL );
+    wxBoxSizer* layerCol = new wxBoxSizer( wxVERTICAL );
+    layerCol->Add( new wxStaticText( page, wxID_ANY, _( "Route on these layers:" ) ), 0,
+                   wxBOTTOM, 4 );
+    m_layers = new wxCheckListBox( page, wxID_ANY, wxDefaultPosition, FromDIP( wxSize( 160, 90 ) ) );
+
+    for( PCB_LAYER_ID layer : board->GetEnabledLayers().CuStack() )
+        m_layers->Append( board->GetLayerName( layer ) );
+
+    layerCol->Add( m_layers, 1, wxEXPAND );
+    lower->Add( layerCol, 0, wxEXPAND | wxRIGHT, 16 );
+
+    wxBoxSizer* firstCol = new wxBoxSizer( wxVERTICAL );
+    firstCol->Add( new wxStaticText( page, wxID_ANY, _( "Before routing:" ) ), 0, wxBOTTOM, 4 );
+    m_planesFirst = new wxCheckBox( page, wxID_ANY, _( "Pour the planes first" ) );
+    m_fanoutFirst = new wxCheckBox( page, wxID_ANY, _( "Fan out the parts first" ) );
+    firstCol->Add( m_planesFirst, 0, wxBOTTOM, 4 );
+    firstCol->Add( m_fanoutFirst, 0, wxBOTTOM, 4 );
+    firstCol->Add( narrowNote( page, _( "Planes and parts are set on their tabs. Fine-pitch chips "
+                                        "(0.5 mm pitch and below) usually route only after they "
+                                        "are fanned out." ) ),
+                   0, wxTOP, 4 );
+    lower->Add( firstCol, 1, wxEXPAND );
+    top->Add( lower, 0, wxEXPAND | wxALL, 6 );
+
+    page->SetSizer( top );
+
+    auto toggle =
+            [this]( wxCommandEvent& )
+            {
+                m_routeNets->Enable( m_routeChosen->GetValue() );
+                updateRouterHints();
+            };
+
+    m_routeAll->Bind( wxEVT_RADIOBUTTON, toggle );
+    m_routeChosen->Bind( wxEVT_RADIOBUTTON, toggle );
+    return page;
+}
