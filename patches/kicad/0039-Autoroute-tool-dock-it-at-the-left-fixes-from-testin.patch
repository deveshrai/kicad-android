+
+void AUTOROUTE_PANEL::OpenTool( PCB_EDIT_FRAME* aFrame, const AUTOROUTE_SETTINGS* aSettings,
+                                bool aAutoStart )
+{
+    s_autoStartDone = false;
+    s_autoStartError.clear();
+
+    auto autoStart =
+            []( AUTOROUTE_PANEL* aPanel )
+            {
+                if( !aPanel->Start() )
+                    s_autoStartError = aPanel->StartError();
+
+                s_autoStartDone = true;
+            };
+
+    if( s_active )
+    {
+        // Already on screen: bring it up; an MCP start goes into it unless it is busy.
+        if( aAutoStart && !IsEditorLocked() )
+        {
+            if( aSettings )
+                s_active->LoadSettings( *aSettings );
+
+            autoStart( s_active );
+        }
+        else if( aAutoStart )
+        {
+            s_autoStartError = _( "The Autoroute tool is busy with another run." );
+            s_autoStartDone = true;
+        }
+
+        return;
+    }
+
+    if( PreferDocked() )
+    {
+        wxAuiPaneInfo&   pane = aFrame->m_auimgr.GetPane( PANE_NAME );
+        AUTOROUTE_PANEL* panel = nullptr;
+
+        if( pane.IsOk() )
+        {
+            panel = static_cast<AUTOROUTE_PANEL*>( pane.window );
+        }
+        else
+        {
+            DOCKED_AUTOROUTE_HOST* host = new DOCKED_AUTOROUTE_HOST( aFrame );
+            panel = new AUTOROUTE_PANEL( aFrame, aFrame, host );
+            panel->m_ownedHost.reset( host );
+            host->m_panel = panel;
+
+            // In the Properties panel's place at the left (Properties is hidden while the tool
+            // is shown there), the full height of the editor.
+            aFrame->m_auimgr.AddPane( panel, EDA_PANE().Name( PANE_NAME )
+                                                     .Left().Layer( 5 ).Row( 0 ).Position( 0 )
+                                                     .Caption( _( "Autoroute" ) )
+                                                     .CaptionVisible( true )
+                                                     .CloseButton( false )
+                                                     .PaneBorder( false )
+                                                     .MinSize( aFrame->FromDIP( wxSize( 360, 200 ) ) )
+                                                     .BestSize( aFrame->FromDIP( wxSize( 420, -1 ) ) ) );
+        }
+
+        s_active = panel;
+
+        if( aSettings )
+            panel->LoadSettings( *aSettings );
+        else if( s_haveLastSettings && !panel->m_job->IsActive() )
+            panel->LoadSettings( s_lastSettings );
+
+        wxAuiPaneInfo& props = aFrame->m_auimgr.GetPane( PCB_EDIT_FRAME::PropertiesPaneName() );
+        static_cast<DOCKED_AUTOROUTE_HOST*>( panel->m_host )->m_propertiesWasShown =
+                props.IsOk() && props.IsShown();
+
+        if( props.IsOk() )
+            props.Show( false );
+
+        aFrame->m_auimgr.GetPane( PANE_NAME ).Show( true );
+        aFrame->m_auimgr.Update();
+
+        if( aAutoStart )
+            autoStart( panel );
+
+        return;
+    }
+
+    DIALOG_AUTOROUTE dlg( aFrame );
+    AUTOROUTE_PANEL* panel = dlg.Panel();
+
+    s_active = panel;
+
+    if( aSettings )
+        panel->LoadSettings( *aSettings );
+
+    if( aAutoStart )
+    {
+        dlg.Bind( wxEVT_INIT_DIALOG,
+                  [&dlg, panel, autoStart]( wxInitDialogEvent& aEvent )
+                  {
+                      aEvent.Skip();
+                      dlg.CallAfter( [panel, autoStart]() { autoStart( panel ); } );
+                  } );
+    }
+
+    dlg.ShowModal();
+
+    if( s_active == panel )
+        s_active = nullptr;
+}
