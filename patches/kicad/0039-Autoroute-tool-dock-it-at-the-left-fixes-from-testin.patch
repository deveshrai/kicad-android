+void AUTOROUTE_PANEL::LoadSettings( const AUTOROUTE_SETTINGS& s )
+{
+    m_router->SetSelection( s.router == AR_ROUTER::KRT ? 0 : 1 );
+
+    m_routeAll->SetValue( s.allNets );
+    m_routeChosen->SetValue( !s.allNets );
+    m_routeNets->SetChecked( s.nets );
+    m_routeNets->Enable( !s.allNets );
+    m_bus->SetValue( s.bus );
+
+    wxString parts;
+
+    for( const wxString& ref : s.betweenParts )
+        parts << ( parts.IsEmpty() ? wxS( "" ) : wxS( ", " ) ) << ref;
+
+    m_betweenParts->ChangeValue( parts );
+    m_betweenOn->SetValue( !s.betweenParts.empty() );
+
+    for( unsigned i = 0; i < m_layers->GetCount(); i++ )
+    {
+        m_layers->Check( i, s.layers.empty()
+                                    || std::find( s.layers.begin(), s.layers.end(),
+                                                  m_layers->GetString( i ) )
+                                               != s.layers.end() );
+    }
+
+    m_planesFirst->SetValue( s.planesFirst );
+    m_fanoutFirst->SetValue( s.fanoutFirst );
+
+    for( unsigned i = 0; i < m_fanoutParts->GetCount(); i++ )
+    {
+        m_fanoutParts->Check( i, std::find( s.fanoutParts.begin(), s.fanoutParts.end(),
+                                            m_fanoutRefs[i] )
+                                         != s.fanoutParts.end() );
+    }
+
+    m_fanoutWidth->SetValue( s.fanoutWidthMm > 0 ? mmText( s.fanoutWidthMm ) : wxString() );
+    m_planes = s.planes;
+    fillPlanesList();
+
+    m_optimizeAll->SetValue( s.optimizeAll );
+    m_optimizeChosen->SetValue( !s.optimizeAll );
+    m_optimizeNets->SetChecked( s.optimizeNets );
+    m_optimizeNets->Enable( !s.optimizeAll );
+
+    m_rules->SetSelection( s.rules == AR_RULES::EXACT ? 0 : s.rules == AR_RULES::BOARD ? 1 : 2 );
+    m_grid->SetValue( mmText( s.gridMm ) );
+    m_viaCost->SetValue( s.viaCost );
+    m_passes->SetValue( s.optimizerPasses );
+    m_optimizeAfter->SetValue( s.optimizeAfter );
+    m_frFanout->SetValue( s.freeroutingFanout );
+    m_live->SetValue( s.liveView );
+    m_refill->SetValue( s.refillZones );
+    m_ripOthers->SetValue( s.ripOtherNets );
+
+    // A first use with no fan-out chosen yet: suggest the fine-pitch parts.
+    if( !s_haveLastSettings && s.fanoutParts.empty() )
+        selectFinePitchParts();
+
+    switch( s.task )
+    {
+    case AR_TASK::ROUTE:    m_book->SetSelection( 0 ); break;
+    case AR_TASK::FANOUT:   m_book->SetSelection( 1 ); break;
+    case AR_TASK::PLANES:   m_book->SetSelection( 2 ); break;
+    case AR_TASK::OPTIMIZE: m_book->SetSelection( 3 ); break;
+    }
+
+    updateRouterHints();
+}
+
+
+bool AUTOROUTE_PANEL::readSettings( AUTOROUTE_SETTINGS& s, wxString& aError )
+{
+    s.router = m_router->GetSelection() == 1 ? AR_ROUTER::FREEROUTING : AR_ROUTER::KRT;
+
+    switch( m_book->GetSelection() )
+    {
+    case 1:  s.task = AR_TASK::FANOUT; break;
+    case 2:  s.task = AR_TASK::PLANES; break;
+    case 3:  s.task = AR_TASK::OPTIMIZE; break;
+    default: s.task = AR_TASK::ROUTE; break;
+    }
+
+    s.allNets = m_routeAll->GetValue();
+    s.nets = m_routeNets->GetChecked();
+    s.bus = m_bus->GetValue();
+    s.betweenParts.clear();
+
+    if( m_betweenOn->GetValue() )
+    {
+        BOARD*            board = m_frame->GetBoard();
+        wxStringTokenizer tok( m_betweenParts->GetValue(), wxS( ", ;" ), wxTOKEN_STRTOK );
+
+        while( tok.HasMoreTokens() )
+        {
+            wxString ref = tok.GetNextToken();
+            bool     found = false;
+
+            for( FOOTPRINT* fp : board->Footprints() )
+                found |= fp->GetReference() == ref;
+
+            if( !found )
+            {
+                aError = wxString::Format( _( "The board has no part %s." ), ref );
+                return false;
+            }
+
+            s.betweenParts.push_back( ref );
+        }
+
+        if( s.betweenParts.size() < 2 )
+        {
+            aError = _( "Name at least two parts to route between." );
+            return false;
+        }
+    }
+
+    s.layers.clear();
+    bool allLayers = true;
+
+    for( unsigned i = 0; i < m_layers->GetCount(); i++ )
+    {
+        if( m_layers->IsChecked( i ) )
+            s.layers.push_back( m_layers->GetString( i ) );
+        else
+            allLayers = false;
+    }
+
+    if( s.layers.empty() )
+    {
+        aError = _( "Choose at least one layer to route on." );
+        return false;
+    }
+
+    if( allLayers )
+        s.layers.clear();
+
+    s.planesFirst = m_planesFirst->GetValue();
+    s.fanoutFirst = m_fanoutFirst->GetValue();
+
+    s.fanoutParts.clear();
+
+    for( unsigned i = 0; i < m_fanoutParts->GetCount(); i++ )
+    {
+        if( m_fanoutParts->IsChecked( i ) )
+            s.fanoutParts.push_back( m_fanoutRefs[i] );
+    }
+
+    s.fanoutWidthMm = 0;
+
+    if( !m_fanoutWidth->GetValue().Trim().IsEmpty()
+        && ( !m_fanoutWidth->GetValue().ToCDouble( &s.fanoutWidthMm ) || s.fanoutWidthMm <= 0 ) )
+    {
+        aError = _( "The fan-out track width must be a number of millimetres." );
+        return false;
+    }
+
+    s.planes = m_planes;
+    s.optimizeAll = m_optimizeAll->GetValue();
+    s.optimizeNets = m_optimizeNets->GetChecked();
+
+    if( s.task == AR_TASK::OPTIMIZE && !s.optimizeAll && s.optimizeNets.empty() )
+    {
+        aError = _( "Choose at least one net to optimize." );
+        return false;
+    }
+
+    s.rules = m_rules->GetSelection() == 0 ? AR_RULES::EXACT
+            : m_rules->GetSelection() == 1 ? AR_RULES::BOARD
+                                           : AR_RULES::FAB;
+
+    if( !m_grid->GetValue().ToCDouble( &s.gridMm ) || s.gridMm < 0.01 || s.gridMm > 1.0 )
+    {
+        aError = _( "The routing grid must be between 0.01 and 1 mm." );
+        return false;
+    }
+
+    s.viaCost = m_viaCost->GetValue();
+    s.optimizerPasses = m_passes->GetValue();
+    s.optimizeAfter = m_optimizeAfter->GetValue();
+    s.freeroutingFanout = m_frFanout->GetValue();
+    s.liveView = m_live->GetValue();
+    s.refillZones = m_refill->GetValue();
+    s.ripOtherNets = m_ripOthers->GetValue();
+    return true;
+}
+
+
+void AUTOROUTE_PANEL::updateRouterHints()
+{
+    bool krt = m_router->GetSelection() != 1;
+
+    setWrapped( m_routerInfo,
+            krt ? _( "Recommended. KiCadRoutingTools by Andy Haas: a grid router with rip-up and reroute, "
+                     "fan-out of fine-pitch parts, bus routing and plane connections. Runs in its "
+                     "own process; large boards take minutes." )
+                : _( "Freerouting: a gridless push-and-shove router with an optimizer. Routes "
+                     "the whole board at once." ) );
+
+    m_bus->Enable( krt && m_routeChosen->GetValue() );
+    m_fanoutFirst->Enable( krt );
+    m_rules->Enable( krt );
+    m_grid->Enable( krt );
+    m_ripOthers->Enable( krt );
+    m_passes->Enable( !krt );
+    m_optimizeAfter->Enable( !krt );
+    m_frFanout->Enable( !krt );
+    m_live->Enable( !krt );
+
+    wxString hint;
+
+    if( !krt && m_book->GetSelection() == 1 )
+        hint = _( "Freerouting cannot fan out single parts. Choose KiCadRoutingTools, or use "
+                  "Freerouting's fan-out of every SMD pad on the Settings tab." );
+    else if( krt && !KIPLATFORM::ROUTER_PROCESS::IsRuntimeReady() )
+        hint = _( "The first run unpacks KiCadRoutingTools (about 150 MB), which takes a minute." );
+
+    setWrapped( m_hint, hint );
+    updateRunButton();
+    Layout();
+}
+
+
+void AUTOROUTE_PANEL::updateRunButton()
+{
+    switch( m_book->GetSelection() )
+    {
+    case 1:  m_runBtn->SetLabel( _( "Fan Out" ) ); break;
+    case 2:  m_runBtn->SetLabel( _( "Pour Planes" ) ); break;
+    case 3:  m_runBtn->SetLabel( _( "Optimize" ) ); break;
+    default: m_runBtn->SetLabel( _( "Route" ) ); break;
+    }
+
+    bool krt = m_router->GetSelection() != 1;
+    m_runBtn->Enable( !( !krt && m_book->GetSelection() == 1 ) );
+
+    if( m_book->GetSelection() == 4 )
+        m_runBtn->SetLabel( _( "Route" ) );
+}
+
+
+bool AUTOROUTE_PANEL::Start()
+{
+    AUTOROUTE_SETTINGS settings;
+    wxString           error;
+
+    if( m_job->IsActive() || m_locked )
+    {
+        m_startError = _( "A run is already in progress." );
+        return false;
+    }
+
+    // From the Settings tab, the button routes.
+    if( m_book->GetSelection() == 4 )
+        m_book->SetSelection( 0 );
+
+    if( !readSettings( settings, error ) || !m_job->Start( settings, error ) )
+    {
+        m_startError = error;
+        return false;
+    }
+
+    s_lastSettings = settings;
+    s_haveLastSettings = true;
+    m_startError.clear();
+    m_shownLogLines = 0;
+    m_log->Clear();
+    lockEditor( true );
+    setView( VIEW::RUN );
+    m_timer.Start( 300 );
+    return true;
+}
+
+
+void AUTOROUTE_PANEL::setView( VIEW aView )
+{
+    m_view = aView;
+
+    bool setup = aView == VIEW::SETUP;
+    bool run = aView == VIEW::RUN;
+    bool result = aView == VIEW::RESULT;
+
+    m_setupPanel->Show( setup );
+    m_runPanel->Show( !setup );
+    m_openLabel->Show( result && !m_job->GetOpenNets().empty() );
+    m_openNets->Show( result && !m_job->GetOpenNets().empty() );
+
+    m_closeBtn->Show( setup );
+    m_runBtn->Show( setup );
+    m_fitBtn->Show( !setup );
+    m_pauseBtn->Show( run );
+    m_stopBtn->Show( run );
+    m_discardBtn->Show( result && m_job->ChangedBoard() );
+    m_backBtn->Show( result );
+    m_keepBtn->Show( result );
+
+    if( result )
+    {
+        m_openNets->Clear();
+
+        for( const wxString& net : m_job->GetOpenNets() )
+            m_openNets->Append( net );
+    }
+
+    if( !setup )
+        refreshRunView();
+
+    m_dockBtn->Enable( setup );
+    m_runPanel->Layout();
+    m_setupPanel->Layout();
+    Layout();
+
+    if( result )
+    {
+        m_log->SetInsertionPointEnd();
+        m_log->ShowPosition( m_log->GetLastPosition() );
+    }
+
+    m_host->PanelLayoutChanged( !setup );
+}
+
+
+static wxString duration( long aMs )
+{
+    long secs = aMs / 1000;
+
+    if( secs < 60 )
+        return wxString::Format( _( "%ld s" ), secs );
+
+    return wxString::Format( wxS( "%ld:%02ld" ), secs / 60, secs % 60 );
+}
+
+
+void AUTOROUTE_PANEL::refreshRunView()
+{
+    const AUTOROUTE_JOB::PROGRESS& p = m_job->GetProgress();
+    AUTOROUTE_JOB::STATE           state = m_job->GetState();
+
+    wxString title = m_job->GetSettings().task == AR_TASK::OPTIMIZE ? _( "Optimizing with %s" )
+                                                                    : _( "Routing with %s" );
+    title = wxString::Format( title, AUTOROUTE_JOB::RouterName( m_job->GetSettings().router ) );
+
+    if( state == AUTOROUTE_JOB::STATE::PAUSED )
+        title += wxS( "  " ) + _( "(paused)" );
+
+    m_runTitle->SetLabel( title );
+
+    wxString stage = state == AUTOROUTE_JOB::STATE::FAILED && !m_job->GetError().IsEmpty()
+                             ? p.stage + wxS( "\n" ) + m_job->GetError()
+                             : p.stage;
+    wxString before = m_stage->GetLabel();
+    setWrapped( m_stage, stage, 300 );
+
+    // A longer or shorter stage line changes its height: lay the panel out again.
+    if( m_stage->GetLabel() != before )
+        m_runPanel->Layout();
+
+    if( state == AUTOROUTE_JOB::STATE::FINISHED )
+    {
+        m_gauge->SetRange( 1 );
+        m_gauge->SetValue( 1 );
+    }
+    else if( p.total > 0 )
+    {
+        m_gauge->SetRange( p.total );
+        m_gauge->SetValue( std::min( std::max( p.done, 0 ), p.total ) );
+    }
+    else if( m_job->IsActive() )
+    {
+        m_gauge->Pulse();
+    }
+    else
+    {
+        m_gauge->SetRange( 1 );
+        m_gauge->SetValue( state == AUTOROUTE_JOB::STATE::FINISHED ? 1 : 0 );
+    }
+
+    wxArrayString counts;
+
+    if( state == AUTOROUTE_JOB::STATE::PREPARING && p.total > 0 )
+        counts.Add( wxString::Format( _( "%d of %d files" ), p.done, p.total ) );
+    else if( p.total > 0 && m_job->GetSettings().router == AR_ROUTER::FREEROUTING )
+        counts.Add( wxString::Format( _( "%d of %d connections" ), p.done, p.total ) );
+    else if( p.total > 0 && m_job->IsActive() )
+        counts.Add( wxString::Format( _( "net %d of %d" ), p.done + 1, p.total ) );
+
+    if( !p.net.IsEmpty() && m_job->IsActive() )
+        counts.Add( p.net );
+
+    if( p.failed > 0 )
+        counts.Add( wxString::Format( _( "%d failed" ), p.failed ) );
+
+    if( p.vias >= 0 )
+        counts.Add( wxString::Format( _( "%d vias" ), p.vias ) );
+
+    if( p.lengthMm > 0 )
+        counts.Add( wxString::Format( _( "%.0f mm of track" ), p.lengthMm ) );
+
+    counts.Add( duration( p.elapsedMs ) );
+
+    wxString countText;
+
+    for( size_t i = 0; i < counts.size(); i++ )
+        countText << ( i ? wxS( "    " ) : wxS( "" ) ) << counts[i];
+
+    m_counts->SetLabel( countText );
+
+    // Steps
+    const std::vector<AUTOROUTE_JOB::STEP>& steps = m_job->GetSteps();
+
+    if( m_steps->GetItemCount() != (int) steps.size() )
+    {
+        m_steps->DeleteAllItems();
+
+        for( size_t i = 0; i < steps.size(); i++ )
+            m_steps->InsertItem( i, steps[i].title );
+    }
+
+    for( size_t i = 0; i < steps.size(); i++ )
+    {
+        wxString status;
+
+        switch( steps[i].state )
+        {
+        case AUTOROUTE_JOB::STEP_STATE::PENDING: status = _( "Waiting" ); break;
+        case AUTOROUTE_JOB::STEP_STATE::RUNNING:
+            status = state == AUTOROUTE_JOB::STATE::PAUSED ? _( "Paused" ) : _( "Running" );
+            break;
+        case AUTOROUTE_JOB::STEP_STATE::DONE:    status = _( "Done" ); break;
+        case AUTOROUTE_JOB::STEP_STATE::FAILED:  status = _( "Failed" ); break;
+        case AUTOROUTE_JOB::STEP_STATE::SKIPPED: status = _( "Skipped" ); break;
+        }
+
+        m_steps->SetItem( i, 0, steps[i].title );
+        m_steps->SetItem( i, 1, status );
+        m_steps->SetItem( i, 2, steps[i].detail );
+    }
+
+    // Log: append the new lines only.  The job keeps the last few hundred, so count by the total.
+    const std::deque<wxString>& log = m_job->GetLog();
+    size_t                      total = m_job->GetLogTotal();
+
+    if( total < m_shownLogLines )
+    {
+        m_log->Clear();
+        m_shownLogLines = 0;
+    }
+
+    if( total > m_shownLogLines )
+    {
+        size_t   fresh = std::min( total - m_shownLogLines, log.size() );
+        wxString add;
+
+        for( size_t i = log.size() - fresh; i < log.size(); i++ )
+            add << log[i] << wxS( "\n" );
+
+        m_log->AppendText( add );
+        m_shownLogLines = total;
+
+        // Keep the box to the last thousand or so lines, and follow the end (wxQt does not by
+        // itself).
+        if( m_log->GetNumberOfLines() > 1200 )
+            m_log->Remove( 0, m_log->XYToPosition( 0, m_log->GetNumberOfLines() - 1000 ) );
+
+        m_log->SetInsertionPointEnd();
+        m_log->ShowPosition( m_log->GetLastPosition() );
+    }
+
+    m_pauseBtn->SetLabel( state == AUTOROUTE_JOB::STATE::PAUSED ? _( "Resume" ) : _( "Pause" ) );
+    m_pauseBtn->Enable( state == AUTOROUTE_JOB::STATE::RUNNING
+                        || state == AUTOROUTE_JOB::STATE::PAUSED );
+    m_stopBtn->Enable( state != AUTOROUTE_JOB::STATE::STOPPING );
+}
+
+
+void AUTOROUTE_PANEL::onTimer( wxTimerEvent& aEvent )
+{
+    m_job->Poll();
+
+    if( m_view == VIEW::RUN && !m_job->IsActive() )
+    {
+        m_timer.Stop();
+        setView( VIEW::RESULT );
+        return;
+    }
+
+    refreshRunView();
+}
+
+
+bool AUTOROUTE_PANEL::DoPause()
+{
+    bool ok = m_job->Pause();
+    refreshRunView();
+    return ok;
+}
+
+
+bool AUTOROUTE_PANEL::DoResume()
+{
+    bool ok = m_job->Resume();
+    refreshRunView();
+    return ok;
+}
+
+
+void AUTOROUTE_PANEL::DoStop()
+{
+    m_job->Stop();
+    refreshRunView();
+}
+
+
+void AUTOROUTE_PANEL::DoKeep()
+{
+    if( m_job->IsActive() )
+        return;
+
+    bool fill = m_job->ChangedBoard() && m_job->GetSettings().refillZones;
+
+    clearHighlight();
+    lockEditor( false );
+
+    if( m_host->IsDocked() )
+        setView( VIEW::SETUP );
+    else
+        m_host->CloseTool( false );
+
+    if( fill )
+        m_frame->GetToolManager()->PostAction( PCB_ACTIONS::zoneFillAll );
+}
+
+
+void AUTOROUTE_PANEL::DoDiscard()
+{
+    if( m_job->IsActive() )
+        return;
+
+    clearHighlight();
+    m_job->Discard();
+    lockEditor( false );
+    setView( VIEW::SETUP );
+}
+
+
+void AUTOROUTE_PANEL::DoClose()
+{
+    HandleCloseRequest();
+}
+
+
+void AUTOROUTE_PANEL::HandleCloseRequest()
+{
+    if( m_job->IsActive() )
+    {
+        // Closing while a run is active means stop; the result is offered when it ends.
+        DoStop();
+        return;
+    }
+
+    if( m_view == VIEW::RESULT )
+    {
+        // Keeping the result ends the run; the docked tool goes back to its tabs, so close it too.
+        DoKeep();
+
+        if( m_host->IsDocked() )
+            m_host->CloseTool( false );
+
+        return;
+    }
+
+    clearHighlight();
+    m_host->CloseTool( false );
+}
+
+
+void AUTOROUTE_PANEL::zoomToNet( const wxString& aNet )
+{
+    BOARD*        board = m_frame->GetBoard();
+    NETINFO_ITEM* net = board->FindNet( aNet );
+
+    if( !net )
+        return;
+
+    BOX2I box;
+    bool  first = true;
+
+    for( FOOTPRINT* fp : board->Footprints() )
+    {
+        for( PAD* pad : fp->Pads() )
+        {
+            if( pad->GetNetCode() != net->GetNetCode() )
+                continue;
+
+            if( first )
+                box = pad->GetBoundingBox();
+            else
+                box.Merge( pad->GetBoundingBox() );
+
+            first = false;
+        }
+    }
+
+    if( first )
+        return;
+
+    box.Inflate( std::max( box.GetWidth(), box.GetHeight() ) / 4 + pcbIUScale.mmToIU( 2 ) );
+
+    KIGFX::VIEW*             view = m_frame->GetCanvas()->GetView();
+    KIGFX::RENDER_SETTINGS*  rs = view->GetPainter()->GetSettings();
+
+    rs->SetHighlight( true, net->GetNetCode() );
+    view->UpdateAllLayersColor();
+    view->SetViewport( BOX2D( box.GetOrigin(), box.GetSize() ) );
+    m_frame->GetCanvas()->Refresh();
+}
+
+
+void AUTOROUTE_PANEL::clearHighlight()
+{
+    if( !m_frame || m_frame->IsBeingDeleted() || !m_frame->GetCanvas() )
+        return;
+
+    KIGFX::VIEW* view = m_frame->GetCanvas()->GetView();
+
+    if( !view )
+        return;
+
+    KIGFX::RENDER_SETTINGS* rs = view->GetPainter()->GetSettings();
+
+    if( rs->IsHighlightEnabled() )
+    {
+        rs->SetHighlight( false );
+        view->UpdateAllLayersColor();
+        m_frame->GetCanvas()->Refresh();
+    }
+}
