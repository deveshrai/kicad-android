+AUTOROUTE_PANEL::AUTOROUTE_PANEL( wxWindow* aParent, PCB_EDIT_FRAME* aFrame,
+                                  AUTOROUTE_HOST* aHost ) :
+        wxPanel( aParent ),
+        m_frame( aFrame ),
+        m_host( aHost ),
+        m_job( std::make_unique<AUTOROUTE_JOB>( aFrame ) ),
+        m_timer( this )
+{
+    wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+
+    // ---- Setup: router, tabs ----
+    m_setupPanel = new wxPanel( this );
+    wxBoxSizer* setup = new wxBoxSizer( wxVERTICAL );
+
+    wxBoxSizer* routerRow = new wxBoxSizer( wxHORIZONTAL );
+    routerRow->Add( new wxStaticText( m_setupPanel, wxID_ANY, _( "Router:" ) ), 0,
+                    wxALIGN_CENTER_VERTICAL | wxRIGHT, 8 );
+    m_router = new wxChoice( m_setupPanel, wxID_ANY );
+    m_router->Append( _( "KiCadRoutingTools" ) );
+    m_router->Append( _( "Freerouting" ) );
+    m_router->SetMinSize( FromDIP( wxSize( 170, -1 ) ) );
+    routerRow->Add( m_router, 0, wxALIGN_CENTER_VERTICAL );
+    routerRow->AddStretchSpacer();
+    m_dockBtn = new wxButton( m_setupPanel, wxID_ANY,
+                              aHost->IsDocked() ? _( "Undock" ) : _( "Dock to Side" ) );
+    m_dockBtn->SetToolTip( aHost->IsDocked()
+                                   ? _( "Show the Autoroute tool as a dialog instead" )
+                                   : _( "Show the Autoroute tool as a panel at the left of the "
+                                        "board editor" ) );
+    routerRow->Add( m_dockBtn, 0, wxALIGN_CENTER_VERTICAL | wxLEFT, 8 );
+    setup->Add( routerRow, 0, wxALL | wxEXPAND, 8 );
+
+    m_routerInfo = note( m_setupPanel, wxEmptyString );
+    setup->Add( m_routerInfo, 0, wxLEFT | wxRIGHT | wxBOTTOM | wxEXPAND, 8 );
+
+    m_book = new wxNotebook( m_setupPanel, wxID_ANY );
+    m_book->AddPage( buildRoutePage( m_book ), _( "Route" ) );
+    m_book->AddPage( buildFanoutPage( m_book ), _( "Fan Out" ) );
+    m_book->AddPage( buildPlanesPage( m_book ), _( "Planes" ) );
+    m_book->AddPage( buildOptimizePage( m_book ), _( "Optimize" ) );
+    m_book->AddPage( buildSettingsPage( m_book ), _( "Settings" ) );
+
+    // In the dialog the tabs size the dialog (they only need to scroll in the docked column).
+    if( !aHost->IsDocked() )
+    {
+        for( size_t i = 0; i < m_book->GetPageCount(); i++ )
+        {
+            wxWindow* page = m_book->GetPage( i );
+
+            if( page->GetSizer() )
+                page->SetMinSize( page->GetSizer()->CalcMin() );
+        }
+    }
+    setup->Add( m_book, 1, wxEXPAND | wxLEFT | wxRIGHT, 8 );
+
+    m_hint = note( m_setupPanel, wxEmptyString );
+    setup->Add( m_hint, 0, wxALL | wxEXPAND, 8 );
+    m_setupPanel->SetSizer( setup );
+    top->Add( m_setupPanel, 1, wxEXPAND );
+
+    // ---- Run and result ----
+    m_runPanel = buildRunPanel();
+    top->Add( m_runPanel, 1, wxEXPAND );
+
+    // ---- Buttons ----
+    wxBoxSizer* buttons = new wxBoxSizer( wxHORIZONTAL );
+    m_fitBtn = new wxButton( this, wxID_ANY, _( "Zoom to Fit" ) );
+    buttons->Add( m_fitBtn, 0, wxRIGHT, 8 );
+    buttons->AddStretchSpacer();
+    m_closeBtn = new wxButton( this, wxID_ANY, _( "Close" ) );
+    m_pauseBtn = new wxButton( this, wxID_ANY, _( "Pause" ) );
+    m_stopBtn = new wxButton( this, wxID_ANY, _( "Stop" ) );
+    m_discardBtn = new wxButton( this, wxID_ANY, _( "Discard" ) );
+    m_backBtn = new wxButton( this, wxID_ANY, _( "New Run" ) );
+    m_keepBtn = new wxButton( this, wxID_ANY, _( "Keep" ) );
+    m_runBtn = new wxButton( this, wxID_ANY, _( "Route" ) );
+
+    for( wxButton* b : { m_closeBtn, m_pauseBtn, m_stopBtn, m_discardBtn, m_backBtn, m_keepBtn,
+                         m_runBtn } )
+    {
+        buttons->Add( b, 0, wxLEFT, 8 );
+    }
+
+    top->Add( new wxStaticLine( this ), 0, wxEXPAND | wxLEFT | wxRIGHT, 8 );
+    top->Add( buttons, 0, wxEXPAND | wxALL, 8 );
+    SetSizer( top );
+
+    m_runBtn->Bind( wxEVT_BUTTON,
+                    [this]( wxCommandEvent& )
+                    {
+                        if( !Start() )
+                            DisplayErrorMessage( this, m_startError );
+                    } );
+    m_closeBtn->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { DoClose(); } );
+    m_dockBtn->Bind( wxEVT_BUTTON,
+                     [this]( wxCommandEvent& )
+                     {
+                         AUTOROUTE_SETTINGS settings;
+                         wxString           error;
+
+                         // Carry the settings over to the other host.
+                         if( readSettings( settings, error ) )
+                         {
+                             s_lastSettings = settings;
+                             s_haveLastSettings = true;
+                         }
+
+                         SetPreferDocked( !m_host->IsDocked() );
+                         clearHighlight();
+                         m_host->CloseTool( true );
+                     } );
+    m_pauseBtn->Bind( wxEVT_BUTTON,
+                      [this]( wxCommandEvent& )
+                      {
+                          if( m_job->GetState() == AUTOROUTE_JOB::STATE::PAUSED )
+                              DoResume();
+                          else
+                              DoPause();
+                      } );
+    m_stopBtn->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { DoStop(); } );
+    m_discardBtn->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { DoDiscard(); } );
+    m_keepBtn->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { DoKeep(); } );
+    m_backBtn->Bind( wxEVT_BUTTON,
+                     [this]( wxCommandEvent& )
+                     {
+                         // The result stays on the board (its own undo step).
+                         bool fill = m_job->ChangedBoard() && m_job->GetSettings().refillZones;
+
+                         clearHighlight();
+                         lockEditor( false );
+                         setView( VIEW::SETUP );
+
+                         if( fill )
+                             m_frame->GetToolManager()->PostAction( PCB_ACTIONS::zoneFillAll );
+                     } );
+    m_fitBtn->Bind( wxEVT_BUTTON,
+                    [this]( wxCommandEvent& )
+                    {
+                        m_frame->GetToolManager()->RunAction( ACTIONS::zoomFitScreen );
+                    } );
+    m_router->Bind( wxEVT_CHOICE, [this]( wxCommandEvent& ) { updateRouterHints(); } );
+    m_book->Bind( wxEVT_NOTEBOOK_PAGE_CHANGED,
+                  [this]( wxBookCtrlEvent& aEvent )
+                  {
+                      aEvent.Skip();
+                      updateRunButton();
+                  } );
+    Bind( wxEVT_TIMER, &AUTOROUTE_PANEL::onTimer, this );
+
+    LoadSettings( s_haveLastSettings ? s_lastSettings : AUTOROUTE_SETTINGS() );
+    setView( VIEW::SETUP );
+}
