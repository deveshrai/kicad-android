-void DIALOG_AUTOROUTE::updateRouterHints()
-{
-    bool krt = m_router->GetSelection() != 1;
-
-    m_routerInfo->SetLabel(
-            krt ? _( "KiCadRoutingTools by Andy Haas: a grid router with rip-up and reroute, "
-                     "fan-out of fine-pitch parts, bus routing and plane connections. Runs in its "
-                     "own process; large boards take minutes." )
-                : _( "Freerouting: a gridless push-and-shove router with an optimizer. Routes "
-                     "the whole board at once." ) );
-    m_routerInfo->Wrap( FromDIP( 560 ) );
-
-    m_bus->Enable( krt && m_routeChosen->GetValue() );
-    m_fanoutFirst->Enable( krt );
-    m_rules->Enable( krt );
-    m_grid->Enable( krt );
-    m_ripOthers->Enable( krt );
-    m_passes->Enable( !krt );
-    m_optimizeAfter->Enable( !krt );
-    m_frFanout->Enable( !krt );
-    m_live->Enable( !krt );
-
-    wxString hint;
-
-    if( !krt && m_book->GetSelection() == 1 )
-        hint = _( "Freerouting cannot fan out single parts. Choose KiCadRoutingTools, or use "
-                  "Freerouting's fan-out of every SMD pad on the Settings tab." );
-    else if( krt && !KIPLATFORM::ROUTER_PROCESS::IsRuntimeReady() )
-        hint = _( "The first run unpacks KiCadRoutingTools (about 150 MB), which takes a minute." );
-
-    m_hint->SetLabel( hint );
-    m_hint->Wrap( FromDIP( 560 ) );
-    updateRunButton();
-    Layout();
-}
