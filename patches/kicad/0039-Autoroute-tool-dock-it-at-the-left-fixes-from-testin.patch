+/**
+ * The pane at the left of the board editor.  The panel lives as long as the frame; closing the
+ * tool hides the pane.
+ */
+class DOCKED_AUTOROUTE_HOST : public AUTOROUTE_HOST
+{
+public:
+    DOCKED_AUTOROUTE_HOST( PCB_EDIT_FRAME* aFrame ) : m_frame( aFrame ) {}
+
+    bool IsDocked() const override { return true; }
+
+    void PanelLayoutChanged( bool aRunning ) override
+    {
+        if( m_panel )
+            m_panel->Layout();
+    }
+
+    void CloseTool( bool aToggleDock ) override;
+
+    PCB_EDIT_FRAME*  m_frame;
+    AUTOROUTE_PANEL* m_panel = nullptr;
+    bool             m_propertiesWasShown = false;
+};
+
+
+void DOCKED_AUTOROUTE_HOST::CloseTool( bool aToggleDock )
+{
+    wxAuiPaneInfo& pane = m_frame->m_auimgr.GetPane( PANE_NAME );
+
+    if( pane.IsOk() )
+    {
+        pane.Show( false );
+
+        // Give the Properties panel its place back.
+        wxAuiPaneInfo& props = m_frame->m_auimgr.GetPane( PCB_EDIT_FRAME::PropertiesPaneName() );
+
+        if( props.IsOk() && m_propertiesWasShown )
+            props.Show( true );
+
+        m_frame->m_auimgr.Update();
+    }
+
+    if( AUTOROUTE_PANEL::s_active == m_panel )
+        AUTOROUTE_PANEL::s_active = nullptr;
+
+    if( aToggleDock )
+    {
+        PCB_EDIT_FRAME* frame = m_frame;
+        frame->CallAfter( [frame]() { AUTOROUTE_PANEL::OpenTool( frame ); } );
+    }
+}
