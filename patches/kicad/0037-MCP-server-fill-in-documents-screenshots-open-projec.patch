 #define KIAPI_JSON_H
 
 #include <string>
+#include <vector>
 
 // JSON access to the API messages.  These live in the kiapi library because the message
 // descriptors are registered with the protobuf copy linked into it; other libraries can only
 // pass serialized messages across.
 
+/**
+ * What KiapiJsonToMessage() may fill into a request's document specifiers when the caller left
+ * them out or left parts empty.  An API client must otherwise repeat the project's name and path
+ * and the board's file name in every request, and a handler told nothing answers AS_UNHANDLED.
+ */
+struct KIAPI_DOCUMENT_DEFAULTS
+{
+    /// The open documents as serialized kiapi.common.types.DocumentSpecifier messages, as
+    /// GetOpenDocuments returns them
+    std::vector<std::string> openDocuments;
+
+    std::string projectName;    ///< for DOCTYPE_PROJECT documents
+    std::string projectPath;
+
+    /// The DocumentType to assume for a command of the common package that names none
+    /// (DOCTYPE_UNKNOWN to leave such a document alone)
+    int commonType = 0;
+};
+
 /**
  * Convert JSON to an API message.  @a aName may be a full name (kiapi.board.commands.GetItems)
  * or a short one (GetItems).  On success, @a aTypeUrl and @a aBytes are what goes into a
@@ -35,6 +55,21 @@ KIAPI_IMPORTEXPORT bool KiapiJsonToMessage( const std::string& aName, const std:
                                             std::string& aTypeUrl, std::string& aBytes,
                                             std::string& aError );
 
+/**
+ * As above, filling the request's document specifiers (top level, or in an ItemHeader) from
+ * @a aDefaults: the type from the command's package (board or schematic) or
+ * aDefaults.commonType, then the project, and the board file name, of the open document of that
+ * type.  Parts the caller set are kept.  @a aAssumedType is set to the type the conversion chose
+ * for a document that named none, or 0.
+ */
+KIAPI_IMPORTEXPORT bool KiapiJsonToMessage( const std::string& aName, const std::string& aJson,
+                                            const KIAPI_DOCUMENT_DEFAULTS& aDefaults,
+                                            std::string& aTypeUrl, std::string& aBytes,
+                                            int& aAssumedType, std::string& aError );
+
+/// The package of an API command (kiapi.board.commands...), or empty if it is unknown
+KIAPI_IMPORTEXPORT std::string KiapiCommandPackage( const std::string& aName );
+
 /// Convert a serialized message (as found in an Any) to JSON, with the .proto field names.
 KIAPI_IMPORTEXPORT bool KiapiMessageToJson( const std::string& aTypeUrl, const std::string& aBytes,
                                             std::string& aJson, std::string& aError );
