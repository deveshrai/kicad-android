+using kiapi::common::types::DocumentSpecifier;
+using kiapi::common::types::DocumentType;
+
+
+const DocumentSpecifier* findOpen( const std::vector<DocumentSpecifier>& aOpen, DocumentType aType )
+{
+    for( const DocumentSpecifier& doc : aOpen )
+    {
+        if( doc.type() == aType )
+            return &doc;
+    }
+
+    return nullptr;
+}
+
+
+void fillDocument( DocumentSpecifier& aDoc, DocumentType aPackageType,
+                   const std::vector<DocumentSpecifier>& aOpen,
+                   const KIAPI_DOCUMENT_DEFAULTS& aDefaults, int& aAssumedType )
+{
+    DocumentType type = aDoc.type();
+
+    if( type == kiapi::common::types::DOCTYPE_UNKNOWN )
+    {
+        type = aPackageType;
+
+        if( type == kiapi::common::types::DOCTYPE_UNKNOWN )
+        {
+            type = static_cast<DocumentType>( aDefaults.commonType );
+            aAssumedType = aDefaults.commonType;
+        }
+
+        if( type == kiapi::common::types::DOCTYPE_UNKNOWN )
+            return;
+
+        aDoc.set_type( type );
+    }
+
+    if( type == kiapi::common::types::DOCTYPE_PROJECT )
+    {
+        if( aDoc.project().name().empty() )
+            aDoc.mutable_project()->set_name( aDefaults.projectName );
+
+        if( aDoc.project().path().empty() && aDoc.project().name() == aDefaults.projectName )
+            aDoc.mutable_project()->set_path( aDefaults.projectPath );
+
+        return;
+    }
+
+    if( type != kiapi::common::types::DOCTYPE_SCHEMATIC && type != kiapi::common::types::DOCTYPE_PCB )
+        return;
+
+    const DocumentSpecifier* open = findOpen( aOpen, type );
+
+    if( !open )
+        return;
+
+    if( aDoc.project().name().empty() )
+        aDoc.mutable_project()->set_name( open->project().name() );
+
+    if( aDoc.project().path().empty() && aDoc.project().name() == open->project().name() )
+        aDoc.mutable_project()->set_path( open->project().path() );
+
+    // A schematic's sheet path narrows some commands to one sheet, so it is never assumed
+    if( type == kiapi::common::types::DOCTYPE_PCB && aDoc.board_filename().empty() )
+        aDoc.set_board_filename( open->board_filename() );
+}
+
+
+// Fill the document specifiers of aMsg, and of its ItemHeader, at most a level down
+void fillDocuments( gpb::Message& aMsg, DocumentType aPackageType,
+                    const std::vector<DocumentSpecifier>& aOpen,
+                    const KIAPI_DOCUMENT_DEFAULTS& aDefaults, int aDepth, int& aAssumedType )
+{
+    const gpb::Descriptor* desc = aMsg.GetDescriptor();
+    const gpb::Reflection* refl = aMsg.GetReflection();
+
+    for( int i = 0; i < desc->field_count(); ++i )
+    {
+        const gpb::FieldDescriptor* f = desc->field( i );
+
+        if( !f->message_type() || f->is_repeated() )
+            continue;
+
+        if( f->message_type() == DocumentSpecifier::descriptor() )
+        {
+            gpb::Message* doc = refl->MutableMessage( &aMsg, f );
+            fillDocument( *static_cast<DocumentSpecifier*>( doc ), aPackageType, aOpen, aDefaults,
+                          aAssumedType );
+        }
+        else if( aDepth == 0 && f->message_type() == kiapi::common::types::ItemHeader::descriptor() )
+        {
+            fillDocuments( *refl->MutableMessage( &aMsg, f ), aPackageType, aOpen, aDefaults, 1,
+                           aAssumedType );
+        }
+    }
+}
+} // namespace
