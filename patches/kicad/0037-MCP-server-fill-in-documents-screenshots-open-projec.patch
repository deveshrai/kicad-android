+#ifdef __ANDROID__
+// What a GPU window (a canvas, the 3D viewer) shows.  Qt cannot grab these: they draw into an
+// Android TextureView (see CreateVulkanSurface), whose picture TextureView.getBitmap() copies
+// out, on the Android UI thread that owns the view.
+static QImage grabTextureView( QWindow* aWindow )
+{
+    if( !aWindow->handle() )
+        return {};
+
+    QJniObject qtWindow( reinterpret_cast<jobject>( aWindow->winId() ) );
+
+    if( !qtWindow.isValid() )
+        return {};
+
+    auto        result = std::make_shared<std::promise<QImage>>();
+    std::future<QImage> future = result->get_future();
+    QJniObject  window = qtWindow;
+
+    QNativeInterface::QAndroidApplication::runOnAndroidMainThread(
+            [window, result]()
+            {
+                QJniEnvironment env;
+                QImage          image;
+                QJniObject      container = window.getObjectField( "m_surfaceContainer",
+                                                                   "Landroid/view/View;" );
+                env.checkAndClearExceptions();
+                jclass textureView = env->FindClass( "android/view/TextureView" );
+
+                if( container.isValid() && textureView
+                    && env->IsInstanceOf( container.object(), textureView ) )
+                {
+                    QJniObject bitmap = container.callObjectMethod( "getBitmap",
+                                                                    "()Landroid/graphics/Bitmap;" );
+                    env.checkAndClearExceptions();
+
+                    if( bitmap.isValid() )
+                    {
+                        int w = bitmap.callMethod<jint>( "getWidth" );
+                        int h = bitmap.callMethod<jint>( "getHeight" );
+
+                        if( w > 0 && h > 0 )
+                        {
+                            // ARGB_8888 is laid out as R, G, B, A bytes
+                            image = QImage( w, h, QImage::Format_RGBA8888 );
+                            jobject buffer = env->NewDirectByteBuffer( image.bits(),
+                                                                       image.sizeInBytes() );
+                            bitmap.callMethod<void>( "copyPixelsToBuffer", "(Ljava/nio/Buffer;)V",
+                                                     buffer );
+                            env->DeleteLocalRef( buffer );
+
+                            if( env.checkAndClearExceptions() )
+                                image = QImage();
+                        }
+
+                        bitmap.callMethod<void>( "recycle" );
+                        env.checkAndClearExceptions();
+                    }
+                }
+
+                if( textureView )
+                    env->DeleteLocalRef( textureView );
+
+                result->set_value( image );
+            } );
+
+    // The UI thread can be waiting on this one (a surface change); then go without the picture
+    if( future.wait_for( std::chrono::seconds( 2 ) ) != std::future_status::ready )
+        return {};
+
+    return future.get();
+}
+
+
+static bool isInside( QWindow* aWindow, QWindow* aTop )
+{
+    for( QWindow* w = aWindow; w; w = w->parent() )
+    {
+        if( w == aTop )
+            return true;
+    }
+
+    return false;
+}
+#endif
