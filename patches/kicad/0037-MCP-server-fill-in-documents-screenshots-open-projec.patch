+/// The documents open in the editors, as GetOpenDocuments lists them
+static std::vector<json> openDocuments()
+{
+    std::vector<json> docs;
+
+    for( const char* type : { "DOCTYPE_PCB", "DOCTYPE_SCHEMATIC" } )
+    {
+        int         assumed = 0, status = 0;
+        std::string err;
+        json        r = callApiOnce( "GetOpenDocuments", { { "type", type } }, nullptr, assumed,
+                                     status, err );
+
+        if( r.contains( "documents" ) )
+        {
+            for( const json& d : r["documents"] )
+                docs.push_back( d );
+        }
+    }
+
+    return docs;
+}
+
+
+json MCP_SERVER::CallApi( const std::string& aCommand, const json& aArgs, std::string& aError )
+{
+    int assumed = 0, status = 0;
+
+    if( aCommand == "GetOpenDocuments" )
+        return callApiOnce( aCommand, aArgs, nullptr, assumed, status, aError );
+
+    // A client would otherwise have to repeat the project and board in every request, and a
+    // request naming no document reaches no editor (AS_UNHANDLED)
+    KIAPI_DOCUMENT_DEFAULTS defaults;
+    std::vector<int>        openTypes;
+    PROJECT&                prj = Pgm().GetSettingsManager().Prj();
+
+    defaults.projectName = prj.GetProjectName().ToStdString();
+    defaults.projectPath = prj.GetProjectPath().ToStdString();
+
+    for( const json& doc : openDocuments() )
+    {
+        std::string typeUrl, bytes, err;
+
+        if( KiapiJsonToMessage( "kiapi.common.types.DocumentSpecifier", doc.dump(), typeUrl, bytes,
+                                err ) )
+        {
+            defaults.openDocuments.push_back( bytes );
+        }
+
+        std::string type = doc.value( "type", std::string() );
+
+        if( type == "DOCTYPE_PCB" )
+            openTypes.push_back( kiapi::common::types::DOCTYPE_PCB );
+        else if( type == "DOCTYPE_SCHEMATIC" )
+            openTypes.push_back( kiapi::common::types::DOCTYPE_SCHEMATIC );
+    }
+
+    if( openTypes.empty() )
+        openTypes.push_back( 0 );
+
+    json result;
+
+    // A common command (SaveDocumentToString, GetItems...) naming no document type goes to each
+    // open editor in turn, until one handles it
+    for( int type : openTypes )
+    {
+        aError.clear();
+        defaults.commonType = type;
+        result = callApiOnce( aCommand, aArgs, &defaults, assumed, status, aError );
+
+        if( status != kiapi::common::ApiStatusCode::AS_UNHANDLED || !assumed )
+            break;
+    }
+
+    if( status == kiapi::common::ApiStatusCode::AS_UNHANDLED )
+    {
+        std::string package = KiapiCommandPackage( aCommand );
+        std::string editor = package.rfind( "kiapi.schematic", 0 ) == 0 ? "schematic editor"
+                             : package.rfind( "kiapi.board", 0 ) == 0   ? "board editor"
+                                                                        : "editor";
+
+        aError = "AS_UNHANDLED: nothing handled " + aCommand + ". The " + editor
+                 + " that runs it must be open (kicad_status lists the open documents; "
+                   "kicad_open_editor opens one), and a document's type must match it: "
+                   "DOCTYPE_SCHEMATIC or DOCTYPE_PCB. The open project and board are filled "
+                   "in when left out.";
+    }
+
+    return result;
+}
