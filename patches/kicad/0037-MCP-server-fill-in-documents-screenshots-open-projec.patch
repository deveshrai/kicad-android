+
+bool KIPLATFORM::UI::GrabAppImage( wxImage& aImage )
+{
+    QWidget* active = QApplication::activeWindow();
+
+    if( !active )
+        active = QApplication::activeModalWidget();
+
+    // The frame under the active dialog, if a dialog is active
+    QWidget* base = active;
+
+    while( base && base->parentWidget() && ( base->windowType() == Qt::Dialog
+                                             || base->windowType() == Qt::Popup
+                                             || base->windowType() == Qt::Tool ) )
+    {
+        base = base->parentWidget()->window();
+    }
+
+    if( !base )
+    {
+        for( QWidget* w : QApplication::topLevelWidgets() )
+        {
+            if( w->isVisible() && ( !base || w->width() * w->height() > base->width() * base->height() ) )
+                base = w;
+        }
+    }
+
+    if( !base )
+        return false;
+
+    const qreal  dpr = base->devicePixelRatioF();
+    const QPoint origin = base->mapToGlobal( QPoint( 0, 0 ) );
+    QImage       image = base->grab().toImage().convertToFormat( QImage::Format_RGB888 );
+
+    image.setDevicePixelRatio( 1.0 );
+
+    QPainter painter( &image );
+
+    auto drawWidget = [&]( QWidget* aWidget )
+    {
+        QImage part = aWidget->grab().toImage();
+        part.setDevicePixelRatio( 1.0 );
+        QPoint at = ( aWidget->mapToGlobal( QPoint( 0, 0 ) ) - origin ) * dpr;
+        painter.drawImage( at, part );
+    };
+
+    auto drawSurfaces = [&]( QWidget* aTop )
+    {
+#ifdef __ANDROID__
+        QWindow* topWindow = aTop->windowHandle();
+
+        for( QWindow* win : QGuiApplication::allWindows() )
+        {
+            if( win == topWindow || !win->isVisible() || !isInside( win, topWindow ) )
+                continue;
+
+            QImage picture = grabTextureView( win );
+
+            if( picture.isNull() )
+                continue;
+
+            QRect at( ( win->mapToGlobal( QPoint( 0, 0 ) ) - origin ) * dpr,
+                      win->size() * dpr );
+            painter.drawImage( at, picture );
+        }
+#endif
+    };
+
+    drawSurfaces( base );
+
+    // Dialogs and popups over the frame, the active one last
+    std::vector<QWidget*> above;
+
+    for( QWidget* w : QApplication::topLevelWidgets() )
+    {
+        if( w != base && w != active && w->isVisible() && w->window() == w
+            && ( w->windowType() == Qt::Dialog || w->windowType() == Qt::Popup
+                 || w->windowType() == Qt::Tool || w->windowType() == Qt::ToolTip ) )
+        {
+            above.push_back( w );
+        }
+    }
+
+    if( active && active != base )
+        above.push_back( active );
+
+    for( QWidget* w : above )
+    {
+        drawWidget( w );
+        drawSurfaces( w );
+    }
+
+    painter.end();
+
+    aImage.Create( image.width(), image.height(), false );
+    unsigned char* dst = aImage.GetData();
+
+    for( int y = 0; y < image.height(); ++y )
+        memcpy( dst + size_t( y ) * image.width() * 3, image.constScanLine( y ), image.width() * 3 );
+
+    return true;
+}
