+        std::string  package( desc->file()->package() );
+        DocumentType packageType = kiapi::common::types::DOCTYPE_UNKNOWN;
+
+        if( package.rfind( "kiapi.board", 0 ) == 0 )
+            packageType = kiapi::common::types::DOCTYPE_PCB;
+        else if( package.rfind( "kiapi.schematic", 0 ) == 0 )
+            packageType = kiapi::common::types::DOCTYPE_SCHEMATIC;
+
+        fillDocuments( *msg, packageType, open, *aDefaults, 0, aAssumedType );
+    }
+
     aTypeUrl = "type.googleapis.com/" + std::string( desc->full_name() );
     aBytes = msg->SerializeAsString();
     return true;
 }
 
 
+bool KiapiJsonToMessage( const std::string& aName, const std::string& aJson,
+                         std::string& aTypeUrl, std::string& aBytes, std::string& aError )
+{
+    int assumed = 0;
+    return jsonToMessage( aName, aJson, nullptr, aTypeUrl, aBytes, assumed, aError );
+}
+
+
+bool KiapiJsonToMessage( const std::string& aName, const std::string& aJson,
+                         const KIAPI_DOCUMENT_DEFAULTS& aDefaults, std::string& aTypeUrl,
+                         std::string& aBytes, int& aAssumedType, std::string& aError )
+{
+    return jsonToMessage( aName, aJson, &aDefaults, aTypeUrl, aBytes, aAssumedType, aError );
+}
