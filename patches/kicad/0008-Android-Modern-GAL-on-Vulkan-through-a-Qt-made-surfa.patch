+#ifdef __ANDROID__
+uint64_t KIPLATFORM::UI::CreateVulkanSurface( void* aNativeHandle, void* aVkInstance )
+{
+    // One QVulkanInstance per adopted VkInstance; they live as long as the process
+    static std::mutex                        s_mutex;
+    static QHash<void*, QVulkanInstance*>    s_instances;
+
+    if( !aNativeHandle || !aVkInstance )
+        return 0;
+
+    QVulkanInstance* qvk = nullptr;
+
+    {
+        std::lock_guard<std::mutex> lock( s_mutex );
+        qvk = s_instances.value( aVkInstance );
+
+        if( !qvk )
+        {
+            qvk = new QVulkanInstance;
+            qvk->setVkInstance( static_cast<VkInstance>( aVkInstance ) );
+
+            if( !qvk->create() )
+            {
+                delete qvk;
+                return 0;
+            }
+
+            s_instances.insert( aVkInstance, qvk );
+        }
+    }
+
+    QWindow* window = static_cast<QWindow*>( aNativeHandle );
+
+    if( window->vulkanInstance() != qvk )
+        window->setVulkanInstance( qvk );
+
+    return reinterpret_cast<uint64_t>( QVulkanInstance::surfaceForWindow( window ) );
+}
+#endif
