+/**
+ * Make the user's global symbol and footprint tables refer to the stock libraries, now that
+ * they are there.  Only for tables that exist: at first start the library tables page creates
+ * them after this page, with the stock libraries in them.
+ */
+void addStockLibrariesToGlobalTables()
+{
+    bool changed = false;
+
+    for( LIBRARY_TABLE_TYPE type : { LIBRARY_TABLE_TYPE::SYMBOL, LIBRARY_TABLE_TYPE::FOOTPRINT } )
+    {
+        const wxString tablePath = LIBRARY_MANAGER::DefaultGlobalTablePath( type );
+        const wxString stockPath = LIBRARY_MANAGER::StockTablePath( type );
+
+        if( !LIBRARY_MANAGER::IsTableValid( tablePath ) || !LIBRARY_MANAGER::IsTableValid( stockPath ) )
+            continue;
+
+        LIBRARY_TABLE table( wxFileName( tablePath ), LIBRARY_TABLE_SCOPE::GLOBAL );
+
+        if( !table.IsOk() )
+            continue;
+
+        const wxString stockUri = LIBRARY_MANAGER::StockTableReferenceURI( type );
+        std::set<wxString> nicknames;
+        bool               present = false;
+
+        for( const LIBRARY_TABLE_ROW& row : table.Rows() )
+        {
+            nicknames.insert( row.Nickname() );
+
+            if( row.Type() == LIBRARY_TABLE_ROW::TABLE_TYPE_NAME
+                && ( row.URI() == stockUri || row.URI() == stockPath
+                     || row.URI() == LIBRARY_MANAGER::StockTableTokenizedURI( type ) ) )
+            {
+                present = true;
+            }
+        }
+
+        if( present )
+            continue;
+
+        wxString nickname = wxS( "KiCad" );
+
+        for( int i = 2; nicknames.count( nickname ); ++i )
+            nickname = wxString::Format( wxS( "KiCad_%d" ), i );
+
+        LIBRARY_TABLE_ROW& chained = table.InsertRow();
+        chained.SetType( LIBRARY_TABLE_ROW::TABLE_TYPE_NAME );
+        chained.SetNickname( nickname );
+        chained.SetDescription( _( "KiCad Default Libraries" ) );
+        chained.SetURI( stockUri );
+
+        table.Save();
+        changed = true;
+    }
+
+    if( changed )
+        Pgm().GetLibraryManager().LoadGlobalTables();
+}
