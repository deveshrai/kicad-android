+
+void STARTWIZARD_PROVIDER_LIBRARY_FILES::Finish()
+{
+    ApplyDefaults();
+
+    if( !m_model || ( !m_model->download3dModels && !m_model->updateLibraries && !m_model->installArchives ) )
+        return;
+
+    const wxString root = stockRoot();
+    const wxString staging = root + wxS( "/.staging" );
+
+    if( m_model->download3dModels || m_model->updateLibraries )
+    {
+        double needed = 0;
+
+        if( m_model->download3dModels )
+            needed += REPO_3D.downloadMB + REPO_3D.installedMB;
+
+        if( m_model->updateLibraries )
+        {
+            for( const REPO_INFO* repo : { &REPO_SYMBOLS, &REPO_FOOTPRINTS, &REPO_TEMPLATES } )
+                needed += repo->downloadMB + repo->installedMB;
+        }
+
+        if( double free = freeSpaceMB(); free >= 0 && free < needed )
+        {
+            if( wxMessageBox( wxString::Format( _( "Installing needs about %s, but only %s is free.  "
+                                                   "Try anyway?" ),
+                                                formatMB( needed ), formatMB( free ) ),
+                              _( "Libraries" ), wxYES_NO | wxICON_WARNING, m_parent ) != wxYES )
+            {
+                return;
+            }
+        }
+    }
+
+    wxFileName cache;
+    cache.AssignDir( PATHS::GetUserCachePath() );
+    cache.AppendDir( wxS( "library-downloads" ) );
+    PATHS::EnsurePathExists( cache.GetPath() );
+
+    const STARTWIZARD_PROVIDER_LIBRARY_FILES_MODEL model = *m_model;
+    const wxString                                 installed = InstalledRelease();
+
+    INSTALL_STATE state;
+    wxString      newRelease;
+    bool          alreadyNewest = false;
+    state.SetStatus( _( "Starting..." ) );
+
+    std::thread worker(
+            [&]()
+            {
+                // Progress: downloads by their size, archives by theirs, in one scale
+                struct DOWNLOAD
+                {
+                    const REPO_INFO* repo;
+                    double           weight;
+                };
+
+                std::vector<DOWNLOAD> downloads;
+                double                total = 0;
+                wxString              release = installed;
+
+                if( model.updateLibraries )
+                {
+                    state.SetStatus( _( "Looking for the newest library release..." ) );
+                    newRelease = latestRelease( installed, state );
+
+                    if( newRelease == installed )
+                    {
+                        alreadyNewest = true;
+                        newRelease.Clear();
+                    }
+                    else if( !newRelease.IsEmpty() )
+                    {
+                        release = newRelease;
+
+                        for( const REPO_INFO* repo : { &REPO_SYMBOLS, &REPO_FOOTPRINTS, &REPO_TEMPLATES } )
+                            downloads.push_back( { repo, repo->downloadMB } );
+                    }
+                }
+
+                if( model.download3dModels )
+                    downloads.push_back( { &REPO_3D, REPO_3D.downloadMB } );
+
+                for( const DOWNLOAD& download : downloads )
+                    total += download.weight;
+
+                double archiveBytes = 0;
+
+                if( model.installArchives )
+                {
+                    for( const wxString& archive : model.archives )
+                        archiveBytes += wxFileName::GetSize( archive ).ToDouble();
+                }
+
+                // Archives count as much as their size in MB
+                total += archiveBytes / 1048576.0;
+                total = std::max( total, 1.0 );
+
+                double done = 0;
+                bool   librariesOk = true;   // symbols, footprints and templates, all or none
+                bool   models3dOk = true;
+
+                if( wxFileName::DirExists( staging ) )
+                    wxFileName::Rmdir( staging, wxPATH_RMDIR_RECURSIVE );
+
+                for( const DOWNLOAD& download : downloads )
+                {
+                    if( state.cancel )
+                        break;
+
+                    const double   span = download.weight / total;
+                    const wxString url = archiveUrl( *download.repo, release );
+                    const wxString file = cache.GetPathWithSep() + wxFileName( url ).GetFullName();
+
+                    bool ok = downloadFile( url, file, download.repo->downloadMB * 1048576.0, done,
+                                            span / 2, state );
+
+                    if( ok )
+                        ok = extractArchive( file, staging, done + span / 2, span / 2, state );
+
+                    wxRemoveFile( file );
+
+                    if( download.repo == &REPO_3D )
+                        models3dOk &= ok;
+                    else
+                        librariesOk &= ok;
+
+                    done += span;
+                    state.fraction = done;
+                }
+
+                // Only a complete set replaces the installed libraries
+                if( !downloads.empty() && !state.cancel )
+                {
+                    if( !librariesOk )
+                    {
+                        newRelease.Clear();
+
+                        for( const wxChar* dir : { wxS( "symbols" ), wxS( "footprints" ), wxS( "template" ),
+                                                   wxS( "blocks" ) } )
+                        {
+                            wxFileName::Rmdir( staging + wxS( "/" ) + dir, wxPATH_RMDIR_RECURSIVE );
+                        }
+                    }
+
+                    if( !models3dOk )
+                        wxFileName::Rmdir( staging + wxS( "/3dmodels" ), wxPATH_RMDIR_RECURSIVE );
+
+                    state.SetStatus( _( "Installing..." ) );
+
+                    if( wxFileName::DirExists( staging ) && !commitStaging( staging, root, state ) )
+                        newRelease.Clear();
+                }
+
+                if( wxFileName::DirExists( staging ) )
+                    wxFileName::Rmdir( staging, wxPATH_RMDIR_RECURSIVE );
+
+                if( model.installArchives )
+                {
+                    for( const wxString& archive : model.archives )
+                    {
+                        if( state.cancel )
+                            break;
+
+                        const double span = wxFileName::GetSize( archive ).ToDouble() / 1048576.0 / total;
+
+                        state.SetStatus( wxString::Format( _( "Installing from %s" ),
+                                                           wxFileName( archive ).GetFullName() ) );
+                        extractArchive( archive, root, done, span, state );
+                        done += span;
+                        state.fraction = done;
+                    }
+                }
+
+                state.done = true;
+            } );
+
+    {
+        wxProgressDialog progress( _( "Installing Libraries" ), state.Status(), 1000, m_parent,
+                                   wxPD_APP_MODAL | wxPD_CAN_ABORT | wxPD_AUTO_HIDE | wxPD_ELAPSED_TIME );
+
+        while( !state.done )
+        {
+            if( !progress.Update( static_cast<int>( std::min( 0.999, state.fraction.load() ) * 1000 ),
+                                  state.Status() ) )
+            {
+                state.cancel = true;
+            }
+
+            wxMilliSleep( 100 );
+        }
+    }
+
+    worker.join();
+
+    if( !newRelease.IsEmpty() && !state.cancel )
+    {
+        wxFFileOutputStream out( root + wxS( "/" ) + RELEASE_FILE );
+        out.Write( newRelease.utf8_str().data(), newRelease.utf8_str().length() );
+    }
+
+    // At first start the global tables don't exist yet: the library tables page, after this
+    // one, creates them
+    if( StockLibrariesInstalled() )
+    {
+        // Must not stop the wizard's later pages from finishing
+        try
+        {
+            addStockLibrariesToGlobalTables();
+        }
+        catch( ... )
+        {
+        }
+    }
+
+    if( state.cancel )
+    {
+        wxMessageBox( _( "Installing the libraries was cancelled.  The installed libraries are "
+                         "unchanged, apart from any archive installed before the cancel." ),
+                      _( "Libraries" ), wxOK | wxICON_INFORMATION, m_parent );
+        return;
+    }
+
+    wxString summary;
+
+    if( alreadyNewest )
+    {
+        summary << wxString::Format( _( "The symbol and footprint libraries are the newest release "
+                                        "(%s) already." ),
+                                     installed )
+                << wxS( "\n" );
+    }
+    else if( !newRelease.IsEmpty() )
+    {
+        summary << wxString::Format( _( "The libraries were updated from %s to %s." ), installed, newRelease )
+                << wxS( "\n" );
+    }
+
+    const std::pair<const char*, wxString> categories[] = {
+        { "symbols", _( "symbol libraries" ) },
+        { "footprints", _( "footprint libraries" ) },
+        { "3dmodels", _( "3D model libraries" ) },
+        { "template", _( "project templates" ) },
+        { "blocks", _( "design block libraries" ) },
+    };
+
+    for( const auto& [key, label] : categories )
+    {
+        auto it = state.libraries.find( wxString::FromUTF8( key ) );
+
+        if( it != state.libraries.end() && !it->second.empty() )
+            summary << wxString::Format( _( "Installed %zu %s." ), it->second.size(), label ) << wxS( "\n" );
+    }
+
+    if( !state.libraries.empty() )
+        summary << wxS( "\n" ) << _( "Editors that are open use them after you close and reopen them." );
+
+    if( !state.errors.IsEmpty() )
+    {
+        wxMessageBox( summary + ( summary.IsEmpty() ? wxString() : wxString( wxS( "\n\n" ) ) )
+                              + _( "Problems:" ) + wxS( "\n" ) + state.errors,
+                      _( "Libraries" ), wxOK | wxICON_WARNING, m_parent );
+    }
+    else if( !summary.IsEmpty() )
+    {
+        wxMessageBox( summary, _( "Libraries" ), wxOK | wxICON_INFORMATION, m_parent );
+    }
+}
