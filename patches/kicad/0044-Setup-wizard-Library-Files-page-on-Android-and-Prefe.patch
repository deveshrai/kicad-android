+/// Progress and results shared between the worker thread and the progress dialog
+struct INSTALL_STATE
+{
+    std::atomic<bool>   cancel{ false };
+    std::atomic<bool>   done{ false };
+    std::atomic<double> fraction{ 0.0 };
+
+    std::mutex                              mutex;
+    wxString                                status;
+    wxString                                errors;
+    std::map<wxString, std::set<wxString>>  libraries;   // category -> library names
+    size_t                                  files = 0;
+
+    void SetStatus( const wxString& aStatus )
+    {
+        std::lock_guard<std::mutex> lock( mutex );
+        status = aStatus;
+    }
+
+    wxString Status()
+    {
+        std::lock_guard<std::mutex> lock( mutex );
+        return status;
+    }
+
+    void AddError( const wxString& aError )
+    {
+        std::lock_guard<std::mutex> lock( mutex );
+        errors << aError << wxS( "\n" );
+    }
+};
