+/// A library table is taken as the stock one only if it points into the stock libraries: a
+/// project's own sym-lib-table in the archive must not replace it
+bool isStockTable( const wxString& aFile, const std::string& aContent )
+{
+    if( aFile == wxS( "sym-lib-table" ) )
+        return aContent.find( "_SYMBOL_DIR}" ) != std::string::npos;
+
+    if( aFile == wxS( "fp-lib-table" ) )
+        return aContent.find( "_FOOTPRINT_DIR}" ) != std::string::npos;
+
+    return aContent.find( "_DESIGN_BLOCK_DIR}" ) != std::string::npos;
+}
