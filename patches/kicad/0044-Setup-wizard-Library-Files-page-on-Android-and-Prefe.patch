+#ifdef __ANDROID__
+/// The system's trusted CA certificates (since Android 14 the updatable copy in the Conscrypt
+/// APEX), concatenated once.  The files have text before their PEM block, which OpenSSL skips.
+static const std::string& androidCaBundle()
+{
+    static const std::string bundle = []()
+    {
+        std::string all;
+
+        for( const wxString& dir : { wxString( wxT( "/apex/com.android.conscrypt/cacerts" ) ),
+                                     wxString( wxT( "/system/etc/security/cacerts" ) ) } )
+        {
+            wxDir certs( dir );
+            wxString name;
+
+            if( !certs.IsOpened() )
+                continue;
+
+            for( bool more = certs.GetFirst( &name, wxEmptyString, wxDIR_FILES ); more;
+                 more = certs.GetNext( &name ) )
+            {
+                std::ifstream in( ( dir + wxT( "/" ) + name ).fn_str(), std::ios::binary );
+                all.append( std::istreambuf_iterator<char>( in ), std::istreambuf_iterator<char>() );
+                all.push_back( '\n' );
+            }
+
+            if( !all.empty() )
+                break;
+        }
+
+        return all;
+    }();
+
+    return bundle;
+}
+#endif
