+/// The newest release tag of KiCad's libraries in the series of @a aCurrent (10.0.x for 10.0.8),
+/// from GitLab's tag list, or an empty string
+wxString latestRelease( const wxString& aCurrent, INSTALL_STATE& aState )
+{
+    const wxString major = aCurrent.BeforeFirst( '.' );
+
+    if( major.IsEmpty() || !major.IsNumber() )
+        return wxEmptyString;
+
+    KICAD_CURL_EASY curl;
+    curl.SetURL( wxString::Format( wxS( "https://gitlab.com/api/v4/projects/kicad%%2Flibraries%%2F"
+                                        "kicad-symbols/repository/tags?per_page=100&search=%%5E%s." ),
+                                   major ).ToStdString() );
+    curl.SetFollowRedirects( true );
+
+    const int code = curl.Perform();
+
+    if( code != CURLE_OK || curl.GetResponseStatusCode() != 200 )
+    {
+        aState.AddError( wxString::Format( _( "Could not get the list of library releases: %s" ),
+                                           code != CURLE_OK ? wxString( curl.GetErrorText( code ) )
+                                                            : wxString::Format( wxS( "HTTP %d" ),
+                                                                                curl.GetResponseStatusCode() ) ) );
+        return wxEmptyString;
+    }
+
+    const std::regex tag( R"re("name"\s*:\s*"(\d+)\.(\d+)\.(\d+)")re" );
+    const std::string& json = curl.GetBuffer();
+    std::tuple<long, long, long> best{ -1, -1, -1 };
+    wxString bestName;
+
+    for( std::sregex_iterator it( json.begin(), json.end(), tag ), end; it != end; ++it )
+    {
+        std::tuple<long, long, long> version{ std::stol( ( *it )[1] ), std::stol( ( *it )[2] ),
+                                              std::stol( ( *it )[3] ) };
+
+        if( std::to_string( std::get<0>( version ) ) == major.ToStdString() && version > best )
+        {
+            best = version;
+            bestName = wxString::Format( wxS( "%ld.%ld.%ld" ), std::get<0>( version ),
+                                         std::get<1>( version ), std::get<2>( version ) );
+        }
+    }
+
+    return bestName;
+}
