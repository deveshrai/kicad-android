+class PANEL_STARTWIZARD_LIBRARY_FILES : public wxPanel
+{
+public:
+    PANEL_STARTWIZARD_LIBRARY_FILES( const std::shared_ptr<STARTWIZARD_PROVIDER_LIBRARY_FILES_MODEL>& aModel,
+                                     wxWindow* aParent ) :
+            wxPanel( aParent ),
+            m_model( aModel )
+    {
+        const int   wrap = FromDIP( 600 );
+        const int   indent = FromDIP( 28 );
+        wxBoxSizer* sizer = new wxBoxSizer( wxVERTICAL );
+
+        const wxString release = STARTWIZARD_PROVIDER_LIBRARY_FILES::InstalledRelease();
+        wxString       intro;
+
+        if( STARTWIZARD_PROVIDER_LIBRARY_FILES::StockLibrariesInstalled() )
+        {
+            intro = wxString::Format( _( "KiCad's symbol and footprint libraries (release %s) and "
+                                         "the project templates are installed.  The 3D models are "
+                                         "not part of the app: they are a large download." ),
+                                      release );
+        }
+        else
+        {
+            intro = _( "KiCad's symbol and footprint libraries are not installed.  Install them "
+                       "from archive files, or update to download the newest release." );
+        }
+
+        wxStaticText* introText = new wxStaticText( this, wxID_ANY, intro );
+        introText->Wrap( wrap );
+        sizer->Add( introText, 0, wxEXPAND | wxBOTTOM, FromDIP( 10 ) );
+
+        const bool have3d = STARTWIZARD_PROVIDER_LIBRARY_FILES::Models3dInstalled();
+        m_cb3d = new wxCheckBox( this, wxID_ANY,
+                                 wxString::Format( have3d ? _( "Download the 3D models again (%s download, %s installed)" )
+                                                          : _( "Download the 3D models (%s download, %s installed)" ),
+                                                   formatMB( REPO_3D.downloadMB ),
+                                                   formatMB( REPO_3D.installedMB ) ) );
+        sizer->Add( m_cb3d, 0, wxTOP, FromDIP( 4 ) );
+
+        m_stSpace = new wxStaticText( this, wxID_ANY, wxEmptyString );
+        sizer->AddSpacer( FromDIP( 4 ) );
+        sizer->Add( m_stSpace, 0, wxLEFT, indent );
+
+        m_cbUpdate = new wxCheckBox( this, wxID_ANY,
+                                     wxString::Format( _( "Update the symbol and footprint libraries and "
+                                                          "the templates to the newest %s.x release "
+                                                          "(about %s download)" ),
+                                                       release.BeforeLast( '.' ),
+                                                       formatMB( REPO_SYMBOLS.downloadMB
+                                                                 + REPO_FOOTPRINTS.downloadMB
+                                                                 + REPO_TEMPLATES.downloadMB ) ) );
+        sizer->Add( m_cbUpdate, 0, wxTOP, FromDIP( 14 ) );
+
+        wxStaticText* sourceHint = new wxStaticText(
+                this, wxID_ANY,
+                _( "Downloads come from KiCad's library repositories on GitLab "
+                   "(gitlab.com/kicad/libraries)." ) );
+        sourceHint->Wrap( wrap - indent );
+        sizer->AddSpacer( FromDIP( 4 ) );
+        sizer->Add( sourceHint, 0, wxLEFT, indent );
+
+        m_cbArchives = new wxCheckBox( this, wxID_ANY, _( "Install libraries from archive files" ) );
+        sizer->Add( m_cbArchives, 0, wxTOP, FromDIP( 14 ) );
+
+        wxStaticText* archiveHint = new wxStaticText(
+                this, wxID_ANY,
+                _( "Zip or tar.gz archives of KiCad's library repositories, or of the symbols, "
+                   "footprints, 3dmodels and template folders of a desktop KiCad.  Their libraries "
+                   "are added to the installed ones." ) );
+        archiveHint->Wrap( wrap - indent );
+        sizer->AddSpacer( FromDIP( 4 ) );
+        sizer->Add( archiveHint, 0, wxLEFT, indent );
+
+        wxBoxSizer* chooseSizer = new wxBoxSizer( wxHORIZONTAL );
+        m_btnChoose = new wxButton( this, wxID_ANY, _( "Choose Files..." ) );
+        m_stArchives = new wxStaticText( this, wxID_ANY, _( "No files chosen" ) );
+        chooseSizer->Add( m_btnChoose, 0, wxALIGN_CENTER_VERTICAL );
+        chooseSizer->Add( m_stArchives, 1, wxALIGN_CENTER_VERTICAL | wxLEFT, FromDIP( 8 ) );
+        sizer->AddSpacer( FromDIP( 6 ) );
+        sizer->Add( chooseSizer, 0, wxEXPAND | wxLEFT, indent );
+
+        wxStaticText* laterHint = new wxStaticText(
+                this, wxID_ANY,
+                _( "With nothing ticked the libraries stay as they are.  This page is also under "
+                   "Preferences > Run Setup Wizard." ) );
+        laterHint->Wrap( wrap );
+        sizer->Add( laterHint, 0, wxTOP, FromDIP( 18 ) );
+
+        SetSizer( sizer );
+
+        for( wxCheckBox* cb : { m_cb3d, m_cbUpdate, m_cbArchives } )
+            cb->Bind( wxEVT_CHECKBOX, [this]( wxCommandEvent& ) { updateEnabled(); } );
+
+        m_btnChoose->Bind( wxEVT_BUTTON, &PANEL_STARTWIZARD_LIBRARY_FILES::onChoose, this );
+
+        GetSizer()->Fit( this );
+        SetSize( GetBestSize() );
+    }
+
+    bool TransferDataToWindow() override
+    {
+        m_cb3d->SetValue( m_model->download3dModels );
+        m_cbUpdate->SetValue( m_model->updateLibraries );
+        m_cbArchives->SetValue( m_model->installArchives );
+        updateArchivesLabel();
+        updateEnabled();
+        return true;
+    }
+
+    bool TransferDataFromWindow() override
+    {
+        m_model->download3dModels = m_cb3d->GetValue();
+        m_model->updateLibraries = m_cbUpdate->GetValue();
+        m_model->installArchives = m_cbArchives->GetValue();
+
+        if( m_model->installArchives && m_model->archives.IsEmpty() )
+        {
+            wxMessageBox( _( "Choose the archive files to install, or untick \"Install libraries "
+                             "from archive files\"." ),
+                          _( "Libraries" ), wxOK | wxICON_INFORMATION, this );
+            return false;
+        }
+
+        return true;
+    }
+
+private:
+    void onChoose( wxCommandEvent& )
+    {
+        wxFileDialog dlg( this, _( "Choose Library Archives" ), wxEmptyString, wxEmptyString,
+                          _( "Library archives (*.zip;*.tar.gz;*.tgz;*.tar)|*.zip;*.tar.gz;*.tgz;*.tar|"
+                             "All files (*.*)|*.*" ),
+                          wxFD_OPEN | wxFD_FILE_MUST_EXIST | wxFD_MULTIPLE );
+
+        if( dlg.ShowModal() != wxID_OK )
+            return;
+
+        dlg.GetPaths( m_model->archives );
+        m_cbArchives->SetValue( !m_model->archives.IsEmpty() );
+        updateArchivesLabel();
+        updateEnabled();
+    }
+
+    void updateArchivesLabel()
+    {
+        wxString label;
+
+        for( const wxString& path : m_model->archives )
+            label << ( label.IsEmpty() ? wxString() : wxString( wxS( ", " ) ) ) << wxFileName( path ).GetFullName();
+
+        m_stArchives->SetLabel( label.IsEmpty() ? _( "No files chosen" ) : label );
+        Layout();
+    }
+
+    void updateEnabled()
+    {
+        m_btnChoose->Enable( m_cbArchives->GetValue() );
+
+        double needed = 0;
+
+        if( m_cb3d->GetValue() )
+            needed += REPO_3D.downloadMB + REPO_3D.installedMB;
+
+        if( m_cbUpdate->GetValue() )
+        {
+            for( const REPO_INFO* repo : { &REPO_SYMBOLS, &REPO_FOOTPRINTS, &REPO_TEMPLATES } )
+                needed += repo->downloadMB + repo->installedMB;
+        }
+
+        const double free = freeSpaceMB();
+        wxString     text;
+
+        if( needed > 0 )
+            text = wxString::Format( _( "Needs about %s while installing" ), formatMB( needed ) );
+
+        if( free >= 0 )
+            text << ( text.IsEmpty() ? wxString() : wxString( wxS( "; " ) ) )
+                 << wxString::Format( _( "%s free" ), formatMB( free ) );
+
+        m_stSpace->SetLabel( text );
+        Layout();
+    }
+
+    std::shared_ptr<STARTWIZARD_PROVIDER_LIBRARY_FILES_MODEL> m_model;
+
+    wxCheckBox*   m_cb3d;
+    wxCheckBox*   m_cbUpdate;
+    wxCheckBox*   m_cbArchives;
+    wxStaticText* m_stSpace;
+    wxButton*     m_btnChoose;
+    wxStaticText* m_stArchives;
+};
