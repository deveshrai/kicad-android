+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License along
+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef STARTWIZARD_PROVIDER_LIBRARY_FILES_H
+#define STARTWIZARD_PROVIDER_LIBRARY_FILES_H
+
+#include <memory>
+#include <vector>
+
+#include <wx/arrstr.h>
+#include <startwizard/startwizard_provider.h>
+
+
+struct STARTWIZARD_PROVIDER_LIBRARY_FILES_MODEL
+{
+    bool          download3dModels = false;   ///< The 3D models, which the app does not carry
+    bool          updateLibraries = false;    ///< Symbols, footprints and templates, newest release
+    bool          installArchives = false;
+    wxArrayString archives;
+};
+
+
+/**
+ * Library files on Android.  The app carries the symbol and footprint libraries and the templates
+ * (scripts/build-kicad-apk.sh) but not the 3D models (several GB).  This page downloads the 3D
+ * models from KiCad's library repositories on GitLab, updates the bundled libraries to the newest
+ * release there, or installs libraries from archive files.  Shown once at first start, and
+ * whenever the wizard is run from the menu.
+ */
+class STARTWIZARD_PROVIDER_LIBRARY_FILES : public STARTWIZARD_PROVIDER
+{
+public:
+    STARTWIZARD_PROVIDER_LIBRARY_FILES();
+
+    wxString Name() const override { return wxT( "library_files" ); }
+
+    bool NeedsUserInput() const override;
+
+    bool OfferOnRerun() const override { return true; }
+
+    wxPanel* GetWizardPanel( wxWindow* aParent, STARTWIZARD* aWizard ) override;
+
+    void Finish() override;
+
+    void ApplyDefaults() override;
+
+    /// The release of the installed libraries: the bundled one, or the one last downloaded
+    static wxString InstalledRelease();
+
+    /// True when the stock 3D model libraries are installed
+    static bool Models3dInstalled();
+
+    /// True when the stock symbol or footprint library table is present
+    static bool StockLibrariesInstalled();
+
+private:
+    std::shared_ptr<STARTWIZARD_PROVIDER_LIBRARY_FILES_MODEL> m_model;
+    wxWindow*                                                  m_parent = nullptr;
+};
+
+#endif // STARTWIZARD_PROVIDER_LIBRARY_FILES_H
