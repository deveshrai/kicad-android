+/**
+ * Move what was unpacked into @a aStaging into @a aRoot.  Library directories (symbols,
+ * footprints, 3dmodels, blocks) replace the installed ones whole, so libraries removed upstream
+ * go too; template files are merged, as template/ also holds the app's own base project.
+ */
+bool commitStaging( const wxString& aStaging, const wxString& aRoot, INSTALL_STATE& aState )
+{
+    bool ok = true;
+
+    for( const wxString& dir : { wxString( wxS( "symbols" ) ), wxString( wxS( "footprints" ) ),
+                                 wxString( wxS( "3dmodels" ) ), wxString( wxS( "blocks" ) ) } )
+    {
+        const wxString from = aStaging + wxS( "/" ) + dir;
+        const wxString to = aRoot + wxS( "/" ) + dir;
+        const wxString old = aRoot + wxS( "/." ) + dir + wxS( ".old" );
+
+        if( !wxFileName::DirExists( from ) )
+            continue;
+
+        if( wxFileName::DirExists( old ) )
+            wxFileName::Rmdir( old, wxPATH_RMDIR_RECURSIVE );
+
+        if( wxFileName::DirExists( to ) && !wxRenameFile( to, old ) )
+        {
+            aState.AddError( wxString::Format( _( "Could not replace '%s'." ), to ) );
+            ok = false;
+            continue;
+        }
+
+        if( !wxRenameFile( from, to ) )
+        {
+            aState.AddError( wxString::Format( _( "Could not install '%s'." ), to ) );
+            wxRenameFile( old, to );   // put the old libraries back
+            ok = false;
+            continue;
+        }
+
+        wxFileName::Rmdir( old, wxPATH_RMDIR_RECURSIVE );
+    }
+
+    // Merge template/
+    const wxString templates = aStaging + wxS( "/template" );
+
+    if( wxFileName::DirExists( templates ) )
+    {
+        wxArrayString files;
+        wxDir::GetAllFiles( templates, &files, wxEmptyString, wxDIR_FILES | wxDIR_DIRS | wxDIR_HIDDEN );
+
+        for( const wxString& file : files )
+        {
+            wxString   rel = file.Mid( aStaging.length() );
+            wxFileName dest( aRoot + rel );
+
+            wxFileName::Mkdir( dest.GetPath(), wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+
+            if( !wxRenameFile( file, dest.GetFullPath(), true ) )
+                ok = false;
+        }
+    }
+
+    wxFileName::Rmdir( aStaging, wxPATH_RMDIR_RECURSIVE );
+    return ok;
+}
