+/// Counts what an input stream has read, for the progress of an archive's extraction
+class COUNTING_STREAM : public wxFilterInputStream
+{
+public:
+    explicit COUNTING_STREAM( wxInputStream& aStream ) :
+            wxFilterInputStream( aStream )
+    {}
+
+    wxFileOffset Count() const { return m_count; }
+
+protected:
+    size_t OnSysRead( void* aBuffer, size_t aSize ) override
+    {
+        m_parent_i_stream->Read( aBuffer, aSize );
+        size_t read = m_parent_i_stream->LastRead();
+        m_count += read;
+        m_lasterror = m_parent_i_stream->GetLastError();
+        return read;
+    }
+
+private:
+    wxFileOffset m_count = 0;
+};
