+/**
+ * Extract the library archive @a aPath into @a aRoot.  Zip, tar and gzipped tar archives are
+ * told apart by their first bytes.  Progress goes from @a aStart to @a aStart + @a aSpan.
+ */
+bool extractArchive( const wxString& aPath, const wxString& aRoot, double aStart, double aSpan,
+                     INSTALL_STATE& aState )
+{
+    wxFFileInputStream file( aPath );
+
+    if( !file.IsOk() )
+    {
+        aState.AddError( wxString::Format( _( "Could not open '%s'." ), aPath ) );
+        return false;
+    }
+
+    const double size = std::max<double>( 1.0, static_cast<double>( file.GetLength() ) );
+    unsigned char magic[4] = {};
+    file.Read( magic, sizeof( magic ) );
+    file.SeekI( 0 );
+
+    COUNTING_STREAM                       counted( file );
+    std::unique_ptr<wxInputStream>        gunzip;
+    std::unique_ptr<wxArchiveInputStream> archive;
+
+    if( magic[0] == 'P' && magic[1] == 'K' )
+    {
+        archive = std::make_unique<wxZipInputStream>( counted );
+    }
+    else if( magic[0] == 0x1f && magic[1] == 0x8b )
+    {
+        gunzip = std::make_unique<wxZlibInputStream>( counted, wxZLIB_GZIP );
+        archive = std::make_unique<wxTarInputStream>( *gunzip );
+    }
+    else
+    {
+        archive = std::make_unique<wxTarInputStream>( counted );
+    }
+
+    const wxString name = wxFileName( aPath ).GetFullName();
+    size_t         written = 0;
+    bool           ok = true;
+
+    while( std::unique_ptr<wxArchiveEntry> entry{ archive->GetNextEntry() } )
+    {
+        if( aState.cancel )
+            return false;
+
+        aState.fraction = aStart + aSpan * std::min( 1.0, counted.Count() / size );
+
+        if( entry->IsDir() )
+            continue;
+
+        if( wxTarEntry* tar = dynamic_cast<wxTarEntry*>( entry.get() ) )
+        {
+            if( tar->GetTypeFlag() != wxTAR_REGTYPE && tar->GetTypeFlag() != '\0' )
+                continue;   // links, devices, ...
+        }
+
+        wxString category;
+        wxString rel = mapEntry( entry->GetName( wxPATH_UNIX ), category );
+
+        if( rel.IsEmpty() )
+            continue;
+
+        wxFileName dest( aRoot + wxS( "/" ) + rel );
+
+        if( !wxFileName::Mkdir( dest.GetPath(), wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL )
+            && !wxFileName::DirExists( dest.GetPath() ) )
+        {
+            aState.AddError( wxString::Format( _( "Could not create '%s'." ), dest.GetPath() ) );
+            return false;
+        }
+
+        if( category == wxS( "tables" ) )
+        {
+            std::string content;
+            char        buf[16384];
+
+            while( archive->Read( buf, sizeof( buf ) ).LastRead() > 0 )
+                content.append( buf, archive->LastRead() );
+
+            if( !isStockTable( dest.GetFullName(), content ) )
+                continue;
+
+            std::ofstream out( dest.GetFullPath().fn_str(), std::ios::binary | std::ios::trunc );
+            out << content;
+            ok &= out.good();
+        }
+        else
+        {
+            wxFFileOutputStream out( dest.GetFullPath() );
+
+            if( !out.IsOk() )
+            {
+                aState.AddError( wxString::Format( _( "Could not write '%s'." ), dest.GetFullPath() ) );
+                return false;
+            }
+
+            out.Write( *archive );
+            ok &= out.Close();
+
+            wxArrayString relParts = wxStringTokenize( rel, wxS( "/" ) );
+
+            if( relParts.size() >= 2 )
+                aState.libraries[category].insert( relParts[1] );
+        }
+
+        if( ( ++written % 200 ) == 0 )
+            aState.SetStatus( wxString::Format( _( "Installing from %s: %zu files" ), name, written ) );
+    }
+
+    {
+        std::lock_guard<std::mutex> lock( aState.mutex );
+        aState.files += written;
+    }
+
+    if( !ok )
+        aState.AddError( wxString::Format( _( "Some files from '%s' could not be written." ), name ) );
+
+    if( written == 0 )
+        aState.AddError( wxString::Format( _( "'%s' holds no KiCad libraries." ), name ) );
+
+    return ok && written > 0;
+}
