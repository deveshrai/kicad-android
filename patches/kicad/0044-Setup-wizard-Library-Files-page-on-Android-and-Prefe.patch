+bool downloadFile( const wxString& aUrl, const wxString& aDest, double aApproxBytes,
+                   double aStart, double aSpan, INSTALL_STATE& aState )
+{
+    std::ofstream out( aDest.fn_str(), std::ios::binary | std::ios::trunc );
+
+    if( !out.good() )
+    {
+        aState.AddError( wxString::Format( _( "Could not write '%s'." ), aDest ) );
+        return false;
+    }
+
+    const wxString name = wxFileName( aUrl ).GetFullName();
+
+    KICAD_CURL_EASY curl;
+    curl.SetURL( aUrl.ToStdString() );
+    curl.SetFollowRedirects( true );
+    curl.SetOutputStream( &out );
+    curl.SetTransferCallback(
+            [&]( size_t aTotal, size_t aNow, size_t, size_t ) -> int
+            {
+                // GitLab makes the archives on the fly and often sends no length
+                const double total = aTotal > 0 ? static_cast<double>( aTotal ) : aApproxBytes;
+
+                aState.fraction = aStart + aSpan * std::min( 1.0, aNow / std::max( 1.0, total ) );
+                aState.SetStatus( wxString::Format( _( "Downloading %s: %s of about %s" ), name,
+                                                    formatMB( aNow / 1048576.0 ),
+                                                    formatMB( total / 1048576.0 ) ) );
+                return aState.cancel ? 1 : 0;
+            },
+            250000 );
+
+    const int code = curl.Perform();
+    out.close();
+
+    if( aState.cancel )
+        return false;
+
+    if( code != CURLE_OK )
+    {
+        aState.AddError( wxString::Format( _( "Could not download %s: %s" ), aUrl,
+                                           curl.GetErrorText( code ) ) );
+        return false;
+    }
+
+    if( int status = curl.GetResponseStatusCode(); status != 200 )
+    {
+        aState.AddError( wxString::Format( _( "Could not download %s (HTTP %d)." ), aUrl, status ) );
+        return false;
+    }
+
+    return true;
+}
