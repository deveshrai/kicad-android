+/**
+ * Where an archive entry goes under the stock library directory, or an empty string to leave
+ * it out.  Archives are taken apart by their content, so the GitLab archives of KiCad's library
+ * repositories, release tarballs, and zips of a desktop KiCad's symbols, footprints, 3dmodels
+ * and template folders all work:
+ *   *.kicad_symdir/ and *.kicad_sym  -> symbols/
+ *   *.pretty/                        -> footprints/
+ *   *.3dshapes/                      -> 3dmodels/
+ *   *.kicad_blocks/                  -> blocks/
+ *   Projects/<name>/ and template/<name>/, *.kicad_wks, the stock library tables -> template/
+ *
+ * @param aCategory receives the top directory the entry goes to
+ */
+wxString mapEntry( const wxString& aName, wxString& aCategory )
+{
+    wxArrayString parts = wxStringTokenize( aName, wxS( "/\\" ), wxTOKEN_STRTOK );
+
+    if( parts.IsEmpty() )
+        return wxEmptyString;
+
+    for( const wxString& part : parts )
+    {
+        if( part == wxS( ".." ) || part.StartsWith( wxS( "." ) ) )
+            return wxEmptyString;   // no escaping the target, and no .git, .github, ...
+    }
+
+    const auto join =
+            [&]( size_t aFrom )
+            {
+                wxString rel;
+
+                for( size_t i = aFrom; i < parts.size(); ++i )
+                    rel << ( rel.IsEmpty() ? wxString() : wxString( wxS( "/" ) ) ) << parts[i];
+
+                return rel;
+            };
+
+    int libIndex = -1;
+    int templateIndex = -1;
+
+    for( size_t i = 0; i + 1 < parts.size(); ++i )
+    {
+        const wxString& part = parts[i];
+
+        if( libIndex < 0
+            && ( part.EndsWith( wxS( ".pretty" ) ) || part.EndsWith( wxS( ".3dshapes" ) )
+                 || part.EndsWith( wxS( ".kicad_symdir" ) ) || part.EndsWith( wxS( ".kicad_blocks" ) ) ) )
+        {
+            libIndex = static_cast<int>( i );
+        }
+
+        if( templateIndex < 0 && ( part == wxS( "Projects" ) || part == wxS( "template" ) ) )
+            templateIndex = static_cast<int>( i );
+    }
+
+    // A project template can hold a footprint library of its own: it stays with the template
+    if( templateIndex >= 0 && ( libIndex < 0 || templateIndex < libIndex )
+        && templateIndex + 2 < static_cast<int>( parts.size() ) )
+    {
+        aCategory = wxS( "template" );
+        return wxS( "template/" ) + join( templateIndex + 1 );
+    }
+
+    if( libIndex >= 0 )
+    {
+        const wxString& lib = parts[libIndex];
+
+        if( lib.EndsWith( wxS( ".pretty" ) ) )
+            aCategory = wxS( "footprints" );
+        else if( lib.EndsWith( wxS( ".3dshapes" ) ) )
+            aCategory = wxS( "3dmodels" );
+        else if( lib.EndsWith( wxS( ".kicad_symdir" ) ) )
+            aCategory = wxS( "symbols" );
+        else
+            aCategory = wxS( "blocks" );
+
+        return aCategory + wxS( "/" ) + join( libIndex );
+    }
+
+    const wxString& file = parts.Last();
+
+    if( file.EndsWith( wxS( ".kicad_sym" ) ) )
+    {
+        aCategory = wxS( "symbols" );
+        return wxS( "symbols/" ) + file;
+    }
+
+    if( file.EndsWith( wxS( ".kicad_wks" ) ) )
+    {
+        aCategory = wxS( "template" );
+        return wxS( "template/" ) + file;
+    }
+
+    // The stock tables go where LIBRARY_MANAGER::StockTablePath() looks; their content is
+    // checked when they are written (see isStockTable())
+    if( file == wxS( "sym-lib-table" ) || file == wxS( "fp-lib-table" )
+        || file == wxS( "design-block-lib-table" ) )
+    {
+        aCategory = wxS( "tables" );
+        return wxS( "template/" ) + file;
+    }
+
+    // A desktop template folder's base project
+    if( templateIndex >= 0 && file == wxS( "kicad.kicad_pro" ) )
+    {
+        aCategory = wxS( "template" );
+        return wxS( "template/" ) + file;
+    }
+
+    return wxEmptyString;
+}
