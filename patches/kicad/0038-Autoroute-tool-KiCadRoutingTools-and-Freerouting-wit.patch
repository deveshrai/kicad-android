+
+void AUTOROUTE_JOB::readLog( const wxString& aPath )
+{
+    wxFFile f;
+
+    if( !wxFileExists( aPath ) || !f.Open( aPath, wxS( "rb" ) ) )
+        return;
+
+    wxFileOffset length = f.Length();
+
+    if( length <= m_logOffset )
+        return;
+
+    f.Seek( m_logOffset );
+
+    std::string buf( (size_t) ( length - m_logOffset ), '\0' );
+    size_t      n = f.Read( buf.data(), buf.size() );
+    buf.resize( n );
+    m_logOffset += (long) n;
+
+    wxString text = m_logPartial + wxString::FromUTF8( buf );
+    m_logPartial.clear();
+
+    wxStringTokenizer lines( text, wxS( "\n" ), wxTOKEN_RET_EMPTY_ALL );
+
+    while( lines.HasMoreTokens() )
+    {
+        wxString line = lines.GetNextToken();
+
+        if( !lines.HasMoreTokens() && !text.EndsWith( wxS( "\n" ) ) )
+        {
+            m_logPartial = line;   // incomplete; finish it on the next read
+            break;
+        }
+
+        line.Replace( wxS( "\r" ), wxEmptyString );
+        parseLine( line );
+        m_log.push_back( line );
+
+        while( m_log.size() > MAX_LOG_LINES )
+            m_log.pop_front();
+    }
+}
+
+
+void AUTOROUTE_JOB::parseLine( const wxString& aLine )
+{
+    // "[17/57 (5 failed)] Routing /GPIO22 (id=50)"  or  "[1/46] Routing /L_LED (id=47)"
+    static wxRegEx netLine( wxS( "^\\[([0-9]+)/([0-9]+)( \\(([0-9]+) failed\\))?\\] Routing (.+) "
+                                 "\\(id=[0-9]+\\)" ),
+                            wxRE_ADVANCED );
+    static wxRegEx summary( wxS( "^JSON_SUMMARY(_MIN)?: (\\{.*\\})\\s*$" ), wxRE_ADVANCED );
+
+    if( netLine.Matches( aLine ) )
+    {
+        long index = 0, total = 0, failed = 0;
+        netLine.GetMatch( aLine, 1 ).ToLong( &index );
+        netLine.GetMatch( aLine, 2 ).ToLong( &total );
+        netLine.GetMatch( aLine, 4 ).ToLong( &failed );
+
+        // The router makes several passes (first routes, then rip-up and reroute rounds); a
+        // new pass starts its count again.
+        if( total != m_progress.total || index - 1 < m_progress.done )
+            m_progress.pass++;
+
+        m_progress.done = (int) index - 1;
+        m_progress.total = (int) total;
+        m_progress.failed = (int) failed;
+        m_progress.net = netLine.GetMatch( aLine, 5 );
+
+        if( m_state == STATE::RUNNING )
+        {
+            m_progress.stage = m_progress.pass <= 1
+                                       ? m_steps[m_step].title
+                                       : wxString::Format( _( "%s: rerouting the nets that did "
+                                                              "not fit (round %d)" ),
+                                                           m_steps[m_step].title,
+                                                           m_progress.pass - 1 );
+        }
+
+        return;
+    }
+
+    if( summary.Matches( aLine ) )
+    {
+        json j = json::parse( summary.GetMatch( aLine, 2 ).ToStdString(), nullptr, false );
+
+        if( !j.is_object() )
+            return;
+
+        STEP& step = m_steps[m_step];
+
+        if( j.contains( "routed" ) && j["routed"].is_number() )
+        {
+            int routed = j.value( "routed", 0 );
+            int failed = j.value( "failed", 0 );
+
+            m_progress.vias = j.value( "vias", m_progress.vias );
+            m_progress.failed = failed;
+            step.detail = wxString::Format( _( "%d net(s) routed, %d failed" ), routed, failed );
+        }
+        else if( j.contains( "escaped" ) )
+        {
+            step.detail = wxString::Format( _( "%d of %d pins escaped" ), j.value( "escaped", 0 ),
+                                            j.value( "requested", 0 ) );
+        }
+    }
+}
+
+
+json AUTOROUTE_JOB::StatusJson() const
+{
+    json steps = json::array();
+
+    for( const STEP& step : m_steps )
+    {
+        const char* state = step.state == STEP_STATE::PENDING   ? "pending"
+                          : step.state == STEP_STATE::RUNNING   ? "running"
+                          : step.state == STEP_STATE::DONE      ? "done"
+                          : step.state == STEP_STATE::FAILED    ? "failed"
+                                                                : "skipped";
+
+        steps.push_back( { { "title", step.title.ToStdString() },
+                           { "state", state },
+                           { "detail", step.detail.ToStdString() } } );
+    }
+
+    json out = { { "state", StateName( m_state ).ToStdString() },
+                 { "router", RouterName( m_settings.router ).ToStdString() },
+                 { "stage", m_progress.stage.ToStdString() },
+                 { "steps", steps },
+                 { "elapsed_s", m_progress.elapsedMs / 1000.0 },
+                 { "board_changed", m_pushed } };
+
+    if( !m_progress.net.IsEmpty() )
+        out["net"] = m_progress.net.ToStdString();
+
+    if( m_progress.total > 0 )
+    {
+        out["done"] = m_progress.done;
+        out["total"] = m_progress.total;
+    }
+
+    if( m_progress.pass > 0 )
+        out["pass"] = m_progress.pass;
+
+    if( m_progress.failed >= 0 )
+        out["failed"] = m_progress.failed;
+
+    if( m_progress.vias >= 0 )
+        out["vias"] = m_progress.vias;
+
+    if( !m_error.IsEmpty() )
+        out["error"] = m_error.ToStdString();
+
+    if( !IsActive() && m_state != STATE::IDLE )
+    {
+        out["open_nets"] = toJson( m_openNets );
+        out["summary"] = m_summary.ToStdString();
+    }
+
+    json log = json::array();
+    size_t first = m_log.size() > 20 ? m_log.size() - 20 : 0;
+
+    for( size_t i = first; i < m_log.size(); i++ )
+        log.push_back( m_log[i].ToStdString() );
+
+    out["log_tail"] = log;
+    return out;
+}
