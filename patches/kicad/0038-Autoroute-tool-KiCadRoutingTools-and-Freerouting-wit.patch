+#ifndef KIPLATFORM_ROUTER_PROCESS_H_
+#define KIPLATFORM_ROUTER_PROCESS_H_
+
+#include <functional>
+#include <vector>
+
+#include <wx/string.h>
+
+namespace KIPLATFORM
+{
+/**
+ * Runs Python programs (the steps of KiCadRoutingTools) in a process of their own, with the
+ * Python runtime the app bundles.  One step runs at a time.
+ *
+ * A step has a work directory: the process writes "pid" there when it starts and "exit" (its
+ * exit code) when it ends, and its output goes to a log file the caller names.
+ */
+namespace ROUTER_PROCESS
+{
+
+/// True if this build bundles the Python runtime and the router.
+bool IsAvailable();
+
+/**
+ * Make sure the bundled runtime is unpacked (the first use after an install or update unpacks
+ * about 150 MB, which takes a while).  Blocks; call it from a worker thread.
+ *
+ * @param aProgress is called with (files done, files in all) while unpacking; may be empty.
+ * @param aRoot receives the runtime's directory: home/ (Python's standard library), site/
+ *              (numpy, scipy, shapely) and krt/ (KiCadRoutingTools).
+ */
+bool PrepareRuntime( const std::function<void( int, int )>& aProgress, wxString& aRoot,
+                     wxString& aError );
+
+/// True if the runtime is unpacked and current, so PrepareRuntime() would return at once.
+bool IsRuntimeReady();
+
+struct STEP
+{
+    wxString              workDir;   ///< Must exist; "pid" and "exit" are written here.
+    wxString              logPath;
+    wxString              title;     ///< Shown in the notification while the step runs.
+    std::vector<wxString> args;      ///< Program and arguments, without the interpreter.
+    std::vector<wxString> env;       ///< Extra environment, "NAME=value".
+};
+
+/// Starts @a aStep; the runtime must be prepared.  Returns false with @a aError if it cannot.
+bool Start( const STEP& aStep, wxString& aError );
+
+enum class STATE
+{
+    STARTING,   ///< Started, the process has not reported its pid yet.
+    RUNNING,
+    PAUSED,
+    EXITED      ///< See ExitCode().
+};
+
+STATE GetState( const wxString& aWorkDir );
+
+/// The exit code of a step that has ended; -9 when it was killed or its process died.
+int ExitCode( const wxString& aWorkDir );
+
+bool Pause( const wxString& aWorkDir );
+bool Resume( const wxString& aWorkDir );
+
+/// Ends the step at once.  Its exit code becomes -9.
+void Kill( const wxString& aWorkDir );
+
+} // namespace ROUTER_PROCESS
+} // namespace KIPLATFORM
+
+#endif // KIPLATFORM_ROUTER_PROCESS_H_
diff --git a/libs/kiplatform/os/android/autorouter.cpp b/libs/kiplatform/os/android/autorouter.cpp
index 4c4ac3e9..32238f54 100644
--- a/libs/kiplatform/os/android/autorouter.cpp
+++ b/libs/kiplatform/os/android/autorouter.cpp
@@ -157,6 +157,64 @@ bool Start( const wxString& aDsnPath, const wxString& aSesPath, int aMaxPasses,
 }
 
 
+void SetOptions( const OPTIONS& aOptions )
+{
+    if( !IsAvailable() )
+        return;
+
+    QJniEnvironment env;
+    jclass          stringClass = env->FindClass( "java/lang/String" );
+
+    auto toArray =
+            [&]( const std::vector<wxString>& aItems )
+            {
+                jobjectArray array = env->NewObjectArray( (jsize) aItems.size(), stringClass,
+                                                          nullptr );
+
+                for( size_t i = 0; i < aItems.size(); i++ )
+                {
+                    QJniObject s = QJniObject::fromString(
+                            QString::fromUtf8( aItems[i].utf8_string().c_str() ) );
+                    env->SetObjectArrayElement( array, (jsize) i, s.object<jstring>() );
+                }
+
+                return array;
+            };
+
+    jobjectArray nets = toArray( aOptions.onlyNets );
+    jobjectArray layers = toArray( aOptions.inactiveLayers );
+
+    QJniObject::callStaticMethod<void>( g_class, "setOptions",
+                                        "([Ljava/lang/String;[Ljava/lang/String;ZIII)V", nets,
+                                        layers, (jboolean) aOptions.route, (jint) aOptions.fanout,
+                                        (jint) aOptions.optimizerPasses,
+                                        (jint) aOptions.viaCost );
+    env->DeleteLocalRef( nets );
+    env->DeleteLocalRef( layers );
+    env.checkAndClearExceptions();
+}
+
+
+void Pause()
+{
+    if( IsAvailable() )
+        call<void>( "pause", "()V" );
+}
+
+
+void Resume()
+{
+    if( IsAvailable() )
+        call<void>( "resume", "()V" );
+}
+
+
+bool IsPaused()
+{
+    return IsAvailable() && call<jboolean>( "isPaused", "()Z" );
+}
+
+
 void StopRouting()
 {
     if( IsAvailable() )
diff --git a/libs/kiplatform/os/android/router_process.cpp b/libs/kiplatform/os/android/router_process.cpp
new file mode 100644
index 00000000..70d1237a
--- /dev/null
+++ b/libs/kiplatform/os/android/router_process.cpp
@@ -0,0 +1,434 @@
+/*
+ * This program source code file is part of KiCad, a free EDA CAD application.
+ *
+ * Copyright The KiCad Developers, see AUTHORS.txt for contributors.
+ *
+ * This program is free software: you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or (at your
+ * option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// The app bundles python.org's Python for Android with numpy, scipy and shapely, and
+// KiCadRoutingTools (scripts/build-python-android.sh).  The Python files are an asset tree,
+// unpacked on first use; the native side (libpython and libkrtrunner) is in the APK's jniLibs and
+// is loaded only by io.github.deveshrai.kicadandroid.RouterService, which runs in a process of
+// its own (":router").  This file starts that service and signals its process.
+
+#include <kiplatform/router_process.h>
+
+#include <wx/dir.h>
+#include <wx/ffile.h>
+#include <wx/filefn.h>
+#include <wx/filename.h>
+
+#include <QCoreApplication>
+#include <QJniEnvironment>
+#include <QJniObject>
+
+#include <android/asset_manager.h>
+#include <android/asset_manager_jni.h>
+#include <android/log.h>
+
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <string>
+
+namespace
+{
+const char* const TREE = "python-router";
+const char* const CONTROL_CLASS = "io.github.deveshrai.kicadandroid.RouterControl";
+
+std::mutex         g_lock;
+std::set<wxString> g_paused;     ///< Work directories whose process is stopped.
+std::set<wxString> g_killed;
+
+
+QString qstr( const wxString& aText )
+{
+    return QString::fromUtf8( aText.utf8_string().c_str() );
+}
+
+
+wxString filesDir()
+{
+    QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+
+    if( !ctx.isValid() )
+        return wxEmptyString;
+
+    QJniObject dir = ctx.callObjectMethod( "getFilesDir", "()Ljava/io/File;" );
+    QString    path = dir.callObjectMethod( "getAbsolutePath", "()Ljava/lang/String;" ).toString();
+    return wxString::FromUTF8( path.toUtf8().constData() );
+}
+
+
+AAssetManager* assetManager()
+{
+    QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+
+    if( !ctx.isValid() )
+        return nullptr;
+
+    QJniObject      assets = ctx.callObjectMethod( "getAssets",
+                                                   "()Landroid/content/res/AssetManager;" );
+    QJniEnvironment env;
+    return AAssetManager_fromJava( env.jniEnv(), assets.object() );
+}
+
+
+std::string readAsset( AAssetManager* aMgr, const std::string& aAsset )
+{
+    std::string text;
+
+    if( AAsset* asset = AAssetManager_open( aMgr, aAsset.c_str(), AASSET_MODE_BUFFER ) )
+    {
+        text.assign( static_cast<const char*>( AAsset_getBuffer( asset ) ),
+                     AAsset_getLength( asset ) );
+        AAsset_close( asset );
+    }
+
+    return text;
+}
+
+
+bool copyAsset( AAssetManager* aMgr, const std::string& aAsset, const std::string& aDest )
+{
+    AAsset* asset = AAssetManager_open( aMgr, aAsset.c_str(), AASSET_MODE_STREAMING );
+
+    if( !asset )
+        return false;
+
+    wxFileName::Mkdir( wxFileName( wxString::FromUTF8( aDest ) ).GetPath(), wxS_DIR_DEFAULT,
+                       wxPATH_MKDIR_FULL );
+
+    bool  ok = false;
+    FILE* out = fopen( aDest.c_str(), "wb" );
+
+    if( out )
+    {
+        char buf[65536];
+        int  n = 0;
+        ok = true;
+
+        while( ( n = AAsset_read( asset, buf, sizeof( buf ) ) ) > 0 )
+            ok &= fwrite( buf, 1, n, out ) == static_cast<size_t>( n );
+
+        ok &= fclose( out ) == 0 && n == 0;
+    }
+
+    AAsset_close( asset );
+    return ok;
+}
+
+
+wxString readText( const wxString& aPath )
+{
+    wxString text;
+    wxFFile  f;
+
+    if( wxFileExists( aPath ) && f.Open( aPath, wxS( "rb" ) ) )
+        f.ReadAll( &text );
+
+    return text.Trim().Trim( false );
+}
+
+
+int pidOf( const wxString& aWorkDir )
+{
+    long pid = 0;
+
+    if( !readText( aWorkDir + wxS( "/pid" ) ).ToLong( &pid ) )
+        return 0;
+
+    return (int) pid;
+}
+
+
+/// True if @a aPid is still one of our router processes (not a reused pid).
+bool alive( int aPid )
+{
+    if( aPid <= 0 )
+        return false;
+
+    // /proc files report a length of 0, so read them until EOF rather than by their size.
+    std::string path = "/proc/" + std::to_string( aPid ) + "/cmdline";
+    FILE*       f = fopen( path.c_str(), "rb" );
+
+    if( !f )
+        return false;
+
+    char   buf[256] = {};
+    size_t n = fread( buf, 1, sizeof( buf ) - 1, f );
+    fclose( f );
+
+    return std::string( buf, n ).find( ":router" ) != std::string::npos;
+}
+
+
+void signal( const char* aMethod, int aPid )
+{
+    QJniObject::callStaticMethod<void>( CONTROL_CLASS, aMethod, "(I)V", (jint) aPid );
+    QJniEnvironment env;
+    env.checkAndClearExceptions();
+}
+} // namespace
+
+
+namespace KIPLATFORM
+{
+namespace ROUTER_PROCESS
+{
+
+bool IsAvailable()
+{
+    static const bool available =
+            []()
+            {
+                AAssetManager* mgr = assetManager();
+                return mgr && !readAsset( mgr, std::string( TREE ) + "/VERSION" ).empty();
+            }();
+
+    return available;
+}
+
+
+bool IsRuntimeReady()
+{
+    AAssetManager* mgr = assetManager();
+    wxString       root = filesDir() + wxS( "/" ) + TREE;
+
+    if( !mgr || root.IsEmpty() )
+        return false;
+
+    std::string version = readAsset( mgr, std::string( TREE ) + "/VERSION" );
+    return !version.empty()
+           && readText( root + wxS( "/.extracted" ) ) == wxString::FromUTF8( version ).Trim();
+}
+
+
+bool PrepareRuntime( const std::function<void( int, int )>& aProgress, wxString& aRoot,
+                     wxString& aError )
+{
+    AAssetManager* mgr = assetManager();
+    wxString       files = filesDir();
+
+    if( !mgr || files.IsEmpty() )
+    {
+        aError = wxS( "The app's storage is not available." );
+        return false;
+    }
+
+    aRoot = files + wxS( "/" ) + TREE;
+
+    if( IsRuntimeReady() )
+        return true;
+
+    std::string version = readAsset( mgr, std::string( TREE ) + "/VERSION" );
+
+    if( version.empty() )
+    {
+        aError = wxS( "This build does not include the router." );
+        return false;
+    }
+
+    __android_log_print( ANDROID_LOG_INFO, "KiCad", "unpacking %s (%s)", TREE, version.c_str() );
+
+    // A new version replaces the old tree entirely, so no stale module survives an update.
+    if( wxDirExists( aRoot ) )
+        wxFileName::Rmdir( aRoot, wxPATH_RMDIR_RECURSIVE );
+
+    std::vector<std::string> list;
+    std::istringstream       lines( readAsset( mgr, std::string( TREE ) + "/FILES.txt" ) );
+    std::string              rel;
+
+    while( std::getline( lines, rel ) )
+    {
+        if( !rel.empty() )
+            list.push_back( rel );
+    }
+
+    const std::string root = aRoot.utf8_string();
+    int               done = 0;
+
+    for( const std::string& file : list )
+    {
+        if( !copyAsset( mgr, std::string( TREE ) + "/" + file + ".kad", root + "/" + file ) )
+        {
+            aError = wxString::Format( wxS( "Could not unpack %s (is the device out of space?)" ),
+                                       wxString::FromUTF8( file ) );
+            return false;
+        }
+
+        if( aProgress && ( ++done % 25 == 0 || done == (int) list.size() ) )
+            aProgress( done, (int) list.size() );
+    }
+
+    wxFFile stamp( aRoot + wxS( "/.extracted" ), wxS( "wb" ) );
+    stamp.Write( wxString::FromUTF8( version ) );
+    return true;
+}
+
+
+bool Start( const STEP& aStep, wxString& aError )
+{
+    for( const wxChar* name : { wxS( "pid" ), wxS( "exit" ), wxS( "error" ) } )
+    {
+        wxString path = aStep.workDir + wxS( "/" ) + name;
+
+        if( wxFileExists( path ) )
+            wxRemoveFile( path );
+    }
+
+    {
+        std::lock_guard<std::mutex> lock( g_lock );
+        g_paused.erase( aStep.workDir );
+        g_killed.erase( aStep.workDir );
+    }
+
+    QJniEnvironment env;
+    jclass          stringClass = env->FindClass( "java/lang/String" );
+
+    auto toArray =
+            [&]( const std::vector<wxString>& aItems )
+            {
+                jobjectArray array = env->NewObjectArray( (jsize) aItems.size(), stringClass,
+                                                          nullptr );
+
+                for( size_t i = 0; i < aItems.size(); i++ )
+                {
+                    QJniObject s = QJniObject::fromString( qstr( aItems[i] ) );
+                    env->SetObjectArrayElement( array, (jsize) i, s.object<jstring>() );
+                }
+
+                return array;
+            };
+
+    // The interpreter's own first argument; Py_BytesMain reads argv[0] as the program name.
+    std::vector<wxString> argv = { wxS( "python3" ) };
+    argv.insert( argv.end(), aStep.args.begin(), aStep.args.end() );
+
+    jobjectArray jargv = toArray( argv );
+    jobjectArray jenv = toArray( aStep.env );
+    QJniObject   ctx = QNativeInterface::QAndroidApplication::context();
+
+    QJniObject result = QJniObject::callStaticObjectMethod(
+            CONTROL_CLASS, "start",
+            "(Landroid/content/Context;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;"
+            "[Ljava/lang/String;[Ljava/lang/String;)Ljava/lang/String;",
+            ctx.object(), QJniObject::fromString( qstr( aStep.workDir ) ).object<jstring>(),
+            QJniObject::fromString( qstr( aStep.logPath ) ).object<jstring>(),
+            QJniObject::fromString( qstr( aStep.title ) ).object<jstring>(), jargv, jenv );
+
+    env->DeleteLocalRef( jargv );
+    env->DeleteLocalRef( jenv );
+
+    if( env.checkAndClearExceptions() )
+    {
+        aError = wxS( "The router process could not be started." );
+        return false;
+    }
+
+    wxString why = wxString::FromUTF8( result.toString().toUtf8().constData() );
+
+    if( !why.IsEmpty() )
+    {
+        aError = why;
+        return false;
+    }
+
+    return true;
+}
+
+
+STATE GetState( const wxString& aWorkDir )
+{
+    if( wxFileExists( aWorkDir + wxS( "/exit" ) ) )
+        return STATE::EXITED;
+
+    int pid = pidOf( aWorkDir );
+
+    {
+        std::lock_guard<std::mutex> lock( g_lock );
+
+        if( g_killed.count( aWorkDir ) )
+            return STATE::EXITED;
+
+        if( pid == 0 )
+            return STATE::STARTING;
+
+        if( !alive( pid ) )
+        {
+            // The process died without writing its exit code (out of memory, or killed by the
+            // system); record that, so the step reads as ended.
+            g_killed.insert( aWorkDir );
+            return STATE::EXITED;
+        }
+
+        return g_paused.count( aWorkDir ) ? STATE::PAUSED : STATE::RUNNING;
+    }
+}
+
+
+int ExitCode( const wxString& aWorkDir )
+{
+    long code = -9;
+
+    if( !readText( aWorkDir + wxS( "/exit" ) ).ToLong( &code ) )
+        return -9;
+
+    return (int) code;
+}
+
+
+bool Pause( const wxString& aWorkDir )
+{
+    int pid = pidOf( aWorkDir );
+
+    if( !alive( pid ) )
+        return false;
+
+    signal( "pause", pid );
+    std::lock_guard<std::mutex> lock( g_lock );
+    g_paused.insert( aWorkDir );
+    return true;
+}
+
+
+bool Resume( const wxString& aWorkDir )
+{
+    int pid = pidOf( aWorkDir );
+
+    if( !alive( pid ) )
+        return false;
+
+    signal( "resume", pid );
+    std::lock_guard<std::mutex> lock( g_lock );
+    g_paused.erase( aWorkDir );
+    return true;
+}
+
+
+void Kill( const wxString& aWorkDir )
+{
+    int pid = pidOf( aWorkDir );
+
+    if( alive( pid ) )
+        signal( "kill", pid );
+
+    std::lock_guard<std::mutex> lock( g_lock );
+    g_paused.erase( aWorkDir );
+    g_killed.insert( aWorkDir );
+}
+
+} // namespace ROUTER_PROCESS
+} // namespace KIPLATFORM
