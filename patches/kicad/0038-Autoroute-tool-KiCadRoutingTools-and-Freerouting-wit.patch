+    KIGFX::VIEW*             view = m_frame->GetCanvas()->GetView();
+    KIGFX::RENDER_SETTINGS*  rs = view->GetPainter()->GetSettings();
+
+    rs->SetHighlight( true, net->GetNetCode() );
