+// ---------------------------------------------------------------------------------------------
+// Settings <-> JSON (the MCP tool's arguments)
+
+static const std::pair<AR_ROUTER, const char*> ROUTER_NAMES[] = {
+    { AR_ROUTER::KRT, "kicadroutingtools" }, { AR_ROUTER::FREEROUTING, "freerouting" }
+};
+static const std::pair<AR_TASK, const char*> TASK_NAMES[] = {
+    { AR_TASK::ROUTE, "route" }, { AR_TASK::FANOUT, "fanout" },
+    { AR_TASK::PLANES, "planes" }, { AR_TASK::OPTIMIZE, "optimize" }
+};
+static const std::pair<AR_RULES, const char*> RULES_NAMES[] = {
+    { AR_RULES::EXACT, "exact" }, { AR_RULES::BOARD, "board" }, { AR_RULES::FAB, "fab" }
+};
+
+
+template <typename E, size_t N>
+static const char* nameOf( const std::pair<E, const char*> ( &aTable )[N], E aValue )
+{
+    for( const auto& [value, name] : aTable )
+    {
+        if( value == aValue )
+            return name;
+    }
+
+    return "";
+}
+
+
+template <typename E, size_t N>
+static bool valueOf( const std::pair<E, const char*> ( &aTable )[N], const std::string& aName,
+                     E& aValue )
+{
+    for( const auto& [value, name] : aTable )
+    {
+        if( aName == name )
+        {
+            aValue = value;
+            return true;
+        }
+    }
+
+    return false;
+}
+
+
+static json toJson( const std::vector<wxString>& aList )
+{
+    json out = json::array();
+
+    for( const wxString& s : aList )
+        out.push_back( s.ToStdString() );
+
+    return out;
+}
+
+
+static std::vector<wxString> fromJson( const json& aList )
+{
+    std::vector<wxString> out;
+
+    if( aList.is_array() )
+    {
+        for( const json& s : aList )
+        {
+            if( s.is_string() )
+                out.push_back( wxString::FromUTF8( s.get<std::string>() ) );
+        }
+    }
+
+    return out;
+}
+
+
+json AUTOROUTE_SETTINGS::ToJson() const
+{
+    json planesJson = json::array();
+
+    for( const AR_PLANE& p : planes )
+        planesJson.push_back( { { "net", p.net.ToStdString() }, { "layer", p.layer.ToStdString() } } );
+
+    return { { "router", nameOf( ROUTER_NAMES, router ) },
+             { "task", nameOf( TASK_NAMES, task ) },
+             { "nets", allNets ? json( "all" ) : toJson( nets ) },
+             { "bus", bus },
+             { "between_parts", toJson( betweenParts ) },
+             { "layers", layers.empty() ? json( "all" ) : toJson( layers ) },
+             { "planes_first", planesFirst },
+             { "fanout_first", fanoutFirst },
+             { "fanout_parts", toJson( fanoutParts ) },
+             { "fanout_width_mm", fanoutWidthMm },
+             { "planes", planesJson },
+             { "optimize_nets", optimizeAll ? json( "all" ) : toJson( optimizeNets ) },
+             { "rules", nameOf( RULES_NAMES, rules ) },
+             { "grid_mm", gridMm },
+             { "via_cost", viaCost },
+             { "optimizer_passes", optimizerPasses },
+             { "optimize_after", optimizeAfter },
+             { "freerouting_fanout", freeroutingFanout },
+             { "refill_zones", refillZones },
+             { "rip_other_nets", ripOtherNets } };
+}
+
+
+bool AUTOROUTE_SETTINGS::FromJson( const json& aJson, wxString& aError )
+{
+    if( !aJson.is_object() )
+        return true;
+
+    if( aJson.contains( "router" )
+        && !valueOf( ROUTER_NAMES, aJson.value( "router", std::string() ), router ) )
+    {
+        aError = wxS( "router must be \"kicadroutingtools\" or \"freerouting\"" );
+        return false;
+    }
+
+    if( aJson.contains( "task" )
+        && !valueOf( TASK_NAMES, aJson.value( "task", std::string() ), task ) )
+    {
+        aError = wxS( "task must be \"route\", \"fanout\", \"planes\" or \"optimize\"" );
+        return false;
+    }
+
+    if( aJson.contains( "rules" )
+        && !valueOf( RULES_NAMES, aJson.value( "rules", std::string() ), rules ) )
+    {
+        aError = wxS( "rules must be \"exact\", \"board\" or \"fab\"" );
+        return false;
+    }
+
+    if( aJson.contains( "nets" ) )
+    {
+        const json& n = aJson["nets"];
+        allNets = n.is_string() && n.get<std::string>() == "all";
+        nets = allNets ? std::vector<wxString>() : fromJson( n );
+
+        if( !allNets && nets.empty() )
+        {
+            aError = wxS( "nets must be \"all\" or a list of net names" );
+            return false;
+        }
+    }
+
+    if( aJson.contains( "optimize_nets" ) )
+    {
+        const json& n = aJson["optimize_nets"];
+        optimizeAll = n.is_string() && n.get<std::string>() == "all";
+        optimizeNets = optimizeAll ? std::vector<wxString>() : fromJson( n );
+    }
+
+    if( aJson.contains( "layers" ) )
+        layers = aJson["layers"].is_array() ? fromJson( aJson["layers"] ) : std::vector<wxString>();
+
+    if( aJson.contains( "between_parts" ) )
+        betweenParts = fromJson( aJson["between_parts"] );
+
+    if( aJson.contains( "fanout_parts" ) )
+        fanoutParts = fromJson( aJson["fanout_parts"] );
+
+    if( aJson.contains( "planes" ) && aJson["planes"].is_array() )
+    {
+        planes.clear();
+
+        for( const json& p : aJson["planes"] )
+        {
+            if( !p.is_object() || !p.contains( "net" ) || !p.contains( "layer" ) )
+            {
+                aError = wxS( "each plane needs a net and a layer" );
+                return false;
+            }
+
+            planes.push_back( { wxString::FromUTF8( p.value( "net", std::string() ) ),
+                                wxString::FromUTF8( p.value( "layer", std::string() ) ) } );
+        }
+    }
+
+    bus = aJson.value( "bus", bus );
+    planesFirst = aJson.value( "planes_first", planesFirst );
+    fanoutFirst = aJson.value( "fanout_first", fanoutFirst );
+    fanoutWidthMm = aJson.value( "fanout_width_mm", fanoutWidthMm );
+    gridMm = aJson.value( "grid_mm", gridMm );
+    viaCost = aJson.value( "via_cost", viaCost );
+    optimizerPasses = aJson.value( "optimizer_passes", optimizerPasses );
+    optimizeAfter = aJson.value( "optimize_after", optimizeAfter );
+    freeroutingFanout = aJson.value( "freerouting_fanout", freeroutingFanout );
+    refillZones = aJson.value( "refill_zones", refillZones );
+    ripOtherNets = aJson.value( "rip_other_nets", ripOtherNets );
+
+    if( gridMm < 0.01 || gridMm > 1.0 )
+    {
+        aError = wxS( "grid_mm must be between 0.01 and 1" );
+        return false;
+    }
+
+    return true;
+}
+
+
+// ---------------------------------------------------------------------------------------------
+
+AUTOROUTE_JOB::AUTOROUTE_JOB( PCB_EDIT_FRAME* aFrame ) :
+        m_frame( aFrame )
+{
+    s_current = this;
+
+    wxFileName dir( KIPLATFORM::ENV::GetUserCachePath(), wxEmptyString );
+    dir.AppendDir( wxS( "autoroute" ) );
+    dir.AppendDir( wxS( "run" ) );
+    m_workDir = dir.GetPath();
+}
+
+
+AUTOROUTE_JOB::~AUTOROUTE_JOB()
+{
+    if( IsActive() )
+    {
+        if( m_state == STATE::PREPARING )
+        {
+            // Unpacking cannot be interrupted; wait for it (it only copies files).
+        }
+        else if( m_step >= 0 && m_steps[m_step].kind == STEP::KRT )
+        {
+            RP::Kill( m_workDir );
+        }
+        else if( m_step >= 0 && m_steps[m_step].kind == STEP::FREEROUTING )
+        {
+            AR::StopAll();
+
+            while( AR::GetStatus().running )
+                wxMilliSleep( 50 );
+        }
+    }
+
+    if( m_prepareThread.joinable() )
+        m_prepareThread.join();
+
+    if( s_current == this )
+        s_current = nullptr;
+}
+
+
+AUTOROUTE_JOB* AUTOROUTE_JOB::Current()
+{
+    return s_current;
+}
+
+
+wxString AUTOROUTE_JOB::RouterName( AR_ROUTER aRouter )
+{
+    return aRouter == AR_ROUTER::KRT ? wxString( wxS( "KiCadRoutingTools" ) )
+                                     : wxString( wxS( "Freerouting" ) );
+}
+
+
+wxString AUTOROUTE_JOB::StateName( STATE aState )
+{
+    switch( aState )
+    {
+    case STATE::IDLE:      return wxS( "idle" );
+    case STATE::PREPARING: return wxS( "preparing" );
+    case STATE::RUNNING:   return wxS( "running" );
+    case STATE::PAUSED:    return wxS( "paused" );
+    case STATE::STOPPING:  return wxS( "stopping" );
+    case STATE::FINISHED:  return wxS( "finished" );
+    case STATE::STOPPED:   return wxS( "stopped" );
+    case STATE::FAILED:    return wxS( "failed" );
+    }
+
+    return wxEmptyString;
+}
+
+
+bool AUTOROUTE_JOB::IsActive() const
+{
+    return m_state == STATE::PREPARING || m_state == STATE::RUNNING || m_state == STATE::PAUSED
+           || m_state == STATE::STOPPING;
+}
+
+
+static long long nowMs()
+{
+    return wxGetLocalTimeMillis().GetValue();
+}
+
+
+bool AUTOROUTE_JOB::Start( const AUTOROUTE_SETTINGS& aSettings, wxString& aError )
+{
+    if( IsActive() )
+    {
+        aError = _( "A run is already in progress." );
+        return false;
+    }
+
+    m_settings = aSettings;
+    m_error.clear();
+    m_summary.clear();
+    m_log.clear();
+    m_openNets.clear();
+    m_progress = PROGRESS();
+    m_step = -1;
+
+    if( m_settings.router == AR_ROUTER::FREEROUTING && m_settings.task == AR_TASK::FANOUT )
+    {
+        aError = _( "Freerouting cannot fan out single parts. Choose KiCadRoutingTools, or use "
+                    "Freerouting's fan-out of every SMD pad on the Settings tab." );
+        return false;
+    }
+
+    if( m_settings.router == AR_ROUTER::FREEROUTING && !AR::IsAvailable() )
+    {
+        aError = _( "This build does not include Freerouting." );
+        return false;
+    }
+
+    if( m_settings.router == AR_ROUTER::KRT && !RP::IsAvailable() )
+    {
+        aError = _( "This build does not include KiCadRoutingTools." );
+        return false;
+    }
+
+    if( m_settings.task == AR_TASK::FANOUT && m_settings.fanoutParts.empty() )
+    {
+        aError = _( "Choose at least one part to fan out." );
+        return false;
+    }
+
+    if( m_settings.task == AR_TASK::PLANES && m_settings.planes.empty() )
+    {
+        aError = _( "Add at least one plane." );
+        return false;
+    }
+
+    if( m_settings.task == AR_TASK::ROUTE && m_settings.betweenParts.size() == 1 )
+    {
+        aError = _( "Choose at least two parts to route between." );
+        return false;
+    }
+
+    if( m_settings.task == AR_TASK::ROUTE && !m_settings.allNets && m_settings.nets.empty() )
+    {
+        aError = _( "Choose at least one net to route." );
+        return false;
+    }
+
+    buildSteps();
+
+    if( m_steps.empty() )
+    {
+        aError = _( "There is nothing to do." );
+        return false;
+    }
+
+    // A fresh work directory for this run.
+    if( wxDirExists( m_workDir ) )
+        wxFileName::Rmdir( m_workDir, wxPATH_RMDIR_RECURSIVE );
+
+    wxFileName::Mkdir( m_workDir + wxS( "/tmp" ), wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+
+    m_pushed = false;
+    m_startedAt = nowMs();
+    m_pausedMs = 0;
+    m_current.clear();
+
+    bool needsRuntime = false;
+
+    for( const STEP& step : m_steps )
+        needsRuntime |= step.kind == STEP::KRT;
+
+    if( needsRuntime && !RP::IsRuntimeReady() )
+    {
+        m_state = STATE::PREPARING;
+        m_progress.stage = _( "Unpacking the router (first use after an install or update)..." );
+        m_prepareFinished = false;
+
+        if( m_prepareThread.joinable() )
+            m_prepareThread.join();
+
+        m_prepareThread = std::thread(
+                [this]()
+                {
+                    wxString root, error;
+                    bool     ok = RP::PrepareRuntime(
+                            [this]( int aDone, int aTotal )
+                            {
+                                m_prepareTotal = aTotal;
+                                m_prepareDone = aDone;
+                            },
+                            root, error );
+
+                    m_prepareOk = ok;
+                    m_prepareError = error;
+                    m_runtime = root;
+                    m_prepareFinished = true;
+                } );
+
+        return true;
+    }
+
+    if( needsRuntime )
+    {
+        wxString root, error;
+
+        if( !RP::PrepareRuntime( {}, root, error ) )
+        {
+            aError = error;
+            return false;
+        }
+
+        m_runtime = root;
+    }
+
+    m_state = STATE::RUNNING;
+    startStep();
+    return true;
+}
+
+
+static bool isBga( FOOTPRINT* aFootprint )
+{
+    wxString name = aFootprint->GetFPID().GetLibItemName().wx_str().Upper();
+    return name.Contains( wxS( "BGA" ) ) || name.Contains( wxS( "WLCSP" ) );
+}
+
+
+void AUTOROUTE_JOB::buildSteps()
+{
+    m_steps.clear();
+
+    const AUTOROUTE_SETTINGS& s = m_settings;
+    BOARD*                    board = m_frame->GetBoard();
+    BOARD_DESIGN_SETTINGS&    bds = board->GetDesignSettings();
+    std::shared_ptr<NETCLASS> defaultClass = bds.m_NetSettings->GetDefaultNetclass();
+    bool                      krt = s.router == AR_ROUTER::KRT;
+
+    auto mm = []( int aIU ) { return wxString::FromCDouble( pcbIUScale.IUTomm( aIU ), 4 ); };
+
+    wxString escalation = s.rules == AR_RULES::EXACT ? wxS( "off" )
+                        : s.rules == AR_RULES::BOARD ? wxS( "board" )
+                                                     : wxS( "fab" );
+    wxString grid = wxString::FromCDouble( s.gridMm, 4 );
+
+    if( ( s.task == AR_TASK::PLANES || ( s.task == AR_TASK::ROUTE && s.planesFirst ) )
+        && !s.planes.empty() )
+    {
+        STEP step;
+        step.kind = STEP::PLANES;
+        step.title = wxString::Format( _( "Pour %zu plane(s)" ), s.planes.size() );
+        m_steps.push_back( step );
+    }
+
+    if( krt && ( s.task == AR_TASK::FANOUT || ( s.task == AR_TASK::ROUTE && s.fanoutFirst ) ) )
+    {
+        int width = s.fanoutWidthMm > 0 ? pcbIUScale.mmToIU( s.fanoutWidthMm )
+                                        : std::max( bds.m_TrackMinWidth,
+                                                    pcbIUScale.mmToIU( 0.1 ) );
+
+        for( const wxString& ref : s.fanoutParts )
+        {
+            FOOTPRINT* fp = nullptr;
+
+            for( FOOTPRINT* candidate : board->Footprints() )
+            {
+                if( candidate->GetReference() == ref )
+                    fp = candidate;
+            }
+
+            if( !fp )
+                continue;
+
+            STEP step;
+            step.kind = STEP::KRT;
+            step.output = wxString::Format( wxS( "step%zu.kicad_pcb" ), m_steps.size() + 1 );
+
+            if( isBga( fp ) )
+            {
+                step.title = wxString::Format( _( "Fan out %s (BGA)" ), ref );
+                step.args = { wxS( "py_router/bga_fanout.py" ), wxS( "{in}" ), wxS( "-o" ),
+                              wxS( "{out}" ), wxS( "-c" ), ref, wxS( "--clearance" ),
+                              mm( defaultClass->GetClearance() ), wxS( "--via-size" ),
+                              mm( defaultClass->GetViaDiameter() ), wxS( "--via-drill" ),
+                              mm( defaultClass->GetViaDrill() ) };
+            }
+            else
+            {
+                step.title = wxString::Format( _( "Fan out %s" ), ref );
+                step.args = { wxS( "py_router/qfn_fanout.py" ), wxS( "{in}" ), wxS( "-o" ),
+                              wxS( "{out}" ), wxS( "-c" ), ref, wxS( "-w" ), mm( width ),
+                              wxS( "--clearance" ), mm( defaultClass->GetClearance() ) };
+            }
+
+            step.args.insert( step.args.end(), { wxS( "--grid-step" ), grid, wxS( "--escalation" ),
+                                                 escalation, wxS( "--no-fix-drc-settings" ) } );
+            m_steps.push_back( step );
+        }
+    }
+
+    if( s.task == AR_TASK::ROUTE || s.task == AR_TASK::OPTIMIZE )
+    {
+        bool     optimize = s.task == AR_TASK::OPTIMIZE;
+        STEP     step;
+        wxString what = optimize ? ( s.optimizeAll ? _( "every routed net" )
+                                                   : wxString::Format( _( "%zu net(s)" ),
+                                                                       s.optimizeNets.size() ) )
+                                 : ( s.allNets ? _( "every unrouted net" )
+                                               : wxString::Format( _( "%zu net(s)" ),
+                                                                   s.nets.size() ) );
+
+        step.title = wxString::Format( optimize ? _( "Optimize %s" ) : _( "Route %s" ), what );
+
+        if( !optimize && !s.betweenParts.empty() )
+        {
+            wxString parts;
+
+            for( const wxString& ref : s.betweenParts )
+                parts << ( parts.IsEmpty() ? wxS( "" ) : wxS( ", " ) ) << ref;
+
+            step.title += wxString::Format( _( " between %s" ), parts );
+        }
+
+        if( krt )
+        {
+            step.kind = STEP::KRT;
+            step.output = wxString::Format( wxS( "step%zu.kicad_pcb" ), m_steps.size() + 1 );
+            step.args = { wxS( "py_router/route.py" ), wxS( "{in}" ), wxS( "{out}" ) };
+
+            const std::vector<wxString>& nets = optimize ? s.optimizeNets : s.nets;
+            bool                         all = optimize ? s.optimizeAll : s.allNets;
+
+            step.args.push_back( wxS( "--nets" ) );
+
+            if( all )
+                step.args.push_back( wxS( "*" ) );
+            else
+            {
+                for( const wxString& net : nets )
+                    step.args.push_back( krtNetPattern( net ) );
+            }
+
+            if( optimize )
+                step.args.push_back( wxS( "--force-reroute" ) );
+
+            if( !s.layers.empty() )
+            {
+                step.args.push_back( wxS( "--layers" ) );
+                step.args.insert( step.args.end(), s.layers.begin(), s.layers.end() );
+            }
+
+            if( s.bus && !optimize )
+                step.args.insert( step.args.end(), { wxS( "--bus" ), wxS( "--ordering" ),
+                                                     wxS( "bus" ) } );
+
+            if( s.viaCost > 0 )
+                step.args.insert( step.args.end(), { wxS( "--via-cost" ),
+                                                     wxString::Format( wxS( "%d" ), s.viaCost ) } );
+
+            step.args.insert( step.args.end(), { wxS( "--grid-step" ), grid, wxS( "--escalation" ),
+                                                 escalation, wxS( "--no-fix-drc-settings" ),
+                                                 wxS( "--keep-input-copper" ) } );
+
+            // Routing a choice of nets leaves every other net's copper alone, unless asked: the
+            // router would otherwise rip blockers (fan-out stubs included) and route them in full.
+            if( !all && !s.ripOtherNets )
+            {
+                step.env = { wxS( "KICAD_RIP_PREEXISTING=0" ), wxS( "KICAD_FINALIZE_RIP=0" ),
+                             wxS( "KICAD_RECONCILE_RIP_ESCALATION=0" ) };
+            }
+        }
+        else
+        {
+            step.kind = STEP::FREEROUTING;
+        }
+
+        m_steps.push_back( step );
+    }
+}
+
+
+wxString AUTOROUTE_JOB::krtNetPattern( const wxString& aNet ) const
+{
+    // KiCadRoutingTools matches nets with fnmatch patterns; make a name match only itself.
+    wxString out;
+
+    for( wxUniChar c : aNet )
+    {
+        if( c == '*' || c == '?' || c == '[' )
+            out << wxS( "[" ) << c << wxS( "]" );
+        else
+            out << c;
+    }
+
+    return out;
+}
+
+
+bool AUTOROUTE_JOB::Pause()
+{
+    if( m_state != STATE::RUNNING || m_step < 0 )
+        return false;
+
+    const STEP& step = m_steps[m_step];
+    bool        ok = true;
+
+    if( step.kind == STEP::KRT )
+        ok = RP::Pause( m_workDir );
+    else if( step.kind == STEP::FREEROUTING )
+        AR::Pause();
+
+    if( ok )
+    {
+        m_state = STATE::PAUSED;
+        m_pausedAt = nowMs();
+    }
+
+    return ok;
+}
+
+
+bool AUTOROUTE_JOB::Resume()
+{
+    if( m_state != STATE::PAUSED )
+        return false;
+
+    const STEP& step = m_steps[m_step];
+
+    if( step.kind == STEP::KRT )
+        RP::Resume( m_workDir );
+    else if( step.kind == STEP::FREEROUTING )
+        AR::Resume();
+
+    m_pausedMs += nowMs() - m_pausedAt;
+    m_state = STATE::RUNNING;
+    return true;
+}
+
+
+void AUTOROUTE_JOB::Stop()
+{
+    if( m_state == STATE::PREPARING )
+    {
+        // Unpacking finishes on its own; the run ends as soon as it does.
+        m_state = STATE::STOPPING;
+        return;
+    }
+
+    if( m_state != STATE::RUNNING && m_state != STATE::PAUSED )
+        return;
+
+    const STEP& step = m_steps[m_step];
+
+    if( m_state == STATE::PAUSED )
+        Resume();
+
+    m_state = STATE::STOPPING;
+    m_progress.stage = _( "Stopping..." );
+
+    if( step.kind == STEP::KRT )
+        RP::Kill( m_workDir );
+    else if( step.kind == STEP::FREEROUTING )
+        AR::StopAll();   // Freerouting still writes the routes it found so far
+}
+
+
+void AUTOROUTE_JOB::Discard()
+{
+    if( IsActive() || !m_pushed )
+        return;
+
+    m_frame->GetToolManager()->RunAction( ACTIONS::undo );
+    m_pushed = false;
+}
+
+
+void AUTOROUTE_JOB::Poll()
+{
+    if( m_state == STATE::PREPARING || ( m_state == STATE::STOPPING && m_step < 0 ) )
+    {
+        if( m_prepareTotal > 0 )
+        {
+            m_progress.done = m_prepareDone;
+            m_progress.total = m_prepareTotal;
+        }
+
+        if( !m_prepareFinished )
+            return;
+
+        m_prepareThread.join();
+
+        if( m_state == STATE::STOPPING )
+        {
+            finish( STATE::STOPPED );
+            return;
+        }
+
+        if( !m_prepareOk )
+        {
+            m_error = m_prepareError;
+            finish( STATE::FAILED );
+            return;
+        }
+
+        m_startedAt = nowMs();
+        m_state = STATE::RUNNING;
+        m_progress = PROGRESS();
+        startStep();
+        return;
+    }
+
+    if( !IsActive() || m_step < 0 || m_step >= (int) m_steps.size() )
+        return;
+
+    if( m_state != STATE::PAUSED )
+        m_progress.elapsedMs = (long) ( nowMs() - m_startedAt - m_pausedMs );
+
+    switch( m_steps[m_step].kind )
+    {
+    case STEP::KRT:         pollKrtStep(); break;
+    case STEP::FREEROUTING: pollFreeroutingStep(); break;
+    case STEP::PLANES:      break;
+    }
+}
+
+
+void AUTOROUTE_JOB::startStep()
+{
+    m_step++;
+
+    if( m_step >= (int) m_steps.size() )
+    {
+        finish( STATE::FINISHED );
+        return;
+    }
+
+    STEP& step = m_steps[m_step];
+    step.state = STEP_STATE::RUNNING;
+    m_progress.stage = step.title;
+    m_progress.net.clear();
+    m_progress.done = m_progress.total = m_progress.failed = -1;
+    m_progress.pass = 0;
+
+    wxString error;
+
+    if( step.kind == STEP::PLANES )
+    {
+        if( !runPlanes( error ) )
+        {
+            m_error = error;
+            finishStep( false, error );
+            finish( STATE::FAILED );
+            return;
+        }
+
+        finishStep( true );
+        startStep();
+        return;
+    }
+
+    if( step.kind == STEP::FREEROUTING )
+    {
+        wxString dsn = m_workDir + wxS( "/board.dsn" );
+        wxString ses = m_workDir + wxS( "/board.ses" );
+        wxString snap = m_workDir + wxS( "/snapshot.ses" );
+
+        bool exported = false;
+
+        {
+            PART_FILTER filter( *this );
+            exported = m_frame->ExportSpecctraFile( dsn );
+        }
+
+        if( !exported )
+        {
+            m_error = _( "Could not export the board for Freerouting." );
+            finishStep( false, m_error );
+            finish( STATE::FAILED );
+            return;
+        }
+
+        bool         optimize = m_settings.task == AR_TASK::OPTIMIZE;
+        AR::OPTIONS  opts;
+        BOARD*       board = m_frame->GetBoard();
+
+        if( optimize && !m_settings.optimizeAll )
+            opts.onlyNets = m_settings.optimizeNets;
+        else if( !optimize && !m_settings.allNets )
+            opts.onlyNets = m_settings.nets;
+
+        if( !m_settings.layers.empty() )
+        {
+            std::set<wxString> on( m_settings.layers.begin(), m_settings.layers.end() );
+
+            for( PCB_LAYER_ID layer : board->GetEnabledLayers().CuStack() )
+            {
+                if( !on.count( board->GetLayerName( layer ) ) )
+                    opts.inactiveLayers.push_back( board->GetLayerName( layer ) );
+            }
+        }
+
+        opts.route = !optimize;
+        opts.fanout = optimize ? 0 : ( m_settings.freeroutingFanout ? 1 : -1 );
+        opts.optimizerPasses = m_settings.optimizerPasses > 0 ? m_settings.optimizerPasses : -1;
+        opts.viaCost = m_settings.viaCost > 0 ? m_settings.viaCost : -1;
+        AR::SetOptions( opts );
+
+        m_lastSnapshot = 0;
+
+        if( !AR::Start( dsn, ses, 0, optimize || m_settings.optimizeAfter,
+                        m_settings.liveView ? snap : wxString() ) )
+        {
+            m_error = _( "Freerouting could not be started." );
+            finishStep( false, m_error );
+            finish( STATE::FAILED );
+            return;
+        }
+
+        return;
+    }
+
+    // A KiCadRoutingTools step reads the board as it is now (the first one exports it).
+    if( m_current.IsEmpty() && !exportBoard( error ) )
+    {
+        m_error = error;
+        finishStep( false, error );
+        finish( STATE::FAILED );
+        return;
+    }
+
+    // Each tool reads the project file next to its input board (the design rules).
+    wxFileName in( m_current );
+    wxFileName out( m_workDir, step.output );
+
+    for( const wxChar* ext : { wxS( "kicad_pro" ), wxS( "kicad_dru" ) } )
+    {
+        wxFileName src( m_workDir, wxS( "in" ), ext );
+        wxFileName inSide( in );
+        inSide.SetExt( ext );
+
+        if( src.FileExists() && !inSide.FileExists() )
+            wxCopyFile( src.GetFullPath(), inSide.GetFullPath() );
+    }
+
+    RP::STEP run;
+    run.workDir = m_workDir;
+    run.logPath = m_workDir + wxString::Format( wxS( "/step%d.log" ), m_step + 1 );
+    run.title = step.title;
+    run.args.push_back( m_runtime + wxS( "/krt/" ) + step.args[0] );
+
+    for( size_t i = 1; i < step.args.size(); i++ )
+    {
+        wxString arg = step.args[i];
+        arg.Replace( wxS( "{in}" ), in.GetFullPath() );
+        arg.Replace( wxS( "{out}" ), out.GetFullPath() );
+        run.args.push_back( arg );
+    }
+
+    run.env = { wxS( "PYTHONHOME=" ) + m_runtime + wxS( "/home" ),
+                wxS( "PYTHONPATH=" ) + m_runtime + wxS( "/site" ),
+                wxS( "HOME=" ) + m_workDir,
+                wxS( "TMPDIR=" ) + m_workDir + wxS( "/tmp" ),
+                wxS( "KRT_CWD=" ) + m_workDir,
+                wxS( "PYTHONUNBUFFERED=1" ),
+                wxS( "PYTHONIOENCODING=utf-8" ),
+                wxS( "NO_COLOR=1" ),
+                wxS( "TERM=dumb" ) };
+    run.env.insert( run.env.end(), step.env.begin(), step.env.end() );
+
+    m_logOffset = 0;
+    m_logPartial.clear();
+
+    if( !RP::Start( run, error ) )
+    {
+        m_error = error;
+        finishStep( false, error );
+        finish( STATE::FAILED );
+    }
+}
+
+
+void AUTOROUTE_JOB::finishStep( bool aOk, const wxString& aDetail )
+{
+    if( m_step < 0 || m_step >= (int) m_steps.size() )
+        return;
+
+    m_steps[m_step].state = aOk ? STEP_STATE::DONE : STEP_STATE::FAILED;
+
+    if( !aDetail.IsEmpty() )
+        m_steps[m_step].detail = aDetail;
+}
+
+
+void AUTOROUTE_JOB::pollKrtStep()
+{
+    STEP&    step = m_steps[m_step];
+    wxString log = m_workDir + wxString::Format( wxS( "/step%d.log" ), m_step + 1 );
+
+    readLog( log );
+
+    if( RP::GetState( m_workDir ) != RP::STATE::EXITED )
+        return;
+
+    readLog( log );
+
+    int        code = RP::ExitCode( m_workDir );
+    wxFileName out( m_workDir, step.output );
+    wxString   error;
+
+    if( m_state == STATE::STOPPING )
+    {
+        finishStep( false, _( "Stopped." ) );
+
+        for( size_t i = m_step + 1; i < m_steps.size(); i++ )
+            m_steps[i].state = STEP_STATE::SKIPPED;
+
+        finish( STATE::STOPPED );
+        return;
+    }
+
+    if( code != 0 || !out.FileExists() )
+    {
+        wxString why = code == -9 ? _( "The router process ended unexpectedly (out of memory?)." )
+                                  : wxString::Format( _( "The router stopped with an error "
+                                                         "(exit code %d)." ),
+                                                      code );
+
+        // The last meaningful lines of its output say why.
+        wxString tail;
+
+        for( auto it = m_log.rbegin(); it != m_log.rend() && tail.Length() < 600; ++it )
+        {
+            if( !it->Trim().IsEmpty() )
+                tail = *it + wxS( "\n" ) + tail;
+
+            if( it->StartsWith( wxS( "Traceback" ) ) )
+                break;
+        }
+
+        m_error = why + wxS( "\n" ) + tail.Trim();
+        finishStep( false, why );
+        finish( STATE::FAILED );
+        return;
+    }
+
+    // Show the step's result on the board right away, so the board follows the run.
+    if( !importBoard( out.GetFullPath(), error ) )
+    {
+        m_error = error;
+        finishStep( false, error );
+        finish( STATE::FAILED );
+        return;
+    }
+
+    m_current = out.GetFullPath();
+    finishStep( true, step.detail );
+    startStep();
+}
+
+
+void AUTOROUTE_JOB::pollFreeroutingStep()
+{
+    AR::STATUS s = AR::GetStatus();
+    wxString   snap = m_workDir + wxS( "/snapshot.ses" );
+    wxString   error;
+
+    if( s.connections > 0 && s.unrouted >= 0 )
+    {
+        m_progress.total = s.connections;
+        m_progress.done = std::max( 0, s.connections - s.unrouted );
+    }
+
+    m_progress.pass = s.pass;
+    m_progress.vias = s.vias;
+    m_progress.lengthMm = s.traceLengthMm;
+
+    if( m_state == STATE::RUNNING )
+    {
+        if( s.stage == wxS( "loading" ) )
+            m_progress.stage = _( "Reading the board..." );
+        else if( s.stage == wxS( "routing" ) && s.message == wxS( "fanout" ) )
+            m_progress.stage = wxString::Format( _( "Fanning out pads, pass %d" ), s.pass );
+        else if( s.stage == wxS( "routing" ) )
+            m_progress.stage = wxString::Format( _( "Routing, pass %d" ), s.pass );
+        else if( s.stage == wxS( "optimizing" ) )
+            m_progress.stage = wxString::Format( _( "Optimizing, pass %d" ), s.pass );
+        else if( s.stage == wxS( "saving" ) )
+            m_progress.stage = _( "Saving..." );
+    }
+
+    if( s.running && s.snapshotSerial != m_lastSnapshot && wxFileExists( snap ) )
+    {
+        m_lastSnapshot = s.snapshotSerial;
+        importSession( snap, error );
+    }
+
+    if( s.running )
+        return;
+
+    wxString ses = m_workDir + wxS( "/board.ses" );
+
+    if( !s.error.IsEmpty() || !wxFileExists( ses ) )
+    {
+        m_error = s.error.IsEmpty() ? _( "Freerouting did not write its routes." ) : s.error;
+        finishStep( false, m_error );
+        finish( STATE::FAILED );
+        return;
+    }
+
+    if( !importSession( ses, error ) )
+    {
+        m_error = error;
+        finishStep( false, error );
+        finish( STATE::FAILED );
+        return;
+    }
+
+    bool stopped = m_state == STATE::STOPPING;
+    finishStep( true, wxString::Format( _( "%d of %d connections routed" ),
+                                        std::max( 0, s.connections - s.unrouted ),
+                                        s.connections ) );
+
+    if( stopped )
+        finish( STATE::STOPPED );
+    else
+        startStep();
+}
+
+
+void AUTOROUTE_JOB::finish( STATE aState )
+{
+    m_state = aState;
+
+    if( m_step >= 0 && m_step < (int) m_steps.size()
+        && m_steps[m_step].state == STEP_STATE::RUNNING )
+    {
+        m_steps[m_step].state = aState == STATE::FINISHED ? STEP_STATE::DONE : STEP_STATE::FAILED;
+    }
+
+    if( aState != STATE::FINISHED )
+    {
+        for( STEP& step : m_steps )
+        {
+            if( step.state == STEP_STATE::PENDING )
+                step.state = STEP_STATE::SKIPPED;
+        }
+    }
+
+    collectOpenNets();
+
+    int unrouted = (int) m_frame->GetBoard()->GetConnectivity()->GetUnconnectedCount( false );
+
+    switch( aState )
+    {
+    case STATE::FINISHED:
+        m_progress.stage = unrouted == 0 ? _( "Done: every connection is routed." )
+                                         : wxString::Format( _( "Done: %d connection(s) on %zu "
+                                                                "net(s) are still unrouted." ),
+                                                             unrouted, m_openNets.size() );
+        break;
+
+    case STATE::STOPPED:
+        m_progress.stage = m_pushed ? _( "Stopped. The board shows what was done so far." )
+                                    : _( "Stopped before anything changed." );
+        break;
+
+    case STATE::FAILED:
+        m_progress.stage = m_pushed ? _( "Failed. The board shows what was done before the "
+                                         "error." )
+                                    : _( "Failed." );
+        break;
+
+    default:
+        break;
+    }
+
+    m_summary = m_progress.stage;
+}
+
+
+void AUTOROUTE_JOB::collectOpenNets()
+{
+    m_openNets.clear();
+
+    BOARD*                             board = m_frame->GetBoard();
+    std::shared_ptr<CONNECTIVITY_DATA> conn = board->GetConnectivity();
+
+    conn->RecalculateRatsnest();
+
+    for( NETINFO_ITEM* net : board->GetNetInfo() )
+    {
+        if( net->GetNetCode() <= 0 )
+            continue;
+
+        RN_NET* rn = conn->GetRatsnestForNet( net->GetNetCode() );
+
+        if( !rn )
+            continue;
+
+        for( const CN_EDGE& edge : rn->GetUnsortedEdges() )
+        {
+            if( edge.IsVisible() )
+            {
+                m_openNets.push_back( net->GetNetname() );
+                break;
+            }
+        }
+    }
+}
+
+
+bool AUTOROUTE_JOB::runPlanes( wxString& aError )
+{
+    BOARD*                 board = m_frame->GetBoard();
+    BOARD_DESIGN_SETTINGS& bds = board->GetDesignSettings();
+    SHAPE_POLY_SET         outline;
+    wxString               done;
+
+    if( !board->GetBoardPolygonOutlines( outline, true ) || outline.OutlineCount() == 0 )
+    {
+        aError = _( "The board has no closed outline on Edge.Cuts, so planes cannot be poured." );
+        return false;
+    }
+
+    BOARD_COMMIT commit( m_frame );
+    int          added = 0;
+
+    for( const AR_PLANE& plane : m_settings.planes )
+    {
+        NETINFO_ITEM* net = board->FindNet( plane.net );
+        PCB_LAYER_ID  layer = board->GetLayerID( plane.layer );
+
+        if( !net )
+        {
+            aError = wxString::Format( _( "The board has no net %s." ), plane.net );
+            return false;
+        }
+
+        if( layer == UNDEFINED_LAYER || !IsCopperLayer( layer ) || !board->IsLayerEnabled( layer ) )
+        {
+            aError = wxString::Format( _( "The board has no copper layer %s. Add inner layers in "
+                                          "Board Setup > Physical Stackup." ),
+                                       plane.layer );
+            return false;
+        }
+
+        bool exists = false;
+
+        for( ZONE* zone : board->Zones() )
+        {
+            if( !zone->GetIsRuleArea() && zone->GetNetCode() == net->GetNetCode()
+                && zone->IsOnLayer( layer ) )
+            {
+                exists = true;
+            }
+        }
+
+        if( exists )
+            continue;
+
+        ZONE* zone = new ZONE( board );
+        bds.GetDefaultZoneSettings().ExportSetting( *zone );
+        zone->SetIsRuleArea( false );
+        zone->SetLayer( layer );
+        zone->SetNetCode( net->GetNetCode() );
+        zone->SetZoneName( wxString::Format( wxS( "%s plane" ), plane.net ) );
+        *zone->Outline() = outline;
+        zone->Outline()->Simplify();
+        commit.Add( zone );
+        added++;
+    }
+
+    if( added )
+    {
+        commit.Push( _( "Autoroute" ), m_pushed ? APPEND_UNDO : 0 );
+        m_pushed = true;
+    }
+
+    // The zones are filled when the run is kept (the routers work from the zone outlines), so
+    // the whole run stays one undo step.
+    m_steps[m_step].detail = added ? wxString::Format( _( "%d zone(s) added" ), added )
+                                   : _( "The zones already exist" );
+    return true;
+}
+
+
+bool AUTOROUTE_JOB::exportBoard( wxString& aError )
+{
+    wxString    path = m_workDir + wxS( "/in.kicad_pcb" );
+    PART_FILTER filter( *this );
+
+    if( !m_frame->SavePcbCopy( path, true, true ) )
+    {
+        aError = _( "Could not write a copy of the board for the router." );
+        return false;
+    }
+
+    m_current = path;
+    return true;
+}
+
+
+AUTOROUTE_JOB::PART_FILTER::PART_FILTER( AUTOROUTE_JOB& aJob )
+{
+    const AUTOROUTE_SETTINGS& s = aJob.m_settings;
+
+    if( s.betweenParts.empty() || s.task != AR_TASK::ROUTE )
+        return;
+
+    std::set<wxString> parts( s.betweenParts.begin(), s.betweenParts.end() );
+    std::set<wxString> nets( s.nets.begin(), s.nets.end() );
+
+    for( FOOTPRINT* fp : aJob.m_frame->GetBoard()->Footprints() )
+    {
+        if( parts.count( fp->GetReference() ) )
+            continue;
+
+        for( PAD* pad : fp->Pads() )
+        {
+            if( pad->GetNetCode() > 0 && ( s.allNets || nets.count( pad->GetNetname() ) ) )
+            {
+                m_pads.emplace_back( pad, pad->GetNetCode() );
+                pad->SetNetCode( 0, true );
+            }
+        }
+    }
+}
+
+
+AUTOROUTE_JOB::PART_FILTER::~PART_FILTER()
+{
+    for( const auto& [pad, net] : m_pads )
+        pad->SetNetCode( net, true );
+}
