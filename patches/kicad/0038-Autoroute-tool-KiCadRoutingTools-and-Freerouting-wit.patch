+class PCB_EDIT_FRAME;
+
+/// The routers the Autoroute tool can drive.
+enum class AR_ROUTER
+{
+    KRT,          ///< KiCadRoutingTools (Python, in its own process)
+    FREEROUTING   ///< Freerouting's core, in the app's Java runtime
+};
+
+/// What a run does.
+enum class AR_TASK
+{
+    ROUTE,      ///< Route nets (optionally pouring planes and fanning out parts first)
+    FANOUT,     ///< Only fan out the chosen parts
+    PLANES,     ///< Only pour the planes
+    OPTIMIZE    ///< Improve nets that are already routed
+};
+
+/// How far KiCadRoutingTools may go below the board's rules when a net does not fit.
+enum class AR_RULES
+{
+    EXACT,      ///< Never: sizes and clearances are exactly the net classes'
+    BOARD,      ///< Down to the board's own minimums (Board Setup > Constraints)
+    FAB         ///< Down to a fab's minimums; every place it does so is reported
+};
+
+struct AR_PLANE
+{
+    wxString net;
+    wxString layer;
+};
+
+/**
+ * Everything a run needs.  The dialog edits one of these, MCP fills one from JSON, and both
+ * hand it to AUTOROUTE_JOB::Start().
+ */
+struct AUTOROUTE_SETTINGS
+{
+    AR_ROUTER router = AR_ROUTER::KRT;
+    AR_TASK   task = AR_TASK::ROUTE;
+
+    // Route
+    bool                  allNets = true;     ///< False: only @a nets
+    std::vector<wxString> nets;
+    bool                  bus = false;        ///< Keep @a nets together like a bus (KRT)
+    /// When not empty, route the nets only between the pads of these parts (references): the
+    /// router does not see the nets' pads on other parts.
+    std::vector<wxString> betweenParts;
+    std::vector<wxString> layers;             ///< Copper layers to route on; empty for all
+    bool                  planesFirst = true; ///< Pour @a planes before routing
+    bool                  fanoutFirst = true; ///< Fan out @a fanoutParts before routing (KRT)
+
+    // Fan out
+    std::vector<wxString> fanoutParts;        ///< References
+    double                fanoutWidthMm = 0;  ///< 0 for the board's minimum track width
+
+    // Planes
+    std::vector<AR_PLANE> planes;
+
+    // Optimize
+    bool                  optimizeAll = true;
+    std::vector<wxString> optimizeNets;
+
+    // Settings
+    AR_RULES rules = AR_RULES::BOARD;
+    double   gridMm = 0.1;            ///< KRT's routing grid
+    int      viaCost = 0;             ///< 0 for the router's default
+    int      optimizerPasses = 0;     ///< Freerouting; 0 for its default
+    bool     optimizeAfter = true;    ///< Freerouting: run the optimizer after routing
+    bool     freeroutingFanout = false;
+    bool     liveView = true;         ///< Freerouting: show routes as they are found
+    bool     refillZones = true;
+    /// When routing chosen nets: whether KRT may rip up and reroute other nets' copper.
+    bool     ripOtherNets = false;
+
+    nlohmann::json ToJson() const;
+    /// Fills from JSON (the MCP tool's arguments); returns false with @a aError on a bad value.
+    bool           FromJson( const nlohmann::json& aJson, wxString& aError );
+};
+
+
+/**
+ * One autorouting run on the open board: its steps, its state and its progress.  The Autoroute
+ * dialog owns the job and calls Poll() from a timer; MCP reads the same job through Current().
+ * Everything here runs on the main thread except the runtime unpacking.
+ */
+class AUTOROUTE_JOB
+{
+public:
+    enum class STATE
+    {
+        IDLE,
+        PREPARING,   ///< Unpacking the bundled Python runtime
+        RUNNING,
+        PAUSED,
+        STOPPING,
+        FINISHED,    ///< Ended by itself; the board shows the result
+        STOPPED,     ///< Stopped by the user; the board shows what was done
+        FAILED
+    };
+
+    enum class STEP_STATE
+    {
+        PENDING,
+        RUNNING,
+        DONE,
+        FAILED,
+        SKIPPED
+    };
+
+    struct STEP
+    {
+        wxString   title;
+        STEP_STATE state = STEP_STATE::PENDING;
+        wxString   detail;
+
+        // KiCadRoutingTools steps
+        std::vector<wxString> args;     ///< Script (relative to krt/) and its arguments
+        wxString              output;   ///< Board file the step writes
+        std::vector<wxString> env;      ///< Extra environment ("NAME=value")
+
+        enum KIND
+        {
+            PLANES,
+            KRT,
+            FREEROUTING
+        } kind = KRT;
+    };
+
+    struct PROGRESS
+    {
+        wxString stage;            ///< One line: what is happening now
+        wxString net;              ///< The net being routed, if known
+        int      done = -1;        ///< Nets (or connections) done in this pass, -1 if unknown
+        int      total = -1;
+        int      pass = 0;
+        int      failed = -1;
+        int      vias = -1;
+        double   lengthMm = -1;
+        long     elapsedMs = 0;
+    };
+
+    AUTOROUTE_JOB( PCB_EDIT_FRAME* aFrame );
+    ~AUTOROUTE_JOB();
+
+    /// The job of the open Autoroute dialog, or nullptr.
+    static AUTOROUTE_JOB* Current();
+
+    bool Start( const AUTOROUTE_SETTINGS& aSettings, wxString& aError );
+
+    /// Advance the job; call every few hundred ms while it is active.
+    void Poll();
+
+    bool Pause();
+    bool Resume();
+    void Stop();
+
+    /// Undo everything the run changed on the board.
+    void Discard();
+
+    STATE GetState() const { return m_state; }
+    bool  IsActive() const;
+    bool  ChangedBoard() const { return m_pushed; }
+
+    const AUTOROUTE_SETTINGS& GetSettings() const { return m_settings; }
+    const std::vector<STEP>&  GetSteps() const { return m_steps; }
+    const PROGRESS&           GetProgress() const { return m_progress; }
+    const wxString&           GetError() const { return m_error; }
+    const wxString&           GetSummary() const { return m_summary; }
+
+    /// The last lines the router printed.
+    const std::deque<wxString>& GetLog() const { return m_log; }
+
+    /// Nets that still have unrouted connections, after the run.
+    const std::vector<wxString>& GetOpenNets() const { return m_openNets; }
+
+    nlohmann::json StatusJson() const;
+
+    static wxString RouterName( AR_ROUTER aRouter );
+    static wxString StateName( STATE aState );
+
+private:
+    void buildSteps();
+    void startStep();
+    void pollKrtStep();
+    void pollFreeroutingStep();
+    void finishStep( bool aOk, const wxString& aDetail = wxEmptyString );
+    void finish( STATE aState );
+
+    bool runPlanes( wxString& aError );
+    bool exportBoard( wxString& aError );
+
+    /// Takes the routed nets' pads on parts outside betweenParts off their nets until destroyed,
+    /// so a board written meanwhile only asks for connections between those parts.
+    class PART_FILTER
+    {
+    public:
+        PART_FILTER( AUTOROUTE_JOB& aJob );
+        ~PART_FILTER();
+
+    private:
+        std::vector<std::pair<class PAD*, int>> m_pads;
+    };
+    bool importBoard( const wxString& aPath, wxString& aError );
+    bool importSession( const wxString& aPath, wxString& aError );
+    void readLog( const wxString& aPath );
+    void parseLine( const wxString& aLine );
+    void collectOpenNets();
+
+    wxString krtNetPattern( const wxString& aNet ) const;
+
+    PCB_EDIT_FRAME*       m_frame;
+    AUTOROUTE_SETTINGS    m_settings;
+    STATE                 m_state = STATE::IDLE;
+    std::vector<STEP>     m_steps;
+    int                   m_step = -1;
+    PROGRESS              m_progress;
+    wxString              m_error;
+    wxString              m_summary;
+    std::deque<wxString>  m_log;
+    long                  m_logOffset = 0;
+    wxString              m_logPartial;
+    std::vector<wxString> m_openNets;
+
+    wxString              m_workDir;      ///< This run's files
+    wxString              m_runtime;      ///< The unpacked Python runtime
+    wxString              m_current;      ///< The board file the next KRT step reads
+    bool                  m_pushed = false;
+    long long             m_startedAt = 0;
+    long long             m_pausedAt = 0;
+    long long             m_pausedMs = 0;
+    int                   m_lastSnapshot = 0;
+
+    std::thread           m_prepareThread;
+    std::atomic<int>      m_prepareDone{ 0 };
+    std::atomic<int>      m_prepareTotal{ 0 };
+    std::atomic<bool>     m_prepareFinished{ false };
+    bool                  m_prepareOk = false;
+    wxString              m_prepareError;
+
+    static AUTOROUTE_JOB* s_current;
+};
+
+#endif // AUTOROUTE_JOB_H
