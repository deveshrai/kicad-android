+    m_discardBtn->Show( result && m_job->ChangedBoard() );
+    m_backBtn->Show( result );
+    m_keepBtn->Show( result );
+
+    if( result )
+    {
+        m_openNets->Clear();
+
+        for( const wxString& net : m_job->GetOpenNets() )
+            m_openNets->Append( net );
+    }
+
+    if( !setup )
+        refreshRunView();
+
+    m_runPanel->Layout();
+    m_setupPanel->Layout();
+    Layout();
+    GetSizer()->Fit( this );
+
+    if( result )
+        m_log->ShowPosition( m_log->GetLastPosition() );
+
+    if( !setup )
+        moveToCorner();
+    else
+        Centre();
