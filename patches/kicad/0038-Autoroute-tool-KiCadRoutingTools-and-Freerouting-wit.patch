+
+bool AUTOROUTE_JOB::importBoard( const wxString& aPath, wxString& aError )
+{
+    std::unique_ptr<BOARD> routed;
+
+    try
+    {
+        routed = PCB_IO_MGR::Load( PCB_IO_MGR::KICAD_SEXP, aPath );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        aError = wxString::Format( _( "Could not read the router's result: %s" ), ioe.What() );
+        return false;
+    }
+
+    BOARD*       board = m_frame->GetBoard();
+    BOARD_COMMIT commit( m_frame );
+    int          added = 0;
+    int          removed = 0;
+
+    // Tracks and vias: the router keeps the ones it did not change (same id), so add the new
+    // ones and remove the ones it took out.
+    std::map<KIID, PCB_TRACK*> live;
+
+    for( PCB_TRACK* track : board->Tracks() )
+        live[track->m_Uuid] = track;
+
+    std::set<KIID> kept;
+
+    for( PCB_TRACK* track : routed->Tracks() )
+    {
+        if( live.count( track->m_Uuid ) )
+        {
+            kept.insert( track->m_Uuid );
+            continue;
+        }
+
+        PCB_TRACK*    copy = static_cast<PCB_TRACK*>( track->Clone() );
+        NETINFO_ITEM* net = board->FindNet( track->GetNetname() );
+
+        copy->SetParent( board );
+        copy->SetNet( net ? net : NETINFO_LIST::OrphanedItem() );
+        commit.Add( copy );
+        added++;
+    }
+
+    for( const auto& [id, track] : live )
+    {
+        if( !kept.count( id ) && !track->IsLocked() )
+        {
+            commit.Remove( track );
+            removed++;
+        }
+    }
+
+    // Zones the router added (planes it poured).
+    std::set<KIID> zones;
+
+    for( ZONE* zone : board->Zones() )
+        zones.insert( zone->m_Uuid );
+
+    for( ZONE* zone : routed->Zones() )
+    {
+        if( zones.count( zone->m_Uuid ) || zone->GetIsRuleArea() )
+            continue;
+
+        ZONE*         copy = static_cast<ZONE*>( zone->Clone() );
+        NETINFO_ITEM* net = board->FindNet( zone->GetNetname() );
+
+        copy->SetParent( board );
+        copy->SetNet( net ? net : NETINFO_LIST::OrphanedItem() );
+        commit.Add( copy );
+        added++;
+    }
+
+    if( added || removed )
+    {
+        m_frame->GetToolManager()->RunAction( ACTIONS::selectionClear );
+        commit.Push( _( "Autoroute" ), m_pushed ? APPEND_UNDO : 0 );
+        m_pushed = true;
+        m_frame->GetCanvas()->ForceRefresh();
+    }
+
+    return true;
+}
+
+
+bool AUTOROUTE_JOB::importSession( const wxString& aPath, wxString& aError )
+{
+    BOARD_COMMIT commit( m_frame );
+
+    m_frame->GetToolManager()->RunAction( ACTIONS::selectionClear );
+
+    try
+    {
+        DSN::ImportSpecctraSession( m_frame->GetBoard(), aPath, commit );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        commit.Revert();
+        aError = ioe.What();
+        return false;
+    }
+
+    // Every import replaces the routes of the one before, so they share one undo step.
+    commit.Push( _( "Autoroute" ), m_pushed ? APPEND_UNDO : 0 );
+    m_pushed = true;
+    m_frame->GetCanvas()->ForceRefresh();
+    return true;
+}
