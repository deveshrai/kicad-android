@@ -2943,6 +2962,36 @@ bool PCB_EDIT_FRAME::interactiveOperationInProgress() const
 }
 
 
+void PCB_EDIT_FRAME::onDocumentFilesChanged( const std::vector<wxString>& aFiles )
+{
+    wxString name = aFiles.empty() ? wxString() : wxFileName( aFiles.front() ).GetFullName();
+
+    // Neither choice is safe without asking: reloading discards the unsaved edits, keeping
+    // them means the next save overwrites what changed on disk
+    if( IsContentModified() )
+    {
+        wxMessageDialog dlg( this,
+                             wxString::Format( _( "%s changed on disk while you had unsaved edits.\n\n"
+                                                  "Reloading loses your edits. Keeping them means "
+                                                  "your next save overwrites the changes on disk." ),
+                                               name ),
+                             _( "Board Changed on Disk" ),
+                             wxYES_NO | wxNO_DEFAULT | wxICON_WARNING | wxCENTER );
+        dlg.SetYesNoLabels( _( "&Reload" ), _( "&Keep My Edits" ) );
+
+        if( dlg.ShowModal() != wxID_YES )
+            return;
+    }
+
+    if( ReloadFromDisk() && GetInfoBar() )
+    {
+        GetInfoBar()->ShowMessageFor( wxString::Format( _( "Reloaded %s, which changed on disk." ),
+                                                        name ),
+                                      6000 );
+    }
+}
+
+
 bool PCB_EDIT_FRAME::CanAcceptApiCommands()
 {
     if( interactiveOperationInProgress() )
