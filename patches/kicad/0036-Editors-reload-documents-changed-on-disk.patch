+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+
+#include <document_file_watcher.h>
+
+#include <eda_base_frame.h>
+
+#include <wx/filename.h>
+
+
+DOCUMENT_FILE_WATCHER::DOCUMENT_FILE_WATCHER( EDA_BASE_FRAME* aFrame, FILES_FN aFiles,
+                                              CHANGED_FN aOnChanged, int aIntervalMs ) :
+        m_frame( aFrame ),
+        m_files( std::move( aFiles ) ),
+        m_onChanged( std::move( aOnChanged ) ),
+        m_timer( this )
+{
+    Bind( wxEVT_TIMER, &DOCUMENT_FILE_WATCHER::onTimer, this, m_timer.GetId() );
+    m_timer.Start( aIntervalMs );
+}
+
+
+DOCUMENT_FILE_WATCHER::~DOCUMENT_FILE_WATCHER()
+{
+    m_timer.Stop();
+}
+
+
+DOCUMENT_FILE_WATCHER::STAMPS DOCUMENT_FILE_WATCHER::stamp() const
+{
+    STAMPS stamps;
+
+    for( const wxString& file : m_files() )
+    {
+        wxFileName fn( file );
+
+        if( file.IsEmpty() || !fn.FileExists() )
+            continue;
+
+        STAMP s;
+        s.mtime = fn.GetModificationTime().GetValue();
+        s.size = fn.GetSize();
+        stamps[fn.GetFullPath()] = s;
+    }
+
+    return stamps;
+}
+
+
+void DOCUMENT_FILE_WATCHER::Snapshot()
+{
+    m_baseline = stamp();
+    m_pending.clear();
+}
+
+
+void DOCUMENT_FILE_WATCHER::onTimer( wxTimerEvent& aEvent )
+{
+    if( m_inCallback || !m_frame || !m_frame->CanAcceptApiCommands() )
+        return;
+
+    STAMPS now = stamp();
+
+    // Another document, or the same one under a new name: nothing to compare with yet
+    bool sameFiles = now.size() == m_baseline.size();
+
+    for( auto it = now.begin(); sameFiles && it != now.end(); ++it )
+        sameFiles = m_baseline.count( it->first ) > 0;
+
+    if( !sameFiles )
+    {
+        m_baseline = now;
+        m_pending.clear();
+        return;
+    }
+
+    std::vector<wxString> changed;
+
+    for( const auto& [file, s] : now )
+    {
+        if( m_baseline[file] != s )
+            changed.push_back( file );
+    }
+
+    if( changed.empty() )
+    {
+        m_pending.clear();
+        return;
+    }
+
+    // Wait for the writer to finish: report the change once two polls agree
+    if( m_pending != now )
+    {
+        m_pending = now;
+        return;
+    }
+
+    m_baseline = now;
+    m_pending.clear();
+
+    m_inCallback = true;
+    m_onChanged( changed );
+    m_inCallback = false;
+}
