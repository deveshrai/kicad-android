+#pragma once
+
+#include <wx/event.h>
+#include <wx/longlong.h>
+#include <wx/string.h>
+#include <wx/timer.h>
+
+#include <functional>
+#include <map>
+#include <vector>
+
+class EDA_BASE_FRAME;
+
+/**
+ * Notices when the files an editor has open change on disk behind its back, for example when
+ * an AI agent or a script edits them, so the editor can reload instead of showing (and later
+ * saving over) a stale copy.
+ *
+ * Polls the files' modification times and sizes, which works on every file system, Android's
+ * shared storage included.  A change is reported once it has held for two polls, so a file
+ * still being written is not read half done, and only while the frame could take an API
+ * command (no modal dialog, no interactive tool running).  The editor calls Snapshot() after
+ * it saves, so its own writes are not reported.  A different set of files (another document
+ * opened, Save As) is taken as the new baseline without a report.
+ */
+class DOCUMENT_FILE_WATCHER : public wxEvtHandler
+{
+public:
+    using FILES_FN = std::function<std::vector<wxString>()>;
+    using CHANGED_FN = std::function<void( const std::vector<wxString>& aChangedFiles )>;
+
+    DOCUMENT_FILE_WATCHER( EDA_BASE_FRAME* aFrame, FILES_FN aFiles, CHANGED_FN aOnChanged,
+                           int aIntervalMs = 1000 );
+    ~DOCUMENT_FILE_WATCHER();
+
+    /// Take the files as they are now as the baseline; call after saving them.
+    void Snapshot();
+
+private:
+    struct STAMP
+    {
+        wxLongLong  mtime;
+        wxULongLong size;
+
+        bool operator==( const STAMP& aOther ) const
+        {
+            return mtime == aOther.mtime && size == aOther.size;
+        }
+
+        bool operator!=( const STAMP& aOther ) const { return !( *this == aOther ); }
+    };
+
+    using STAMPS = std::map<wxString, STAMP>;
+
+    STAMPS stamp() const;
+    void   onTimer( wxTimerEvent& aEvent );
+
+    EDA_BASE_FRAME* m_frame;
+    FILES_FN        m_files;
+    CHANGED_FN      m_onChanged;
+    wxTimer         m_timer;
+    STAMPS          m_baseline;
+    STAMPS          m_pending;      ///< a change seen at the last poll, reported if it holds
+    bool            m_inCallback = false;
+};
