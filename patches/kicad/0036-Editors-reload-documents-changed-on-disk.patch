+            {
+                onDocumentFilesChanged( aFiles );
+            } );
     subscribeConnectivity();
 
     if( Kiface().IsSingle() )
@@ -611,6 +637,7 @@ void SCH_EDIT_FRAME::OnCrossProbeFlashTimer( wxTimerEvent& aEvent )
 
 SCH_EDIT_FRAME::~SCH_EDIT_FRAME()
 {
+    m_documentWatcher.reset();
     m_crossProbeFlashing = false;
     m_crossProbeFlashTimer.Stop();
 
@@ -3647,6 +3674,39 @@ bool SCH_EDIT_FRAME::interactiveOperationInProgress() const
 }
 
 
+void SCH_EDIT_FRAME::onDocumentFilesChanged( const std::vector<wxString>& aFiles )
+{
+    wxString names;
+
+    for( const wxString& file : aFiles )
+        names += ( names.IsEmpty() ? wxString() : wxString( wxS( ", " ) ) ) + wxFileName( file ).GetFullName();
+
+    // Neither choice is safe without asking: reloading discards the unsaved edits, keeping
+    // them means the next save overwrites what changed on disk
+    if( IsContentModified() )
+    {
+        wxMessageDialog dlg( this,
+                             wxString::Format( _( "%s changed on disk while you had unsaved edits.\n\n"
+                                                  "Reloading loses your edits. Keeping them means "
+                                                  "your next save overwrites the changes on disk." ),
+                                               names ),
+                             _( "Schematic Changed on Disk" ),
+                             wxYES_NO | wxNO_DEFAULT | wxICON_WARNING | wxCENTER );
+        dlg.SetYesNoLabels( _( "&Reload" ), _( "&Keep My Edits" ) );
+
+        if( dlg.ShowModal() != wxID_YES )
+            return;
+    }
+
+    if( ReloadFromDisk() && GetInfoBar() )
+    {
+        GetInfoBar()->ShowMessageFor( wxString::Format( _( "Reloaded %s, which changed on disk." ),
+                                                        names ),
+                                      6000 );
+    }
+}
+
+
 bool SCH_EDIT_FRAME::CanAcceptApiCommands()
 {
     if( interactiveOperationInProgress() )
