+ * with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include <android_coroutine_stacks.h>
+
+#include <android/log.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+
+namespace
+{
+/// Room left for the thread's own (main) stack above the pool
+constexpr std::size_t MAIN_STACK_HEADROOM = 32 * 1024 * 1024;
+
+/// Kept clear at the bottom of the thread stack (ART's guard and reserved overflow area)
+constexpr std::size_t BOTTOM_RESERVE = 1024 * 1024;
+
+/// Don't bother with small thread stacks: they can't hold coroutine stacks
+constexpr std::size_t MIN_THREAD_STACK = 128 * 1024 * 1024;
+
+
+struct BLOCK
+{
+    std::uintptr_t base;
+    std::size_t    size;
+};
+
+
+class POOL
+{
+public:
+    void* Alloc( std::size_t aSize )
+    {
+        std::lock_guard<std::mutex> lock( m_mutex );
+
+        if( !m_initialized )
+            init();
+
+        // Only the thread whose stack hosts the pool may use it
+        if( !m_enabled || !pthread_equal( pthread_self(), m_owner ) )
+            return nullptr;
+
+        for( auto it = m_free.begin(); it != m_free.end(); ++it )
+        {
+            if( it->size == aSize )
+            {
+                std::uintptr_t base = it->base;
+                m_free.erase( it );
+                return reinterpret_cast<void*>( base );
+            }
+        }
+
+        if( m_next - m_floor < aSize )
+        {
+            __android_log_print( ANDROID_LOG_WARN, "KiCad",
+                                 "coroutine stack pool exhausted, using heap stack" );
+            return nullptr;
+        }
+
+        m_next -= aSize;
+        return reinterpret_cast<void*>( m_next );
+    }
+
+    bool Free( void* aBase, std::size_t aSize )
+    {
+        std::lock_guard<std::mutex> lock( m_mutex );
+        std::uintptr_t base = reinterpret_cast<std::uintptr_t>( aBase );
+
+        if( !m_enabled || base < m_floor || base >= m_ceiling )
+            return false;
+
+        // The caller turned the lowest page into a guard page; make it usable again
+        mprotect( aBase, getpagesize(), PROT_READ | PROT_WRITE );
+        m_free.push_back( { base, aSize } );
+        return true;
+    }
+
+private:
+    void init()
+    {
+        m_initialized = true;
+        m_owner = pthread_self();
+
+        pthread_attr_t attr;
+
+        if( pthread_getattr_np( m_owner, &attr ) != 0 )
+            return;
+
+        void*       stackAddr = nullptr;
+        std::size_t stackSize = 0;
+        pthread_attr_getstack( &attr, &stackAddr, &stackSize );
+        pthread_attr_destroy( &attr );
+
+        const std::uintptr_t page = getpagesize();
+        const std::uintptr_t here = reinterpret_cast<std::uintptr_t>( __builtin_frame_address( 0 ) );
+        const std::uintptr_t bottom = reinterpret_cast<std::uintptr_t>( stackAddr );
+
+        if( stackSize < MIN_THREAD_STACK || here < bottom + MAIN_STACK_HEADROOM + BOTTOM_RESERVE )
+        {
+            __android_log_print( ANDROID_LOG_WARN, "KiCad",
+                                 "thread stack too small (%zu KB) for coroutine stacks",
+                                 stackSize / 1024 );
+            return;
+        }
+
+        m_ceiling = ( here - MAIN_STACK_HEADROOM ) & ~( page - 1 );
+        m_floor = ( bottom + BOTTOM_RESERVE + page - 1 ) & ~( page - 1 );
+        m_next = m_ceiling;
+        m_enabled = true;
+
+        __android_log_print( ANDROID_LOG_INFO, "KiCad", "coroutine stack pool: %zu MB",
+                             static_cast<std::size_t>( ( m_ceiling - m_floor ) >> 20 ) );
+    }
+
+    std::mutex         m_mutex;
+    bool               m_initialized = false;
+    bool               m_enabled = false;
+    pthread_t          m_owner = {};
+    std::uintptr_t     m_floor = 0;     ///< Lowest usable address
+    std::uintptr_t     m_ceiling = 0;   ///< One past the highest usable address
+    std::uintptr_t     m_next = 0;      ///< Bump allocator, grows down from m_ceiling
+    std::vector<BLOCK> m_free;
+};
+
+
+POOL& pool()
+{
+    static POOL s_pool;
+    return s_pool;
+}
+} // namespace
+
+
+void* KiAndroidAllocCoroutineStack( std::size_t aSize )
+{
+    return pool().Alloc( aSize );
+}
+
+
+bool KiAndroidFreeCoroutineStack( void* aBase, std::size_t aSize )
+{
+    return pool().Free( aBase, aSize );
+}
