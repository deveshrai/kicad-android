+
+#ifndef ANDROID_COROUTINE_STACKS_H
+#define ANDROID_COROUTINE_STACKS_H
+
+#ifdef __ANDROID__
+
+#include <cstddef>
+#include <kicommon.h>
+
+/*
+ * Tool coroutines call into Java (window creation, dialogs, clipboard, ...).  The Android
+ * runtime only accepts Java frames and JNI references inside the calling thread's own stack,
+ * so coroutine stacks allocated elsewhere fail ("invalid JNI transition frame reference",
+ * spurious StackOverflowError).  The Qt main-loop thread is therefore started with a very
+ * large stack, and coroutine stacks are carved out of its lower part.
+ */
+
+/**
+ * Reserve a coroutine stack of @p aSize bytes (a multiple of the page size) inside the
+ * current thread's stack.
+ *
+ * @return the lowest address of the block, or nullptr when the thread's stack is too small
+ *         or the pool is exhausted; the caller then falls back to ordinary memory.
+ */
+KICOMMON_API void* KiAndroidAllocCoroutineStack( std::size_t aSize );
+
+/**
+ * Return a block obtained from KiAndroidAllocCoroutineStack().
+ *
+ * @return false if @p aBase was not allocated by the pool (the caller frees it itself).
+ */
+KICOMMON_API bool KiAndroidFreeCoroutineStack( void* aBase, std::size_t aSize );
+
+#endif // __ANDROID__
+
+#endif // ANDROID_COROUTINE_STACKS_H
