         std::size_t m_size = 0;
 
         void SetSize( std::size_t aSize ) { m_size = aSize; }
-        void operator()( void* aMem ) noexcept { ::munmap( aMem, m_size ); }
+        void operator()( void* aMem ) noexcept
+        {
+#ifdef __ANDROID__
+            if( KiAndroidFreeCoroutineStack( aMem, m_size ) )
+                return;
