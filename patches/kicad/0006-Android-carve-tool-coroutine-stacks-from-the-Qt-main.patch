+        // Java frames on a coroutine stack must lie inside the thread's own stack
+        if( void* threadStackMem = KiAndroidAllocCoroutineStack( aAllocSize ) )
+            return threadStackMem;
+#endif
+
         void* mem = ::mmap( 0, aAllocSize, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0 );
 
         if( mem == (void*) -1 )
