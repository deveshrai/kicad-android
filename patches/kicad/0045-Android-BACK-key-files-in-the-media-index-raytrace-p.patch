diff --git a/3d-viewer/3d_rendering/raytracing/render_3d_raytrace_gl.cpp b/3d-viewer/3d_rendering/raytracing/render_3d_raytrace_gl.cpp
index d99df30e..7e4f24bf 100644
--- a/3d-viewer/3d_rendering/raytracing/render_3d_raytrace_gl.cpp
+++ b/3d-viewer/3d_rendering/raytracing/render_3d_raytrace_gl.cpp
@@ -315,7 +315,31 @@ uint8_t* RENDER_3D_RAYTRACE_GL::mapPixels()
         const size_t size = size_t( m_realBufferSize.x ) * size_t( m_realBufferSize.y ) * 4;
 
         if( m_clientPixels.size() != size )
-            m_clientPixels.assign( size, 0 );
+        {
+            // Start from the background, which the blocks then cover as they are traced
+            m_clientPixels.resize( size );
+
+            const SFVEC4F top = m_boardAdapter.m_BgColorTop;
+            const SFVEC4F bottom = m_boardAdapter.m_BgColorBot;
+            const unsigned int width = m_realBufferSize.x;
+            const unsigned int height = m_realBufferSize.y;
+
+            for( unsigned int y = 0; y < height; ++y )
+            {
+                // Row 0 is the bottom of the window
+                const float t = height > 1 ? float( y ) / float( height - 1 ) : 0.0f;
+                const uint8_t rgba[4] = {
+                    uint8_t( std::clamp( ( bottom.r + ( top.r - bottom.r ) * t ) * 255.0f, 0.0f, 255.0f ) ),
+                    uint8_t( std::clamp( ( bottom.g + ( top.g - bottom.g ) * t ) * 255.0f, 0.0f, 255.0f ) ),
+                    uint8_t( std::clamp( ( bottom.b + ( top.b - bottom.b ) * t ) * 255.0f, 0.0f, 255.0f ) ),
+                    255
+                };
+                uint8_t* row = &m_clientPixels[size_t( y ) * width * 4];
+
+                for( unsigned int x = 0; x < width; ++x )
+                    std::copy( rgba, rgba + 4, row + size_t( x ) * 4 );
+            }
+        }
 
         return m_clientPixels.data();
     }
