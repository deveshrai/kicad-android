         if( qobject_cast<QMessageBox*>( aWidget ) )
             at = QPoint( ( image.width() - part.width() ) / 2, ( image.height() - part.height() ) / 2 );
 
+        // The frame and title strip that the platform draws around a dialog (Qt's Android
+        // plugin, in QtWindow) are not part of the widget: draw them the same way, from the frame
+        // margins it reports and the colours it takes from the palette
+        if( QWindow* window = aWidget->windowHandle(); window && !qobject_cast<QMessageBox*>( aWidget ) )
+        {
+            const QMargins margins = window->frameMargins();
+
+            if( !margins.isNull() )
+            {
+                const auto blend = []( const QColor& aBase, const QColor& aOther, qreal aAmount )
+                {
+                    return QColor::fromRgbF( aBase.redF() + ( aOther.redF() - aBase.redF() ) * aAmount,
+                                             aBase.greenF() + ( aOther.greenF() - aBase.greenF() ) * aAmount,
+                                             aBase.blueF() + ( aOther.blueF() - aBase.blueF() ) * aAmount );
+                };
+
+                const QPalette palette = QGuiApplication::palette();
+                const QColor   bg = palette.color( QPalette::Active, QPalette::Window );
+                const QColor   fg = palette.color( QPalette::Active, QPalette::WindowText );
+                const int      left = qRound( margins.left() * dpr );
+                const int      top = qRound( margins.top() * dpr );
+                const int      right = qRound( margins.right() * dpr );
+                const int      bottom = qRound( margins.bottom() * dpr );
+                const QRect    outer( at.x() - left, at.y() - top, part.width() + left + right,
+                                      part.height() + top + bottom );
+                const QRect    strip( outer.left() + left, outer.top() + left, outer.width() - left - right,
+                                      top - left );
+
+                painter.fillRect( outer, blend( bg, fg, 0.4 ) );
+                painter.fillRect( strip, blend( bg, fg, 0.14 ) );
+
+                QFont font = QGuiApplication::font();
+                font.setBold( true );
+                font.setPixelSize( qMax( 1, qRound( strip.height() * 0.44 ) ) );
+                painter.setFont( font );
+                painter.setPen( fg );
+
+                const int pad = qRound( strip.height() * 0.4 );
+                const bool cross = window->flags() & Qt::WindowCloseButtonHint;
+                const QRect text( strip.left() + pad, strip.top(),
+                                  strip.width() - pad - ( cross ? strip.height() : pad ), strip.height() );
+
+                painter.drawText( text, Qt::AlignVCenter | Qt::AlignLeft,
+                                  QFontMetrics( font ).elidedText( window->title(), Qt::ElideRight,
+                                                                   text.width() ) );
+
+                if( cross )
+                {
+                    const QPointF c( strip.right() - strip.height() / 2.0, strip.center().y() );
+                    const qreal   arm = strip.height() * 0.16;
+                    QPen          pen( fg, qMax( 2.0, strip.height() * 0.05 ) );
+
+                    painter.setPen( pen );
+                    painter.drawLine( c + QPointF( -arm, -arm ), c + QPointF( arm, arm ) );
+                    painter.drawLine( c + QPointF( -arm, arm ), c + QPointF( arm, -arm ) );
+                }
+            }
+        }
+
         painter.drawImage( at, part );
     };
 
