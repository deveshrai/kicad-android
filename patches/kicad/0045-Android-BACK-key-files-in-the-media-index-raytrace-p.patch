+/**
+ * Files KiCad writes to shared storage (exports, plots, saved projects) are not in Android's
+ * media index until something adds them, so other apps' file pickers don't list them (the
+ * SolidCraft STEP import found no file).  The writers are many and mostly plain fopen(), so
+ * rather than hook each one, a thread looks every few seconds at the open project's folder
+ * (KIPRJMOD, a few levels deep) and the top of Documents and Download, and hands every file
+ * changed since the last look to MediaScannerConnection.scanFile().
+ */
+void scanFiles( const std::vector<std::string>& aPaths )
+{
+    if( aPaths.empty() )
+        return;
+
+    QJniEnvironment env;
+    QJniObject      ctx = QNativeInterface::QAndroidApplication::context();
+
+    if( !ctx.isValid() || !env.isValid() )
+        return;
+
+    jclass       stringClass = env->FindClass( "java/lang/String" );
+    jobjectArray paths = env->NewObjectArray( static_cast<jsize>( aPaths.size() ), stringClass, nullptr );
+
+    for( size_t i = 0; i < aPaths.size(); ++i )
+    {
+        jstring path = env->NewStringUTF( aPaths[i].c_str() );
+        env->SetObjectArrayElement( paths, static_cast<jsize>( i ), path );
+        env->DeleteLocalRef( path );
+    }
+
+    QJniObject::callStaticMethod<void>(
+            "android/media/MediaScannerConnection", "scanFile",
+            "(Landroid/content/Context;[Ljava/lang/String;[Ljava/lang/String;"
+            "Landroid/media/MediaScannerConnection$OnScanCompletedListener;)V",
+            ctx.object(), paths, nullptr, nullptr );
+
+    env->DeleteLocalRef( paths );
+    env->DeleteLocalRef( stringClass );
+    env.checkAndClearExceptions();
+}
+
+
+void collectChanged( const std::filesystem::path& aDir, int aDepth,
+                     std::filesystem::file_time_type aSince, std::vector<std::string>& aOut )
+{
+    namespace fs = std::filesystem;
+    std::error_code ec;
+
+    for( fs::directory_iterator it( aDir, fs::directory_options::skip_permission_denied, ec ), end;
+         !ec && it != end; it.increment( ec ) )
+    {
+        const fs::path& path = it->path();
+        const std::string name = path.filename().string();
+
+        if( name.empty() || name[0] == '.' || name[0] == '~' )
+            continue;   // hidden files, KiCad's lock files
+
+        if( it->is_directory( ec ) )
+        {
+            if( aDepth > 0 )
+                collectChanged( path, aDepth - 1, aSince, aOut );
+        }
+        else if( it->is_regular_file( ec ) && it->last_write_time( ec ) > aSince && !ec )
+        {
+            aOut.push_back( path.string() );
+
+            if( aOut.size() >= 2000 )
+                return;
+        }
+    }
+}
+
+
+void startMediaIndexer()
+{
+    static std::once_flag once;
+
+    std::call_once( once,
+            []()
+            {
+                std::thread(
+                        []()
+                        {
+                            namespace fs = std::filesystem;
+                            const std::string shared = "/storage/emulated/0";
+                            auto              since = fs::file_time_type::clock::now();
+
+                            for( ;; )
+                            {
+                                std::this_thread::sleep_for( std::chrono::seconds( 4 ) );
+
+                                const auto now = fs::file_time_type::clock::now();
+                                std::vector<std::string> changed;
+
+                                for( const char* top : { "/Documents", "/Download" } )
+                                    collectChanged( shared + top, 0, since, changed );
+
+                                if( const char* project = getenv( "KIPRJMOD" ) )
+                                {
+                                    std::string dir( project );
+
+                                    // Only shared storage needs indexing, and the top folders
+                                    // were looked at already
+                                    if( dir.rfind( "/storage/", 0 ) == 0
+                                        && dir != shared + "/Documents" && dir != shared + "/Download" )
+                                    {
+                                        collectChanged( dir, 3, since, changed );
+                                    }
+                                }
+
+                                since = now;
+                                scanFiles( changed );
+                            }
+                        } ).detach();
+            } );
+}
