 /// XDG-style fallback under $HOME for processes without a Java VM
 wxString homePath( const wxString& aSubdir )
 {
@@ -203,6 +223,37 @@ wxString extractStockData()
 
 void KIPLATFORM::ENV::Init()
 {
+    // Development aid: apps cannot be given environment variables, so take wxWidgets trace
+    // masks from a system property:  adb shell setprop debug.kicad.wxtrace KICAD_RHI
+    // (or, since apps may not read debug.* properties, a "wxtrace" file in the app's home)
+    char     traceProp[PROP_VALUE_MAX] = {};
+    wxString traceMasks;
+    wxString home;
+
+    if( __system_property_get( "debug.kicad.wxtrace", traceProp ) > 0 )
+        traceMasks = wxString::FromUTF8( traceProp );
+    else if( wxGetEnv( wxT( "HOME" ), &home ) )
+        wxFFile( home + wxT( "/wxtrace" ) ).ReadAll( &traceMasks );
+
+    traceMasks.Trim().Trim( false );
+
+    if( !traceMasks.IsEmpty() )
+    {
+        // wx sends trace output to stderr, which Android discards; send everything to logcat
+        wxLog::SetActiveTarget( new LOGCAT_LOG );
+
+        // Release builds turn logging off unless asked (kicad.cpp, single_top.cpp)
+        wxSetEnv( wxT( "KICAD_ENABLE_WXTRACE" ), wxT( "1" ) );
+        wxLog::SetLogLevel( wxLOG_Max );
+        __android_log_print( ANDROID_LOG_INFO, "KiCad-wx", "tracing: %s",
+                             static_cast<const char*>( traceMasks.utf8_str() ) );
+
+        wxStringTokenizer masks( traceMasks, wxT( ",;:\n" ) );
+
+        while( masks.HasMoreTokens() )
+            wxLog::AddTraceMask( masks.GetNextToken() );
+    }
+
     // GPU canvases (Vulkan QWindows, see port/wxqt/ui.cpp) must composite with the rest of the
     // UI.  A SurfaceView sits behind the activity window, where KiCad's other frames, dialogs and
     // popups (views in the same activity surface) cover it; a TextureView is part of the view
