+/// wxLog target writing to logcat (tag "KiCad-wx"), used when tracing is requested
+class LOGCAT_LOG : public wxLog
+{
+protected:
+    void DoLogTextAtLevel( wxLogLevel aLevel, const wxString& aMsg ) override
+    {
+        int prio = aLevel <= wxLOG_Error ? ANDROID_LOG_ERROR
+                 : aLevel == wxLOG_Warning ? ANDROID_LOG_WARN
+                 : aLevel >= wxLOG_Debug ? ANDROID_LOG_DEBUG : ANDROID_LOG_INFO;
+
+        __android_log_write( prio, "KiCad-wx", aMsg.utf8_str() );
+    }
+};
