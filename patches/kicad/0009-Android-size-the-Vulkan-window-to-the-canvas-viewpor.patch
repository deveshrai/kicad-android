 #ifdef __ANDROID__
 /**
- * A Vulkan window embedded over a GAL canvas (Android).  The GPU renders into it while the
- * canvas widget underneath keeps receiving input: the window is transparent for input, and any
- * input event that still reaches it is handed to the canvas.
+ * A Vulkan window embedded over a GAL canvas (Android).  The GPU renders into it while the canvas
+ * widget underneath stays the target of input and paint handling:
+ *  - Android delivers pointer, wheel and key events to this window's view (the topmost one), so
+ *    they are forwarded to the canvas.
+ *  - The canvas is fully covered and gets no paint events of its own, yet KiCad renders a frame
+ *    in response to paint; exposure and resizes of this window are turned into canvas repaints.
  */
 class VULKAN_CANVAS_WINDOW : public QWindow
 {
 public:
-    explicit VULKAN_CANVAS_WINDOW( QWidget* aCanvas ) : m_canvas( aCanvas )
+    /// aCanvas is the canvas' own widget (keyboard focus), aViewport the client area that
+    /// receives its pointer and paint events (the scroll area viewport on wxQt)
+    VULKAN_CANVAS_WINDOW( QWidget* aCanvas, QWidget* aViewport ) :
+            m_canvas( aCanvas ), m_viewport( aViewport )
     {
         // Composited as a TextureView (QT_ANDROID_SURFACE_CONTAINER_TYPE, set in
         // KIPLATFORM::ENV::Init), so it stacks correctly with frames, dialogs and popups
         setSurfaceType( QSurface::VulkanSurface );
-        setFlag( Qt::WindowTransparentForInput );
     }
 
 protected:
+    void exposeEvent( QExposeEvent* aEvent ) override
+    {
+        QWindow::exposeEvent( aEvent );
+
+        if( isExposed() )
+            repaintCanvas();
+    }
+
+    void resizeEvent( QResizeEvent* aEvent ) override
+    {
+        QWindow::resizeEvent( aEvent );
+        repaintCanvas();
+    }
+
     bool event( QEvent* aEvent ) override
     {
         switch( aEvent->type() )
@@ -90,15 +113,20 @@ protected:
         case QEvent::MouseButtonDblClick:
         case QEvent::MouseMove:
         case QEvent::Wheel:
-        case QEvent::KeyPress:
-        case QEvent::KeyRelease:
         case QEvent::TouchBegin:
         case QEvent::TouchUpdate:
         case QEvent::TouchEnd:
         case QEvent::TabletPress:
         case QEvent::TabletMove:
         case QEvent::TabletRelease:
-            // The window covers the canvas at (0,0), so positions are already canvas-local
+            // The window covers the viewport at (0,0), so positions are already viewport-local
+            if( m_viewport )
+                return QCoreApplication::sendEvent( m_viewport, aEvent );
+
+            break;
+
+        case QEvent::KeyPress:
+        case QEvent::KeyRelease:
             if( m_canvas )
                 return QCoreApplication::sendEvent( m_canvas, aEvent );
 
@@ -112,11 +140,22 @@ protected:
     }
 
 private:
+    /// Ask the canvas for a frame, as a paint event would on desktop
+    void repaintCanvas()
+    {
+        if( m_viewport )
+        {
+            QPaintEvent paint( m_viewport->rect() );
+            QCoreApplication::sendEvent( m_viewport, &paint );
+        }
+    }
+
     QPointer<QWidget> m_canvas;
+    QPointer<QWidget> m_viewport;
 };
 
 
-/// Keeps the Vulkan window's container covering its canvas
+/// Keeps the Vulkan window's container covering the canvas' client area
 class CANVAS_FOLLOWER : public QObject
 {
 public:
@@ -142,21 +181,27 @@ private:
 /// The Vulkan window for a canvas, created on first use (GUI thread)
 QWindow* vulkanWindowFor( QWidget* aCanvas )
 {
+
     if( QObject* existing = aCanvas->property( "kicadVulkanWindow" ).value<QObject*>() )
         return static_cast<QWindow*>( existing );
 
-    VULKAN_CANVAS_WINDOW* window = new VULKAN_CANVAS_WINDOW( aCanvas );
-    QWidget*              container = QWidget::createWindowContainer( window, aCanvas );
+    // The swapchain is sized from the wx client size, which on wxQt is the scroll area's
+    // viewport (inside the frame).  The surface must match it exactly or presentation waits
+    // for a size that never comes.
+    QWidget* viewport = aCanvas;
+
+    if( QAbstractScrollArea* area = qobject_cast<QAbstractScrollArea*>( aCanvas ) )
+        viewport = area->viewport();
 
-    // createWindowContainer() reparents the window, which resets its flags
-    window->setFlags( window->flags() | Qt::WindowTransparentForInput );
+    VULKAN_CANVAS_WINDOW* window = new VULKAN_CANVAS_WINDOW( aCanvas, viewport );
+    QWidget*              container = QWidget::createWindowContainer( window, viewport );
 
     container->setAttribute( Qt::WA_TransparentForMouseEvents );
     container->setFocusPolicy( Qt::NoFocus );
-    container->setGeometry( aCanvas->rect() );
+    container->setGeometry( viewport->rect() );
     container->show();
 
-    aCanvas->installEventFilter( new CANVAS_FOLLOWER( container, aCanvas ) );
+    viewport->installEventFilter( new CANVAS_FOLLOWER( container, viewport ) );
     aCanvas->setProperty( "kicadVulkanWindow", QVariant::fromValue<QObject*>( window ) );
     return window;
 }
