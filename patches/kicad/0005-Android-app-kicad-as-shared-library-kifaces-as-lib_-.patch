+namespace
+{
+/// Copies one APK asset to a file, creating parent directories.
+bool copyAsset( AAssetManager* aMgr, const std::string& aAsset, const std::string& aDest )
+{
+    AAsset* asset = AAssetManager_open( aMgr, aAsset.c_str(), AASSET_MODE_STREAMING );
+
+    if( !asset )
+        return false;
+
+    wxFileName::Mkdir( wxFileName( wxString::FromUTF8( aDest ) ).GetPath(), wxS_DIR_DEFAULT,
+                       wxPATH_MKDIR_FULL );
+
+    bool  ok = false;
+    FILE* out = fopen( aDest.c_str(), "wb" );
+
+    if( out )
+    {
+        char buf[65536];
+        int  n = 0;
+        ok = true;
+
+        while( ( n = AAsset_read( asset, buf, sizeof( buf ) ) ) > 0 )
+            ok &= fwrite( buf, 1, n, out ) == static_cast<size_t>( n );
+
+        ok &= fclose( out ) == 0 && n == 0;
+    }
+
+    AAsset_close( asset );
+    return ok;
+}
+
+
+/// Reads a small text asset, or returns an empty string.
+std::string readAsset( AAssetManager* aMgr, const char* aAsset )
+{
+    std::string text;
+
+    if( AAsset* asset = AAssetManager_open( aMgr, aAsset, AASSET_MODE_BUFFER ) )
+    {
+        text.assign( static_cast<const char*>( AAsset_getBuffer( asset ) ), AAsset_getLength( asset ) );
+        AAsset_close( asset );
+    }
+
+    return text;
+}
+
+
+/**
+ * KiCad reads its stock data (schemas, templates, drawing sheets, ...) from a directory.  The
+ * APK carries it as assets under kicad-data/, with FILES.txt listing every file (the NDK cannot
+ * list asset subdirectories) and VERSION identifying the build.  Extract it to app storage
+ * when the stamp differs from the last extraction.
+ */
+wxString extractStockData()
+{
+    QJniObject ctx = QNativeInterface::QAndroidApplication::context();
+
+    if( !ctx.isValid() )
+        return wxEmptyString;
+
+    QJniObject  filesDir = ctx.callObjectMethod( "getFilesDir", "()Ljava/io/File;" );
+    QString     filesPath = filesDir.callObjectMethod( "getAbsolutePath", "()Ljava/lang/String;" )
+                                    .toString();
+    QJniObject  assets = ctx.callObjectMethod( "getAssets", "()Landroid/content/res/AssetManager;" );
+    QJniEnvironment env;
+    AAssetManager*  mgr = AAssetManager_fromJava( env.jniEnv(), assets.object() );
+
+    if( !mgr || filesPath.isEmpty() )
+        return wxEmptyString;
+
+    const std::string root = filesPath.toStdString() + "/kicad-data";
+    const std::string version = readAsset( mgr, "kicad-data/VERSION" );
+    const std::string stampFile = root + "/.extracted";
+
+    std::string installed;
+
+    if( FILE* f = fopen( stampFile.c_str(), "rb" ) )
+    {
+        char buf[256] = {};
+        installed.assign( buf, fread( buf, 1, sizeof( buf ) - 1, f ) );
+        fclose( f );
+    }
+
+    if( version.empty() || installed != version )
+    {
+        std::istringstream list( readAsset( mgr, "kicad-data/FILES.txt" ) );
+        std::string        rel;
+        bool               ok = true;
+
+        while( std::getline( list, rel ) )
+        {
+            if( !rel.empty() )
+                // Assets carry a ".kad" suffix so aapt leaves them untouched (it would
+                // decompress *.gz); see scripts/build-kicad-apk.sh
+                ok &= copyAsset( mgr, "kicad-data/" + rel + ".kad", root + "/" + rel );
+        }
+
+        if( ok && !version.empty() )
+        {
+            if( FILE* f = fopen( stampFile.c_str(), "wb" ) )
+            {
+                fwrite( version.data(), 1, version.size(), f );
+                fclose( f );
+            }
+        }
+    }
+
+    return wxString::FromUTF8( root ) + wxT( "/kicad" );
+}
+} // namespace
+
+
 void KIPLATFORM::ENV::Init()
 {
+    // Without a Java VM (kicad-cli from a shell) the caller provides KICAD_STOCK_DATA_HOME
+    if( !hasJavaVM() || wxGetEnv( wxT( "KICAD_STOCK_DATA_HOME" ), nullptr ) )
+        return;
+
+    wxString stockData = extractStockData();
+
+    if( !stockData.IsEmpty() )
+        wxSetEnv( wxT( "KICAD_STOCK_DATA_HOME" ), stockData );
 }
 
 
