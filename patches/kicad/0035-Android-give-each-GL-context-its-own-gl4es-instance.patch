diff --git a/common/kicad_gl/gl_context_mgr.cpp b/common/kicad_gl/gl_context_mgr.cpp
index a6c1572a..a88aecc8 100644
--- a/common/kicad_gl/gl_context_mgr.cpp
+++ b/common/kicad_gl/gl_context_mgr.cpp
@@ -25,6 +25,58 @@
 #include <wx/debug.h>
 #include <wx/log.h>
 
+#ifdef __ANDROID__
+#include <android/dlext.h>
+#include <dlfcn.h>
+
+
+// gl4es keeps its GL state in globals.  Loading the library again (a forced load gets a copy
+// with its own globals, from the same file in the APK) gives a context a state of its own.
+static void* openGl4es( bool aNewInstance )
+{
+    static void* base = dlopen( "libGL.so", RTLD_NOW | RTLD_LOCAL | RTLD_NODELETE );
+
+    if( !aNewInstance || !base )
+        return base;
+
+    Dl_info info{};
+    void*   sym = dlsym( base, "gl4es_GetProcAddress" );
+
+    if( !sym || !dladdr( sym, &info ) || !info.dli_fname )
+        return base;
+
+    android_dlextinfo ext{};
+    ext.flags = ANDROID_DLEXT_FORCE_LOAD;
+
+    void* instance = android_dlopen_ext( info.dli_fname, RTLD_NOW | RTLD_LOCAL | RTLD_NODELETE,
+                                         &ext );
+
+    wxLogTrace( traceGalContext, wxS( "gl4es: new instance %p from %s" ), instance,
+                info.dli_fname );
+
+    return instance ? instance : base;
+}
+
+
+static GLADapiproc gl4esProc( void* aInstance, const char* aName )
+{
+    if( void* proc = dlsym( aInstance, aName ) )
+        return reinterpret_cast<GLADapiproc>( proc );
+
+    using GET_PROC = void* ( * )( const char* );
+    static thread_local void*    lastInstance = nullptr;
+    static thread_local GET_PROC getProc = nullptr;
+
+    if( lastInstance != aInstance )
+    {
+        getProc = reinterpret_cast<GET_PROC>( dlsym( aInstance, "gl4es_GetProcAddress" ) );
+        lastInstance = aInstance;
+    }
+
+    return getProc ? reinterpret_cast<GLADapiproc>( getProc( aName ) ) : nullptr;
+}
+#endif
+
 
 static bool resetRecoveryEnabled()
 {
@@ -79,6 +131,12 @@ wxGLContext* GL_CONTEXT_MANAGER::CreateCtx( wxGLCanvas* aCanvas, const wxGLConte
 
     m_glContexts.insert( std::make_pair( context, aCanvas ) );
 
+#ifdef __ANDROID__
+    // The first context uses the instance loaded at startup; later ones get their own
+    m_gl4es[context] = openGl4es( m_baseGl4esUsed );
+    m_baseGl4esUsed = true;
+#endif
+
     if( loseOnReset )
         m_loseOnResetContexts.insert( context );
 
@@ -92,6 +150,9 @@ void GL_CONTEXT_MANAGER::DestroyCtx( wxGLContext* aContext )
     {
         m_glContexts.erase( aContext );
         m_loseOnResetContexts.erase( aContext );
+#ifdef __ANDROID__
+        m_gl4es.erase( aContext );
+#endif
         delete aContext;
     }
     else
@@ -148,10 +209,42 @@ bool GL_CONTEXT_MANAGER::LockCtx( wxGLContext* aContext, wxGLCanvas* aCanvas )
 
     m_glCtx = aContext;
 
+#ifdef __ANDROID__
+    // Point glad at this context's gl4es; a context not yet loaded does that in LoadGL()
+    auto it = m_gl4es.find( aContext );
+
+    if( current && it != m_gl4es.end() && it->second && m_loadedGl4es
+        && it->second != m_loadedGl4es )
+    {
+        if( gladLoadGLUserPtr( gl4esProc, it->second ) )
+            m_loadedGl4es = it->second;
+    }
+#endif
+
     return current;
 }
 
 
+int GL_CONTEXT_MANAGER::LoadGL()
+{
+#ifdef __ANDROID__
+    auto it = m_gl4es.find( m_glCtx );
+
+    if( it != m_gl4es.end() && it->second )
+    {
+        int version = gladLoadGLUserPtr( gl4esProc, it->second );
+
+        if( version )
+            m_loadedGl4es = it->second;
+
+        return version;
+    }
+#endif
+
+    return gladLoaderLoadGL();
+}
+
+
 void GL_CONTEXT_MANAGER::UnlockCtx( wxGLContext* aContext )
 {
     wxCHECK( aContext && m_glContexts.count( aContext ) > 0, /* void */ );
diff --git a/include/kicad_gl/gl_context_mgr.h b/include/kicad_gl/gl_context_mgr.h
index a0810124..e498d8a5 100644
--- a/include/kicad_gl/gl_context_mgr.h
+++ b/include/kicad_gl/gl_context_mgr.h
@@ -82,6 +82,17 @@ public:
      */
     bool LockCtx( wxGLContext* aContext, wxGLCanvas* aCanvas );
 
+    /**
+     * Load the OpenGL entry points (glad) for the locked context, in place of
+     * gladLoaderLoadGL().  Returns the GL version as gladLoaderLoadGL() does, or 0.
+     *
+     * On Android, GL is gl4es over GLES, which keeps one global GL state and cannot tell EGL
+     * contexts apart: a second context (the 3D viewer opened again) would start from the first
+     * one's state and draw nothing.  So each context gets its own gl4es instance, and locking a
+     * context points glad at that instance.
+     */
+    int LoadGL();
+
     /**
      * Allow other canvases to bind an OpenGL context.
      *
@@ -157,6 +168,13 @@ private:
     /// Contexts created with the lose-on-reset notification strategy.
     std::set<const wxGLContext*> m_loseOnResetContexts;
 
+#ifdef __ANDROID__
+    /// The gl4es instance (a dlopen handle) each context draws with, see LoadGL()
+    std::map<const wxGLContext*, void*> m_gl4es;
+    void* m_loadedGl4es = nullptr;   ///< the instance glad's entry points come from
+    bool  m_baseGl4esUsed = false;   ///< the instance loaded at startup has a context
+#endif
+
     /// Lock to prevent unexpected GL context switching.
     std::mutex m_glCtxMutex;
 };
