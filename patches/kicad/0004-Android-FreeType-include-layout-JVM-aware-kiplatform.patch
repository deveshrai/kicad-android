 #include <QDir>
 #include <QStandardPaths>
 
+#include <dlfcn.h>
+#include <jni.h>
+
 
 namespace
 {
-wxString standardPath( QStandardPaths::StandardLocation aLocation )
+/**
+ * QStandardPaths on Android asks the Java Context for its directories, which crashes in a
+ * process without a Java VM, e.g. kicad-cli started from a shell.  Detect the VM through
+ * JNI_GetCreatedJavaVMs, which is only resolvable once the runtime is loaded.
+ */
+bool hasJavaVM()
+{
+    using GET_VMS = jint ( * )( JavaVM**, jsize, jsize* );
+    static const bool s_hasVM = []()
+    {
+        auto getVMs = reinterpret_cast<GET_VMS>( dlsym( RTLD_DEFAULT, "JNI_GetCreatedJavaVMs" ) );
+        JavaVM* vm = nullptr;
+        jsize   count = 0;
+        return getVMs && getVMs( &vm, 1, &count ) == JNI_OK && count > 0;
+    }();
+
+    return s_hasVM;
+}
+
+
+/// XDG-style fallback under $HOME for processes without a Java VM
+wxString homePath( const wxString& aSubdir )
+{
+    wxString home;
+
+    if( !wxGetEnv( wxT( "HOME" ), &home ) || home.IsEmpty() )
+        home = wxT( "/data/local/tmp" );
+
+    wxFileName dir = wxFileName::DirName( home );
+
+    if( !aSubdir.IsEmpty() )
+        dir.AppendDir( aSubdir );
+
+    dir.Mkdir( wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+    return dir.GetPath();
+}
+
+
+wxString standardPath( QStandardPaths::StandardLocation aLocation, const wxString& aFallback )
 {
+    if( !hasJavaVM() )
+        return homePath( aFallback );
+
     const QString path = QStandardPaths::writableLocation( aLocation );
     QDir().mkpath( path );
     return wxString::FromUTF8( path.toUtf8().constData() );
@@ -80,31 +124,31 @@ wxString KIPLATFORM::ENV::GetDocumentsPath()
     // App-specific external storage: visible to the user over USB and in the Files app,
     // and needs no storage permission.  TODO(android): Storage Access Framework for
     // projects elsewhere.
-    return standardPath( QStandardPaths::DocumentsLocation );
+    return standardPath( QStandardPaths::DocumentsLocation, wxT( "Documents" ) );
 }
 
 
 wxString KIPLATFORM::ENV::GetUserConfigPath()
 {
-    return standardPath( QStandardPaths::AppConfigLocation );
