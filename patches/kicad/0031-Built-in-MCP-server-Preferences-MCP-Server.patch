+
+void MCP_SERVER::RegisterTool( const MCP_TOOL& aTool, const void* aOwner )
+{
+    std::lock_guard<std::mutex> lock( m_lock );
+
+    if( !m_tools.count( aTool.name ) )
+        m_toolOrder.push_back( aTool.name );
+
+    m_tools[aTool.name] = { aTool, aOwner };
+}
+
+
+void MCP_SERVER::SetToolHandler( const std::string& aName,
+                                 std::function<MCP_RESULT( const json& )> aHandler,
+                                 const void* aOwner, bool aMainThread )
+{
+    std::lock_guard<std::mutex> lock( m_lock );
+    auto it = m_tools.find( aName );
+
+    if( it == m_tools.end() )
+        return;
+
+    it->second.first.handler = std::move( aHandler );
+    it->second.first.mainThread = aMainThread;
+    it->second.second = aOwner;
+}
+
+
+void MCP_SERVER::UnregisterTools( const void* aOwner )
+{
+    std::lock_guard<std::mutex> lock( m_lock );
+
+    for( auto it = m_tools.begin(); it != m_tools.end(); )
+    {
+        if( it->second.second != aOwner )
+        {
+            ++it;
+        }
+        else if( m_fallbacks.count( it->first ) )
+        {
+            it->second = { m_fallbacks[it->first], this };
+            ++it;
+        }
+        else
+        {
+            m_toolOrder.erase( std::remove( m_toolOrder.begin(), m_toolOrder.end(), it->first ),
+                               m_toolOrder.end() );
+            it = m_tools.erase( it );
+        }
+    }
+}
