+
+wxString MCP_SERVER::NewToken()
+{
+    std::random_device rd;
+    std::string        token;
+    const char*        hex = "0123456789abcdef";
+
+    for( int i = 0; i < 32; ++i )
+        token += hex[rd() & 0xf];
+
+    return wxString::FromUTF8( token );
+}
+
+
+wxString MCP_SERVER::EnsureToken()
+{
+    COMMON_SETTINGS* settings = Pgm().GetCommonSettings();
+
+    if( settings->m_Mcp.token.IsEmpty() )
+    {
+        settings->m_Mcp.token = NewToken();
+        Pgm().GetSettingsManager().Save( settings );
+    }
+
+    return settings->m_Mcp.token;
+}
+
+
+std::string MCP_SERVER::LocalNetworkAddress()
+{
+    std::string best;
+
+#ifndef __WINDOWS__
+    ifaddrs* addrs = nullptr;
+
+    if( getifaddrs( &addrs ) != 0 )
+        return best;
+
+    for( ifaddrs* a = addrs; a; a = a->ifa_next )
+    {
+        if( !a->ifa_addr || a->ifa_addr->sa_family != AF_INET )
+            continue;
+
+        char buf[INET_ADDRSTRLEN] = {};
+        inet_ntop( AF_INET, &reinterpret_cast<sockaddr_in*>( a->ifa_addr )->sin_addr, buf,
+                   sizeof( buf ) );
+        std::string ip = buf;
+
+        if( ip.rfind( "127.", 0 ) == 0 )
+            continue;
+
+        // Prefer Wi-Fi (wlan*) over mobile data and VPN interfaces.
+        if( best.empty() || std::string( a->ifa_name ).rfind( "wlan", 0 ) == 0 )
+            best = ip;
+    }
+
+    freeifaddrs( addrs );
+#endif
+
+    return best;
+}
+
+
+std::string MCP_SERVER::ClientUrl( bool aRemote, int aPort )
+{
+    std::string host = aRemote ? LocalNetworkAddress() : std::string( "127.0.0.1" );
+
+    if( host.empty() )
+        host = "127.0.0.1";
+
+    return fmt::format( "http://{}:{}/mcp", host, aPort );
+}
+
+
+void MCP_SERVER::ApplySettings()
+{
+    COMMON_SETTINGS* settings = Pgm().GetCommonSettings();
+
+    Stop();
+
+    if( !settings->m_Mcp.enable_server )
+        return;
+
+    start( settings->m_Mcp.allow_remote, settings->m_Mcp.port,
+           EnsureToken().ToStdString() );
+}
