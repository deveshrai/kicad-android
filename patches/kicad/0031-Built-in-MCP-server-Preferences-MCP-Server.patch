+/// One file of each kind of API command; listing walks these files.
+static std::vector<const gpb::FileDescriptor*> apiFiles()
+{
+    return { kiapi::common::commands::GetVersion::descriptor()->file(),
+             kiapi::common::commands::BeginCommit::descriptor()->file(),
+             kiapi::common::commands::OpenDocument::descriptor()->file(),
+             kiapi::common::commands::GetLibraryItems::descriptor()->file(),
+             kiapi::common::commands::GetVariants::descriptor()->file(),
+             kiapi::common::commands::CrossProbeAnnounce::descriptor()->file(),
+             kiapi::board::commands::GetBoardStackup::descriptor()->file(),
+             kiapi::board::jobs::RunBoardJobExportGerbers::descriptor()->file(),
+             kiapi::schematic::commands::GetSchematicHierarchy::descriptor()->file(),
+             kiapi::schematic::jobs::RunSchematicJobExportPdf::descriptor()->file() };
+}
+
+
+static const gpb::Descriptor* findMessage( const std::string& aName )
+{
+    const gpb::DescriptorPool* pool = kiapi::common::commands::GetVersion::descriptor()
+                                              ->file()->pool();
+
+    for( const char* prefix : { "", "kiapi.common.commands.", "kiapi.board.commands.",
+                                "kiapi.schematic.commands.", "kiapi.board.jobs.",
+                                "kiapi.schematic.jobs.", "kiapi.common.project.",
+                                "kiapi.common.types.", "kiapi.board.types.",
+                                "kiapi.schematic.types.", "kiapi.board.", "kiapi.schematic.",
+                                "kiapi.common." } )
+    {
+        if( const gpb::Descriptor* d = pool->FindMessageTypeByName( prefix + aName ) )
+            return d;
+    }
+
+    return nullptr;
+}
+
+
+bool KiapiJsonToMessage( const std::string& aName, const std::string& aJson,
+                         std::string& aTypeUrl, std::string& aBytes, std::string& aError )
+{
+    const gpb::Descriptor* desc = findMessage( aName );
+
+    if( !desc )
+    {
+        aError = "unknown API command '" + aName + "' (see kicad_api_commands)";
+        return false;
+    }
+
+    const gpb::Message* prototype = gpb::MessageFactory::generated_factory()->GetPrototype( desc );
+
+    if( !prototype )
+    {
+        aError = "no message class for " + std::string( desc->full_name() );
+        return false;
+    }
+
+    std::unique_ptr<gpb::Message> msg( prototype->New() );
+    auto status = gpb::util::JsonStringToMessage( aJson.empty() ? "{}" : aJson, msg.get() );
+
+    if( !status.ok() )
+    {
+        aError = "bad arguments for " + std::string( desc->full_name() ) + ": "
+                 + std::string( status.message() );
+        return false;
+    }
+
+    aTypeUrl = "type.googleapis.com/" + std::string( desc->full_name() );
+    aBytes = msg->SerializeAsString();
+    return true;
+}
+
+
+bool KiapiMessageToJson( const std::string& aTypeUrl, const std::string& aBytes,
+                         std::string& aJson, std::string& aError )
+{
+    std::string name = aTypeUrl.substr( aTypeUrl.rfind( '/' ) + 1 );
+    const gpb::Descriptor* desc = findMessage( name );
+
+    if( !desc )
+    {
+        aJson = "{}";
+        return true;
+    }
+
+    std::unique_ptr<gpb::Message> msg(
+            gpb::MessageFactory::generated_factory()->GetPrototype( desc )->New() );
+
+    if( !msg->ParseFromString( aBytes ) )
+    {
+        aError = "could not read the response " + name;
+        return false;
+    }
+
+    gpb::util::JsonPrintOptions options;
+    options.preserve_proto_field_names = true;
+    auto status = gpb::util::MessageToJsonString( *msg, &aJson, options );
+
+    if( !status.ok() )
+    {
+        aError = "could not convert the response " + name + " to JSON";
+        return false;
+    }
+
+    return true;
+}
+
+
+std::string KiapiListCommands()
+{
+    json out = json::object();
+
+    for( const gpb::FileDescriptor* fd : apiFiles() )
+    {
+        json& list = out[std::string( fd->package() )];
+
+        for( int i = 0; i < fd->message_type_count(); ++i )
+        {
+            std::string name( fd->message_type( i )->name() );
+
+            // Responses are not commands
+            if( name.size() > 8 && name.compare( name.size() - 8, 8, "Response" ) == 0 )
+                continue;
+
+            list.push_back( name );
+        }
+    }
+
+    return out.dump( 1 );
+}
+
+
+static json describeMessage( const gpb::Descriptor* d, int aDepth )
+{
+    json fields = json::array();
+
+    for( int i = 0; i < d->field_count(); ++i )
+    {
+        const gpb::FieldDescriptor* f = d->field( i );
+        json        field = { { "name", std::string( f->name() ) } };
+        std::string type;
+
+        if( f->message_type() )
+            type = std::string( f->message_type()->full_name() );
+        else if( f->enum_type() )
+            type = std::string( f->enum_type()->full_name() );
+        else
+            type = std::string( f->type_name() );
+
+        if( f->is_map() )
+            type = "map";
+        else if( f->is_repeated() )
+            type = "repeated " + type;
+
+        field["type"] = type;
+
+        if( f->enum_type() )
+        {
+            json values = json::array();
+
+            for( int v = 0; v < f->enum_type()->value_count(); ++v )
+                values.push_back( std::string( f->enum_type()->value( v )->name() ) );
+
+            field["values"] = values;
+        }
+
+        if( f->real_containing_oneof() )
+            field["oneof"] = std::string( f->real_containing_oneof()->name() );
+
+        if( aDepth > 0 && f->message_type() && !f->is_map()
+            && std::string( f->message_type()->full_name() ).rfind( "google.protobuf.", 0 ) != 0 )
+        {
+            field["fields"] = describeMessage( f->message_type(), aDepth - 1 );
+        }
+
+        fields.push_back( field );
+    }
+
+    return fields;
+}
+
+
+std::string KiapiDescribe( const std::string& aName )
+{
+    const gpb::Descriptor* d = findMessage( aName );
+
+    if( !d )
+        return std::string();
+
+    json out = { { "message", std::string( d->full_name() ) },
+                 { "fields", describeMessage( d, 2 ) } };
+
+    if( const gpb::Descriptor* resp = findMessage( std::string( d->full_name() ) + "Response" ) )
+    {
+        out["response"] = { { "message", std::string( resp->full_name() ) },
+                            { "fields", describeMessage( resp, 1 ) } };
+    }
+
+    return out.dump( 1 );
+}
