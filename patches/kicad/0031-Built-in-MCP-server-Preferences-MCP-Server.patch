+
+bool MCP_SERVER::RunOnMainThread( std::function<void()> aFunc, int aTimeoutMs )
+{
+    if( wxThread::IsMain() )
+    {
+        aFunc();
+        return true;
+    }
+
+    auto done = std::make_shared<std::promise<void>>();
+    std::future<void> finished = done->get_future();
+
+    wxTheApp->CallAfter(
+            [aFunc, done]()
+            {
+                try
+                {
+                    aFunc();
+                }
+                catch( ... )
+                {
+                }
+
+                done->set_value();
+            } );
+
+    return finished.wait_for( std::chrono::milliseconds( aTimeoutMs ) )
+           == std::future_status::ready;
+}
