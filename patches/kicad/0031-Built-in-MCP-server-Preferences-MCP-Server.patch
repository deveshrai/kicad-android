+
+void MCP_SERVER::start( bool aRemote, int aPort, const std::string& aToken )
+{
+#ifdef __WINDOWS__
+    std::lock_guard<std::mutex> lock( m_lock );
+    m_status.error = "The MCP server is not available on Windows yet.";
+#else
+    int fd = socket( AF_INET, SOCK_STREAM, 0 );
+
+    if( fd < 0 )
+    {
+        std::lock_guard<std::mutex> lock( m_lock );
+        m_status.error = std::string( "socket: " ) + strerror( errno );
+        return;
+    }
+
+    int one = 1;
+    setsockopt( fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof( one ) );
+
+    sockaddr_in addr = {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons( aPort );
+    addr.sin_addr.s_addr = htonl( aRemote ? INADDR_ANY : INADDR_LOOPBACK );
+
+    if( bind( fd, reinterpret_cast<sockaddr*>( &addr ), sizeof( addr ) ) != 0
+        || listen( fd, 8 ) != 0 )
+    {
+        std::lock_guard<std::mutex> lock( m_lock );
+        m_status.error = fmt::format( "Port {} is not available ({})", aPort, strerror( errno ) );
+        close( fd );
+        return;
+    }
+
+    m_token = aToken;
+    m_remote = aRemote;
+    m_port = aPort;
+    m_stopping = false;
+    m_listenSocket = fd;
+
+    {
+        std::lock_guard<std::mutex> lock( m_lock );
+        m_status = STATUS();
+        m_status.running = true;
+        m_status.address = ClientUrl( aRemote, aPort );
+    }
+
+    m_acceptThread = std::thread( &MCP_SERVER::acceptLoop, this );
+    wxLogTrace( traceMcp, "MCP server listening on port %d", aPort );
+#endif
+}
+
+
+void MCP_SERVER::Stop()
+{
+#ifndef __WINDOWS__
+    int fd = m_listenSocket.exchange( -1 );
+
+    if( fd >= 0 )
+    {
+        m_stopping = true;
+        shutdown( fd, SHUT_RDWR );
+        close( fd );
+    }
+
+    if( m_acceptThread.joinable() )
+        m_acceptThread.join();
+
+    {
+        std::lock_guard<std::mutex> lock( m_lock );
+
+        for( int client : m_clients )
+            shutdown( client, SHUT_RDWR );
+    }
+#endif
+
+    std::lock_guard<std::mutex> lock( m_lock );
+    m_status.running = false;
+}
+
+
+void MCP_SERVER::acceptLoop()
+{
+#ifndef __WINDOWS__
+    while( !m_stopping )
+    {
+        int fd = m_listenSocket;
+
+        if( fd < 0 )
+            break;
+
+        int client = accept( fd, nullptr, nullptr );
+
+        if( client < 0 )
+        {
+            if( m_stopping )
+                break;
+
+            std::this_thread::sleep_for( std::chrono::milliseconds( 50 ) );
+            continue;
+        }
+
+        std::thread( &MCP_SERVER::serveConnection, this, client ).detach();
+    }
+#endif
+}
+
+
+#ifndef __WINDOWS__
+static bool sendAll( int aSocket, const std::string& aData )
+{
+    size_t sent = 0;
+
+    while( sent < aData.size() )
+    {
+        ssize_t n = send( aSocket, aData.data() + sent, aData.size() - sent, MSG_NOSIGNAL );
+
+        if( n <= 0 )
+            return false;
+
+        sent += n;
+    }
+
+    return true;
+}
+
+
+static void sendResponse( int aSocket, int aCode, const std::string& aReason,
+                          const std::string& aBody, const std::string& aExtraHeaders = "" )
+{
+    std::string head = fmt::format( "HTTP/1.1 {} {}\r\n"
+                                    "Content-Length: {}\r\n"
+                                    "Cache-Control: no-store\r\n",
+                                    aCode, aReason, aBody.size() );
+
+    if( !aBody.empty() )
+        head += "Content-Type: application/json\r\n";
+
+    sendAll( aSocket, head + aExtraHeaders + "\r\n" + aBody );
+}
+#endif
+
+
+void MCP_SERVER::serveConnection( int aSocket )
+{
+#ifndef __WINDOWS__
+    {
+        std::lock_guard<std::mutex> lock( m_lock );
+        m_clients.insert( aSocket );
+    }
+
+    // Closes the socket however the connection ends
+    struct CLOSER
+    {
+        MCP_SERVER* server;
+        int         socket;
+
+        ~CLOSER()
+        {
+            {
+                std::lock_guard<std::mutex> lock( server->m_lock );
+                server->m_clients.erase( socket );
+            }
+
+            close( socket );
+        }
+    } closer{ this, aSocket };
+
+    timeval tv = { 300, 0 };
+    setsockopt( aSocket, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof( tv ) );
+    int one = 1;
+    setsockopt( aSocket, IPPROTO_TCP, TCP_NODELAY, &one, sizeof( one ) );
+
+    std::string buffer;
+    char        chunk[16384];
+
+    while( !m_stopping )
+    {
+        // Read the request head
+        size_t headEnd;
+
+        while( ( headEnd = buffer.find( "\r\n\r\n" ) ) == std::string::npos )
+        {
+            if( buffer.size() > 65536 )
+                return;
+
+            ssize_t n = recv( aSocket, chunk, sizeof( chunk ), 0 );
+
+            if( n <= 0 )
+                return;
+
+            buffer.append( chunk, n );
+        }
+
+        std::istringstream head( buffer.substr( 0, headEnd ) );
+        std::string        method, path, version, line;
+        head >> method >> path >> version;
+        std::getline( head, line );
+
+        std::map<std::string, std::string> headers;
+
+        while( std::getline( head, line ) )
+        {
+            if( !line.empty() && line.back() == '\r' )
+                line.pop_back();
+
+            size_t colon = line.find( ':' );
+
+            if( colon == std::string::npos )
+                continue;
+
+            std::string key = line.substr( 0, colon );
+            std::transform( key.begin(), key.end(), key.begin(), ::tolower );
+            std::string value = line.substr( colon + 1 );
+            value.erase( 0, value.find_first_not_of( " \t" ) );
+            headers[key] = value;
+        }
+
+        size_t length = headers.count( "content-length" )
+                                ? std::strtoul( headers["content-length"].c_str(), nullptr, 10 )
+                                : 0;
+
+        if( length > 64 * 1024 * 1024 )
+        {
+            sendResponse( aSocket, 413, "Payload Too Large", "" );
+            return;
+        }
+
+        buffer.erase( 0, headEnd + 4 );
+
+        while( buffer.size() < length )
+        {
+            ssize_t n = recv( aSocket, chunk, sizeof( chunk ), 0 );
+
+            if( n <= 0 )
+                return;
+
+            buffer.append( chunk, n );
+        }
+
+        std::string body = buffer.substr( 0, length );
+        buffer.erase( 0, length );
+
+        bool keepAlive = version == "HTTP/1.1" && headers["connection"] != "close";
+
+        {
+            std::lock_guard<std::mutex> lock( m_lock );
+            m_status.requests++;
+            m_status.lastRequestMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                             std::chrono::system_clock::now().time_since_epoch() )
+                                             .count();
+        }
+
+        size_t query = path.find( '?' );
+
+        if( query != std::string::npos )
+            path.erase( query );
+
+        // A web page on this device must not be able to drive KiCad through the user's browser
+        if( !m_remote && headers.count( "origin" ) )
+        {
+            const std::string& origin = headers["origin"];
+
+            if( origin.find( "://127.0.0.1" ) == std::string::npos
+                && origin.find( "://localhost" ) == std::string::npos )
+            {
+                sendResponse( aSocket, 403, "Forbidden", "" );
+                return;
+            }
+        }
+
+        if( headers["authorization"] != "Bearer " + m_token )
+        {
+            sendResponse( aSocket, 401, "Unauthorized",
+                          R"({"error":"missing or wrong Bearer token; copy it from KiCad's )"
+                          R"(Preferences > MCP Server"})" );
+        }
+        else if( path != "/mcp" && path != "/mcp/" )
+        {
+            sendResponse( aSocket, 404, "Not Found", "" );
+        }
+        else if( method == "GET" || method == "DELETE" )
+        {
+            // No server-initiated stream and no session state to end
+            sendResponse( aSocket, 405, "Method Not Allowed", "", "Allow: POST\r\n" );
+        }
+        else if( method != "POST" )
+        {
+            sendResponse( aSocket, 405, "Method Not Allowed", "", "Allow: POST\r\n" );
+        }
+        else
+        {
+            json message = json::parse( body, nullptr, false );
+
+            if( message.is_discarded() )
+            {
+                sendResponse( aSocket, 400, "Bad Request",
+                              R"({"jsonrpc":"2.0","id":null,"error":{"code":-32700,)"
+                              R"("message":"parse error"}})" );
+            }
+            else
+            {
+                json reply;
+
+                if( message.is_array() )
+                {
+                    reply = json::array();
+
+                    for( const json& m : message )
+                    {
+                        json r = handleMessage( m );
+
+                        if( !r.is_null() )
+                            reply.push_back( r );
+                    }
+
+                    if( reply.empty() )
+                        reply = json();
+                }
+                else
+                {
+                    reply = handleMessage( message );
+                }
+
+                if( reply.is_null() )
+                    sendResponse( aSocket, 202, "Accepted", "" );
+                else
+                    sendResponse( aSocket, 200, "OK", reply.dump() );
+            }
+        }
+
+        if( !keepAlive )
+            break;
+    }
+#endif
+}
