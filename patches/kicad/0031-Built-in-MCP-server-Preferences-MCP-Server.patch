+json MCP_SERVER::listTools()
+{
+    std::lock_guard<std::mutex> lock( m_lock );
+    json tools = json::array();
+
+    for( const std::string& name : m_toolOrder )
+    {
+        const MCP_TOOL& t = m_tools[name].first;
+        tools.push_back( { { "name", t.name },
+                           { "description", t.description },
+                           { "inputSchema", t.inputSchema } } );
+    }
+
+    return { { "tools", tools } };
+}
+
+
+json MCP_SERVER::callTool( const std::string& aName, const json& aArgs )
+{
+    MCP_TOOL tool;
+
+    {
+        std::lock_guard<std::mutex> lock( m_lock );
+        auto it = m_tools.find( aName );
+
+        if( it == m_tools.end() )
+        {
+            MCP_RESULT r = MCP_RESULT::Error( "unknown tool '" + aName
+                                              + "'; the editor that provides it may be closed" );
+            return { { "content", r.content }, { "isError", true } };
+        }
+
+        tool = it->second.first;
+        m_status.lastTool = aName;
+    }
+
+    MCP_RESULT result;
+
+    auto run = [&]()
+    {
+        try
+        {
+            result = tool.handler( aArgs );
+        }
+        catch( const std::exception& e )
+        {
+            result = MCP_RESULT::Error( std::string( "tool failed: " ) + e.what() );
+        }
+    };
+
+    if( tool.mainThread )
+    {
+        if( !RunOnMainThread( run ) )
+            result = MCP_RESULT::Error( "KiCad is busy (a dialog may be open); try again" );
+    }
+    else
+    {
+        run();
+    }
+
+    return { { "content", result.content }, { "isError", result.isError } };
+}
+
+
+json MCP_SERVER::handleMessage( const json& aMessage )
+{
+    auto error = [&]( int aCode, const std::string& aText ) -> json
+    {
+        return { { "jsonrpc", "2.0" },
+                 { "id", aMessage.contains( "id" ) ? aMessage["id"] : json() },
+                 { "error", { { "code", aCode }, { "message", aText } } } };
+    };
+
+    if( !aMessage.is_object() || !aMessage.contains( "method" ) )
+    {
+        // A response from the client, or junk; nothing to answer
+        return json();
+    }
+
+    std::string method = aMessage.value( "method", std::string() );
+    bool        isNotification = !aMessage.contains( "id" );
+    json        params = aMessage.contains( "params" ) ? aMessage["params"] : json::object();
+    json        result;
+
+    if( method == "initialize" )
+    {
+        std::string requested = params.value( "protocolVersion", std::string() );
+        std::string version = "2025-06-18";
+
+        for( const char* v : { "2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05" } )
+        {
+            if( requested == v )
+                version = v;
+        }
+
+        {
+            std::lock_guard<std::mutex> lock( m_lock );
+
+            if( params.contains( "clientInfo" ) )
+            {
+                m_status.clientName = params["clientInfo"].value( "name", std::string() );
+                m_status.clientVersion = params["clientInfo"].value( "version", std::string() );
+            }
+        }
+
+        result = { { "protocolVersion", version },
+                   { "capabilities", { { "tools", { { "listChanged", false } } } } },
+                   { "serverInfo",
+                     { { "name", "kicad" },
+                       { "title", "KiCad" },
+                       { "version", GetSemanticVersion().ToStdString() } } },
+                   { "instructions", SERVER_INSTRUCTIONS } };
+    }
+    else if( method == "ping" )
+    {
+        result = json::object();
+    }
+    else if( method == "tools/list" )
+    {
+        result = listTools();
+    }
+    else if( method == "tools/call" )
+    {
+        result = callTool( params.value( "name", std::string() ),
+                           params.contains( "arguments" ) ? params["arguments"]
+                                                          : json::object() );
+    }
+    else if( method.rfind( "notifications/", 0 ) == 0 )
+    {
+        return json();
+    }
+    else
+    {
+        return isNotification ? json() : error( -32601, "method not found: " + method );
+    }
+
+    if( isNotification )
+        return json();
+
+    return { { "jsonrpc", "2.0" }, { "id", aMessage["id"] }, { "result", result } };
+}
