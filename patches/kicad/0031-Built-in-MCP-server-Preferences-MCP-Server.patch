+    describe.handler = []( const json& aArgs ) -> MCP_RESULT
+    {
+        std::string name = aArgs.value( "message", std::string() );
+        std::string out = KiapiDescribe( name );
+
+        if( out.empty() )
+            return MCP_RESULT::Error( "unknown message '" + name + "'" );
+
+        return MCP_RESULT::Text( out );
+    };
+    RegisterTool( describe, this );
+
+    // Implemented by the project manager and the board editor; see SetToolHandler()
+    const std::string noPcb = "The board editor is not open. Open it with kicad_open_editor (editor: pcb), or in the app.";
+
+    declareTool( "kicad_open_editor",
+                 "Open the project's board (editor: pcb) or schematic (editor: schematic) in "
+                 "the app, as if the user had clicked it in the project manager.",
+                 { { "type", "object" },
+                   { "properties",
+                     { { "editor", { { "type", "string" },
+                                     { "enum", { "pcb", "schematic" } } } } } },
+                   { "required", { "editor" } } },
+                 "The project manager is not available." );
+
+    declareTool( "pcb_board_summary",
+                 "Summarise the board open in the PCB editor: outline, layers, every footprint "
+                 "with its position, and counts of tracks, vias, zones and unrouted "
