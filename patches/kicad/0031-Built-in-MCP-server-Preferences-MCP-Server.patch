+PANEL_MCP_SERVER::PANEL_MCP_SERVER( wxWindow* aParent ) :
+        RESETTABLE_PANEL( aParent ),
+        m_timer( this )
+{
+    wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+
+    m_enable = new wxCheckBox( this, wxID_ANY, _( "Turn on the MCP server" ) );
+    m_enable->SetFont( m_enable->GetFont().Bold() );
+    top->Add( m_enable, 0, wxALL, 8 );
+
+    m_explain = new wxStaticText( this, wxID_ANY,
+                                  _( "Lets Claude Code, or another AI agent that speaks MCP, use "
+                                     "KiCad.  You see every change happen in the editor, and "
+                                     "can undo it." ) );
+    top->Add( m_explain, 0, wxLEFT | wxRIGHT | wxBOTTOM, 8 );
+
+    wxBoxSizer* from = new wxBoxSizer( wxHORIZONTAL );
+    from->Add( new wxStaticText( this, wxID_ANY, _( "Connect from:" ) ), 0,
+               wxALIGN_CENTER_VERTICAL | wxRIGHT, 12 );
+    m_thisDevice = new wxRadioButton( this, wxID_ANY, _( "This device" ), wxDefaultPosition,
+                                      wxDefaultSize, wxRB_GROUP );
+    m_otherComputer = new wxRadioButton( this, wxID_ANY, _( "Another computer" ) );
+    from->Add( m_thisDevice, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 12 );
+    from->Add( m_otherComputer, 0, wxALIGN_CENTER_VERTICAL );
+    top->Add( from, 0, wxALL, 8 );
+
+    m_remoteNote = new wxStaticText( this, wxID_ANY,
+                                     _( "The computer must be on the same Wi-Fi network.  The "
+                                        "connection is not encrypted; the token keeps others "
+                                        "out." ) );
+    top->Add( m_remoteNote, 0, wxLEFT | wxRIGHT | wxBOTTOM, 8 );
+
+    top->Add( new wxStaticText( this, wxID_ANY, _( "Server address:" ) ), 0,
+              wxLEFT | wxRIGHT | wxTOP, 8 );
+    wxBoxSizer* addr = new wxBoxSizer( wxHORIZONTAL );
+    m_address = new wxTextCtrl( this, wxID_ANY, wxEmptyString, wxDefaultPosition, wxDefaultSize,
+                                wxTE_READONLY );
+    m_copyAddress = new wxButton( this, wxID_ANY, _( "Copy" ) );
+    addr->Add( m_address, 1, wxALIGN_CENTER_VERTICAL | wxRIGHT, 8 );
+    addr->Add( m_copyAddress, 0, wxALIGN_CENTER_VERTICAL );
+    top->Add( addr, 0, wxEXPAND | wxALL, 8 );
+
+    top->Add( new wxStaticText( this, wxID_ANY,
+                                _( "Start Claude Code connected to KiCad (paste into a "
+                                   "terminal):" ) ),
+              0, wxLEFT | wxRIGHT | wxTOP, 8 );
+    wxBoxSizer* cmd = new wxBoxSizer( wxHORIZONTAL );
+    m_command = new wxTextCtrl( this, wxID_ANY, wxEmptyString, wxDefaultPosition,
+                                wxSize( -1, 64 ), wxTE_READONLY | wxTE_MULTILINE );
+    m_copyCommand = new wxButton( this, wxID_ANY, _( "Copy" ) );
+    cmd->Add( m_command, 1, wxEXPAND | wxRIGHT, 8 );
+    cmd->Add( m_copyCommand, 0, wxALIGN_CENTER_VERTICAL );
+    top->Add( cmd, 0, wxEXPAND | wxALL, 8 );
+
+    m_status = new wxStaticText( this, wxID_ANY, wxEmptyString );
+    m_status->SetFont( m_status->GetFont().Bold() );
+    top->Add( m_status, 0, wxALL, 8 );
+
+    top->Add( new wxStaticLine( this ), 0, wxEXPAND | wxTOP | wxBOTTOM, 8 );
+    top->Add( new wxStaticText( this, wxID_ANY, _( "Advanced" ) ), 0, wxLEFT | wxRIGHT, 8 );
+
+    wxBoxSizer* port = new wxBoxSizer( wxHORIZONTAL );
+    port->Add( new wxStaticText( this, wxID_ANY, _( "Port:" ) ), 0,
+               wxALIGN_CENTER_VERTICAL | wxRIGHT, 8 );
+    m_port = new wxSpinCtrl( this, wxID_ANY, wxEmptyString, wxDefaultPosition, wxDefaultSize,
+                             wxSP_ARROW_KEYS, 1024, 65535, 27880 );
+    port->Add( m_port, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT, 16 );
+    m_newToken = new wxButton( this, wxID_ANY, _( "New Token" ) );
+    m_newToken->SetToolTip( _( "Make a new token.  Clients that use the old one are locked "
+                               "out." ) );
+    port->Add( m_newToken, 0, wxALIGN_CENTER_VERTICAL );
+    top->Add( port, 0, wxALL, 8 );
+
+    top->Add( new wxStaticText( this, wxID_ANY,
+                                _( "Or add KiCad to Claude Code for good:" ) ),
+              0, wxLEFT | wxRIGHT | wxTOP, 8 );
+    wxBoxSizer* add = new wxBoxSizer( wxHORIZONTAL );
+    m_addCommand = new wxTextCtrl( this, wxID_ANY, wxEmptyString, wxDefaultPosition,
+                                   wxSize( -1, 64 ), wxTE_READONLY | wxTE_MULTILINE );
+    m_copyAdd = new wxButton( this, wxID_ANY, _( "Copy" ) );
+    add->Add( m_addCommand, 1, wxEXPAND | wxRIGHT, 8 );
+    add->Add( m_copyAdd, 0, wxALIGN_CENTER_VERTICAL );
+    top->Add( add, 0, wxEXPAND | wxALL, 8 );
+
+    SetSizer( top );
