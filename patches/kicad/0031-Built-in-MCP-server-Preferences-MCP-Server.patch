+
+PANEL_MCP_SERVER::~PANEL_MCP_SERVER()
+{
+    m_timer.Stop();
+}
+
+
+bool PANEL_MCP_SERVER::TransferDataToWindow()
+{
+    const COMMON_SETTINGS::MCP& mcp = Pgm().GetCommonSettings()->m_Mcp;
+
+    m_loading = true;
+    m_enable->SetValue( mcp.enable_server );
+    m_thisDevice->SetValue( !mcp.allow_remote );
+    m_otherComputer->SetValue( mcp.allow_remote );
+    m_port->SetValue( mcp.port );
+    m_loading = false;
+
+    updateTexts();
+    updateStatus();
+    return true;
+}
+
+
+bool PANEL_MCP_SERVER::TransferDataFromWindow()
+{
+    // Everything is applied as it changes
+    return true;
+}
+
+
+void PANEL_MCP_SERVER::ResetPanel()
+{
+    COMMON_SETTINGS::MCP& mcp = Pgm().GetCommonSettings()->m_Mcp;
+
+    m_loading = true;
+    m_enable->SetValue( false );
+    m_thisDevice->SetValue( true );
+    m_otherComputer->SetValue( false );
+    m_port->SetValue( 27880 );
+    m_loading = false;
+
+    mcp.token.clear();
+    apply();
+}
+
+
+void PANEL_MCP_SERVER::apply()
+{
+    if( m_loading )
+        return;
+
+    COMMON_SETTINGS* settings = Pgm().GetCommonSettings();
+    settings->m_Mcp.enable_server = m_enable->GetValue();
+    settings->m_Mcp.allow_remote = m_otherComputer->GetValue();
+    settings->m_Mcp.port = m_port->GetValue();
+    MCP_SERVER::EnsureToken();
+    Pgm().GetSettingsManager().Save( settings );
+
+    MCP_SERVER::Instance().ApplySettings();
+
+    updateTexts();
+    updateStatus();
+}
+
+
+void PANEL_MCP_SERVER::updateTexts()
+{
+    const COMMON_SETTINGS::MCP& mcp = Pgm().GetCommonSettings()->m_Mcp;
+    bool     on = m_enable->GetValue();
+    wxString token = mcp.token.IsEmpty() ? wxString( wxS( "<token>" ) ) : mcp.token;
+    wxString url = wxString::FromUTF8( MCP_SERVER::ClientUrl( mcp.allow_remote, mcp.port ) );
+
+    m_address->SetValue( url );
+
+    m_command->SetValue( wxString::Format(
+            wxS( "claude --mcp-config '{\"mcpServers\":{\"kicad\":{\"type\":\"http\",\"url\":"
+                 "\"%s\",\"headers\":{\"Authorization\":\"Bearer %s\"}}}}'" ),
+            url, token ) );
+
+    m_addCommand->SetValue( wxString::Format(
+            wxS( "claude mcp add --transport http kicad %s --header \"Authorization: Bearer "
+                 "%s\"" ),
+            url, token ) );
+
+    for( wxWindow* w : std::initializer_list<wxWindow*>{ m_thisDevice, m_otherComputer, m_address,
+                                                         m_copyAddress, m_command, m_copyCommand,
+                                                         m_port, m_addCommand, m_copyAdd,
+                                                         m_newToken } )
+    {
+        w->Enable( on );
+    }
+
+    m_remoteNote->Show( mcp.allow_remote );
+
+    if( mcp.allow_remote && MCP_SERVER::LocalNetworkAddress().empty() )
+        m_remoteNote->SetLabel( _( "This device is not on a network.  Connect to Wi-Fi first." ) );
+    else
+        m_remoteNote->SetLabel( _( "The computer must be on the same Wi-Fi network.  The "
+                                   "connection is not encrypted; the token keeps others out." ) );
+
+    Layout();
+}
+
+
+void PANEL_MCP_SERVER::updateStatus()
+{
+    MCP_SERVER::STATUS s = MCP_SERVER::Instance().GetStatus();
+    wxString           text;
+
+    if( !m_enable->GetValue() )
+    {
+        text = _( "The server is off." );
+    }
+    else if( !s.running )
+    {
+        text = wxString::Format( _( "The server could not start: %s" ),
+                                 wxString::FromUTF8( s.error ) );
+    }
+    else if( s.clientName.empty() && s.requests == 0 )
+    {
+        text = _( "Listening.  Waiting for Claude Code to connect..." );
+    }
+    else
+    {
+        long long now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                                std::chrono::system_clock::now().time_since_epoch() )
+                                .count();
+        long long ago = std::max( 0LL, ( now - s.lastRequestMs ) / 1000 );
+        wxString  who = s.clientName.empty() ? wxString( _( "A client" ) )
+                                             : wxString::FromUTF8( s.clientName + " "
+                                                                   + s.clientVersion );
+
+        text = wxString::Format( _( "Connected: %s.  Last request %lld s ago." ), who.Trim(),
+                                 ago );
+
+        if( !s.lastTool.empty() )
+            text += wxString::Format( _( "  Last tool: %s." ), wxString::FromUTF8( s.lastTool ) );
+    }
+
+    if( m_status->GetLabel() != text )
+    {
+        m_status->SetLabel( text );
+        Layout();
+    }
+}
+
+
+void PANEL_MCP_SERVER::copy( const wxString& aText )
+{
+    if( wxTheClipboard->Open() )
+    {
+        wxTheClipboard->SetData( new wxTextDataObject( aText ) );
+        wxTheClipboard->Flush();
+        wxTheClipboard->Close();
+    }
+}
