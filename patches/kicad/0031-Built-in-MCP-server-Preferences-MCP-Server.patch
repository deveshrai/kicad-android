+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#ifndef KICAD_MCP_SERVER_H
+#define KICAD_MCP_SERVER_H
+
+#include <atomic>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <nlohmann/json.hpp>
+#include <wx/string.h>
+
+#include <kicommon.h>
+
+/**
+ * The result of an MCP tool call: a list of MCP content blocks (text or image), and whether the
+ * call failed.
+ */
+struct KICOMMON_API MCP_RESULT
+{
+    nlohmann::json content = nlohmann::json::array();
+    bool           isError = false;
+
+    static MCP_RESULT Text( const std::string& aText );
+    static MCP_RESULT Json( const nlohmann::json& aValue );
+    static MCP_RESULT Error( const std::string& aMessage );
+
+    /// Add a PNG image (raw bytes) to the result.
+    MCP_RESULT& AddPng( const std::string& aBytes );
+};
+
+
+/**
+ * A tool offered to MCP clients.  Tools run on the main (UI) thread unless mainThread is false;
+ * then the handler runs on the connection's thread and must use MCP_SERVER::RunOnMainThread()
+ * for anything that touches KiCad's data.
+ */
+struct KICOMMON_API MCP_TOOL
+{
+    std::string    name;
+    std::string    description;
+    nlohmann::json inputSchema;
+    std::function<MCP_RESULT( const nlohmann::json& aArgs )> handler;
+    bool           mainThread = true;
+};
+
+
+/**
+ * A Model Context Protocol server built into KiCad (Streamable HTTP transport, JSON responses).
+ * Clients such as Claude Code connect to http://<host>:<port>/mcp with a Bearer token.  Every
+ * change a tool makes goes through KiCad's normal editing paths, so the user sees it happen and
+ * can undo it.
+ *
+ * Built-in tools give access to KiCad's IPC API in process.  Every tool is declared up front
+ * (clients read the list once, when they connect); editors attach the handlers of their tools
+ * with SetToolHandler() while they are open, and until then those tools say what to open.
+ */
+class KICOMMON_API MCP_SERVER
+{
+public:
+    struct STATUS
+    {
+        bool        running = false;
+        std::string error;        ///< Why the server is not running, if it failed to start.
+        std::string address;      ///< The URL clients connect to.
+        std::string clientName;   ///< From the last initialize request.
+        std::string clientVersion;
+        long long   lastRequestMs = 0;  ///< Wall-clock time of the last request, 0 if none.
+        int         requests = 0;
+        std::string lastTool;
+    };
+
+    static MCP_SERVER& Instance();
+
+    /// Start, stop or restart the server from the current settings (COMMON_SETTINGS::m_Mcp).
+    void ApplySettings();
+
+    void Stop();
+
+    STATUS GetStatus() const;
+
+    /// The token in the settings, generating and saving one first if there is none.
+    static wxString EnsureToken();
+
+    /// A new random token.
+    static wxString NewToken();
+
+    /// The URL clients use: on this device, or on this device's Wi-Fi address.
+    static std::string ClientUrl( bool aRemote, int aPort );
+
+    /// The device's address on the local network, or empty if it has none.
+    static std::string LocalNetworkAddress();
+
+    void RegisterTool( const MCP_TOOL& aTool, const void* aOwner );
+
+    /// Attach the handler of a declared tool while @a aOwner (an editor) is open.
+    void SetToolHandler( const std::string& aName,
+                         std::function<MCP_RESULT( const nlohmann::json& )> aHandler,
+                         const void* aOwner, bool aMainThread = true );
+
+    /// Remove every tool registered by @a aOwner, or give declared tools their fallback back.
+    void UnregisterTools( const void* aOwner );
+
+    /**
+     * Run @a aFunc on the main thread and wait for it.  Runs it directly when called on the main
+     * thread.  Returns false if it did not finish within @a aTimeoutMs (it may still run later).
+     */
+    static bool RunOnMainThread( std::function<void()> aFunc, int aTimeoutMs = 600000 );
+
+    /// Run a KiCad IPC API command, given its message type name and its fields as JSON.
+    /// Must be called on the main thread.
+    static nlohmann::json CallApi( const std::string& aCommand, const nlohmann::json& aArgs,
+                                   std::string& aError );
+
+private:
+    MCP_SERVER();
+    ~MCP_SERVER();
+
+    void start( bool aRemote, int aPort, const std::string& aToken );
+    void acceptLoop();
+    void serveConnection( int aSocket );
+
+    /// Handle one JSON-RPC message; returns a null json for notifications.
+    nlohmann::json handleMessage( const nlohmann::json& aMessage );
+    nlohmann::json callTool( const std::string& aName, const nlohmann::json& aArgs );
+    nlohmann::json listTools();
+
+    void registerBuiltinTools();
+
+    /// Declare a tool that an editor or the project manager implements; @a aMissing says what
+    /// to do while it is not there.
+    void declareTool( const std::string& aName, const std::string& aDescription,
+                      const nlohmann::json& aSchema, const std::string& aMissing );
+
+    mutable std::mutex m_lock;
+    std::map<std::string, std::pair<MCP_TOOL, const void*>> m_tools;
+    std::vector<std::string> m_toolOrder;
+    std::map<std::string, MCP_TOOL> m_fallbacks;    ///< Declared tools without their owner
+
+    std::set<int>     m_clients;   ///< Open connections, guarded by m_lock
+    std::atomic<int>  m_listenSocket{ -1 };
+    std::thread       m_acceptThread;
+    std::atomic<bool> m_stopping{ false };
+    std::string       m_token;
+    bool              m_remote = false;
+    int               m_port = 0;
+
+    STATUS            m_status;
+};
+
