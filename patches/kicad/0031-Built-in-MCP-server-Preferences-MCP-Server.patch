+/**
+ * Convert JSON to an API message.  @a aName may be a full name (kiapi.board.commands.GetItems)
+ * or a short one (GetItems).  On success, @a aTypeUrl and @a aBytes are what goes into a
+ * google.protobuf.Any.
+ */
+KIAPI_IMPORTEXPORT bool KiapiJsonToMessage( const std::string& aName, const std::string& aJson,
+                                            std::string& aTypeUrl, std::string& aBytes,
+                                            std::string& aError );
+
+/// Convert a serialized message (as found in an Any) to JSON, with the .proto field names.
+KIAPI_IMPORTEXPORT bool KiapiMessageToJson( const std::string& aTypeUrl, const std::string& aBytes,
+                                            std::string& aJson, std::string& aError );
+
+/// A JSON object listing the request messages of each API package.
+KIAPI_IMPORTEXPORT std::string KiapiListCommands();
+
+/// A JSON description of a message's fields (and its response's), or empty if unknown.
+KIAPI_IMPORTEXPORT std::string KiapiDescribe( const std::string& aName );
+
+#endif // KIAPI_JSON_H
diff --git a/include/api/mcp_server.h b/include/api/mcp_server.h
new file mode 100644
index 00000000..d268e7e4
--- /dev/null
+++ b/include/api/mcp_server.h
@@ -0,0 +1,174 @@
+/*
