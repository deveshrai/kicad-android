+                 { { "type", "object" },
+                   { "properties", { { "nets", { { "type", "boolean" } } } } } },
+                 noPcb );
+
+    declareTool( "pcb_move_footprint",
+                 "Move, rotate or flip a footprint by reference designator. x and y are the "
+                 "footprint's position in mm, rotation is in degrees, side is front or back. "
