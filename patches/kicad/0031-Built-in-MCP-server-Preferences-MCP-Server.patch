+void MCP_SERVER::registerBuiltinTools()
+{
+    MCP_TOOL status;
+    status.name = "kicad_status";
+    status.description = "KiCad's version, the open project, and the documents open in the "
+                         "board and schematic editors.";
+    status.inputSchema = { { "type", "object" }, { "properties", json::object() } };
+    status.handler = []( const json& ) -> MCP_RESULT
+    {
+        json out;
+        out["kicad_version"] = GetBuildVersion().ToStdString();
+
+        PROJECT& prj = Pgm().GetSettingsManager().Prj();
+        out["project"] = prj.GetProjectFullName().ToStdString();
+
+        std::string err;
+        json docs = json::array();
+
+        for( const char* type : { "DOCTYPE_PCB", "DOCTYPE_SCHEMATIC" } )
+        {
+            json r = CallApi( "GetOpenDocuments", { { "type", type } }, err );
+
+            if( r.contains( "documents" ) )
+            {
+                for( const json& d : r["documents"] )
+                    docs.push_back( d );
+            }
+        }
+
+        out["open_documents"] = docs;
+
+        if( docs.empty() )
+            out["hint"] = "No editor is open. Open the project's board or schematic in the app, "
+                          "or use kicad_api with OpenDocument.";
+
+        return MCP_RESULT::Json( out );
+    };
+    RegisterTool( status, this );
+
+    MCP_TOOL api;
+    api.name = "kicad_api";
+    api.description = "Run a command of KiCad's IPC API, the API kicad-python uses. 'command' "
+                      "is the request message name (for example GetItems, CreateItems, "
+                      "BeginCommit, GetNets, RefillZones, RunBoardJobExportGerbers); 'args' "
+                      "holds its fields as JSON, with the field names from the .proto files. "
+                      "Lengths are nanometres. Returns the response message as JSON.";
+    api.inputSchema = {
+        { "type", "object" },
+        { "properties",
+          { { "command", { { "type", "string" } } },
+            { "args", { { "type", "object" } } } } },
+        { "required", { "command" } }
+    };
+    api.handler = []( const json& aArgs ) -> MCP_RESULT
+    {
+        std::string err;
+        json        r = CallApi( aArgs.value( "command", std::string() ),
+                                 aArgs.contains( "args" ) ? aArgs["args"] : json::object(), err );
+
+        if( !err.empty() )
+            return MCP_RESULT::Error( err );
+
+        return MCP_RESULT::Json( r );
+    };
+    RegisterTool( api, this );
+
+    MCP_TOOL commands;
+    commands.name = "kicad_api_commands";
+    commands.description = "List the commands kicad_api can run, by API package.";
+    commands.inputSchema = { { "type", "object" }, { "properties", json::object() } };
+    commands.handler = []( const json& ) -> MCP_RESULT
+    {
+        return MCP_RESULT::Text( KiapiListCommands() );
+    };
+    RegisterTool( commands, this );
+
+    MCP_TOOL describe;
+    describe.name = "kicad_api_describe";
+    describe.description = "Describe the fields of an IPC API message (a command, its response, "
+                           "or a type such as kiapi.board.types.Track), two levels deep.";
+    describe.inputSchema = {
+        { "type", "object" },
+        { "properties", { { "message", { { "type", "string" } } } } },
+        { "required", { "message" } }
