+    m_enable->Bind( wxEVT_CHECKBOX, [this]( wxCommandEvent& ) { apply(); } );
+    m_thisDevice->Bind( wxEVT_RADIOBUTTON, [this]( wxCommandEvent& ) { apply(); } );
+    m_otherComputer->Bind( wxEVT_RADIOBUTTON, [this]( wxCommandEvent& ) { apply(); } );
+    m_port->Bind( wxEVT_SPINCTRL, [this]( wxSpinEvent& ) { apply(); } );
+    m_copyAddress->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { copy( m_address->GetValue() ); } );
+    m_copyCommand->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { copy( m_command->GetValue() ); } );
+    m_copyAdd->Bind( wxEVT_BUTTON, [this]( wxCommandEvent& ) { copy( m_addCommand->GetValue() ); } );
