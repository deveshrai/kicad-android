+
+void MCP_SERVER::declareTool( const std::string& aName, const std::string& aDescription,
+                              const json& aSchema, const std::string& aMissing )
+{
+    MCP_TOOL tool;
+    tool.name = aName;
+    tool.description = aDescription;
+    tool.inputSchema = aSchema;
+    tool.handler = [aMissing]( const json& ) { return MCP_RESULT::Error( aMissing ); };
+
+    m_fallbacks[aName] = tool;
+    RegisterTool( tool, this );
+}
