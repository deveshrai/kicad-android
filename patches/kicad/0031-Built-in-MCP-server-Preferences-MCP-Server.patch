+
+MCP_RESULT& MCP_RESULT::AddPng( const std::string& aBytes )
+{
+    wxString data = wxBase64Encode( aBytes.data(), aBytes.size() );
+    content.push_back( { { "type", "image" }, { "mimeType", "image/png" },
+                         { "data", data.ToStdString() } } );
+    return *this;
+}
