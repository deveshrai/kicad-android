+#endif
+
+using nlohmann::json;
+
+
+static double mm( int aIU )
+{
+    return std::round( pcbIUScale.IUTomm( aIU ) * 1000.0 ) / 1000.0;
+}
+
+
+static json boardSummary( PCB_EDIT_FRAME* aFrame, bool aNets )
+{
+    BOARD* board = aFrame->GetBoard();
+    json   out;
+
+    out["file"] = board->GetFileName().ToStdString();
+    out["units"] = "mm, degrees; y grows downwards";
+
+    BOX2I edges = board->GetBoardEdgesBoundingBox();
+    out["outline_bbox"] = { { "x", mm( edges.GetX() ) }, { "y", mm( edges.GetY() ) },
+                            { "width", mm( edges.GetWidth() ) },
+                            { "height", mm( edges.GetHeight() ) } };
+    out["copper_layers"] = board->GetCopperLayerCount();
+
+    json fps = json::array();
+
+    for( FOOTPRINT* fp : board->Footprints() )
+    {
+        fps.push_back( { { "reference", fp->GetReference().ToStdString() },
+                         { "value", fp->GetValue().ToStdString() },
+                         { "footprint", std::string( fp->GetFPID().Format().c_str() ) },
+                         { "x", mm( fp->GetPosition().x ) },
+                         { "y", mm( fp->GetPosition().y ) },
+                         { "rotation", fp->GetOrientation().AsDegrees() },
+                         { "side", fp->IsFlipped() ? "back" : "front" },
+                         { "locked", fp->IsLocked() },
+                         { "pads", (int) fp->Pads().size() } } );
+    }
+
+    out["footprints"] = fps;
+
+    int tracks = 0, vias = 0;
+
+    for( PCB_TRACK* t : board->Tracks() )
+    {
+        if( t->Type() == PCB_VIA_T )
+            vias++;
+        else
+            tracks++;
+    }
+
+    out["track_segments"] = tracks;
+    out["vias"] = vias;
+    out["zones"] = (int) board->Zones().size();
+    out["nets"] = (int) board->GetNetInfo().GetNetCount();
+    out["unrouted_connections"] = (int) board->GetConnectivity()->GetUnconnectedCount( false );
+
+    if( aNets )
+    {
+        json nets = json::array();
+
+        for( NETINFO_ITEM* net : board->GetNetInfo() )
+        {
+            if( net->GetNetCode() <= 0 )
+                continue;
+
+            nets.push_back( { { "name", net->GetNetname().ToStdString() },
+                              { "class", net->GetNetClass() ? net->GetNetClass()->GetName().ToStdString()
+                                                        : std::string() },
+                              { "pads", (int) board->GetConnectivity()->GetPadCount(
+                                                net->GetNetCode() ) } } );
+        }
+
+        out["net_list"] = nets;
+    }
+
+    return out;
+}
+
+
+static MCP_RESULT moveFootprint( PCB_EDIT_FRAME* aFrame, const json& aArgs )
+{
+    BOARD*     board = aFrame->GetBoard();
+    wxString   ref = wxString::FromUTF8( aArgs.value( "reference", std::string() ) );
+    FOOTPRINT* fp = board->FindFootprintByReference( ref );
+
+    if( !fp )
+        return MCP_RESULT::Error( "no footprint " + ref.ToStdString() + " on the board" );
+
+    BOARD_COMMIT commit( aFrame );
+    commit.Modify( fp );
+
+    if( aArgs.contains( "side" ) )
+    {
+        bool back = aArgs["side"] == "back";
+
+        if( back != fp->IsFlipped() )
+            fp->Flip( fp->GetPosition(), FLIP_DIRECTION::LEFT_RIGHT );
+    }
+
+    if( aArgs.contains( "x" ) || aArgs.contains( "y" ) )
+    {
+        VECTOR2I pos = fp->GetPosition();
+
+        if( aArgs.contains( "x" ) )
+            pos.x = pcbIUScale.mmToIU( aArgs["x"].get<double>() );
+
+        if( aArgs.contains( "y" ) )
+            pos.y = pcbIUScale.mmToIU( aArgs["y"].get<double>() );
+
+        fp->SetPosition( pos );
+    }
+
+    if( aArgs.contains( "rotation" ) )
+        fp->SetOrientation( EDA_ANGLE( aArgs["rotation"].get<double>(), DEGREES_T ) );
+
+    commit.Push( _( "Move Footprint" ) );
+
+    return MCP_RESULT::Json( { { "reference", ref.ToStdString() },
+                               { "x", mm( fp->GetPosition().x ) },
+                               { "y", mm( fp->GetPosition().y ) },
+                               { "rotation", fp->GetOrientation().AsDegrees() },
+                               { "side", fp->IsFlipped() ? "back" : "front" } } );
+}
+
+
+static MCP_RESULT runDrc( PCB_EDIT_FRAME* aFrame, const json& aArgs )
+{
+    BOARD*         board = aFrame->GetBoard();
+    TOOL_MANAGER*  mgr = aFrame->GetToolManager();
+    bool           refill = aArgs.value( "refill_zones", true );
+    size_t         limit = aArgs.value( "max_items", 100 );
+
+    mgr->RunAction( ACTIONS::selectionClear );
+    board->DeleteMARKERs( true, false );
+
+    {
+        WX_PROGRESS_REPORTER reporter( aFrame, _( "Design Rules Check" ), 2, PR_CAN_ABORT );
+
+        if( refill )
+            mgr->GetTool<ZONE_FILLER_TOOL>()->FillAllZones( aFrame, &reporter );
+
+        mgr->GetTool<DRC_TOOL>()->RunTests( &reporter, false, false, false );
+    }
+
+    UNITS_PROVIDER         units( pcbIUScale, EDA_UNITS::MM );
+    BOARD_RC_ITEM_RESOLVER resolver( *board );
+    json                   items = json::array();
+    int                    errors = 0, warnings = 0;
+
+    for( PCB_MARKER* marker : board->Markers() )
+    {
+        SEVERITY severity = marker->GetSeverity();
+
+        if( severity == RPT_SEVERITY_EXCLUSION || severity == RPT_SEVERITY_IGNORE )
+            continue;
+
+        std::shared_ptr<RC_ITEM> item = marker->GetRCItem();
+
+        if( severity == RPT_SEVERITY_ERROR )
+            errors++;
+        else
+            warnings++;
+
+        if( items.size() < limit )
+        {
+            items.push_back( { { "severity", severity == RPT_SEVERITY_ERROR ? "error"
+                                                                             : "warning" },
+                               { "type", item->GetSettingsKey().ToStdString() },
+                               { "report", item->ShowReport( &units, severity, resolver )
+                                                   .ToStdString() } } );
+        }
+    }
+
+    aFrame->GetCanvas()->ForceRefresh();
+
+    return MCP_RESULT::Json(
+            { { "errors", errors },
+              { "warnings", warnings },
+              { "unrouted_connections",
+                (int) board->GetConnectivity()->GetUnconnectedCount( false ) },
+              { "items", items },
+              { "note", "The violations are shown as markers on the board." } } );
+}
+
+
+#ifdef __ANDROID__
+// Runs on the MCP connection's thread, so the UI stays live while the router works; every
+// board change is made on the main thread.
+static MCP_RESULT autoroute( PCB_EDIT_FRAME* aFrame, const json& aArgs )
+{
+    namespace AR = KIPLATFORM::AUTOROUTER;
+
+    if( !AR::IsAvailable() )
+        return MCP_RESULT::Error( "this build has no autorouter" );
+
+    bool optimize = aArgs.value( "optimize", true );
+    int  passes = aArgs.value( "max_passes", 0 );
+    bool fill = aArgs.value( "refill_zones", true );
+
+    wxFileName dir( KIPLATFORM::ENV::GetUserCachePath(), wxEmptyString );
+    dir.AppendDir( wxS( "autoroute" ) );
+    dir.Mkdir( wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+    wxString dsn = dir.GetPath() + wxS( "/mcp.dsn" );
+    wxString ses = dir.GetPath() + wxS( "/mcp.ses" );
+    wxString snap = dir.GetPath() + wxS( "/mcp-snapshot.ses" );
+
+    for( const wxString& old : { ses, snap } )
+    {
+        if( wxFileExists( old ) )
+            wxRemoveFile( old );
+    }
+
+    bool exported = false;
+    MCP_SERVER::RunOnMainThread( [&]() { exported = aFrame->ExportSpecctraFile( dsn ); } );
+
+    if( !exported )
+        return MCP_RESULT::Error( "could not export the board for routing" );
+
+    if( !AR::Start( dsn, ses, passes, optimize, snap ) )
+        return MCP_RESULT::Error( "the autorouter is busy (is the Autoroute dialog open?)" );
+
+    bool     pushed = false;
+    int      lastSnapshot = 0;
+    wxString error;
+    AR::STATUS s;
+
+    while( true )
+    {
+        std::this_thread::sleep_for( std::chrono::milliseconds( 500 ) );
+        s = AR::GetStatus();
+
+        if( s.running && s.snapshotSerial != lastSnapshot && wxFileExists( snap ) )
+        {
+            lastSnapshot = s.snapshotSerial;
+            MCP_SERVER::RunOnMainThread(
+                    [&]()
+                    {
+                        if( ImportAutorouteSession( aFrame, snap, pushed, nullptr ) )
+                            pushed = true;
+                    } );
+        }
+
+        if( !s.running )
+            break;
+    }
+
+    if( !s.error.IsEmpty() || !wxFileExists( ses ) )
+        return MCP_RESULT::Error( "routing failed: " + s.error.ToStdString() );
+
+    bool imported = false;
+    MCP_SERVER::RunOnMainThread(
+            [&]()
+            {
+                imported = ImportAutorouteSession( aFrame, ses, pushed, &error );
+
+                if( imported && fill )
+                    aFrame->GetToolManager()->GetTool<ZONE_FILLER_TOOL>()->FillAllZones( aFrame );
+            } );
+
+    if( !imported )
+        return MCP_RESULT::Error( "could not import the routes: " + error.ToStdString() );
+
+    int unrouted = 0;
+    MCP_SERVER::RunOnMainThread(
+            [&]()
+            {
+                unrouted = aFrame->GetBoard()->GetConnectivity()->GetUnconnectedCount( false );
+            } );
+
+    return MCP_RESULT::Json(
+            { { "routed_connections", std::max( 0, s.connections - s.unrouted ) },
+              { "connections", s.connections },
+              { "unrouted_connections", unrouted },
+              { "vias", s.vias },
+              { "track_length_mm", std::round( s.traceLengthMm ) },
+              { "seconds", s.elapsedMs / 1000.0 },
+              { "undo", "All the routing is one undo step (Edit > Undo, or Ctrl+Z)." } } );
+}
+#endif
+
+
+void RegisterPcbMcpTools( PCB_EDIT_FRAME* aFrame )
+{
+    // The tools are declared by the MCP server (so clients see them before the editor opens);
+    // this attaches their handlers while the frame is open.
+    MCP_SERVER& server = MCP_SERVER::Instance();
+
+    server.SetToolHandler( "pcb_board_summary",
+                           [aFrame]( const json& aArgs )
+                           {
+                               return MCP_RESULT::Json(
+                                       boardSummary( aFrame, aArgs.value( "nets", false ) ) );
+                           },
+                           aFrame );
+
+    server.SetToolHandler( "pcb_move_footprint",
+                           [aFrame]( const json& aArgs ) { return moveFootprint( aFrame, aArgs ); },
+                           aFrame );
+
+    server.SetToolHandler( "pcb_run_drc",
+                           [aFrame]( const json& aArgs ) { return runDrc( aFrame, aArgs ); },
+                           aFrame );
+
+#ifdef __ANDROID__
+    server.SetToolHandler( "pcb_autoroute",
+                           [aFrame]( const json& aArgs ) { return autoroute( aFrame, aArgs ); },
+                           aFrame, false );
+#else
+    server.SetToolHandler( "pcb_autoroute",
+                           []( const json& )
+                           {
+                               return MCP_RESULT::Error( "this build has no built-in autorouter" );
+                           },
+                           aFrame );
+#endif
+}
+
+
+void UnregisterPcbMcpTools( PCB_EDIT_FRAME* aFrame )
+{
+    MCP_SERVER::Instance().UnregisterTools( aFrame );
+}
