+MCP_RESULT MCP_RESULT::Text( const std::string& aText )
+{
+    MCP_RESULT r;
+    r.content.push_back( { { "type", "text" }, { "text", aText } } );
+    return r;
+}
+
+
+MCP_RESULT MCP_RESULT::Json( const json& aValue )
+{
+    return Text( aValue.dump( 1 ) );
+}
+
+
+MCP_RESULT MCP_RESULT::Error( const std::string& aMessage )
+{
+    MCP_RESULT r = Text( aMessage );
+    r.isError = true;
+    return r;
+}
