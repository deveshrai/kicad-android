+
+json MCP_SERVER::CallApi( const std::string& aCommand, const json& aArgs, std::string& aError )
+{
+    std::string typeUrl, bytes;
+
+    if( !KiapiJsonToMessage( aCommand, aArgs.is_null() ? std::string( "{}" ) : aArgs.dump(),
+                             typeUrl, bytes, aError ) )
+    {
+        return json();
+    }
+
+    kiapi::common::ApiRequest request;
+    request.mutable_header()->set_client_name( "kicad-mcp" );
+    request.mutable_message()->set_type_url( typeUrl );
+    request.mutable_message()->set_value( bytes );
+
+    kiapi::common::ApiResponse response = Pgm().GetApiServer().HandleRequest( request );
+
+    if( response.status().status() != kiapi::common::ApiStatusCode::AS_OK )
+    {
+        aError = std::string( kiapi::common::ApiStatusCode_Name( response.status().status() ) )
+                 + ": " + response.status().error_message();
+        return json();
+    }
+
+    std::string out;
+
+    if( !KiapiMessageToJson( response.message().type_url(), response.message().value(), out,
+                             aError ) )
+    {
+        return json();
+    }
+
+    json result = json::parse( out, nullptr, false );
+    return result.is_discarded() ? json::object() : result;
+}
