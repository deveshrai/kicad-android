+namespace
+{
+
+/// One library the package provides, before it is registered
+struct PACKAGE_LIB
+{
+    LIBRARY_TABLE_TYPE m_Type;
+    wxString           m_Name;    ///< wanted nickname (file or .pretty name)
+    wxString           m_Path;    ///< absolute path of the .kicad_sym / .lib / .pretty
+    wxString           m_IoType;  ///< library table plugin type
+    wxString           m_Nickname; ///< nickname it was registered under
+};
+
+
+wxString sanitizeName( const wxString& aName )
+{
+    wxString out;
+
+    for( wxUniChar c : aName )
+    {
+        if( wxIsalnum( c ) || c == '-' || c == '_' || c == '.' || c == '+' )
+            out += c;
+        else
+            out += '_';
+    }
+
+    out.Trim().Trim( false );
+
+    while( out.StartsWith( wxS( "." ) ) )
+        out = out.Mid( 1 );
+
+    return out.IsEmpty() ? wxString( wxS( "package" ) ) : out;
+}
+
+
+bool readFile( const wxString& aPath, wxString& aText )
+{
+    wxFFile f( aPath, wxS( "rb" ) );
+    return f.IsOpened() && f.ReadAll( &aText, wxConvUTF8 );
+}
+
+
+bool writeFile( const wxString& aPath, const wxString& aText )
+{
+    wxFFile f( aPath, wxS( "wb" ) );
+    return f.IsOpened() && f.Write( aText, wxConvUTF8 ) && f.Close();
+}
+
+
+/// Every regular file under aDir, recursively
+void listFiles( const wxString& aDir, std::vector<wxString>& aFiles )
+{
+    wxDir dir( aDir );
+
+    if( !dir.IsOpened() )
+        return;
+
+    wxString name;
+
+    for( bool ok = dir.GetFirst( &name, wxEmptyString, wxDIR_FILES | wxDIR_HIDDEN ); ok;
+         ok = dir.GetNext( &name ) )
+    {
+        aFiles.push_back( aDir + wxFileName::GetPathSeparator() + name );
+    }
+
+    for( bool ok = dir.GetFirst( &name, wxEmptyString, wxDIR_DIRS | wxDIR_HIDDEN ); ok;
+         ok = dir.GetNext( &name ) )
+    {
+        listFiles( aDir + wxFileName::GetPathSeparator() + name, aFiles );
+    }
+}
+
+
+/// The file name of a path written on any platform (models often carry Windows paths)
+wxString baseName( const wxString& aPath )
+{
+    wxString p = aPath;
+    p.Replace( wxS( "\\" ), wxS( "/" ) );
+    return p.AfterLast( '/' );
+}
+
+
+wxString quoteSexpr( const wxString& aText )
+{
+    wxString out = aText;
+    out.Replace( wxS( "\\" ), wxS( "\\\\" ) );
+    out.Replace( wxS( "\"" ), wxS( "\\\"" ) );
+    return wxS( "\"" ) + out + wxS( "\"" );
+}
+
+
+/// The libraries in a table of the given type and scope that use a path, by nickname
+std::optional<wxString> nicknameForUri( LIBRARY_MANAGER& aManager, LIBRARY_TABLE_TYPE aType,
+                                        LIBRARY_TABLE_SCOPE aScope, const wxString& aUri )
+{
+    for( LIBRARY_TABLE_ROW* row : aManager.Rows( aType, aScope, true ) )
+    {
+        if( row->URI() == aUri )
+            return row->Nickname();
+    }
+
+    return std::nullopt;
+}
+
+
+/// The top-level "(symbol ...)" blocks of a .kicad_sym file's text
+std::vector<wxString> symbolBlocks( const wxString& aLib )
+{
+    std::vector<wxString> blocks;
+    int                   depth = 0;
+    bool                  inString = false;
+    size_t                start = 0;
+
+    for( size_t i = 0; i < aLib.length(); ++i )
+    {
+        wxUniChar c = aLib[i];
+
+        if( inString )
+        {
+            if( c == '\\' )
+                ++i;
+            else if( c == '"' )
+                inString = false;
+
+            continue;
+        }
+
+        if( c == '"' )
+        {
+            inString = true;
+        }
+        else if( c == '(' )
+        {
+            if( ++depth == 2 )
+                start = i;
+        }
+        else if( c == ')' )
+        {
+            if( depth-- == 2 && aLib.Mid( start, 8 ) == wxS( "(symbol " ) )
+                blocks.push_back( aLib.Mid( start, i - start + 1 ) );
+        }
+    }
+
+    return blocks;
+}
+
+
+/// A symbol library as one .kicad_sym text: a file as it is, a .kicad_symdir folder (one file
+/// per symbol, as KiCad 10's own libraries are) merged
+bool readSymbolLibrary( const wxString& aPath, wxString& aText )
+{
+    if( !wxDirExists( aPath ) )
+        return readFile( aPath, aText );
+
+    std::vector<wxString> files;
+    listFiles( aPath, files );
+    std::sort( files.begin(), files.end() );
+
+    wxString header, body;
+
+    for( const wxString& file : files )
+    {
+        wxString text;
+
+        if( !file.Lower().EndsWith( wxS( ".kicad_sym" ) ) || !readFile( file, text ) )
+            continue;
+
+        std::vector<wxString> blocks = symbolBlocks( text );
+
+        if( header.IsEmpty() && !blocks.empty() )
+            header = text.Left( text.Find( blocks.front() ) );
+
+        for( const wxString& block : blocks )
+            body += wxS( "\t" ) + block + wxS( "\n" );
+    }
+
+    if( header.IsEmpty() )
+        return false;
+
+    aText = header.Trim() + wxS( "\n" ) + body + wxS( ")\n" );
+    return true;
+}
+
+
+} // namespace
+
+
+wxString LIBRARY_PACKAGE_RESULT::Summary() const
+{
+    if( !m_Error.IsEmpty() )
+        return m_Error;
+
+    wxString msg;
+
+    auto join = []( const std::vector<wxString>& aList )
+    {
+        wxString s;
+
+        for( const wxString& item : aList )
+            s += ( s.IsEmpty() ? wxString() : wxString( wxS( ", " ) ) ) + item;
+
+        return s;
+    };
+
+    if( !m_SymbolLibs.empty() )
+        msg += wxString::Format( _( "Symbol libraries: %s\n" ), join( m_SymbolLibs ) );
+
+    if( !m_FootprintLibs.empty() )
+        msg += wxString::Format( _( "Footprint libraries: %s (%d footprints)\n" ),
+                                 join( m_FootprintLibs ), m_Footprints );
+
+    if( m_Models )
+        msg += wxString::Format( _( "3D models: %d, linked from %d footprint model references\n" ),
+                                 m_Models, m_ModelLinks );
+
+    if( m_FootprintLinks )
+        msg += wxString::Format( _( "Symbol footprint fields pointed at the imported footprints: %d\n" ),
+                                 m_FootprintLinks );
+
+    msg += wxString::Format( _( "Files are in %s\n" ), m_PackageDir );
+
+    for( const wxString& note : m_Notes )
+        msg += wxS( "\n" ) + note;
+
+    return msg;
+}
+
+
+bool ImportLibraryPackage( KIWAY* aKiway, const wxString& aZipFile, LIBRARY_TABLE_SCOPE aScope,
+                           LIBRARY_PACKAGE_RESULT& aResult )
+{
+    LIBRARY_MANAGER&    manager = Pgm().GetLibraryManager();
+    const ENV_VAR_MAP&  envVars = Pgm().GetLocalEnvVariables();
+    PROJECT*            project = aKiway ? &aKiway->Prj() : nullptr;
+    wxFileName          zipFn( aZipFile );
+
+    if( !zipFn.FileExists() )
+    {
+        aResult.m_Error = wxString::Format( _( "'%s' does not exist." ), aZipFile );
+        return false;
+    }
+
+    if( aScope == LIBRARY_TABLE_SCOPE::PROJECT && ( !project || project->IsNullProject() ) )
+        aScope = LIBRARY_TABLE_SCOPE::GLOBAL;
+
+    // Where the package goes
+    wxFileName rootFn;
+
+    if( aScope == LIBRARY_TABLE_SCOPE::PROJECT )
+    {
+        rootFn.AssignDir( project->GetProjectPath() );
+    }
+    else
+    {
+        std::optional<wxString> thirdParty =
+                ENV_VAR::GetVersionedEnvVarValue( envVars, wxS( "3RD_PARTY" ) );
+        rootFn.AssignDir( thirdParty ? *thirdParty : PATHS::GetDefault3rdPartyPath() );
+    }
+
+    rootFn.AppendDir( wxS( "libraries" ) );
+
+    // Unpack into a staging directory first; PROJECT_ARCHIVER refuses entries that climb out
+    wxFileName staging( PATHS::GetUserCachePath(), wxEmptyString );
+    staging.AppendDir( wxS( "library-import" ) );
+    staging.AppendDir( sanitizeName( zipFn.GetName() ) );
+
+    if( staging.DirExists() )
+        staging.Rmdir( wxPATH_RMDIR_RECURSIVE );
+
+    staging.Mkdir( wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+
+    WX_STRING_REPORTER unzipReport;
+
+    if( !PROJECT_ARCHIVER::Unarchive( aZipFile, staging.GetPath(), unzipReport ) )
+    {
+        aResult.m_Error = wxString::Format( _( "Could not unpack '%s':\n%s" ), aZipFile,
+                                            unzipReport.GetMessages() );
+        staging.Rmdir( wxPATH_RMDIR_RECURSIVE );
+        return false;
+    }
+
+    std::vector<wxString> files;
+    listFiles( staging.GetPath(), files );
+
+    // The package is named after the zip's single top-level folder when it has one (SnapEDA's
+    // "<part>-KiCad.zip" holds "<part>/"), else after the zip
+    wxString packageName = sanitizeName( zipFn.GetName() );
+    {
+        wxDir    top( staging.GetPath() );
+        wxString name, dirName;
+        int      dirs = 0;
+
+        for( bool ok = top.GetFirst( &name, wxEmptyString, wxDIR_DIRS ); ok; ok = top.GetNext( &name ) )
+        {
+            if( name != wxS( "__MACOSX" ) )
+            {
+                dirName = name;
+                dirs++;
+            }
+        }
+
+        if( dirs == 1 && !top.HasFiles() )
+            packageName = sanitizeName( dirName );
+    }
+
+    wxFileName pkgFn( rootFn );
+    pkgFn.AppendDir( packageName );
+    wxString packageDir = pkgFn.GetPath();
+    aResult.m_PackageDir = packageDir;
+
+    // Sort the files by kind
+    std::vector<wxString>                        symbolFiles;   // .kicad_sym and .lib
+    std::map<wxString, std::vector<wxString>>    footprints;    // .pretty name -> .kicad_mod files
+    std::vector<wxString>                        models;
+    std::map<wxString, wxString>                 dcmFiles;      // legacy .lib name -> .dcm
+    int                                          skipped = 0;
+
+    for( const wxString& path : files )
+    {
+        wxFileName fn( path );
+        wxString   ext = fn.GetExt().Lower();
+
+        if( path.Contains( wxS( "__MACOSX" ) ) || fn.GetFullName().StartsWith( wxS( "._" ) ) )
+            continue;
+
+        if( ext == wxS( "kicad_sym" ) || ext == wxS( "lib" ) )
+        {
+            symbolFiles.push_back( path );
+        }
+        else if( ext == wxS( "dcm" ) )
+        {
+            dcmFiles[fn.GetName()] = path;
+        }
+        else if( ext == wxS( "kicad_mod" ) )
+        {
+            wxString parent = fn.GetDirs().IsEmpty() ? wxString() : fn.GetDirs().Last();
+            wxString lib = parent.Lower().EndsWith( wxS( ".pretty" ) )
+                                   ? parent.BeforeLast( '.' )
+                                   : packageName;
+            footprints[sanitizeName( lib )].push_back( path );
+        }
+        else if( ext == wxS( "step" ) || ext == wxS( "stp" ) || ext == wxS( "wrl" )
+                 || ext == wxS( "wrz" ) || ext == wxS( "stpz" ) )
+        {
+            models.push_back( path );
+        }
+        else
+        {
+            skipped++;
+        }
+    }
+
+    if( symbolFiles.empty() && footprints.empty() && models.empty() )
+    {
+        aResult.m_Error = wxString::Format(
+                _( "'%s' has no KiCad symbols, footprints or 3D models in it.  Some parts sites "
+                   "offer several formats; download the KiCad one." ),
+                zipFn.GetFullName() );
+        staging.Rmdir( wxPATH_RMDIR_RECURSIVE );
+        return false;
+    }
+
+    // Replace an earlier import of the same package
+    if( pkgFn.DirExists() )
+        pkgFn.Rmdir( wxPATH_RMDIR_RECURSIVE );
+
+    if( !pkgFn.Mkdir( wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL ) )
+    {
+        aResult.m_Error = wxString::Format( _( "Could not create '%s'." ), packageDir );
+        staging.Rmdir( wxPATH_RMDIR_RECURSIVE );
+        return false;
+    }
+
+    const wxString sep = wxFileName::GetPathSeparator();
+    std::vector<PACKAGE_LIB> libs;
+
+    // 3D models, by lower-case file name and by lower-case stem (a footprint may name a .wrl
+    // where the package has the .step)
+    wxString                     modelDir = packageDir + sep + packageName + wxS( ".3dshapes" );
+    std::map<wxString, wxString> modelByName, modelByStem;
+
+    if( !models.empty() )
+        wxFileName::Mkdir( modelDir, wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+
+    for( const wxString& path : models )
+    {
+        wxFileName fn( path );
+        wxString   dest = modelDir + sep + fn.GetFullName();
+
+        if( wxCopyFile( path, dest ) )
+        {
+            aResult.m_Models++;
+            modelByName[fn.GetFullName().Lower()] = dest;
+
+            // Prefer STEP for a stem that has both
+            wxString ext = fn.GetExt().Lower();
+
+            if( !modelByStem.count( fn.GetName().Lower() ) || ext == wxS( "step" )
+                || ext == wxS( "stp" ) )
+            {
+                modelByStem[fn.GetName().Lower()] = dest;
+            }
+        }
+    }
+
+    auto modelRef = [&]( const wxString& aAbsPath ) -> wxString
+    {
+        if( aScope == LIBRARY_TABLE_SCOPE::PROJECT )
+            return NormalizePath( wxFileName( aAbsPath ), &envVars, project );
+
+        return NormalizePath( wxFileName( aAbsPath ), &envVars, wxEmptyString );
+    };
+
+    // Footprints, with their 3D model paths pointed at the unpacked models
+    wxRegEx modelRe( wxS( "\\(model[ \t\r\n]+(\"([^\"\\\\]|\\\\.)*\"|[^ \t\r\n()]+)" ),
+                     wxRE_ADVANCED );
+    std::set<wxString> footprintNames;
+
+    for( const auto& [lib, mods] : footprints )
+    {
+        wxString prettyDir = packageDir + sep + lib + wxS( ".pretty" );
+        wxFileName::Mkdir( prettyDir, wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+
+        for( const wxString& path : mods )
+        {
+            wxString text;
+
+            if( !readFile( path, text ) )
+                continue;
+
+            wxString out, rest = text;
+            int      refs = 0;
+
+            while( modelRe.Matches( rest ) )
+            {
+                size_t start, len;
+                modelRe.GetMatch( &start, &len, 1 );
+
+                wxString ref = rest.Mid( start, len );
+
+                if( ref.StartsWith( wxS( "\"" ) ) )
+                {
+                    ref = ref.Mid( 1, ref.length() - 2 );
+                    ref.Replace( wxS( "\\\"" ), wxS( "\"" ) );
+                    ref.Replace( wxS( "\\\\" ), wxS( "\\" ) );
+                }
+
+                wxString name = baseName( ref ).Lower();
+                wxString stem = name.BeforeLast( '.' );
+                wxString target;
+
+                if( modelByName.count( name ) )
+                    target = modelByName[name];
+                else if( !stem.IsEmpty() && modelByStem.count( stem ) )
+                    target = modelByStem[stem];
+
+                out += rest.Left( start );
+
+                if( !target.IsEmpty() )
+                {
+                    out += quoteSexpr( modelRef( target ) );
+                    aResult.m_ModelLinks++;
+                }
+                else
+                {
+                    out += rest.Mid( start, len );
+                }
+
+                refs++;
+                rest = rest.Mid( start + len );
+            }
+
+            out += rest;
+
+            // A package with one footprint and one model, where the footprint names no model
+            // (some sites leave it out): add it
+            if( refs == 0 && mods.size() == 1 && footprints.size() == 1 && models.size() == 1
+                && !modelByStem.empty() )
+            {
+                int close = out.Find( ')', true );
+
+                if( close != wxNOT_FOUND )
+                {
+                    out = out.Left( close )
+                          + wxS( "\t(model " ) + quoteSexpr( modelRef( modelByStem.begin()->second ) )
+                          + wxS( "\n\t\t(offset (xyz 0 0 0))\n\t\t(scale (xyz 1 1 1))\n"
+                                 "\t\t(rotate (xyz 0 0 0))\n\t)\n" )
+                          + out.Mid( close );
+                    aResult.m_ModelLinks++;
+                    aResult.m_Notes.push_back(
+                            _( "The footprint named no 3D model, so the package's model was "
+                               "added to it.  Check its position in the 3D viewer." ) );
+                }
+            }
+
+            wxFileName fn( path );
+
+            if( writeFile( prettyDir + sep + fn.GetFullName(), out ) )
+            {
+                aResult.m_Footprints++;
+                footprintNames.insert( fn.GetName() );
+            }
+        }
+
+        libs.push_back( { LIBRARY_TABLE_TYPE::FOOTPRINT, lib, prettyDir, wxS( "KiCad" ), wxEmptyString } );
+    }
+
+    // Symbol libraries (copied now, their Footprint fields fixed once nicknames are known)
+    for( const wxString& path : symbolFiles )
+    {
+        wxFileName fn( path );
+        wxString   name = sanitizeName( fn.GetName() );
+        bool       legacy = fn.GetExt().Lower() == wxS( "lib" );
+        wxString   dest = packageDir + sep + name + wxS( "." ) + fn.GetExt();
+
+        if( !wxCopyFile( path, dest ) )
+            continue;
+
+        if( legacy && dcmFiles.count( fn.GetName() ) )
+            wxCopyFile( dcmFiles[fn.GetName()], packageDir + sep + name + wxS( ".dcm" ) );
+
+        aResult.m_Symbols++;
+        libs.push_back( { LIBRARY_TABLE_TYPE::SYMBOL, name, dest,
+                          legacy ? wxS( "Legacy" ) : wxS( "KiCad" ), wxEmptyString } );
+    }
+
+    staging.Rmdir( wxPATH_RMDIR_RECURSIVE );
+
+    // Register the libraries
+    std::set<LIBRARY_TABLE_TYPE> changed;
+
+    for( PACKAGE_LIB& lib : libs )
+    {
+        wxString uri = aScope == LIBRARY_TABLE_SCOPE::PROJECT
+                               ? NormalizePath( wxFileName( lib.m_Path ), &envVars, project )
+                               : NormalizePath( wxFileName( lib.m_Path ), &envVars, wxEmptyString );
+
+        if( std::optional<wxString> existing = nicknameForUri( manager, lib.m_Type, aScope, uri ) )
+        {
+            lib.m_Nickname = *existing;     // imported before; the row is still right
+            continue;
+        }
+
+        std::optional<LIBRARY_TABLE*> table = manager.Table( lib.m_Type, aScope );
+
+        if( !table )
+        {
+            aResult.m_Error = _( "Could not open the library table." );
+            return false;
+        }
+
+        wxString description = wxString::Format( _( "Imported from %s" ), zipFn.GetFullName() );
+        wxString nick = lib.m_Name;
+        LIBRARY_TABLE_ROW* row = nullptr;
+
+        // A row an earlier import of the same zip made is updated rather than duplicated
+        for( LIBRARY_TABLE_ROW* existing : manager.Rows( lib.m_Type, aScope, true ) )
+        {
+            if( existing->Nickname() == nick && existing->Description() == description )
+                row = existing;
+        }
+
+        if( !row )
+        {
+            // A clash with the same package imported for the other scope is fine: the project
+            // row shadows the global one, and the symbols keep the same footprint links
+            auto clashes = [&]( const wxString& aNick )
+            {
+                std::optional<LIBRARY_TABLE_ROW*> other = manager.GetRow( lib.m_Type, aNick );
+                return other && ( *other )->Description() != description;
+            };
+
+            for( int i = 2; clashes( nick ); ++i )
+                nick = wxString::Format( wxS( "%s_%d" ), lib.m_Name, i );
+
+            row = &( *table )->InsertRow();
+            row->SetNickname( nick );
+        }
+
+        row->SetURI( uri );
+        row->SetType( lib.m_IoType );
+        row->SetDescription( description );
+
+        bool saved = true;
+
+        ( *table )->Save().map_error(
+                [&]( const LIBRARY_ERROR& aError )
+                {
+                    aResult.m_Error = _( "Error saving library table:\n\n" ) + aError.message;
+                    saved = false;
+                } );
+
+        if( !saved )
+            return false;
+
+        lib.m_Nickname = nick;
+        changed.insert( lib.m_Type );
+    }
+
+    // Point the symbols' Footprint fields at the imported footprints
+    if( !footprintNames.empty() )
+    {
+        // footprint name -> nickname of the library it is in
+        std::map<wxString, wxString> fpLib;
+
+        for( const PACKAGE_LIB& lib : libs )
+        {
+            if( lib.m_Type != LIBRARY_TABLE_TYPE::FOOTPRINT )
+                continue;
+
+            for( const wxString& path : footprints[lib.m_Name] )
+                fpLib[wxFileName( path ).GetName()] = lib.m_Nickname;
+        }
+
+        wxRegEx fieldRe( wxS( "(\\(property[ \t]+\"Footprint\"[ \t]+)\"([^\"]*)\"" ),
+                         wxRE_ADVANCED );
+
+        for( const PACKAGE_LIB& lib : libs )
+        {
+            if( lib.m_Type != LIBRARY_TABLE_TYPE::SYMBOL || lib.m_IoType != wxS( "KiCad" ) )
+                continue;
+
+            wxString text;
+
+            if( !readFile( lib.m_Path, text ) )
+                continue;
+
+            wxString out, rest = text;
+            int      fixed = 0;
+
+            while( fieldRe.Matches( rest ) )
+            {
+                size_t start, len, vStart, vLen;
+                fieldRe.GetMatch( &start, &len, 0 );
+                fieldRe.GetMatch( &vStart, &vLen, 2 );
+
+                wxString value = rest.Mid( vStart, vLen );
+                wxString name = value.Contains( ':' ) ? value.AfterFirst( ':' ) : value;
+                wxString newValue = value;
+
+                if( fpLib.count( name ) )
+                    newValue = fpLib[name] + wxS( ":" ) + name;
+                else if( fpLib.size() == 1 && value.IsEmpty() && footprintNames.size() == 1 )
+                    newValue = fpLib.begin()->second + wxS( ":" ) + fpLib.begin()->first;
+
+                out += rest.Left( vStart ) + newValue + wxS( "\"" );
+
+                if( newValue != value )
+                    fixed++;
+
+                rest = rest.Mid( vStart + vLen + 1 );
+            }
+
+            out += rest;
+
+            if( fixed && writeFile( lib.m_Path, out ) )
+                aResult.m_FootprintLinks += fixed;
+        }
+    }
+
+    for( const PACKAGE_LIB& lib : libs )
+    {
+        ( lib.m_Type == LIBRARY_TABLE_TYPE::SYMBOL ? aResult.m_SymbolLibs
+                                                   : aResult.m_FootprintLibs )
+                .push_back( lib.m_Nickname );
+    }
+
+    if( skipped )
+    {
+        aResult.m_Notes.push_back( wxString::Format(
+                _( "%d other files in the zip (datasheets, read-me files, other CAD formats) "
+                   "were left out." ),
+                skipped ) );
+    }
+
+    // Reload the tables and tell the open editors
+    if( !changed.empty() )
+    {
+        if( aScope == LIBRARY_TABLE_SCOPE::PROJECT )
+            manager.ProjectChanged();
+        else
+            manager.LoadGlobalTables( { LIBRARY_TABLE_TYPE::SYMBOL, LIBRARY_TABLE_TYPE::FOOTPRINT } );
+    }
+
+    if( aKiway )
+    {
+        // Reloading the tables restarts the background preload of every library
+        if( KIFACE* face = aKiway->KiFACE( KIWAY::FACE_SCH, false ) )
+            face->PreloadLibraries( aKiway );
+
+        if( KIFACE* face = aKiway->KiFACE( KIWAY::FACE_PCB, false ) )
+            face->PreloadLibraries( aKiway );
+    }
+
+    // Load the package's own libraries now, so they can be used as soon as this returns
+    for( const PACKAGE_LIB& lib : libs )
+    {
+        manager.ReloadLibraryEntry( lib.m_Type, lib.m_Nickname );
+        std::optional<LIB_STATUS> status = manager.LoadLibraryEntry( lib.m_Type, lib.m_Nickname );
+
+        if( status && status->load_status == LOAD_STATUS::LOAD_ERROR )
+        {
+            aResult.m_Notes.push_back( wxString::Format( _( "Library '%s' could not be loaded: %s" ),
+                                                         lib.m_Nickname,
+                                                         status->error ? status->error->message
+                                                                       : wxString() ) );
+        }
+    }
+
+    if( aKiway )
+    {
+
+        std::string payload;
+
+        for( FRAME_T frame : { FRAME_SCH, FRAME_SCH_SYMBOL_EDITOR, FRAME_SCH_VIEWER,
+                               FRAME_PCB_EDITOR, FRAME_FOOTPRINT_EDITOR, FRAME_FOOTPRINT_VIEWER,
+                               FRAME_CVPCB } )
+        {
+            if( aKiway->Player( frame, false ) )
+                aKiway->ExpressMail( frame, MAIL_RELOAD_LIB, payload );
+        }
+    }
+
+    return true;
+}
+
+
+bool ExportLibraryPackage( KIWAY* aKiway, const wxString& aSymbolLib, const wxString& aZipFile,
+                           LIBRARY_PACKAGE_RESULT& aResult )
+{
+    LIBRARY_MANAGER& manager = Pgm().GetLibraryManager();
+    PROJECT*         project = aKiway ? &aKiway->Prj() : nullptr;
+
+    std::optional<LIBRARY_TABLE_ROW*> symRow = manager.GetRow( LIBRARY_TABLE_TYPE::SYMBOL, aSymbolLib );
+
+    if( !symRow )
+    {
+        aResult.m_Error = wxString::Format( _( "There is no symbol library '%s'." ), aSymbolLib );
+        return false;
+    }
+
+    wxString symPath = LIBRARY_MANAGER::GetFullURI( *symRow, true, project );
+    wxString symText;
+
+    if( ( *symRow )->Type() != wxS( "KiCad" ) || !readSymbolLibrary( symPath, symText ) )
+    {
+        aResult.m_Error = wxString::Format( _( "'%s' is not a KiCad symbol library file that can "
+                                               "be read (%s)." ),
+                                            aSymbolLib, symPath );
+        return false;
+    }
+
+    wxString name = sanitizeName( aSymbolLib );
+    wxString modelDir = name + wxS( ".3dshapes" );
+
+    // The footprints the symbols name, by library
+    std::map<wxString, std::set<wxString>> wanted;
+    wxRegEx fieldRe( wxS( "\\(property[ \t]+\"Footprint\"[ \t]+\"([^\":]+):([^\"]+)\"" ), wxRE_ADVANCED );
+    wxString rest = symText;
+
+    while( fieldRe.Matches( rest ) )
+    {
+        size_t start, len;
+        wanted[fieldRe.GetMatch( rest, 1 )].insert( fieldRe.GetMatch( rest, 2 ) );
+        fieldRe.GetMatch( &start, &len, 0 );
+        rest = rest.Mid( start + len );
+    }
+
+    wxFFileOutputStream ostream( aZipFile );
+
+    if( !ostream.IsOk() )
+    {
+        aResult.m_Error = wxString::Format( _( "Could not create '%s'." ), aZipFile );
+        return false;
+    }
+
+    wxZipOutputStream zip( ostream, -1, wxConvUTF8 );
+
+    auto add = [&]( const wxString& aEntry, const wxString& aText ) -> bool
+    {
+        wxScopedCharBuffer utf8 = aText.utf8_str();
+        return zip.PutNextEntry( name + wxS( "/" ) + aEntry ) && zip.Write( utf8.data(), utf8.length() ).IsOk()
+               && zip.CloseEntry();
+    };
+
+    auto addFile = [&]( const wxString& aEntry, const wxString& aPath ) -> bool
+    {
+        wxFFileInputStream in( aPath );
+        return in.IsOk() && zip.PutNextEntry( name + wxS( "/" ) + aEntry ) && ( zip.Write( in ), true )
+               && zip.CloseEntry();
+    };
+
+    add( name + wxS( ".kicad_sym" ), symText );
+    aResult.m_SymbolLibs.push_back( aSymbolLib );
+    aResult.m_Symbols = 1;
+
+    std::set<wxString>    modelsAdded;
+    std::vector<wxString> missingModels;
+    wxRegEx modelRe( wxS( "\\(model[ \t\r\n]+(\"([^\"\\\\]|\\\\.)*\"|[^ \t\r\n()]+)" ),
+                     wxRE_ADVANCED );
+
+    for( const auto& [lib, fps] : wanted )
+    {
+        std::optional<LIBRARY_TABLE_ROW*> fpRow = manager.GetRow( LIBRARY_TABLE_TYPE::FOOTPRINT, lib );
+
+        if( !fpRow || ( *fpRow )->Type() != wxS( "KiCad" ) )
+        {
+            aResult.m_Notes.push_back( wxString::Format(
+                    _( "Footprint library '%s' was not found or is not a KiCad .pretty folder; "
+                       "its footprints were left out." ), lib ) );
+            continue;
+        }
+
+        wxString prettyPath = LIBRARY_MANAGER::GetFullURI( *fpRow, true, project );
+        bool     any = false;
+
+        for( const wxString& fp : fps )
+        {
+            wxString text;
+
+            if( !readFile( prettyPath + wxFileName::GetPathSeparator() + fp + wxS( ".kicad_mod" ), text ) )
+            {
+                aResult.m_Notes.push_back( wxString::Format( _( "Footprint '%s:%s' was not found." ),
+                                                             lib, fp ) );
+                continue;
+            }
+
+            // Copy the models in, and point the footprint at the copies
+            wxString out, r = text;
+
+            while( modelRe.Matches( r ) )
+            {
+                size_t start, len;
+                modelRe.GetMatch( &start, &len, 1 );
+
+                wxString ref = r.Mid( start, len );
+
+                if( ref.StartsWith( wxS( "\"" ) ) )
+                {
+                    ref = ref.Mid( 1, ref.length() - 2 );
+                    ref.Replace( wxS( "\\\"" ), wxS( "\"" ) );
+                    ref.Replace( wxS( "\\\\" ), wxS( "\\" ) );
+                }
+
+                wxString file = ExpandEnvVarSubstitutions( ref, project );
+                wxFileName fn( file );
+
+                if( !fn.IsAbsolute() )
+                    fn.MakeAbsolute( prettyPath );
+
+                out += r.Left( start );
+
+                if( fn.FileExists() )
+                {
+                    if( !modelsAdded.count( fn.GetFullName() ) )
+                    {
+                        addFile( modelDir + wxS( "/" ) + fn.GetFullName(), fn.GetFullPath() );
+                        modelsAdded.insert( fn.GetFullName() );
+                        aResult.m_Models++;
+                    }
+
+                    out += quoteSexpr( modelDir + wxS( "/" ) + fn.GetFullName() );
+                    aResult.m_ModelLinks++;
+                }
+                else
+                {
+                    out += r.Mid( start, len );
+                    missingModels.push_back( fn.GetFullName() );
+                }
+
+                r = r.Mid( start + len );
+            }
+
+            out += r;
+            add( lib + wxS( ".pretty/" ) + fp + wxS( ".kicad_mod" ), out );
+            aResult.m_Footprints++;
+            any = true;
+        }
+
+        if( any )
+            aResult.m_FootprintLibs.push_back( lib );
+    }
+
+    if( !missingModels.empty() )
+    {
+        wxString some;
+
+        for( size_t i = 0; i < missingModels.size() && i < 5; ++i )
+            some += ( i ? wxS( ", " ) : wxS( "" ) ) + missingModels[i];
+
+        aResult.m_Notes.push_back( wxString::Format(
+                _( "%d 3D models were not found on this device and were left out (%s%s); the "
+                   "footprints still name them." ),
+                (int) missingModels.size(), some, missingModels.size() > 5 ? wxS( ", ..." ) : wxS( "" ) ) );
+    }
+
+    if( !zip.Close() || !ostream.Close() )
+    {
+        aResult.m_Error = wxString::Format( _( "Could not write '%s'." ), aZipFile );
+        return false;
+    }
+
+    aResult.m_PackageDir = aZipFile;
+    return true;
+}
