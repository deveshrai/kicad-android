+/// Where a browser saves downloads: parts arrive there as zips
+static wxString downloadsDir()
+{
+    wxFileName docs( KIPLATFORM::ENV::GetDocumentsPath(), wxEmptyString );
+
+    // Documents and Download(s) are siblings on Android, macOS, Linux and Windows
+    if( docs.GetDirCount() > 0 )
+    {
+        docs.RemoveLastDir();
+
+        for( const wxString& name : { wxS( "Download" ), wxS( "Downloads" ) } )
+        {
+            wxFileName dl( docs.GetPath(), wxEmptyString );
+            dl.AppendDir( name );
+
+            if( dl.DirExists() )
+                return dl.GetPath();
+        }
+    }
+
+    return KIPLATFORM::ENV::GetDocumentsPath();
+}
+
+
+int KICAD_MANAGER_CONTROL::ImportLibraryPackage( const TOOL_EVENT& aEvent )
+{
+    wxString defaultDir = downloadsDir();
+
+    wxFileDialog dlg( m_frame, _( "Import Library Package" ), defaultDir, wxEmptyString,
+                      FILEEXT::ZipFileWildcard(), wxFD_OPEN | wxFD_FILE_MUST_EXIST );
+
+    if( dlg.ShowModal() == wxID_CANCEL )
+        return 0;
+
+    LIBRARY_TABLE_SCOPE scope = LIBRARY_TABLE_SCOPE::GLOBAL;
+
+    if( !Prj().IsNullProject() )
+    {
+        wxMessageDialog ask( m_frame,
+                             _( "Add the libraries for all projects, or only for the open "
+                                "project?  Libraries for this project are copied into its "
+                                "folder, so they travel with it." ),
+                             _( "Import Library Package" ),
+                             wxYES_NO | wxCANCEL | wxICON_QUESTION );
+        ask.SetYesNoCancelLabels( _( "All Projects" ), _( "This Project" ), _( "Cancel" ) );
+
+        int answer = ask.ShowModal();
+
+        if( answer == wxID_CANCEL )
+            return 0;
+
+        scope = answer == wxID_NO ? LIBRARY_TABLE_SCOPE::PROJECT : LIBRARY_TABLE_SCOPE::GLOBAL;
+    }
+
+    LIBRARY_PACKAGE_RESULT result;
+    wxBusyCursor           busy;
+    bool                   ok = ::ImportLibraryPackage( &m_frame->Kiway(), dlg.GetPath(), scope, result );
+
+    wxMessageBox( result.Summary(), _( "Import Library Package" ),
+                  wxOK | ( ok ? wxICON_INFORMATION : wxICON_ERROR ), m_frame );
+    return 0;
+}
+
+
+int KICAD_MANAGER_CONTROL::ExportLibraryPackage( const TOOL_EVENT& aEvent )
+{
+    // The user's own libraries first, then KiCad's stock ones
+    LIBRARY_MANAGER& manager = Pgm().GetLibraryManager();
+    wxArrayString    own, stock;
+    wxString         stockPrefix = wxS( "${" ) + ENV_VAR::GetVersionedEnvVarName( wxS( "SYMBOL_DIR" ) );
+
+    for( LIBRARY_TABLE_ROW* row : manager.Rows( LIBRARY_TABLE_TYPE::SYMBOL ) )
+    {
+        if( row->Type() != wxS( "KiCad" ) || row->Hidden() )
+            continue;
+
+        ( row->URI().StartsWith( stockPrefix ) ? stock : own ).Add( row->Nickname() );
+    }
+
+    own.Sort();
+    stock.Sort();
+    WX_APPEND_ARRAY( own, stock );
+
+    if( own.IsEmpty() )
+        return 0;
+
+    wxSingleChoiceDialog choose( m_frame,
+                                 _( "Symbol library to export, with its footprints and 3D models:" ),
+                                 _( "Export Library Package" ), own );
+
+    if( choose.ShowModal() != wxID_OK )
+        return 0;
+
+    wxString lib = choose.GetStringSelection();
+
+    wxFileDialog dlg( m_frame, _( "Export Library Package" ), downloadsDir(), lib + wxS( ".zip" ),
+                      FILEEXT::ZipFileWildcard(), wxFD_SAVE | wxFD_OVERWRITE_PROMPT );
+
+    if( dlg.ShowModal() == wxID_CANCEL )
+        return 0;
+
+    LIBRARY_PACKAGE_RESULT result;
+    wxBusyCursor           busy;
+    bool                   ok = ::ExportLibraryPackage( &m_frame->Kiway(), lib, dlg.GetPath(), result );
+
+    wxString notes;
+
+    for( const wxString& note : result.m_Notes )
+        notes += wxS( "\n\n" ) + note;
+
+    wxMessageBox( ok ? wxString::Format( _( "Saved %s with %d footprints and %d 3D models.%s" ),
+                                         dlg.GetPath(), result.m_Footprints, result.m_Models, notes )
+                     : result.Summary(),
+                  _( "Export Library Package" ), wxOK | ( ok ? wxICON_INFORMATION : wxICON_ERROR ),
+                  m_frame );
+    return 0;
+}
