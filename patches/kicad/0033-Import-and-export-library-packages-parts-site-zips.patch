+#pragma once
+
+#include <libraries/library_table.h>
+#include <wx/string.h>
+#include <vector>
+
+class KIWAY;
+class PROJECT;
+
+/**
+ * What ImportLibraryPackage() did, for the summary shown to the user (or an MCP client).
+ */
+struct LIBRARY_PACKAGE_RESULT
+{
+    wxString              m_PackageDir;      ///< where the package's files now live
+    std::vector<wxString> m_SymbolLibs;      ///< symbol library nicknames added or updated
+    std::vector<wxString> m_FootprintLibs;   ///< footprint library nicknames added or updated
+    int                   m_Symbols = 0;     ///< symbol library files found
+    int                   m_Footprints = 0;  ///< footprints found
+    int                   m_Models = 0;      ///< 3D model files found
+    int                   m_ModelLinks = 0;  ///< footprint 3D model references pointed at them
+    int                   m_FootprintLinks = 0; ///< symbol Footprint fields pointed at them
+    std::vector<wxString> m_Notes;           ///< things the user should know (skipped files...)
+    wxString              m_Error;           ///< set when the import failed
+
+    wxString Summary() const;
+};
+
+/**
+ * Import a part downloaded from a parts site (SnapEDA, Ultra Librarian, SamacSys / Component
+ * Search Engine, Digi-Key, Mouser...) as a zip of KiCad files.
+ *
+ * The symbol libraries (.kicad_sym, or legacy .lib with .dcm), footprints (.kicad_mod, grouped
+ * into .pretty libraries) and 3D models (.step, .stp, .wrl) in the zip are unpacked into
+ * <root>/<package name>, where root is ${KICAD*_3RD_PARTY}/libraries for all projects or
+ * <project>/libraries for the open project.  Then:
+ *  - the footprints' 3D model paths, which usually point into the author's own disk, are
+ *    pointed at the unpacked models;
+ *  - the symbols' Footprint fields are pointed at the unpacked footprint libraries;
+ *  - the libraries are added to the global or project library tables (an existing row for the
+ *    same file is kept, a nickname clash gets a suffix), and the open editors reload them.
+ *
+ * Importing the same zip again replaces the package's files.  Entries that would land outside
+ * the package directory are refused.
+ */
+bool ImportLibraryPackage( KIWAY* aKiway, const wxString& aZipFile, LIBRARY_TABLE_SCOPE aScope,
+                           LIBRARY_PACKAGE_RESULT& aResult );
+
+
+/**
+ * Write a symbol library as a library package zip, the reverse of ImportLibraryPackage():
+ *   <name>/<name>.kicad_sym              the symbol library
+ *   <name>/<fp lib>.pretty/*.kicad_mod   the footprints its symbols' Footprint fields name
+ *   <name>/<name>.3dshapes/*             the 3D models those footprints use
+ * The footprints' model paths are rewritten to the packaged models, so the zip imports anywhere
+ * (with this KiCad or by hand).  Footprints or models that cannot be found are listed in
+ * aResult.m_Notes.  Only KiCad-format (.kicad_sym) symbol libraries can be exported.
+ */
+bool ExportLibraryPackage( KIWAY* aKiway, const wxString& aSymbolLib, const wxString& aZipFile,
+                           LIBRARY_PACKAGE_RESULT& aResult );
