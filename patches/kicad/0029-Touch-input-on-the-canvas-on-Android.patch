+#ifdef __ANDROID__
+namespace
+{
+/// Finger travel (dp, which is what Qt's logical pixels are on Android) before a touch counts
+/// as a drag rather than a tap
+constexpr double TOUCH_SLOP = 8.0;
+
+/// How long a single finger rests before it becomes a mouse press without moving (ms)
+constexpr int TOUCH_HOLD_MS = 120;
+
+/// A three-finger touch shorter than this, with little travel, is a tap (ms)
+constexpr long long TOUCH_TAP_MS = 400;
+}
+
+
+void WX_VIEW_CONTROLS::touchStartMouse()
+{
+    m_touchTimer.Stop();
+
+    if( m_touches.empty() )
+        return;
+
+    const TOUCH_POINT& tp = m_touches.front();
+    const wxPoint      start( KiROUND( tp.start.x ), KiROUND( tp.start.y ) );
+    const wxPoint      pos( KiROUND( tp.pos.x ), KiROUND( tp.pos.y ) );
+
+    m_touchMode = TOUCH_MODE::MOUSE;
+    m_touchMouseId = tp.id;
+
+    // Move there first: a floating item follows the pointer and is dropped where it is
+    KIPLATFORM::UI::InjectTouchMouse( m_parentPanel, KIPLATFORM::UI::TOUCH_MOUSE::HOVER, start );
+    KIPLATFORM::UI::InjectTouchMouse( m_parentPanel, KIPLATFORM::UI::TOUCH_MOUSE::PRESS, start );
+
+    if( pos != start )
+        KIPLATFORM::UI::InjectTouchMouse( m_parentPanel, KIPLATFORM::UI::TOUCH_MOUSE::DRAG, pos );
+}
+
+
+void WX_VIEW_CONTROLS::touchResetGesture()
+{
+    if( m_touches.size() < 2 )
+        return;
+
+    const VECTOR2D a = m_touches[0].pos;
+    const VECTOR2D b = m_touches[1].pos;
+
+    m_touchLastCentroid = ( a + b ) / 2.0;
+    m_touchLastSpan = ( b - a ).EuclideanNorm();
+}
+
+
+void WX_VIEW_CONTROLS::onTouch( wxMultiTouchEvent& aEvent )
+{
+    using KIPLATFORM::UI::TOUCH_MOUSE;
+
+    void*            id = aEvent.GetSequenceId().GetID();
+    const VECTOR2D   pos( aEvent.GetPosition().m_x, aEvent.GetPosition().m_y );
+    const wxPoint    ipos( KiROUND( pos.x ), KiROUND( pos.y ) );
+    const wxEventType type = aEvent.GetEventType();
+    const long long  now = wxGetLocalTimeMillis().GetValue();
+
+    auto it = std::find_if( m_touches.begin(), m_touches.end(),
+                            [id]( const TOUCH_POINT& tp ) { return tp.id == id; } );
+
+    if( type == wxEVT_TOUCH_BEGIN )
+    {
+        if( m_touches.empty() )
+        {
+            m_touchMode = TOUCH_MODE::PENDING;
+            m_touchMaxFingers = 0;
+            m_touchStartMs = now;
+            m_touchTravel = 0.0;
+        }
+
+        if( it == m_touches.end() )
+            m_touches.push_back( { id, pos, pos } );
+
+        m_touchMaxFingers = std::max( m_touchMaxFingers, m_touches.size() );
+
+        if( m_touches.size() == 1 )
+        {
+            m_touchTimer.StartOnce( TOUCH_HOLD_MS );
+        }
+        else if( m_touchMode == TOUCH_MODE::PENDING || m_touchMode == TOUCH_MODE::GESTURE )
+        {
+            m_touchTimer.Stop();
+            m_touchMode = TOUCH_MODE::GESTURE;
+            touchResetGesture();
+        }
+
+        return;
+    }
+
+    if( it == m_touches.end() )
+        return;
+
+    it->pos = pos;
+    m_touchTravel = std::max( m_touchTravel, ( pos - it->start ).EuclideanNorm() );
+
+    if( type == wxEVT_TOUCH_MOVE )
+    {
+        if( m_touchMode == TOUCH_MODE::PENDING && m_touchTravel > TOUCH_SLOP )
+            touchStartMouse();
+        else if( m_touchMode == TOUCH_MODE::MOUSE && id == m_touchMouseId )
+            KIPLATFORM::UI::InjectTouchMouse( m_parentPanel, TOUCH_MOUSE::DRAG, ipos );
+        else if( m_touchMode == TOUCH_MODE::GESTURE && m_touches.size() == 2 )
+        {
+            const VECTOR2D a = m_touches[0].pos;
+            const VECTOR2D b = m_touches[1].pos;
+            const VECTOR2D centroid = ( a + b ) / 2.0;
+            const double   span = ( b - a ).EuclideanNorm();
+            const double   zoom = ( m_touchLastSpan > 1.0 && span > 1.0 ) ? span / m_touchLastSpan
+                                                                          : 1.0;
+
+            ApplyPanAndZoomGesture( centroid - m_touchLastCentroid, zoom, centroid );
+            repaintRetained();
+
+            m_touchLastCentroid = centroid;
+            m_touchLastSpan = span;
+        }
+
+        return;
+    }
+
+    // wxEVT_TOUCH_END or wxEVT_TOUCH_CANCEL
+    if( m_touchMode == TOUCH_MODE::PENDING )
+    {
+        // A tap: click where the finger was
+        touchStartMouse();
+        KIPLATFORM::UI::InjectTouchMouse( m_parentPanel, TOUCH_MOUSE::RELEASE, ipos );
+        m_touchMode = TOUCH_MODE::IGNORE_REST;
+    }
+    else if( m_touchMode == TOUCH_MODE::MOUSE && id == m_touchMouseId )
+    {
+        KIPLATFORM::UI::InjectTouchMouse( m_parentPanel, TOUCH_MOUSE::RELEASE, ipos );
+        m_touchMode = TOUCH_MODE::IGNORE_REST;
+    }
+
+    m_touches.erase( it );
+
+    if( m_touchMode == TOUCH_MODE::GESTURE )
+        touchResetGesture();
+
+    if( m_touches.empty() )
+    {
+        m_touchTimer.Stop();
+
+        if( m_touchMaxFingers == 3 && now - m_touchStartMs < TOUCH_TAP_MS
+            && m_touchTravel < 2 * TOUCH_SLOP && type == wxEVT_TOUCH_END )
+        {
+            if( EDA_DRAW_FRAME* frame = m_parentPanel->GetParentEDAFrame() )
+            {
+                if( TOOL_MANAGER* toolMgr = frame->GetToolManager() )
+                    toolMgr->RunAction( ACTIONS::zoomFitScreen );
+            }
+        }
+
+        m_touchMode = TOUCH_MODE::NONE;
+        m_touchMouseId = nullptr;
+    }
+}
+#endif
+
