+#ifdef __ANDROID__
+void KIPLATFORM::UI::InjectTouchMouse( wxWindow* aWindow, TOUCH_MOUSE aAction, const wxPoint& aPos )
+{
+    QWidget* canvas = qtWidget( aWindow );
+
+    if( !canvas )
+        return;
+
+    // wx client coordinates are the scroll area viewport's
+    QWidget* viewport = canvas;
+
+    if( QAbstractScrollArea* area = qobject_cast<QAbstractScrollArea*>( canvas ) )
+        viewport = area->viewport();
+
+    const QPointF local( aPos.x, aPos.y );
+    const QPointF global = viewport->mapToGlobal( local );
+    QWindow*      target = nullptr;
+    QPointF       targetLocal;
+
+    // The Vulkan window covers the viewport at (0,0) and forwards input to it, as for the
+    // real pointer; without one, go through the top-level window
+    if( QObject* vk = canvas->property( "kicadVulkanWindow" ).value<QObject*>() )
+    {
+        target = static_cast<QWindow*>( vk );
+        targetLocal = local;
+    }
+    else if( QWidget* top = viewport->window() )
+    {
+        target = top->windowHandle();
+        targetLocal = viewport->mapTo( top, local );
+    }
+
+    if( !target )
+        return;
+
+    QEvent::Type     type = QEvent::MouseMove;
+    Qt::MouseButton  button = Qt::NoButton;
+    Qt::MouseButtons state = Qt::NoButton;
+
+    switch( aAction )
+    {
+    case TOUCH_MOUSE::HOVER:                                                              break;
+    case TOUCH_MOUSE::DRAG:    state = Qt::LeftButton;                                    break;
+    case TOUCH_MOUSE::PRESS:   type = QEvent::MouseButtonPress;   button = Qt::LeftButton;
+                               state = Qt::LeftButton;                                    break;
+    case TOUCH_MOUSE::RELEASE: type = QEvent::MouseButtonRelease; button = Qt::LeftButton; break;
+    }
+
+    // QWindowSystemInterface takes native (device) pixels, like a platform plugin delivers
+    QWindowSystemInterface::handleMouseEvent( target,
+                                              QHighDpi::toNativeLocalPosition( targetLocal, target ),
+                                              QHighDpi::toNativeGlobalPosition( global, target ),
+                                              state, button, type,
+                                              QGuiApplication::keyboardModifiers(),
+                                              Qt::MouseEventSynthesizedByApplication );
+}
+#endif
