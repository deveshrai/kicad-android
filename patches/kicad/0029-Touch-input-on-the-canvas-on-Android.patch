+#ifdef __ANDROID__
+    /**
+     * Touch input (Android).  One finger is the left mouse button; its press waits until the
+     * finger moves, lifts or is held briefly, so that a second finger can still make it a
+     * gesture.  Two fingers pan and zoom.  A three-finger tap zooms to fit.
+     */
+    enum class TOUCH_MODE
+    {
+        NONE,      ///< no finger down
+        PENDING,   ///< one finger down, not yet decided
+        MOUSE,     ///< one finger drives the left mouse button
+        GESTURE,   ///< two or more fingers: pan and zoom
+        IGNORE_REST ///< the mouse finger lifted while others are still down
+    };
+
+    struct TOUCH_POINT
+    {
+        void*    id;
+        VECTOR2D start;
+        VECTOR2D pos;
+    };
+
+    void touchStartMouse();
+    void touchResetGesture();
+
+    TOUCH_MODE               m_touchMode = TOUCH_MODE::NONE;
+    std::vector<TOUCH_POINT> m_touches;
+    void*                    m_touchMouseId = nullptr;
+    size_t                   m_touchMaxFingers = 0;
+    long long                m_touchStartMs = 0;
+    double                   m_touchTravel = 0.0;
+    VECTOR2D                 m_touchLastCentroid;
+    double                   m_touchLastSpan = 0.0;
+    wxTimer                  m_touchTimer;
+#endif
 };
