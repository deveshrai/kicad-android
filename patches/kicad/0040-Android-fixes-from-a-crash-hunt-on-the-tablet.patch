index ff7cbb9a..19086b66 100644
--- a/common/kiway_player.cpp
+++ b/common/kiway_player.cpp
@@ -20,6 +20,10 @@
 
 
 #include <kiway_player.h>
+#ifdef __ANDROID__
+#include <eda_draw_frame.h>
+#include <class_draw_panel_gal.h>
+#endif
 #include <kiway_mail.h>
 #include <kiway.h>
 #include <id.h>
@@ -110,7 +114,17 @@ bool KIWAY_PLAYER::ShowModal( wxString* aResult, wxWindow* aResultantFocusWindow
 
     m_modal_resultant_parent = aResultantFocusWindow;
 
+#ifdef __ANDROID__
+    // Frames fill the activity's window on Android (see EDA_BASE_FRAME::LoadWindowState()).  One
+    // that loads no window state, like the footprint chooser, would open at its fitted size in
+    // the top left corner, over the menu bar.  This has to come before the frame is shown: Qt
+    // gives a maximized window its geometry when it becomes visible, and not after
+    if( !IsMaximized() )
+        Maximize();
+#endif
+
     Show( true );
+
     Raise();    // Needed on some Window managers to always display the frame
 
     SetFocus();
@@ -143,6 +157,17 @@ bool KIWAY_PLAYER::ShowModal( wxString* aResult, wxWindow* aResultantFocusWindow
         // the events settle down, set the focus
         wxSafeYield();
         aResultantFocusWindow->SetFocus();
+
+#ifdef __ANDROID__
+        // That gives the keyboard focus to the frame itself, and hotkeys come from the canvas.
+        // On desktop the canvas takes the focus back as soon as the pointer moves over it; with
+        // touch there is no pointer, and the hotkeys were dead until the canvas was tapped
+        if( EDA_DRAW_FRAME* drawFrame = dynamic_cast<EDA_DRAW_FRAME*>( aResultantFocusWindow ) )
+        {
+            if( drawFrame->GetCanvas() )
+                drawFrame->GetCanvas()->SetFocus();
+        }
+#endif
     }
 
     return m_modal_ret_val;
diff --git a/common/tool/common_control.cpp b/common/tool/common_control.cpp
index c12d77ef..ff263b0f 100644
--- a/common/tool/common_control.cpp
+++ b/common/tool/common_control.cpp
@@ -221,6 +221,44 @@ public:
 
 int COMMON_CONTROL::Execute( const wxString& aExecutible, const wxString& aParam )
 {
+#ifdef __ANDROID__
+    // The Android app has no separate programs to run: the other tools are frames of this
+    // process, opened through the kiway like the editors.
+    FRAME_T playerType = FRAME_T_COUNT;
+
+    if( aExecutible == GERBVIEW_EXE )
+        playerType = FRAME_GERBER;
+    else if( aExecutible == PCB_CALCULATOR_EXE )
+        playerType = FRAME_CALC;
+    else if( aExecutible == PL_EDITOR_EXE )
+        playerType = FRAME_PL_EDITOR;
+
+    if( playerType != FRAME_T_COUNT )
+    {
+        KIWAY_PLAYER* player = m_frame->Kiway().Player( playerType, true );
+
+        wxCHECK_MSG( player != nullptr, 0, wxT( "Cannot open/create the frame" ) );
+
+        if( !player->IsShown() )
+            player->Show( true );
+
+        // A file to open, or (the Gerber viewer) the folder to start in
+        if( !aParam.IsEmpty() )
+            player->OpenProjectFiles( { aParam } );
+
+        showFrame( player );
+        return 0;
+    }
+
+    if( aExecutible == EESCHEMA_EXE || aExecutible == PCBNEW_EXE )
+    {
+        // These open a file of another project in a second copy of the editor.
+        DisplayInfoMessage( m_frame, _( "This file is not part of the open project.  Open its "
+                                        "project to edit it." ) );
+        return 0;
+    }
+#endif
+
     TERMINATE_HANDLER* callback = new TERMINATE_HANDLER( aExecutible );
 
     bool isKicadBinary = false;
