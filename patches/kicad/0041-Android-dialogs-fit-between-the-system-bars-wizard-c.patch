+        /**
+         * The part of the screen that windows over @p aWindow's top-level window may use, in
+         * screen coordinates: that window's screen rect without the system bars (status bar,
+         * navigation bar or taskbar) and display cutouts that Android draws over it.
+         *
+         * The top-level frames are maximized edge to edge, so their screen rect, like the
+         * display's client area, includes the status bar.
+         */
+        wxRect GetUsableScreenRect( const wxWindow* aWindow );
