diff --git a/libs/kiplatform/port/wxqt/ui.cpp b/libs/kiplatform/port/wxqt/ui.cpp
index 2a00915b..4327e410 100644
--- a/libs/kiplatform/port/wxqt/ui.cpp
+++ b/libs/kiplatform/port/wxqt/ui.cpp
@@ -449,6 +449,31 @@ bool KIPLATFORM::UI::SupportsKeyState()
 
 
 #ifdef __ANDROID__
+wxRect KIPLATFORM::UI::GetUsableScreenRect( const wxWindow* aWindow )
+{
+    wxWindow* top = aWindow ? wxGetTopLevelParent( const_cast<wxWindow*>( aWindow ) ) : nullptr;
+
+    if( !top )
+        return wxRect();
+
+    wxRect rect = top->GetScreenRect();
+
+    if( QWidget* widget = top->GetHandle() )
+    {
+        if( QWindow* window = widget->windowHandle() )
+        {
+            const QMargins margins = window->safeAreaMargins();
+            rect.x += margins.left();
+            rect.y += margins.top();
+            rect.width -= margins.left() + margins.right();
+            rect.height -= margins.top() + margins.bottom();
+        }
+    }
+
+    return rect;
+}
