diff --git a/CMakeLists.txt b/CMakeLists.txt
index b4b5627b..ef8be63b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -77,8 +77,9 @@ if( APPLE )
     enable_language( OBJCXX )
 endif()
 
-# Create a flag to identify the non-Apple unix systems
-if( UNIX AND NOT APPLE )
+# Create a flag to identify the non-Apple unix desktop systems.  Android is excluded: it has
+# none of the desktop integration (GTK, Wayland, Flatpak) these branches configure.
+if( UNIX AND NOT APPLE AND NOT ANDROID )
     set( UNIX_NOT_APPLE ON )
 else()
     set( UNIX_NOT_APPLE OFF )
@@ -127,7 +128,7 @@ option( KICAD_UPDATE_CHECK
 
 cmake_dependent_option( KICAD_BUILD_NATIVE_MODEL_PREVIEW
     "Build native operating-system 3D model preview components"
-    OFF "MINGW"
+    OFF "MINGW OR ANDROID"
     ON )
 
 if( KICAD_BUILD_NATIVE_MODEL_PREVIEW )
@@ -1040,7 +1041,14 @@ message(STATUS "wxHAS_GLX=${wxWidgets_HAS_GLX}")
 message(STATUS "wxHAS_EGL=${wxWidgets_HAS_EGL}")
 
 # Find OpenGL with GLU
-find_package( OpenGL REQUIRED )
+if( ANDROID )
+    # No desktop GL on Android: GL calls go through glad at run time, GLU is built from
+    # thirdparty/glu, and the platform provides GLES and EGL.  The OpenGL GAL fails to start
+    # without a desktop GL context and KiCad falls back to the Cairo or Modern GAL.
+    set( OPENGL_LIBRARIES glu GLESv3 EGL )
+else()
+    find_package( OpenGL REQUIRED )
+endif()
 
 if( KICAD_WAYLAND )
     message( STATUS "Configuring KiCad to support Wayland features" )
diff --git a/include/kicad_gl/kiglu.h b/include/kicad_gl/kiglu.h
index fcb0aaf9..2aa8fa2a 100644
--- a/include/kicad_gl/kiglu.h
+++ b/include/kicad_gl/kiglu.h
@@ -30,6 +30,9 @@
 #ifdef __APPLE__
 #include <OpenGL/gl.h>
 #include <OpenGL/glu.h>
+#elif defined( __ANDROID__ )
+// No system GL headers: glad (above) declares GL, GLU comes from thirdparty/glu
+#include <GL/glu.h>
 #else
 #include <GL/gl.h>
 #include <GL/glu.h>
