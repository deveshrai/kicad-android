diff --git a/thirdparty/glu/gl_shim/GL/gl.h b/thirdparty/glu/gl_shim/GL/gl.h
new file mode 100644
index 00000000..e63f3484
--- /dev/null
+++ b/thirdparty/glu/gl_shim/GL/gl.h
@@ -0,0 +1,9 @@
+/*
+ * GLU expects <GL/gl.h>.  Android has no desktop GL headers or libGL, so route GL through
+ * KiCad's glad loader: GLU's few GL calls become glad function pointers, resolved at run
+ * time from whatever GL context exists (and never called when no desktop GL is available).
+ */
+#ifndef KICAD_GLU_GL_SHIM_H
+#define KICAD_GLU_GL_SHIM_H
+#include <glad/gl.h>
+#endif
