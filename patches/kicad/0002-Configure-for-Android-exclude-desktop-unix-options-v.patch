diff --git a/thirdparty/glu/CMakeLists.txt b/thirdparty/glu/CMakeLists.txt
new file mode 100644
index 00000000..cc50314a
--- /dev/null
+++ b/thirdparty/glu/CMakeLists.txt
@@ -0,0 +1,36 @@
+# SGI/Mesa GLU 9.0.3 (tessellator, quadrics, utilities; no NURBS), built for platforms without
+# a system GLU (Android).  License: SGI Free Software License B 2.0 (see LICENSE file).
+add_library( glu STATIC
+    src/libutil/error.c
+    src/libutil/glue.c
+    src/libutil/mipmap.c
+    src/libutil/project.c
+    src/libutil/quad.c
+    src/libutil/registry.c
+    src/libtess/dict.c
+    src/libtess/geom.c
+    src/libtess/memalloc.c
+    src/libtess/mesh.c
+    src/libtess/normal.c
+    src/libtess/priorityq.c
+    src/libtess/render.c
+    src/libtess/sweep.c
+    src/libtess/tess.c
+    src/libtess/tessmono.c
+    )
+
+target_compile_definitions( glu PRIVATE LIBRARYBUILD )
+
+# Third-party code: its warnings are not ours to fix
+target_compile_options( glu PRIVATE -w )
+
+target_include_directories( glu
+    PUBLIC
+        ${CMAKE_CURRENT_SOURCE_DIR}/include
+        ${CMAKE_CURRENT_SOURCE_DIR}/gl_shim
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/libutil
+        ${CMAKE_CURRENT_SOURCE_DIR}/src/libtess
+    )
+
+target_link_libraries( glu PUBLIC glad )
