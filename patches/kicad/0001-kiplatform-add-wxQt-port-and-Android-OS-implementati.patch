diff --git a/libs/kiplatform/CMakeLists.txt b/libs/kiplatform/CMakeLists.txt
index 0d06b9ba..5d869878 100644
--- a/libs/kiplatform/CMakeLists.txt
+++ b/libs/kiplatform/CMakeLists.txt
@@ -36,6 +36,21 @@ elseif( KICAD_WX_PORT STREQUAL gtk )
     include_directories( SYSTEM ${GTK3_INCLUDE_DIRS} )
     link_directories( ${GTK3_LIBRARY_DIRS} )
     add_definitions( ${GTK3_CFLAGS_OTHER} )
+elseif( KICAD_WX_PORT STREQUAL qt )
+    # wxQt: wxWindow::GetHandle() is a QWidget, so the port talks to Qt directly
+    set( PLATFORM_SRCS
+        port/wxqt/touchpad.cpp
+        port/wxqt/ui.cpp
+        port/wxqt/webview.cpp
+        )
+
+    find_package( Qt6 REQUIRED COMPONENTS Core Gui Widgets )
+
+    set( PLATFORM_LIBS
+        Qt6::Core
+        Qt6::Gui
+        Qt6::Widgets
+        )
 endif()
 
 
@@ -80,6 +95,21 @@ elseif( WIN32 )
         "imm32"
         "windowsapp"
         )
+elseif( ANDROID )
+    # Android: the generic POSIX pieces come from os/unix, the rest has no glib/gtk/libsecret
+    list( APPEND PLATFORM_SRCS
+        os/android/app.cpp
+        os/android/environment.cpp
+        os/android/printing.cpp
+        os/android/secrets.cpp
+        os/unix/drivers.cpp
+        os/unix/io.cpp
+        os/unix/policy.cpp
+        os/unix/sysinfo.cpp
+        )
+
+    find_package( Qt6 REQUIRED COMPONENTS Core )
+    list( APPEND PLATFORM_LIBS Qt6::Core log android )
 elseif( UNIX )
     list( APPEND PLATFORM_SRCS
         os/unix/app.cpp
