+/*
+ * wxQt port of the KIPLATFORM::UI functions.  Under wxQt, wxWindow::GetHandle() returns the
+ * QWidget backing the window, so platform queries go straight to Qt.  This port serves desktop
+ * Qt (for development) and Qt for Android.
+ */
+
+#include <kiplatform/ui.h>
+
+#include <wx/choice.h>
+#include <wx/dialog.h>
+#include <wx/nonownedwnd.h>
+#include <wx/settings.h>
+#include <wx/toplevel.h>
+#include <wx/window.h>
+
+#include <QCursor>
+#include <QGuiApplication>
+#include <QPalette>
+#include <QScreen>
+#include <QStyleHints>
+#include <QWidget>
+#include <QWindow>
+
+
+namespace
+{
+QWidget* qtWidget( const wxWindow* aWindow )
+{
+    return aWindow ? static_cast<QWidget*>( aWindow->GetHandle() ) : nullptr;
+}
+
+
+wxColour toWx( const QColor& aColor )
+{
+    return wxColour( aColor.red(), aColor.green(), aColor.blue(), aColor.alpha() );
+}
+} // namespace
+
+
+bool KIPLATFORM::UI::IsDarkTheme()
+{
+    Qt::ColorScheme scheme = QGuiApplication::styleHints()->colorScheme();
+
+    if( scheme != Qt::ColorScheme::Unknown )
+        return scheme == Qt::ColorScheme::Dark;
+
+    // Fall back to the palette brightness when the platform doesn't report a scheme
+    const QColor window = QGuiApplication::palette().color( QPalette::Window );
+    return window.lightness() < 128;
+}
+
+
+wxColour KIPLATFORM::UI::GetDialogBGColour()
+{
+    return toWx( QGuiApplication::palette().color( QPalette::Window ) );
+}
+
+
+void KIPLATFORM::UI::ForceFocus( wxWindow* aWindow )
+{
+    if( !aWindow )
+        return;
+
+    aWindow->SetFocus();
+
+    if( QWidget* w = qtWidget( aWindow ) )
+        w->activateWindow();
+}
+
+
+bool KIPLATFORM::UI::IsWindowActive( wxWindow* aWindow )
+{
+    QWidget* w = qtWidget( aWindow );
+    return w && w->isActiveWindow();
+}
+
+
+void KIPLATFORM::UI::ReparentModal( wxNonOwnedWindow* aWindow )
+{
+    // Not needed: Qt keeps modal dialogs above their parents
+}
+
+
+void KIPLATFORM::UI::ReparentWindow( wxNonOwnedWindow* aWindow, wxTopLevelWindow* aParent )
+{
+}
+
+
+void KIPLATFORM::UI::FixupCancelButtonCmdKeyCollision( wxWindow* aWindow )
+{
+    // macOS-only issue
+}
+
+
+bool KIPLATFORM::UI::IsStockCursorOk( wxStockCursor aCursor )
+{
+    switch( aCursor )
+    {
+    case wxCURSOR_BULLSEYE:
+    case wxCURSOR_HAND:
+    case wxCURSOR_ARROW:
+    case wxCURSOR_BLANK:
+        return true;
+
+    default:
+        return false;
+    }
+}
+
+
+void KIPLATFORM::UI::LargeChoiceBoxHack( wxChoice* aChoice )
+{
+    // QComboBox handles large item counts without special configuration
+}
+
+
+void KIPLATFORM::UI::EllipsizeChoiceBox( wxChoice* aChoice )
+{
+    // QComboBox elides overlong text by default
+}
+
+
+double KIPLATFORM::UI::GetPixelScaleFactor( const wxWindow* aWindow )
+{
+    if( QWidget* w = qtWidget( aWindow ) )
+        return w->devicePixelRatioF();
+
+    return qGuiApp ? qGuiApp->devicePixelRatio() : 1.0;
+}
+
+
+double KIPLATFORM::UI::GetContentScaleFactor( const wxWindow* aWindow )
+{
+    return GetPixelScaleFactor( aWindow );
+}
+
+
+double KIPLATFORM::UI::GetDisplayRefreshRate( const wxWindow* aWindow )
+{
+    QScreen* screen = nullptr;
+
+    if( QWidget* w = qtWidget( aWindow ) )
+        screen = w->screen();
+
+    if( !screen && qGuiApp )
+        screen = qGuiApp->primaryScreen();
+
+    return screen ? screen->refreshRate() : 0.0;
+}
+
+
+void KIPLATFORM::UI::GetInfoBarColours( wxColour& aFGColour, wxColour& aBGColour )
+{
+    aBGColour = wxSystemSettings::GetColour( wxSYS_COLOUR_INFOBK );
