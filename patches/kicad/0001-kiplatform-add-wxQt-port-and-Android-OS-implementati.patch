+
+/*
+ * Android paths live inside the app sandbox.  QStandardPaths maps them to the right
+ * Context directories (getFilesDir(), getCacheDir(), getExternalFilesDir()), so we use it
+ * rather than calling into JNI directly.
+ */
+
+#include <kiplatform/environment.h>
+
+#include <wx/filename.h>
+#include <wx/utils.h>
+
+#include <QDir>
+#include <QStandardPaths>
+
+
+namespace
+{
+wxString standardPath( QStandardPaths::StandardLocation aLocation )
+{
+    const QString path = QStandardPaths::writableLocation( aLocation );
+    QDir().mkpath( path );
+    return wxString::FromUTF8( path.toUtf8().constData() );
+}
+} // namespace
+
+
+void KIPLATFORM::ENV::Init()
+{
+}
+
+
+bool KIPLATFORM::ENV::MoveToTrash( const wxString& aPath, wxString& aError )
+{
+    // Android has no app-accessible trash; delete instead
+    bool ok = wxFileName::DirExists( aPath ) ? wxFileName::Rmdir( aPath, wxPATH_RMDIR_RECURSIVE )
+                                             : wxRemoveFile( aPath );
+
+    if( !ok )
+        aError = wxString::Format( wxT( "Unable to delete '%s'" ), aPath );
+
+    return ok;
+}
+
+
+bool KIPLATFORM::ENV::IsNetworkPath( const wxString& aPath )
+{
+    return false;
+}
+
+
+bool KIPLATFORM::ENV::IsRemovablePath( const wxString& aPath )
+{
+    // Removable volumes are mounted under /storage/<UUID>; the built-in volume is
+    // /storage/emulated
+    return aPath.StartsWith( wxT( "/storage/" ) ) && !aPath.StartsWith( wxT( "/storage/emulated" ) );
+}
+
+
+wxString KIPLATFORM::ENV::GetDocumentsPath()
+{
+    // App-specific external storage: visible to the user over USB and in the Files app,
+    // and needs no storage permission.  TODO(android): Storage Access Framework for
+    // projects elsewhere.
+    return standardPath( QStandardPaths::DocumentsLocation );
+}
+
+
+wxString KIPLATFORM::ENV::GetUserConfigPath()
+{
+    return standardPath( QStandardPaths::AppConfigLocation );
+}
+
+
+wxString KIPLATFORM::ENV::GetUserDataPath()
+{
+    return standardPath( QStandardPaths::AppDataLocation );
+}
+
+
+wxString KIPLATFORM::ENV::GetUserLocalDataPath()
+{
+    return standardPath( QStandardPaths::AppLocalDataLocation );
+}
+
+
+wxString KIPLATFORM::ENV::GetUserCachePath()
+{
+    return standardPath( QStandardPaths::CacheLocation );
+}
+
+
+bool KIPLATFORM::ENV::GetSystemProxyConfig( const wxString& aURL, PROXY_CONFIG& aCfg )
+{
+    // TODO(android): read the system proxy via ConnectivityManager.getDefaultProxy()
+    return false;
+}
+
+
+bool KIPLATFORM::ENV::VerifyFileSignature( const wxString& aPath )
+{
+    return true;
+}
+
+
+wxString KIPLATFORM::ENV::GetAppUserModelId()
+{
+    return wxEmptyString;
+}
+
+
+void KIPLATFORM::ENV::SetAppDetailsForWindow( wxWindow* aWindow, const wxString& aRelaunchCommand,
+                                              const wxString& aRelaunchDisplayName )
+{
+}
+
