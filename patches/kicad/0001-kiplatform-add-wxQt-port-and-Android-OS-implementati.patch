+
+
+void KIPLATFORM::UI::GetNativeWindowHandles( wxWindow* aWindow, void** aHandle, void** aDisplay,
+                                             int* aDisplayType )
+{
+    *aHandle = nullptr;
+    *aDisplay = nullptr;
+
+    if( aDisplayType )
+        *aDisplayType = DISPLAY_UNKNOWN;
+
+    // TODO(android): return the ANativeWindow of the canvas' QWindow so the Modern (Vulkan)
+    // GAL can create a VK_KHR_android_surface.  Until then callers fall back to Cairo.
+}
+
+
+void KIPLATFORM::UI::PrepareForExternalRendering( wxWindow* aWindow )
+{
+    if( QWidget* w = qtWidget( aWindow ) )
+    {
+        // The GPU owns the widget's contents; stop Qt painting over them
+        w->setAttribute( Qt::WA_NativeWindow );
+        w->setAttribute( Qt::WA_PaintOnScreen );
+        w->setAttribute( Qt::WA_NoSystemBackground );
+    }
+}
+
+
+void KIPLATFORM::UI::KeepAboveExternalRendering( wxWindow* aChild )
+{
+    if( QWidget* w = qtWidget( aChild ) )
+        w->setAttribute( Qt::WA_NativeWindow );
+}
