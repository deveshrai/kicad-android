+#ifdef __ANDROID__
+void DIALOG_EXPORT_STEP::exportInProcess( const wxString& aOutputPath, double aTolerance )
+{
+    JOB_EXPORT_PCB_3D job;
+    fillJob( job, aTolerance );
+
+    BOARD*             board = m_editFrame->GetBoard();
+    const wxString     previousVariant = board->GetCurrentVariant();
+    WX_STRING_REPORTER reporter;
+    bool               ok = false;
+
+    if( !job.m_variant.IsEmpty() && job.m_variant != previousVariant )
+        board->SetCurrentVariant( job.m_variant );
+
+    {
+        wxBusyCursor  busy;
+        EXPORTER_STEP exporter( board, job.m_3dparams, &reporter );
+        exporter.m_outputFile = aOutputPath;
+        ok = exporter.Export();
+    }
+
+    if( board->GetCurrentVariant() != previousVariant )
+        board->SetCurrentVariant( previousVariant );
+
+    if( ok )
+    {
+        wxString msg = wxString::Format( _( "Exported '%s'." ), aOutputPath );
+
+        if( reporter.HasMessageOfSeverity( RPT_SEVERITY_WARNING | RPT_SEVERITY_ERROR ) )
+            DisplayInfoMessage( this, msg, reporter.GetMessages() );
+        else
+            DisplayInfoMessage( this, msg );
+    }
+    else
+    {
+        DisplayErrorMessage( this, wxString::Format( _( "Failed to export '%s'." ), aOutputPath ),
+                             reporter.GetMessages() );
     }
 }
+#endif
