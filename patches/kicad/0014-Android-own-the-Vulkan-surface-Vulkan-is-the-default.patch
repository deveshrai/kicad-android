@@ -76,6 +84,43 @@ wxColour toWx( const QColor& aColor )
  *  - The canvas is fully covered and gets no paint events of its own, yet KiCad renders a frame
  *    in response to paint; exposure and resizes of this window are turned into canvas repaints.
  */
+/**
+ * Vulkan canvas windows still alive.  The render thread may (re)create a surface for a window at
+ * any time; it checks here under the lock, and a window deregisters under the same lock, so it
+ * can't be deleted while a surface is being made from it.
+ *
+ * kiplatform is linked statically into several libraries, each with its own copy of this file's
+ * statics, so the one registry hangs off the application object (created on the GUI thread
+ * before any surface is asked for, and never replaced).
+ */
+struct LIVE_VULKAN_WINDOWS
+{
+    std::mutex           mutex;
+    QSet<const QWindow*> windows;
+};
+
+
+LIVE_VULKAN_WINDOWS* liveVulkanWindows( bool aCreate = false )
+{
+    static const char* const PROPERTY = "kicadLiveVulkanWindows";
+
+    if( !qApp )
+        return nullptr;
+
+    QVariant existing = qApp->property( PROPERTY );
+
+    if( existing.isValid() )
+        return static_cast<LIVE_VULKAN_WINDOWS*>( existing.value<void*>() );
+
+    if( !aCreate )
+        return nullptr;
+
+    LIVE_VULKAN_WINDOWS* registry = new LIVE_VULKAN_WINDOWS;    // lives as long as the process
+    qApp->setProperty( PROPERTY, QVariant::fromValue<void*>( registry ) );
+    return registry;
+}
+
+
 class VULKAN_CANVAS_WINDOW : public QWindow
 {
 public:
@@ -87,6 +132,19 @@ public:
         // Composited as a TextureView (QT_ANDROID_SURFACE_CONTAINER_TYPE, set in
         // KIPLATFORM::ENV::Init), so it stacks correctly with frames, dialogs and popups
         setSurfaceType( QSurface::VulkanSurface );
+
+        LIVE_VULKAN_WINDOWS*        live = liveVulkanWindows( true );
+        std::lock_guard<std::mutex> lock( live->mutex );
+        live->windows.insert( this );
+    }
+
+    ~VULKAN_CANVAS_WINDOW() override
+    {
+        if( LIVE_VULKAN_WINDOWS* live = liveVulkanWindows() )
+        {
+            std::lock_guard<std::mutex> lock( live->mutex );
+            live->windows.remove( this );
+        }
     }
 
