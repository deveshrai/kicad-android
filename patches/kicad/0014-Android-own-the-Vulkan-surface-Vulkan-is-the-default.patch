+    // Qt's own VkSurfaceKHR would be destroyed whenever Android takes the window's surface away
+    // (a dialog closing, a pane hiding, the app going to the background), from the Android UI
+    // thread and without telling us, so a render thread still using it reads freed memory.  And
+    // Android allows only one VkSurfaceKHR per window, so Qt must not make one at all
+    // (QVulkanInstance::surfaceForWindow is never called).  Instead the window's Java side is
+    // asked for its surface container directly, as QAndroidPlatformWindow::createSurface()
+    // would; Qt then ignores the surface callbacks for it.  The Vulkan loader keeps a reference
+    // to the ANativeWindow for the life of our VkSurfaceKHR, so when Android abandons it the
+    // device reports VK_ERROR_SURFACE_LOST_KHR / OUT_OF_DATE (and the render thread makes a new
+    // one) instead of crashing.  The caller owns and destroys it.
+    //
+    // winId() is the window's org.qtproject.qt.android.QtWindow; its surface container is a
+    // QtTextureView (patched QtWindow, see android/qt-patches) holding the current Surface.
+    QJniEnvironment env;
+    QJniObject      qtWindow( reinterpret_cast<jobject>( window->winId() ) );
+
+    if( !qtWindow.isValid() )
+        return failSurface( "no QtWindow" );
+
+    auto currentSurface = [&]() -> QJniObject
+    {
+        QJniObject container = qtWindow.getObjectField( "m_surfaceContainer", "Landroid/view/View;" );
+        env.checkAndClearExceptions();
+
+        if( !container.isValid() )
+            return {};
+
+        jclass textureView = env->FindClass( "android/view/TextureView" );
+        bool   isTextureView = textureView && env->IsInstanceOf( container.object(), textureView );
+
+        if( textureView )
+            env->DeleteLocalRef( textureView );
+
+        env.checkAndClearExceptions();
+
+        if( !isTextureView )
+            return {};
+
+        QJniObject surface = container.getObjectField( "m_surface", "Landroid/view/Surface;" );
+        env.checkAndClearExceptions();
+        return surface;
+    };
+
+    QJniObject surface = currentSurface();
+
+    if( !surface.isValid() )
+    {
+        QJniObject container = qtWindow.getObjectField( "m_surfaceContainer", "Landroid/view/View;" );
+        env.checkAndClearExceptions();
+
+        // createSurface(onTop, imageDepth, isOpaque, containerType): built on the UI thread
+        if( !container.isValid() )
+        {
+            qtWindow.callMethod<void>( "createSurface", "(ZIZI)V", jboolean( false ), jint( 32 ),
+                                       jboolean( true ), jint( 1 ) );
+            env.checkAndClearExceptions();
+        }
 
-    if( window->vulkanInstance() != qvk )
-        window->setVulkanInstance( qvk );
+        // The Surface arrives once the TextureView is attached and its texture available
+        for( int i = 0; i < 200 && !surface.isValid(); ++i )
+        {
+            std::this_thread::sleep_for( std::chrono::milliseconds( 10 ) );
+            surface = currentSurface();
+        }
+    }
+
+    if( !surface.isValid() )
+        return failSurface( "no android.view.Surface" );
+
+    ANativeWindow* nativeWindow = ANativeWindow_fromSurface( env.jniEnv(), surface.object() );
+
+    if( !nativeWindow )
+        return failSurface( "no ANativeWindow" );
+
+    auto createSurface = reinterpret_cast<PFN_vkCreateAndroidSurfaceKHR>(
+            qvk->getInstanceProcAddr( "vkCreateAndroidSurfaceKHR" ) );
+
+    VkSurfaceKHR vkSurface = VK_NULL_HANDLE;
+
+    if( createSurface )
+    {
+        VkAndroidSurfaceCreateInfoKHR info{};
+        info.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+        info.window = nativeWindow;
+
+        VkResult result = createSurface( static_cast<VkInstance>( aVkInstance ), &info, nullptr,
+                                         &vkSurface );
+
+        if( result != VK_SUCCESS )
+        {
+            __android_log_print( ANDROID_LOG_WARN, "KiCad", "Vulkan surface: create failed (%d)",
+                                 static_cast<int>( result ) );
+            vkSurface = VK_NULL_HANDLE;
+        }
+    }
 
-    return reinterpret_cast<uint64_t>( QVulkanInstance::surfaceForWindow( window ) );
+    // The VkSurfaceKHR holds its own reference
+    ANativeWindow_release( nativeWindow );
+    return reinterpret_cast<uint64_t>( vkSurface );
