+#include <wx/timer.h>
+
+class PCB_EDIT_FRAME;
+class wxButton;
+class wxCheckBox;
+class wxGauge;
+class wxStaticText;
+
+/**
+ * Routes the whole board with the integrated autorouter (Freerouting), showing the routes on the
+ * board as they are found.  Everything it changes is one undo step.
+ */
+class DIALOG_AUTOROUTE : public DIALOG_SHIM
+{
+public:
+    DIALOG_AUTOROUTE( PCB_EDIT_FRAME* aFrame );
+    ~DIALOG_AUTOROUTE() override;
+
+private:
+    enum class STATE
+    {
+        SETUP,
+        RUNNING,
+        FINISHED
+    };
+
+    void onStart( wxCommandEvent& aEvent );
+    void onSkip( wxCommandEvent& aEvent );
+    void onStop( wxCommandEvent& aEvent );
+    void onKeep( wxCommandEvent& aEvent );
+    void onDiscard( wxCommandEvent& aEvent );
+    void onClose( wxCloseEvent& aEvent );
+    void onTimer( wxTimerEvent& aEvent );
+
+    void setState( STATE aState );
+    void moveToCorner();
+    bool importSession( const wxString& aPath );
+    void finish();
+
+    PCB_EDIT_FRAME* m_frame;
+    STATE           m_state = STATE::SETUP;
+    wxTimer         m_timer;
+    wxString        m_workDir;
+    wxString        m_dsnPath;
+    wxString        m_sesPath;
+    wxString        m_snapPath;
+    int             m_lastSnapshot = 0;
+    bool            m_pushed = false;   ///< True once an undo step holds our changes.
+    bool            m_stopping = false;
+    wxString        m_result;
+
+    wxStaticText* m_intro;
+    wxCheckBox*   m_optimize;
+    wxCheckBox*   m_live;
+    wxCheckBox*   m_fillZones;
+    wxStaticText* m_stage;
+    wxGauge*      m_gauge;
+    wxStaticText* m_routed;
+    wxStaticText* m_details;
+    wxButton*     m_cancelBtn;
+    wxButton*     m_startBtn;
+    wxButton*     m_skipBtn;
+    wxButton*     m_stopBtn;
+    wxButton*     m_discardBtn;
+    wxButton*     m_keepBtn;
+};
+
+#endif // DIALOG_AUTOROUTE_H
