+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// The Android app carries Freerouting's routing core, run by the Java class
+// io.github.deveshrai.kicadandroid.Autorouter in the app's own runtime.  Routing runs on a
+// thread of its own here, attached to the Java VM; the status getters are called from the UI.
+
+#include <kiplatform/autorouter.h>
+
+#include <QCoreApplication>
+#include <QJniEnvironment>
+#include <QJniObject>
+
+#include <android/log.h>
+
+#include <atomic>
+#include <mutex>
+#include <thread>
+
+namespace
+{
+const char* const CLASS_NAME = "io.github.deveshrai.kicadandroid.Autorouter";
+
+jclass            g_class = nullptr;   // global reference, usable from any thread
+
+std::mutex        g_lock;
+std::thread       g_thread;
+std::atomic<bool> g_running{ false };
+wxString          g_error;
+
+
+wxString wxstr( const QString& aText )
+{
+    return wxString::FromUTF8( aText.toUtf8().constData() );
+}
+
+
+// The app's own class loader finds classes from the APK on any thread; JNI FindClass on a
+// native thread only sees the system classes.
+bool classFound()
+{
+    QJniEnvironment env;
+    QJniObject      ctx = QNativeInterface::QAndroidApplication::context();
+    QJniObject      loader = ctx.callObjectMethod( "getClassLoader", "()Ljava/lang/ClassLoader;" );
+    QJniObject      cls;
+
+    if( loader.isValid() )
+    {
+        cls = loader.callObjectMethod( "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;",
+                                       QJniObject::fromString( CLASS_NAME ).object<jstring>() );
+    }
+
+    if( env.checkAndClearExceptions() || !cls.isValid() )
+    {
+        __android_log_print( ANDROID_LOG_WARN, "KiCad", "Autorouter: class %s not found",
+                             CLASS_NAME );
+        return false;
+    }
+
+    g_class = static_cast<jclass>( env->NewGlobalRef( cls.object() ) );
+    return true;
+}
+
+
+QString callString( const char* aMethod )
+{
+    return QJniObject::callStaticObjectMethod( g_class, aMethod, "()Ljava/lang/String;" )
+            .toString();
+}
+
+
+template <typename T>
+T call( const char* aMethod, const char* aSignature )
+{
+    return QJniObject::callStaticMethod<T>( g_class, aMethod, aSignature );
+}
+} // namespace
+
+
+namespace KIPLATFORM
+{
+namespace AUTOROUTER
+{
+
+bool IsAvailable()
+{
+    static const bool available = classFound();
+    return available;
+}
+
+
+bool Start( const wxString& aDsnPath, const wxString& aSesPath, int aMaxPasses, bool aOptimize,
+            const wxString& aSnapshotPath )
+{
+    std::lock_guard<std::mutex> lock( g_lock );
+
+    if( g_running || !IsAvailable() )
+        return false;
+
+    if( g_thread.joinable() )
+        g_thread.join();
+
+    g_error.clear();
+    g_running = true;
+
+    std::string dsn = aDsnPath.utf8_string();
+    std::string ses = aSesPath.utf8_string();
+    std::string snap = aSnapshotPath.utf8_string();
+
+    g_thread = std::thread(
+            [dsn, ses, snap, aMaxPasses, aOptimize]()
+            {
+                // QJniObject attaches this thread to the VM, and finds the app's classes
+                // through Qt's class loader.
+                QJniObject result = QJniObject::callStaticObjectMethod(
+                        g_class, "route",
+                        "(Ljava/lang/String;Ljava/lang/String;IZILjava/lang/String;)"
+                        "Ljava/lang/String;",
+                        QJniObject::fromString( QString::fromStdString( dsn ) ).object<jstring>(),
+                        QJniObject::fromString( QString::fromStdString( ses ) ).object<jstring>(),
+                        (jint) aMaxPasses, (jboolean) aOptimize, (jint) 0,
+                        QJniObject::fromString( QString::fromStdString( snap ) ).object<jstring>() );
+
+                QJniEnvironment env;
+
+                if( env.checkAndClearExceptions() )
+                {
+                    std::lock_guard<std::mutex> lock2( g_lock );
+                    g_error = wxS( "The autorouter stopped with a Java exception." );
+                }
+                else if( result.isValid() && !result.toString().isEmpty() )
+                {
+                    std::lock_guard<std::mutex> lock2( g_lock );
+                    g_error = wxstr( result.toString() );
+                }
+
+                g_running = false;
+            } );
+
+    return true;
+}
+
+
+void StopRouting()
+{
+    if( IsAvailable() )
+        call<void>( "stopRouting", "()V" );
+}
+
+
+void StopAll()
+{
+    if( IsAvailable() )
+        call<void>( "stopAll", "()V" );
+}
+
+
+STATUS GetStatus()
+{
+    STATUS s;
+
+    if( !IsAvailable() )
+        return s;
+
+    s.stage = wxstr( callString( "getStage" ) );
+    s.message = wxstr( callString( "getMessage" ) );
+    s.pass = call<jint>( "getPass", "()I" );
+    s.unrouted = call<jint>( "getUnrouted", "()I" );
+    s.connections = call<jint>( "getConnections", "()I" );
+    s.vias = call<jint>( "getVias", "()I" );
+    s.violations = call<jint>( "getViolations", "()I" );
+    s.traceLengthMm = call<jfloat>( "getTraceLengthMm", "()F" );
+    s.snapshotSerial = call<jint>( "getSnapshotSerial", "()I" );
+    s.elapsedMs = (long) call<jlong>( "getElapsedMs", "()J" );
+    s.running = g_running;
+
+    std::lock_guard<std::mutex> lock( g_lock );
+    s.error = g_error;
+
+    if( !s.running && g_thread.joinable() )
+        g_thread.join();
+
+    return s;
+}
+
+} // namespace AUTOROUTER
+} // namespace KIPLATFORM
