+
+namespace AR = KIPLATFORM::AUTOROUTER;
+
+
+DIALOG_AUTOROUTE::DIALOG_AUTOROUTE( PCB_EDIT_FRAME* aFrame ) :
+        DIALOG_SHIM( aFrame, wxID_ANY, _( "Autoroute Board" ), wxDefaultPosition, wxDefaultSize,
+                     wxDEFAULT_DIALOG_STYLE ),
+        m_frame( aFrame ),
+        m_timer( this )
+{
+    wxBoxSizer* top = new wxBoxSizer( wxVERTICAL );
+
+    m_intro = new wxStaticText( this, wxID_ANY,
+                                _( "Routes every unrouted connection with Freerouting, on this "
+                                   "device.\nRoutes you have already drawn are kept, but the "
+                                   "optimizer may improve them.\nLock any track that must stay "
+                                   "exactly as it is." ) );
+    top->Add( m_intro, 0, wxALL, 10 );
+
+    m_optimize = new wxCheckBox( this, wxID_ANY,
+                                 _( "Optimize the routes afterwards (shorter, fewer vias)" ) );
+    m_optimize->SetValue( true );
+    top->Add( m_optimize, 0, wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    m_live = new wxCheckBox( this, wxID_ANY, _( "Show the routes on the board as they are found" ) );
+    m_live->SetValue( true );
+    top->Add( m_live, 0, wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    m_fillZones = new wxCheckBox( this, wxID_ANY, _( "Refill zones when done" ) );
+    m_fillZones->SetValue( true );
+    top->Add( m_fillZones, 0, wxLEFT | wxRIGHT | wxBOTTOM, 10 );
+
+    m_stage = new wxStaticText( this, wxID_ANY, wxEmptyString );
+    m_stage->SetFont( m_stage->GetFont().Bold() );
+    top->Add( m_stage, 0, wxLEFT | wxRIGHT | wxTOP, 10 );
+
+    m_gauge = new wxGauge( this, wxID_ANY, 100, wxDefaultPosition, wxSize( 420, -1 ) );
+    top->Add( m_gauge, 0, wxEXPAND | wxLEFT | wxRIGHT | wxTOP, 10 );
+
+    m_routed = new wxStaticText( this, wxID_ANY, wxEmptyString );
+    top->Add( m_routed, 0, wxLEFT | wxRIGHT | wxTOP, 10 );
+
+    m_details = new wxStaticText( this, wxID_ANY, wxEmptyString );
+    top->Add( m_details, 0, wxLEFT | wxRIGHT | wxTOP, 10 );
+
+    wxBoxSizer* buttons = new wxBoxSizer( wxHORIZONTAL );
+    buttons->AddStretchSpacer();
+    m_cancelBtn = new wxButton( this, wxID_CANCEL, _( "Cancel" ) );
+    m_startBtn = new wxButton( this, wxID_ANY, _( "Route" ) );
+    m_skipBtn = new wxButton( this, wxID_ANY, _( "Optimize Now" ) );
+    m_stopBtn = new wxButton( this, wxID_ANY, _( "Stop" ) );
+    m_discardBtn = new wxButton( this, wxID_ANY, _( "Discard" ) );
+    m_keepBtn = new wxButton( this, wxID_OK, _( "Keep" ) );
+
+    for( wxButton* b : { m_cancelBtn, m_startBtn, m_skipBtn, m_stopBtn, m_discardBtn, m_keepBtn } )
+        buttons->Add( b, 0, wxLEFT, 8 );
+
+    top->Add( buttons, 0, wxEXPAND | wxALL, 10 );
+    SetSizer( top );
+
+    m_startBtn->SetDefault();
+    m_startBtn->Bind( wxEVT_BUTTON, &DIALOG_AUTOROUTE::onStart, this );
+    m_skipBtn->Bind( wxEVT_BUTTON, &DIALOG_AUTOROUTE::onSkip, this );
+    m_stopBtn->Bind( wxEVT_BUTTON, &DIALOG_AUTOROUTE::onStop, this );
+    m_discardBtn->Bind( wxEVT_BUTTON, &DIALOG_AUTOROUTE::onDiscard, this );
+    m_keepBtn->Bind( wxEVT_BUTTON, &DIALOG_AUTOROUTE::onKeep, this );
+    Bind( wxEVT_CLOSE_WINDOW, &DIALOG_AUTOROUTE::onClose, this );
+    Bind( wxEVT_TIMER, &DIALOG_AUTOROUTE::onTimer, this );
+
+    wxFileName dir( KIPLATFORM::ENV::GetUserCachePath(), wxEmptyString );
+    dir.AppendDir( wxS( "autoroute" ) );
+    dir.Mkdir( wxS_DIR_DEFAULT, wxPATH_MKDIR_FULL );
+    m_workDir = dir.GetPath();
+    m_dsnPath = m_workDir + wxS( "/board.dsn" );
+    m_sesPath = m_workDir + wxS( "/board.ses" );
+    m_snapPath = m_workDir + wxS( "/snapshot.ses" );
+
+    setState( STATE::SETUP );
+    finishDialogSettings();
+
+    // Sit in the top right corner, so the board stays in view while it is routed.  Showing the
+    // dialog centres it, so move it once it is up.
+    Bind( wxEVT_INIT_DIALOG,
+          [this]( wxInitDialogEvent& aEvent )
+          {
+              aEvent.Skip();
+              CallAfter( [this]() { moveToCorner(); } );
+          } );
+}
+
+
+void DIALOG_AUTOROUTE::moveToCorner()
+{
+    wxRect frameRect = m_frame->GetScreenRect();
+    wxSize size = GetSize();
+    Move( wxPoint( frameRect.GetRight() - size.x - 24, frameRect.GetTop() + 140 ) );
+}
+
+
+DIALOG_AUTOROUTE::~DIALOG_AUTOROUTE()
+{
+    m_timer.Stop();
+
+    if( m_state == STATE::RUNNING )
+        AR::StopAll();
+}
+
+
+void DIALOG_AUTOROUTE::setState( STATE aState )
+{
+    m_state = aState;
+
+    bool setup = aState == STATE::SETUP;
+    bool running = aState == STATE::RUNNING;
+    bool finished = aState == STATE::FINISHED;
+
+    m_intro->Show( setup );
+    m_optimize->Show( setup );
+    m_live->Show( setup );
+    m_fillZones->Show( setup );
+    m_stage->Show( !setup );
+    m_gauge->Show( !setup );
+    m_routed->Show( !setup );
+    m_details->Show( !setup );
+
+    m_cancelBtn->Show( setup );
+    m_startBtn->Show( setup );
+    m_skipBtn->Show( running && m_optimize->GetValue() );
+    m_stopBtn->Show( running );
+    m_discardBtn->Show( finished && m_pushed );
+    m_keepBtn->Show( finished );
+
+    Layout();
+    GetSizer()->Fit( this );
+}
+
+
+void DIALOG_AUTOROUTE::onStart( wxCommandEvent& aEvent )
+{
+    for( const wxString& old : { m_sesPath, m_snapPath } )
+    {
+        if( wxFileExists( old ) )
+            wxRemoveFile( old );
+    }
+
+    if( !m_frame->ExportSpecctraFile( m_dsnPath ) )
+        return;
+
+    if( !AR::Start( m_dsnPath, m_sesPath, 0, m_optimize->GetValue(),
+                    m_live->GetValue() ? m_snapPath : wxString() ) )
+    {
+        DisplayErrorMessage( this, _( "The autorouter could not be started." ) );
+        return;
+    }
+
+    m_lastSnapshot = 0;
+    m_stage->SetLabel( _( "Reading the board..." ) );
+    m_routed->SetLabel( wxEmptyString );
+    m_details->SetLabel( wxEmptyString );
+    setState( STATE::RUNNING );
+    m_timer.Start( 250 );
+}
+
+
+void DIALOG_AUTOROUTE::onSkip( wxCommandEvent& aEvent )
+{
+    AR::StopRouting();
+    m_skipBtn->Disable();
+}
+
+
+void DIALOG_AUTOROUTE::onStop( wxCommandEvent& aEvent )
+{
+    m_stopping = true;
+    AR::StopAll();
+    m_skipBtn->Disable();
+    m_stopBtn->Disable();
+    m_stage->SetLabel( _( "Stopping..." ) );
+}
+
+
+void DIALOG_AUTOROUTE::onKeep( wxCommandEvent& aEvent )
+{
+    bool fill = m_pushed && m_fillZones->GetValue();
+
+    EndModal( wxID_OK );
+
+    if( fill )
+        m_frame->GetToolManager()->PostAction( PCB_ACTIONS::zoneFillAll );
+}
+
+
+void DIALOG_AUTOROUTE::onDiscard( wxCommandEvent& aEvent )
+{
+    if( m_pushed )
+        m_frame->GetToolManager()->RunAction( ACTIONS::undo );
+
+    EndModal( wxID_CANCEL );
+}
+
+
+void DIALOG_AUTOROUTE::onClose( wxCloseEvent& aEvent )
+{
+    if( m_state == STATE::RUNNING )
+    {
+        // Closing while routing means stop; the routes found so far are offered when it ends.
+        wxCommandEvent dummy;
+        onStop( dummy );
+        aEvent.Veto();
+        return;
+    }
+
+    EndModal( m_state == STATE::FINISHED ? wxID_OK : wxID_CANCEL );
+}
+
+
+bool DIALOG_AUTOROUTE::importSession( const wxString& aPath )
+{
+    BOARD_COMMIT commit( m_frame );
+
+    m_frame->GetToolManager()->RunAction( ACTIONS::selectionClear );
+
+    try
+    {
+        DSN::ImportSpecctraSession( m_frame->GetBoard(), aPath, commit );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        commit.Revert();
+        m_result = ioe.What();
+        return false;
+    }
+
+    // Every import replaces the routes of the one before, so they all share one undo step.
+    commit.Push( _( "Autoroute" ), m_pushed ? APPEND_UNDO : 0 );
+    m_pushed = true;
+    m_frame->GetCanvas()->ForceRefresh();
+    return true;
+}
+
+
+void DIALOG_AUTOROUTE::onTimer( wxTimerEvent& aEvent )
+{
+    AR::STATUS s = AR::GetStatus();
+
+    if( s.connections > 0 && s.unrouted >= 0 )
+    {
+        int routed = std::max( 0, s.connections - s.unrouted );
+        m_gauge->SetRange( s.connections );
+        m_gauge->SetValue( routed );
+        m_routed->SetLabel( wxString::Format( _( "%d of %d connections routed" ), routed,
+                                              s.connections ) );
+    }
+
+    long     secs = s.elapsedMs / 1000;
+    wxString details = secs < 60 ? wxString::Format( _( "%.1f s" ), s.elapsedMs / 1000.0 )
+                                 : wxString::Format( _( "%ld:%02ld" ), secs / 60, secs % 60 );
+
+    if( s.vias >= 0 )
+        details += wxString::Format( _( "   %d vias" ), s.vias );
+
+    if( s.traceLengthMm >= 0 )
+        details += wxString::Format( _( "   %.0f mm of track" ), s.traceLengthMm );
+
+    if( s.violations > 0 )
+        details += wxString::Format( _( "   %d clearance violations" ), s.violations );
+
+    m_details->SetLabel( details );
+
+    if( !m_stopping )
+    {
+        if( s.stage == wxS( "loading" ) )
+            m_stage->SetLabel( _( "Reading the board..." ) );
+        else if( s.stage == wxS( "routing" ) && s.message == wxS( "fanout" ) )
+            m_stage->SetLabel( wxString::Format( _( "Fanning out pads, pass %d" ), s.pass ) );
+        else if( s.stage == wxS( "routing" ) )
+            m_stage->SetLabel( wxString::Format( _( "Routing, pass %d" ), s.pass ) );
+        else if( s.stage == wxS( "optimizing" ) )
+        {
+            m_stage->SetLabel( wxString::Format( _( "Optimizing, pass %d" ), s.pass ) );
+            m_skipBtn->Hide();
+        }
+        else if( s.stage == wxS( "saving" ) )
+            m_stage->SetLabel( _( "Saving..." ) );
+    }
+
+    if( s.running && s.snapshotSerial != m_lastSnapshot && wxFileExists( m_snapPath ) )
+    {
+        m_lastSnapshot = s.snapshotSerial;
+        importSession( m_snapPath );
+    }
+
+    if( !s.running )
+    {
+        m_timer.Stop();
+        m_result = s.error;
+        finish();
+    }
+
+    Layout();
+    GetSizer()->Fit( this );
+    moveToCorner();
+}
+
+
+void DIALOG_AUTOROUTE::finish()
+{
+    if( m_result.IsEmpty() && wxFileExists( m_sesPath ) && importSession( m_sesPath ) )
+    {
+        AR::STATUS s = AR::GetStatus();
+        int        routed = std::max( 0, s.connections - s.unrouted );
+
+        if( s.unrouted == 0 )
+            m_stage->SetLabel( _( "Done: every connection is routed." ) );
+        else if( m_stopping )
+            m_stage->SetLabel( wxString::Format( _( "Stopped: %d connections are still "
+                                                    "unrouted." ),
+                                                 s.unrouted ) );
+        else
+            m_stage->SetLabel( wxString::Format( _( "Done: %d connections are still unrouted. "
+                                                    "Route them by hand, or move parts and "
+                                                    "try again." ),
+                                                 s.unrouted ) );
+
+        m_routed->SetLabel( wxString::Format( _( "%d of %d connections routed. Keep the routes, "
+                                                 "or discard them (same as Undo)." ),
+                                              routed, s.connections ) );
+    }
+    else
+    {
+        m_stage->SetLabel( _( "The autorouter failed." ) );
+        m_routed->SetLabel( m_result );
+
+        if( m_pushed )
+            m_routed->SetLabel( m_result + wxS( "\n" ) + _( "The board shows the last routes "
+                                                            "found. Discard undoes them." ) );
+    }
+
+    setState( STATE::FINISHED );
+}
