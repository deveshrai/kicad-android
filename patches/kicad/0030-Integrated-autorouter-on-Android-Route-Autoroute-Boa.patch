+#ifndef KIPLATFORM_AUTOROUTER_H_
+#define KIPLATFORM_AUTOROUTER_H_
+
+#include <wx/string.h>
+
+namespace KIPLATFORM
+{
+namespace AUTOROUTER
+{
+
+/**
+ * Status of a running or finished autorouter job.
+ *
+ * Stage is one of "idle", "loading", "routing", "optimizing", "saving", "done", "failed" or
+ * "cancelled".
+ */
+struct STATUS
+{
+    wxString stage;
+    wxString message;
+    int      pass = 0;
+    int      unrouted = -1;      ///< Connections still to route, -1 if not known yet.
+    int      connections = -1;   ///< All connections on the board, -1 if not known yet.
+    int      vias = -1;
+    int      violations = -1;
+    double   traceLengthMm = -1;
+    int      snapshotSerial = 0; ///< Goes up each time the snapshot session file is rewritten.
+    long     elapsedMs = 0;
+    bool     running = false;
+    wxString error;              ///< Set when the job ends with an error.
+};
+
+/// True if this build includes an integrated autorouter.
+bool IsAvailable();
+
+/**
+ * Start routing the Specctra DSN file @a aDsnPath on a background thread.  The routed session
+ * is written to @a aSesPath.  While routing, a session file with the routes so far is written
+ * to @a aSnapshotPath (if not empty) every pass or so.
+ *
+ * @param aMaxPasses is the number of autorouter passes, 0 to stop when routing stops improving.
+ * @return false if a job is already running or the router is not available.
+ */
+bool Start( const wxString& aDsnPath, const wxString& aSesPath, int aMaxPasses, bool aOptimize,
+            const wxString& aSnapshotPath );
+
+/// Stop routing and go on to optimize what is routed so far.
+void StopRouting();
+
+/// Stop routing and optimizing.  The session file still gets the routes made so far.
+void StopAll();
+
+STATUS GetStatus();
+
+} // namespace AUTOROUTER
+} // namespace KIPLATFORM
+
+#endif // KIPLATFORM_AUTOROUTER_H_
